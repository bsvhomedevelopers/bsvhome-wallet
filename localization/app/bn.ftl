multisig_review_subtitle = স্বাক্ষর করলেই সম্পদ সঙ্গে সঙ্গে পাঠানো হয় না
multisig_review_notice = নিজে লেনদেন যাচাই করুন। ঠিকানা, পরিমাণ বা ফি বদলালে আবার স্বাক্ষর সংগ্রহ করতে হবে।
multisig_review_check = আমি গন্তব্য, নেটওয়ার্ক, পরিমাণ ও ফি যাচাই করেছি এবং এই লেনদেনে স্বাক্ষর করতে সম্মত।
multisig_authenticate_sign = পরিচয় যাচাই করে স্বাক্ষর করুন
multisig_share_proposal = প্রস্তাব শেয়ার করুন
multisig_share_signature = স্বাক্ষরের প্যাকেজ শেয়ার করুন
multisig_broadcast = লেনদেন নেটওয়ার্কে পাঠান
multisig_confirm_broadcast = স্বাক্ষর সম্পূর্ণ: নেটওয়ার্কে পাঠানো নিশ্চিত করুন
multisig_broadcast_notice = এতে স্বাক্ষরিত লেনদেন BSV নেটওয়ার্কে জমা দেওয়া হবে। পেমেন্টের তথ্য আবার যাচাই করুন।
multisig_collecting = স্বাক্ষরের জন্য অপেক্ষা
multisig_ready = নেটওয়ার্কে পাঠানো বাকি
multisig_broadcasting = নেটওয়ার্কে পাঠানো হচ্ছে
multisig_pending_confirmation = নেটওয়ার্কের নিশ্চিতকরণের জন্য অপেক্ষা
multisig_finished = সম্পন্ন
multisig_stopped = সহযোগিতা বন্ধ
multisig_conflicted = ইনপুট অন্য লেনদেনে খরচ হয়েছে
multisig_uncertain = নেটওয়ার্কের ফল অনিশ্চিত
multisig_stop = সহযোগিতা বন্ধ করুন
multisig_stop_notice = সহযোগিতা বন্ধ করলে আগে শেয়ার করা বৈধ স্বাক্ষর বাতিল হয় না। অন্য সদস্য এখনও মূল লেনদেন নেটওয়ার্কে পাঠাতে পারেন।
multisig_replacement = প্রতিস্থাপন প্রস্তাব তৈরি করুন
multisig_replacement_notice = প্রতিস্থাপন নির্বাচিত ইনপুট এই বহুস্বাক্ষর ওয়ালেটে ফেরত পাঠায় এবং নেটওয়ার্ক ফি লাগে। মূল স্বাক্ষরের সীমাই প্রযোজ্য। পুরোনো লেনদেনের সঙ্গে প্রতিযোগিতা হতে পারে; সফল হওয়ার নিশ্চয়তা নেই।
multisig_receive_title = BSV গ্রহণ করুন
multisig_receive_tag = BSV মূল নেটওয়ার্ক · বহুস্বাক্ষর পেমেন্টের অনুরোধ
multisig_copy_request = পেমেন্টের অনুরোধ কপি করুন
multisig_receive_notice = BSV গ্রহণে খরচের স্বাক্ষর লাগে না। খরচ করতে %d জন সদস্যের স্বাক্ষর লাগে। এই QR কোডে প্রকাশ্য কনফিগারেশন আছে, সাধারণ BSV ঠিকানা নয়।
multisig_qr_too_large = এই অনুরোধ নির্ভরযোগ্য QR কোডের জন্য অতিরিক্ত বড়। ফাইল শেয়ার করুন অথবা সম্পূর্ণ অনুরোধ কপি করুন।
multisig_import = সহযোগিতার প্যাকেজ আমদানি করুন
multisig_import_placeholder = আমন্ত্রণ, জবাব, কনফিগারেশন, প্রস্তাব বা স্বাক্ষরের প্যাকেজ পেস্ট করুন
multisig_import_notice = সংরক্ষণের আগে আমদানি করা তথ্য যাচাই করুন। প্যাকেজ আমদানি কখনো নিজে থেকে লেনদেন স্বাক্ষর বা নেটওয়ার্কে পাঠায় না।
multisig_preview = প্যাকেজ যাচাই করুন
multisig_confirm_import = আমদানি নিশ্চিত করুন
multisig_import_file = ফাইল আমদানি করুন
multisig_configuration_review = ওয়ালেটের চূড়ান্ত কনফিগারেশন নিশ্চিত করুন
multisig_configuration_notice = ওয়ালেট সক্রিয় হওয়ার আগে সব সদস্যকে একই সম্পূর্ণ প্রকাশ্য কী কনফিগারেশন নিশ্চিত করতে হবে। শুধু আমন্ত্রণের জবাবে এটি সক্রিয় হয় না।
multisig_configuration_check = আমি বিশ্বস্ত মাধ্যমে সব সদস্য, স্বাক্ষরের সীমা ও কনফিগারেশনের ফিঙ্গারপ্রিন্ট যাচাই করেছি।
multisig_confirm_configuration = নিশ্চিত করে অনুমোদন শেয়ার করুন
multisig_share_configuration = চূড়ান্ত কনফিগারেশন শেয়ার করুন
multisig_stale_balance = ব্যালেন্স আপডেট ব্যর্থ। আগের তথ্য পুরোনো হতে পারে; খরচের আগে আবার চেষ্টা করুন।
multisig_signing_wallet = সংযুক্ত স্বাক্ষরকারী ওয়ালেট
multisig_wallet_required = BSV অ্যাকাউন্টসহ স্বাক্ষর করতে পারে এমন একটি ওয়ালেট বেছে নিন।
multisig_refresh = ব্লকচেইনের অবস্থা রিফ্রেশ করুন
multisig_all_funds = সব উপলব্ধ অর্থ পাঠান
multisig_close = বন্ধ করুন
multisig_public_key = প্রকাশ্য কী
multisig_package_hash = প্যাকেজের ফিঙ্গারপ্রিন্ট
multisig_input = লেনদেনের ইনপুট
multisig_payment_output = পেমেন্টের আউটপুট
multisig_change_output = ফেরত অর্থের আউটপুট
multisig_transaction_id = লেনদেনের আইডি
multisig_error_invalid_package = সহযোগিতার প্যাকেজ অবৈধ, অসমর্থিত বা পরিবর্তিত। সম্পূর্ণ প্যাকেজ যাচাই করে আবার চেষ্টা করুন।
multisig_error_invalid_rules = শুধু 2/2, 2/3 ও 3/3 নিয়ম সমর্থিত। ওয়ালেটের নাম ও সদস্যদের তথ্য যাচাই করুন।
multisig_error_invalid_proof = সদস্যের প্রমাণ বা লেনদেনের স্বাক্ষর যাচাই করা যায়নি। এই প্যাকেজ ব্যবহার করবেন না।
multisig_error_configuration_conflict = এই পেমেন্ট স্ক্রিপ্ট ইতিমধ্যেই অন্য ওয়ালেট কনফিগারেশনের অন্তর্ভুক্ত। বিদ্যমান ওয়ালেটটি দেখুন।
multisig_error_concurrent_update = বহুস্বাক্ষরের তথ্য বদলেছে। চালিয়ে যাওয়ার আগে ওয়ালেট রিফ্রেশ করুন।
multisig_error_missing_signer = এই সদস্যের সংযুক্ত ওয়ালেট পাওয়া যাচ্ছে না। স্বাক্ষর করতে মূল পুনরুদ্ধারের তথ্য দিয়ে সেই ওয়ালেট পুনরুদ্ধার করুন।
multisig_error_not_active = অর্থ পাঠানো বা গ্রহণের আগে সব সদস্যকে একই চূড়ান্ত কনফিগারেশন অনুমোদন করতে হবে।
multisig_error_missing_record = চাওয়া বহুস্বাক্ষর ওয়ালেট বা প্রস্তাব পাওয়া যাচ্ছে না। রিফ্রেশ করে আবার চেষ্টা করুন।
multisig_error_reserved = এই ইনপুট অন্য প্রস্তাবের জন্য সংরক্ষিত। চালিয়ে যাওয়ার আগে সংঘাত যাচাই করুন।
multisig_error_signatures = নেটওয়ার্কে পাঠানোর আগে প্রতিটি ইনপুটে ভিন্ন সদস্যের প্রয়োজনীয় সংখ্যক স্বাক্ষর থাকতে হবে।
multisig_error_stale_chain = ব্লকচেইনের অবস্থা যাচাই করা যায়নি, অথবা ইনপুট আর নিশ্চিত ও অব্যবহৃত অবস্থায় নেই। স্বাক্ষর বা নেটওয়ার্কে পাঠানোর আগে রিফ্রেশ করুন।
multisig_error_provider = BSV ব্লকচেইন সেবা অনুপলব্ধ বা অবৈধ তথ্য দিয়েছে। আগের ব্যালেন্স পুরোনো হতে পারে। আবার আপডেটের চেষ্টা করুন।
multisig_error_storage = বহুস্বাক্ষরের তথ্য নিরাপদে সংরক্ষণ করা যায়নি। রেকর্ড সংরক্ষণের আগে নতুন করে নেটওয়ার্কে পাঠাবেন না।
multisig_error_authentication = ওয়ালেটের পরিচয় যাচাই ব্যর্থ। চালিয়ে যেতে আবার চেষ্টা করুন।
multisig_error_package_size = প্যাকেজ সমর্থিত আকারের চেয়ে বড়। প্রেরকের কাছ থেকে সমর্থিত প্যাকেজ নিন।
multisig_error_file = নির্বাচিত ফাইলটি সমর্থিত সহযোগিতার প্যাকেজ হিসেবে পড়া যায়নি।
multisig_delete_signer_warning = এই ওয়ালেট একটি বহুস্বাক্ষর ওয়ালেটের জন্য স্বাক্ষর করে। এটি মুছে ফেললে বহুস্বাক্ষরের অর্থ বা ব্লকচেইনের কনফিগারেশন মুছে যায় না। আগে এই সদস্যের পুনরুদ্ধারের তথ্য ও প্রকাশ্য বহুস্বাক্ষর কনফিগারেশন ব্যাকআপ করুন। স্বাক্ষরের নিয়ন্ত্রণ ফিরে পেতে সদস্যের মূল কী প্রয়োজন।

multisig_configuration_changed = প্রকাশ্য কনফিগারেশন এই ডিভাইসে অনুমোদিত কনফিগারেশন থেকে আলাদা। স্বাক্ষর ও অর্থ জমা বন্ধ করা হয়েছে।
multisig_confirmations = নিশ্চিতকরণ
multisig_expired = মেয়াদ শেষ
multisig_expires_at = মেয়াদ শেষ হবে
multisig_funding = সাধারণ ওয়ালেট থেকে স্থানান্তর
multisig_funding_broadcast_notice = লেনদেনটি নেটওয়ার্কে পাঠানো হয়েছে। ব্লকচেইনে নিশ্চিতকরণের জন্য অপেক্ষা করুন। পরে খরচ করতে প্রয়োজনীয় স্বাক্ষরের সংখ্যা পূরণ করতে হবে।
multisig_funding_confirm = পরিচয় যাচাই করে স্থানান্তর
multisig_funding_expired = অর্থ জমার পর্যালোচনার মেয়াদ শেষ। ফিরে যান এবং স্বাক্ষরের আগে নতুন পর্যালোচনা প্রস্তুত করুন।
multisig_funding_payer = পেমেন্ট ওয়ালেট
multisig_funding_payer_notice = শুধু দেখার ওয়ালেট পেমেন্ট করতে পারে না। পেমেন্ট ওয়ালেট বেছে নিলে সদস্যের পরিচয় বদলায় না। অর্থ ও ফি প্রদানকারী বহন করে এবং ফেরত অর্থ সেই ওয়ালেটেই যায়।
multisig_funding_pending_notice = ফলাফল যাচাই করা দরকার। মূল লেনদেন সংরক্ষিত আছে। একই লেনদেন যাচাই বা আবার পাঠান; নতুন করে পেমেন্ট করবেন না।
multisig_funding_result = অর্থ জমার ফলাফল
multisig_funding_operation = অর্থ জমার প্রক্রিয়া
multisig_funding_unsubmitted = এই প্রস্তুতির কোনো স্বাক্ষরিত লেনদেন সংরক্ষিত নেই। এটি বাদ দিয়ে নতুন পেমেন্ট কোড দিয়ে বা পাঠানোর পৃষ্ঠা থেকে আবার শুরু করুন।
multisig_funding_discard = প্রস্তুতি বাদ দিন
multisig_funding_discard_notice = শুধু জমা না দেওয়া প্রস্তুতিটি সরানো হবে। সংরক্ষিত স্বাক্ষরিত লেনদেন এখানে বাদ দেওয়া যাবে না।
multisig_funding_retry = একই লেনদেন যাচাই বা আবার চেষ্টা
multisig_funding_review = অর্থ জমা পর্যালোচনা
multisig_funding_review_notice = এই পর্যালোচনা 5 মিনিট বৈধ। দুই ওয়ালেট, সদস্যদের কী, স্বাক্ষরের সংখ্যা, অর্থ, ফি ও ফেরত অর্থ যাচাই করুন। পেমেন্ট ওয়ালেট স্বাধীনভাবে এই স্থানান্তরের অনুমোদন দেয়।
