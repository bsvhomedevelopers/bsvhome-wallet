test-cold-wallet: (test "BsvColdWalletTests")

test-qr-scanner: (test "QRScannerTests")

test-cold-wallet-storage: (test "BsvHomeCoreServicesTests/BsvColdWalletStoreTests")

test-offline-provider: (test "BsvHomeCoreServicesTests/OfflineProviderTests")

