          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail heeft ongeldige gegevens teruggestuurd. Vernieuw en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail zwrócił nieprawidłowe dane. Odśwież i spróbuj ponownie."
          }
        },
        "pt-BR": {
