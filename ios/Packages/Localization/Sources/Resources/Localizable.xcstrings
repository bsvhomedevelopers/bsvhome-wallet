    "multisig_receive_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استقبال BSV لا يتطلب توقيعات للإنفاق. يتطلب الإنفاق توقيع %d أعضاء. يحتوي رمز QR على الإعدادات العامة، وليس عنوان BSV عاديًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV গ্রহণে খরচের স্বাক্ষর লাগে না। খরচ করতে %d জন সদস্যের স্বাক্ষর লাগে। এই QR কোডে প্রকাশ্য কনফিগারেশন আছে, সাধারণ BSV ঠিকানা নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přijetí BSV nevyžaduje podpisy pro výdaje. Utrácení vyžaduje podpis %d členů. Tento QR kód obsahuje veřejnou konfiguraci, nikoli běžnou BSV adresu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Modtagelse af BSV kræver ikke underskrifter til forbrug. Forbrug kræver underskrift fra %d medlemmer. QR-koden indeholder den offentlige konfiguration, ikke en almindelig BSV-adresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Empfang von BSV sind keine Ausgabesignaturen nötig. Ausgaben erfordern %d Mitgliedssignaturen. Dieser QR-Code enthält die öffentliche Konfiguration, keine normale BSV-Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Receiving BSV does not require expenditure signatures. Spending requires %d members to sign. This QR contains the public configuration, not a regular BSV address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Recibir BSV no requiere firmas de gasto. Gastar requiere la firma de %d miembros. Este QR contiene la configuración pública, no una dirección BSV normal."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دریافت BSV به امضای خرج کردن نیاز ندارد. خرج کردن به امضای %d عضو نیاز دارد. این QR شامل پیکربندی عمومی است، نه یک آدرس عادی BSV."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi kailangan ng mga lagda sa paggastos para tumanggap ng BSV. Kailangan ang lagda ng %d miyembro para gumastos. Pampublikong configuration ang laman ng QR na ito, hindi regular na BSV address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Recevoir des BSV ne nécessite pas de signatures de dépense. Dépenser exige la signature de %d membres. Ce QR contient la configuration publique, pas une adresse BSV classique."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Karɓar BSV ba ya bukatar sa hannun kashe kuɗi. Kashewa na bukatar sa hannun mambobi %d. Wannan QR yana ɗauke da tsarin jama’a, ba adireshin BSV na yau da kullum ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבלת BSV אינה מחייבת חתימות להוצאה. הוצאה מחייבת חתימות של %d חברים. קוד ה־QR מכיל את התצורה הציבורית, לא כתובת BSV רגילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV पाने के लिए खर्च के हस्ताक्षर ज़रूरी नहीं हैं। खर्च करने के लिए %d सदस्यों के हस्ताक्षर चाहिए। इस QR में सार्वजनिक कॉन्फ़िगरेशन है, सामान्य BSV पता नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerima BSV tidak memerlukan tanda tangan pengeluaran. Pengeluaran memerlukan tanda tangan %d anggota. QR ini berisi konfigurasi publik, bukan alamat BSV biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ricevere BSV non richiede firme di spesa. Per spendere servono le firme di %d membri. Questo QR contiene la configurazione pubblica, non un normale indirizzo BSV."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BSVの受取に支出用の署名は不要です。支出には%d人の署名が必要です。このQRコードは公開設定を含み、通常のBSVアドレスではありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV를 받는 데 지출 서명은 필요하지 않습니다. 지출에는 구성원 %d명의 서명이 필요합니다. 이 QR은 일반 BSV 주소가 아니라 공개 설정을 담고 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menerima BSV tidak memerlukan tandatangan perbelanjaan. Perbelanjaan memerlukan tandatangan %d ahli. QR ini mengandungi konfigurasi awam, bukan alamat BSV biasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor het ontvangen van BSV zijn geen uitgavenhandtekeningen nodig. Uitgaven vereisen handtekeningen van %d leden. Deze QR-code bevat de openbare configuratie, geen gewoon BSV-adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Odbieranie BSV nie wymaga podpisów wydatków. Wydawanie wymaga podpisów %d członków. Ten QR zawiera konfigurację publiczną, nie zwykły adres BSV."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Receber BSV não exige assinaturas de gasto. Gastar exige a assinatura de %d membros. Este QR contém a configuração pública, não um endereço BSV comum."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Primirea BSV nu necesită semnături de cheltuieli. Cheltuirea necesită semnătura a %d membri. Acest QR conține configurația publică, nu o adresă BSV obișnuită."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получение BSV не требует подписей для расходов. Для расходов нужны подписи %d участников. Этот QR содержит открытую конфигурацию, а не обычный BSV-адрес."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kupokea BSV hakuhitaji saini za matumizi. Matumizi yanahitaji saini za wanachama %d. QR hii ina usanidi wa umma, si anwani ya kawaida ya BSV."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับ BSV ไม่ต้องมีลายเซ็นการใช้จ่าย การใช้จ่ายต้องมีสมาชิก %d คนลงนาม QR นี้มีการตั้งค่าสาธารณะ ไม่ใช่ที่อยู่ BSV ทั่วไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV almak için harcama imzaları gerekmez. Harcama için %d üyenin imzası gerekir. Bu QR, normal bir BSV adresi değil, açık yapılandırmayı içerir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримання BSV не потребує підписів для витрат. Для витрат потрібні підписи %d учасників. Цей QR містить публічну конфігурацію, а не звичайну BSV-адресу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV وصول کرنے کے لیے اخراجات کے دستخط ضروری نہیں۔ خرچ کرنے کے لیے %d اراکین کے دستخط چاہیے۔ اس QR میں عوامی ترتیب ہے، عام BSV پتہ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhận BSV không cần chữ ký chi tiêu. Chi tiêu cần %d thành viên ký. QR này chứa cấu hình công khai, không phải địa chỉ BSV thông thường."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收到 BSV 无需收集支出签名。转出时，需要 %d 位成员共同签名。此二维码包含公开配置，并非普通 BSV 收款地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收到 BSV 無需收集支出簽名。轉出時，需要 %d 位成員共同簽名。此 QR Code 包含公開配置，並非一般 BSV 收款地址。"
          }
        }
      }
    },
