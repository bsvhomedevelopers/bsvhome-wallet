        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি অন্য সদস্যদের সঙ্গে ওয়ালেটের নিয়ম যাচাই করেছি এবং নিজের ওয়ালেট ব্যবহার করে যোগদান নিশ্চিত করছি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
