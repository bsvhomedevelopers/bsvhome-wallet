    "paymail_signature_rejected": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحدي التوقيع غير صالح أو انتهت صلاحيته. حدّث وأكّد مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বাক্ষরের চ্যালেঞ্জ অবৈধ বা মেয়াদ শেষ। রিফ্রেশ করে আবার নিশ্চিত করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výzva k podpisu je neplatná nebo vypršela. Aktualizujte údaje a znovu potvrďte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Signeringsudfordringen er ugyldig eller udløbet. Opdatér og bekræft igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Signaturanfrage ist ungültig oder abgelaufen. Aktualisiere und bestätige erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signing challenge is invalid or expired. Refresh and confirm again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El desafío de firma no es válido o ha caducado. Actualiza y confirma de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "چالش امضا نامعتبر است یا منقضی شده است. تازه‌سازی و دوباره تأیید کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi valid o nag-expire na ang signing challenge. I-refresh at kumpirmahin muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le défi de signature est non valide ou a expiré. Actualisez et confirmez à nouveau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kalubalen sa hannu ba ya da inganci ko wa’adinsa ya ƙare. Sabunta kuma ka sake tabbatarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אתגר החתימה אינו תקין או שפג תוקפו. יש לרענן ולאשר שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्ताक्षर चुनौती अमान्य है या उसकी अवधि समाप्त हो गई है। रीफ़्रेश करके फिर से पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tantangan penandatanganan tidak valid atau kedaluwarsa. Muat ulang dan konfirmasikan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta di firma non è valida o è scaduta. Aggiorna e conferma di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名チャレンジが無効または期限切れです。更新して再度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명 요청이 유효하지 않거나 만료되었습니다. 새로고침한 후 다시 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Cabaran tandatangan tidak sah atau telah tamat tempoh. Muat semula dan sahkan sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ondertekeningsuitdaging is ongeldig of verlopen. Vernieuw en bevestig opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyzwanie do podpisania jest nieprawidłowe lub wygasło. Odśwież dane i potwierdź ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O desafio de assinatura é inválido ou expirou. Atualize e confirme novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Provocarea de semnare nu este validă sau a expirat. Reîmprospătează și confirmă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос на подпись недействителен или истёк. Обновите данные и подтвердите снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Changamoto ya kutia saini si halali au imeisha muda. Onyesha upya na uthibitishe tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อความท้าทายสำหรับลงนามไม่ถูกต้องหรือหมดอายุแล้ว โปรดรีเฟรชและยืนยันอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmzalama sorgusu geçersiz veya süresi dolmuş. Yenileyin ve tekrar onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит на підпис недійсний або термін його дії минув. Оновіть дані й підтвердьте знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دستخط کا چیلنج غلط ہے یا اس کی میعاد ختم ہو چکی ہے۔ ریفریش کر کے دوبارہ تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu ký không hợp lệ hoặc đã hết hạn. Hãy làm mới và xác nhận lại."
          }
        },
        "zh-Hans": {
