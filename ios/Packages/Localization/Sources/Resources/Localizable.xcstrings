    "shasta_testnet_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الأصول التجريبية ليس لها قيمة حقيقية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পরীক্ষামূলক সম্পদের কোনো বাস্তব মূল্য নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Testovací aktiva nemají skutečnou hodnotu."
          }
        },
