    "multisig_funding_unsubmitted": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد معاملة موقّعة محفوظة لهذا الإعداد. تجاهله وابدأ من جديد برمز دفع جديد أو من صفحة الإرسال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই প্রস্তুতির কোনো স্বাক্ষরিত লেনদেন সংরক্ষিত নেই। এটি বাদ দিয়ে নতুন পেমেন্ট কোড দিয়ে বা পাঠানোর পৃষ্ঠা থেকে আবার শুরু করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro tuto přípravu není uložená podepsaná transakce. Zahoďte ji a začněte znovu s novým platebním kódem nebo na stránce Poslat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne klargøring har ingen gemt, underskrevet transaktion. Kassér den, og start igen med en ny betalingskode eller fra Send."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für diese Vorbereitung ist keine signierte Transaktion gespeichert. Verwirf sie und beginne mit einem neuen Zahlungscode oder auf der Seite Senden erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This preparation has no saved signed transaction. Discard it and start again with a fresh payment code or Send."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta preparación no tiene una transacción firmada guardada. Descártala y vuelve a empezar con un nuevo código de pago o desde Enviar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای این آماده‌سازی، تراکنش امضاشده‌ای ذخیره نشده است. آن را کنار بگذارید و با یک کد پرداخت تازه یا از صفحهٔ ارسال دوباره شروع کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang naka-save na nilagdaang transaksyon para sa paghahandang ito. Itapon ito at magsimula muli gamit ang bagong payment code o mula sa Ipadala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune transaction signée n’est enregistrée pour cette préparation. Abandonnez-la, puis recommencez avec un nouveau code de paiement ou depuis Envoyer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan shiri ba shi da ma’amala mai sa hannu da aka adana. Yi watsi da shi, sannan ka fara da sabuwar lambar biyan kuɗi ko daga shafin Aika."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא נשמרה עסקה חתומה עבור הכנה זו. יש לבטל אותה ולהתחיל מחדש עם קוד תשלום חדש או דרך מסך השליחה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस तैयारी का कोई हस्ताक्षरित लेनदेन सहेजा नहीं गया है। इसे छोड़कर नए भुगतान कोड से या भेजने वाले पृष्ठ से फिर शुरू करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Persiapan ini tidak memiliki transaksi bertanda tangan yang tersimpan. Buang persiapan ini, lalu mulai lagi dengan kode pembayaran baru atau dari Kirim."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è salvata alcuna transazione firmata per questa preparazione. Scartala e ricomincia con un nuovo codice di pagamento o dalla schermata Invia."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この準備には保存済みの署名付きトランザクションがありません。準備を破棄し、新しい支払コードまたは送信画面からやり直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 준비에는 저장된 서명 거래가 없습니다. 준비를 폐기한 후 새 결제 코드나 보내기 화면에서 다시 시작하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada transaksi bertandatangan yang disimpan untuk persediaan ini. Buangnya dan mulakan semula dengan kod pembayaran baharu atau melalui Hantar."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor deze voorbereiding is geen ondertekende transactie opgeslagen. Verwerp deze en begin opnieuw met een nieuwe betaalcode of via Versturen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dla tego przygotowania nie zapisano podpisanej transakcji. Odrzuć je i zacznij od nowa z nowym kodem płatności lub na ekranie Wyślij."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta preparação não tem uma transação assinada salva. Descarte-a e comece novamente com um novo código de pagamento ou pela tela Enviar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această pregătire nu are o tranzacție semnată salvată. Renunță la ea și începe din nou cu un cod de plată nou sau din ecranul Trimite."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для этой подготовки нет сохранённой подписанной транзакции. Отмените подготовку и начните заново с новым платёжным кодом или на экране «Отправить»."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maandalizi haya hayana muamala uliotiwa saini uliohifadhiwa. Yatupe na uanze tena kwa msimbo mpya wa malipo au kwenye Tuma."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การเตรียมนี้ไม่มีธุรกรรมที่ลงนามและบันทึกไว้ ให้ยกเลิกการเตรียมแล้วเริ่มใหม่ด้วยรหัสชำระเงินใหม่หรือจากหน้าส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu hazırlık için kaydedilmiş imzalı bir işlem yok. Hazırlığı iptal edip yeni bir ödeme koduyla veya Gönder ekranından yeniden başlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для цієї підготовки немає збереженої підписаної транзакції. Скасуйте підготовку та почніть заново з новим платіжним кодом або на екрані «Надіслати»."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس تیاری کے لیے کوئی دستخط شدہ ٹرانزیکشن محفوظ نہیں ہے۔ اسے ترک کریں اور نئے ادائیگی کوڈ یا بھیجنے والی اسکرین سے دوبارہ شروع کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bản chuẩn bị này không có giao dịch đã ký được lưu. Hãy hủy bản chuẩn bị rồi bắt đầu lại bằng mã thanh toán mới hoặc từ màn hình Gửi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此准备没有已保存的签名交易。请放弃此准备后重新扫描付款码，或返回发送页面。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此準備沒有已儲存的簽署交易。請放棄此準備後重新掃描付款碼，或返回傳送頁面。"
          }
        }
      }
    },
