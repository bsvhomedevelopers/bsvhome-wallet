            "state": "translated",
            "value": "Pemerhati dalam talian: dompet sejuk mesti menandatangani sebelum disiarkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Online observer: de coldwallet moet tekenen voordat u uitzendt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Obserwator online: zimny portfel musi podpisać przed rozgłoszeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Observador online: a carteira fria precisa assinar antes da transmissão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Observator online: portofelul rece trebuie să semneze înainte de difuzare."
