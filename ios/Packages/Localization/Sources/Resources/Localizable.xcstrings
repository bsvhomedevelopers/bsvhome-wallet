        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपके द्वारा हाल ही में उपयोग की गई संपत्तियाँ यहाँ दिखाई देंगी"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aset yang baru-baru ini Anda gunakan akan muncul di sini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le risorse che hai utilizzato di recente verranno visualizzate qui"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "最近使用したアセットがここに表示されます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "최근에 사용한 애셋이 여기에 표시됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aset yang anda gunakan baru-baru ini akan dipaparkan di sini"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Activa die u onlangs heeft gebruikt, worden hier weergegeven"
