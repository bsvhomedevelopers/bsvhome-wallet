          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktiver, du for nylig har brugt, vises her"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hier werden die Assets angezeigt, die Sie kürzlich verwendet haben"
