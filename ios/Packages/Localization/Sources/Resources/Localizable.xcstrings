    "info.circulating_supply.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عدد العملات المتاحة حاليًا والمتداولة في السوق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বর্তমানে বাজারে উপলব্ধ এবং লেনদেন হওয়া কয়েনের সংখ্যা।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Počet mincí aktuálně dostupných a obchodovaných na trhu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Antallet af tilgængelige og handlede mønter på markedet i øjeblikket."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anzahl der aktuell verfügbaren und auf dem Markt gehandelten Coins."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The number of coins currently available and trading in the market."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cantidad de monedas actualmente disponibles y comercializadas en el mercado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد کوین‌های موجود و قابل معامله در بازار."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang bilang ng mga barya na kasalukuyang magagamit at ipinagbibili sa merkado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le nombre de pièces actuellement disponibles et échangées sur le marché."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Adadin tsabar kuɗi da ake da su a kasuwa a yanzu haka."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מספר המטבעות הזמינים ונסחרים כעת בשוק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बाजार में वर्तमान में उपलब्ध और कारोबार कर रहे सिक्कों की संख्या।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
