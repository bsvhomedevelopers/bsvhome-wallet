    "cold_wallet_startup_storage_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر على المحفظة الباردة فتح مساحة التخزين المحلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোল্ড ওয়ালেটের লোকাল স্টোরেজ খোলা যায়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Studená peněženka nemohla otevřít místní úložiště."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kolde tegnebog kunne ikke åbne sit lokale lager."
