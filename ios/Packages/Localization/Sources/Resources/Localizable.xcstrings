    "cold_wallet_refresh_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بث المعاملة لكن تحديث الرصيد فشل. حدّث الرصيد دون الدفع مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেন সম্প্রচারিত হয়েছে, কিন্তু ব্যালেন্স হালনাগাদ ব্যর্থ। আবার অর্থ না দিয়ে রিফ্রেশ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce odeslána, ale aktualizace zůstatku selhala. Aktualizujte bez další platby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen er udsendt, men saldoopdatering mislykkedes. Opdatér igen uden at betale igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion übertragen, Saldoaktualisierung fehlgeschlagen. Erneut aktualisieren, ohne nochmals zu zahlen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction was broadcast, but balance refresh failed. Refresh again without sending another payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción transmitida, pero falló la actualización del saldo. Actualice sin realizar otro pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش منتشر شد ولی به‌روزرسانی موجودی ناموفق بود. بدون پرداخت دوباره، موجودی را تازه کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-broadcast ang transaksiyon ngunit hindi na-refresh ang balanse. I-refresh muli nang hindi muling nagbabayad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction diffusée, mais actualisation du solde échouée. Actualisez sans envoyer un autre paiement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An watsa ma’amala amma sabunta ma’auni ya gaza. Sabunta ba tare da sake biya ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה שודרה אך עדכון היתרה נכשל. רעננו בלי לשלם שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेनदेन प्रसारित हुआ, लेकिन शेष राशि ताज़ा नहीं हुई। दोबारा भुगतान किए बिना ताज़ा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi disiarkan, tetapi pembaruan saldo gagal. Perbarui lagi tanpa membayar ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transazione trasmessa, ma aggiornamento del saldo fallito. Aggiorna senza effettuare un altro pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引は配信済みですが残高更新に失敗しました。再度支払わずに更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래는 브로드캐스트됐지만 잔액 갱신에 실패했습니다. 다시 결제하지 말고 새로고침하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi disiarkan tetapi penyegaran baki gagal. Segarkan semula tanpa membayar sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactie uitgezonden, maar saldoverversing mislukt. Ververs opnieuw zonder nogmaals te betalen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja rozgłoszona, ale odświeżenie salda nie powiodło się. Odśwież bez ponownej płatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transação transmitida, mas a atualização do saldo falhou. Atualize sem fazer outro pagamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacție difuzată, dar actualizarea soldului a eșuat. Actualizați fără altă plată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция отправлена, но обновить баланс не удалось. Обновите его без повторного платежа."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala umetangazwa lakini kusasisha salio kumeshindwa. Sasisha tena bila kulipa tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เผยแพร่ธุรกรรมแล้วแต่รีเฟรชยอดเงินไม่สำเร็จ รีเฟรชใหม่โดยไม่ชำระเงินซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem yayınlandı ancak bakiye yenilenemedi. Tekrar ödeme yapmadan yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію надіслано, але оновлення балансу не вдалося. Оновіть без повторної оплати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "لین دین نشر ہو گیا لیکن بیلنس تازہ نہیں ہوا۔ دوبارہ ادائیگی کیے بغیر تازہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đã phát nhưng cập nhật số dư thất bại. Làm mới lại, không thanh toán lần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已广播，但余额刷新失败。请再次刷新，不要重复付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已廣播，但餘額重新整理失敗。請再次重新整理，不要重複付款。"
          }
        }
      }
    },
    "cold_wallet_replace_signed_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يظل التوقيع السابق صالحًا. بدء طلب آخر لا يلغي تلك الدفعة. أكد أنك حفظت المعاملة الموقعة السابقة أو سلّمتها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগের স্বাক্ষরটি বৈধ থাকে। নতুন অনুরোধ শুরু করলে আগের পেমেন্ট বাতিল হয় না। আগের স্বাক্ষরিত লেনদেনটি সংরক্ষণ বা হস্তান্তর করেছেন বলে নিশ্চিত করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předchozí podpis zůstává platný. Nový požadavek předchozí platbu nezruší. Potvrďte, že jste předchozí podepsanou transakci uložili nebo předali."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den forrige signatur er stadig gyldig. En ny anmodning annullerer ikke betalingen. Bekræft, at du har gemt eller overført den forrige signerede transaktion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vorherige Signatur bleibt gültig. Eine neue Anfrage storniert diese Zahlung nicht. Bestätige, dass du die vorherige signierte Transaktion gespeichert oder übergeben hast."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The previous signature remains valid. Starting another request does not cancel that payment. Confirm that you have saved or delivered the previous signed transaction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma anterior sigue siendo válida. Iniciar otra solicitud no cancela ese pago. Confirma que has guardado o entregado la transacción firmada anterior."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امضای قبلی همچنان معتبر است. شروع درخواست جدید آن پرداخت را لغو نمی‌کند. تأیید کنید تراکنش امضاشده قبلی را ذخیره یا تحویل داده‌اید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Valid pa rin ang dating lagda. Hindi kinakansela ng bagong request ang bayad na iyon. Kumpirmahing na-save o naipasa mo na ang dating nilagdaang transaksyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature précédente reste valide. Une nouvelle demande n’annule pas ce paiement. Confirmez avoir enregistré ou transmis la transaction signée précédente."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa hannun da ya gabata yana nan da inganci. Sabuwar buƙata ba za ta soke wannan biyan ba. Tabbatar ka adana ko ka miƙa cinikin da aka sa wa hannu a baya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החתימה הקודמת נשארת תקפה. התחלת בקשה חדשה אינה מבטלת את התשלום. יש לאשר ששמרת או העברת את העסקה החתומה הקודמת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पिछला हस्ताक्षर वैध रहता है। नया अनुरोध शुरू करने से पिछला भुगतान रद्द नहीं होता। पुष्टि करें कि आपने पिछला हस्ताक्षरित लेनदेन सहेज लिया है या सौंप दिया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda tangan sebelumnya tetap berlaku. Memulai permintaan baru tidak membatalkan pembayaran tersebut. Konfirmasikan bahwa transaksi bertanda tangan sebelumnya telah disimpan atau diserahkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma precedente resta valida. Una nuova richiesta non annulla quel pagamento. Conferma di aver salvato o consegnato la transazione firmata precedente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "前の署名は引き続き有効です。別のリクエストを開始しても前の支払いは取り消されません。前の署名済み取引を保存または引き渡したことを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 서명은 계속 유효합니다. 새 요청을 시작해도 이전 결제는 취소되지 않습니다. 이전 서명 거래를 저장하거나 전달했는지 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandatangan terdahulu masih sah. Permintaan baharu tidak membatalkan bayaran itu. Sahkan bahawa transaksi bertandatangan terdahulu telah disimpan atau diserahkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vorige handtekening blijft geldig. Een nieuw verzoek annuleert die betaling niet. Bevestig dat je de vorige ondertekende transactie hebt opgeslagen of overgedragen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzedni podpis pozostaje ważny. Nowe żądanie nie anuluje tej płatności. Potwierdź zapisanie lub przekazanie poprzedniej podpisanej transakcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura anterior continua válida. Iniciar outra solicitação não cancela esse pagamento. Confirme que você salvou ou entregou a transação assinada anterior."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Semnătura precedentă rămâne validă. O cerere nouă nu anulează acea plată. Confirmă că ai salvat sau transmis tranzacția semnată precedentă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущая подпись остаётся действительной. Новый запрос не отменяет тот платёж. Подтвердите, что сохранили или передали предыдущую подписанную транзакцию."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sahihi iliyotangulia bado ni halali. Ombi jipya halighairi malipo hayo. Thibitisha kuwa umehifadhi au kuwasilisha muamala uliotiwa sahihi uliotangulia."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลายเซ็นก่อนหน้ายังคงใช้ได้ การเริ่มคำขอใหม่ไม่ยกเลิกการชำระเงินนั้น โปรดยืนยันว่าบันทึกหรือส่งมอบธุรกรรมที่ลงนามก่อนหน้าแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki imza geçerli kalır. Yeni bir istek bu ödemeyi iptal etmez. Önceki imzalı işlemi kaydettiğinizi veya teslim ettiğinizi onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередній підпис залишається чинним. Новий запит не скасовує той платіж. Підтвердьте, що зберегли або передали попередню підписану транзакцію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پچھلا دستخط اب بھی درست ہے۔ نئی درخواست شروع کرنے سے پچھلی ادائیگی منسوخ نہیں ہوتی۔ تصدیق کریں کہ آپ نے پچھلی دستخط شدہ ٹرانزیکشن محفوظ یا فراہم کر دی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chữ ký trước vẫn có hiệu lực. Bắt đầu yêu cầu khác không hủy khoản thanh toán đó. Xác nhận rằng bạn đã lưu hoặc chuyển giao giao dịch đã ký trước đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "上一笔签名仍然有效，开始下一笔不会撤销上一笔付款。请确认你已保存或交付上一笔签名交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "上一筆簽名仍然有效，開始下一筆不會撤銷上一筆付款。請確認你已儲存或交付上一筆簽名交易。"
          }
        }
      }
    },
    "cold_wallet_request_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح جميع إطارات QR بجهاز التوقيع غير المتصل. تحقق بشكل مستقل من المستلم والمبلغ والرسوم والمبلغ المتبقي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইন স্বাক্ষরকারী দিয়ে সব QR ফ্রেম স্ক্যান করুন। প্রাপক, পরিমাণ, ফি ও ফেরত অর্থ স্বাধীনভাবে যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline zařízením naskenujte všechny QR snímky. Nezávisle ověřte příjemce, částku, poplatek a vrácenou částku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan alle QR-billeder med offlineunderskriveren. Kontrollér uafhængigt modtager, beløb, gebyr og byttepenge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle QR-Bilder mit dem Offline-Signierer scannen. Empfänger, Betrag, Gebühr und Wechselgeld unabhängig prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan every QR frame with the offline signer. It will independently verify the recipient, amount, fee, and change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanee todos los fotogramas con el firmante sin conexión. Verifique de forma independiente destinatario, importe, comisión y cambio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه فریم‌های QR را با امضاکننده آفلاین اسکن کنید. گیرنده، مبلغ، کارمزد و باقیمانده را مستقل بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-scan ang lahat ng QR frame sa offline na tagapirma. Malayang suriin ang tatanggap, halaga, bayarin at sukli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez toutes les images QR avec le signataire hors ligne. Vérifiez indépendamment le destinataire, le montant, les frais et la monnaie rendue."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba dukkan sassan QR da mai sa hannu ba tare da intanet ba. Tabbatar da mai karɓa, adadi, kuɗin sabis da canji da kanka."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו את כל פריימי ה־QR בחותם הלא מקוון. בדקו באופן עצמאי נמען, סכום, עמלה ועודף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन हस्ताक्षरकर्ता से सभी QR फ़्रेम स्कैन करें। प्राप्तकर्ता, राशि, शुल्क और लौटने वाले शेष की स्वतंत्र जाँच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai semua bingkai QR dengan perangkat offline. Periksa penerima, jumlah, biaya, dan kembalian secara mandiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona tutti i fotogrammi con il firmatario offline. Verifica autonomamente destinatario, importo, commissione e resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン署名端末ですべての QR フレームを読み取り、送金先、金額、手数料、お釣りを独立に確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 서명 기기로 모든 QR 프레임을 스캔하세요. 수신자, 금액, 수수료, 거스름돈을 독립적으로 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbas semua bingkai QR dengan peranti luar talian. Semak penerima, jumlah, fi dan baki pulangan secara bebas."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan alle QR-beelden met de offline ondertekenaar. Controleer ontvanger, bedrag, kosten en wisselgeld onafhankelijk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj wszystkie klatki urządzeniem offline. Niezależnie sprawdź odbiorcę, kwotę, opłatę i resztę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia todos os quadros com o assinador offline. Confira independentemente destinatário, valor, taxa e troco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanați toate cadrele cu semnatarul offline. Verificați independent destinatarul, suma, taxa și restul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканируйте все QR-кадры офлайн-устройством. Независимо проверьте получателя, сумму, комиссию и сдачу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Changanua fremu zote za QR kwa mtia saini nje ya mtandao. Hakiki mpokeaji, kiasi, ada na chenji kwa kujitegemea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกน QR ทุกเฟรมด้วยอุปกรณ์ออฟไลน์ ตรวจสอบผู้รับ จำนวนเงิน ค่าธรรมเนียม และเงินทอนด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tüm QR karelerini çevrimdışı imzalayıcıyla tarayın. Alıcıyı, tutarı, ücreti ve para üstünü bağımsız doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте всі QR-кадри офлайн-пристроєм. Незалежно перевірте одержувача, суму, комісію та решту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آف لائن آلے سے تمام QR فریم اسکین کریں۔ وصول کنندہ، رقم، فیس اور واپس آنے والی رقم کی آزادانہ جانچ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét tất cả khung QR bằng thiết bị ký ngoại tuyến. Kiểm tra độc lập người nhận, số tiền, phí và tiền thừa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用离线签名端扫描完整的二维码，独立核对收款地址、金额、手续费和找零。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用離線簽名端掃描完整的二維碼，獨立核對收款地址、金額、手續費和找零。"
          }
        }
      }
    },
