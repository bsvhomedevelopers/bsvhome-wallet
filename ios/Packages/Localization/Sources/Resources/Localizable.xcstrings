    "cold_wallet_offline_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "جهاز التوقيع غير المتصل: تحقق من التحويل ثم أعد رمز QR الموقّع إلى الجهاز المتصل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অফলাইন স্বাক্ষরকারী: স্থানান্তর যাচাই করুন এবং স্বাক্ষরিত QR অনলাইন ডিভাইসে ফেরত দিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline podepisující: ověřte převod a vraťte podepsaný QR online zařízení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline underskriver: kontrollér overførslen og returnér den underskrevne QR til onlineenheden."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline-Signierer: Überweisung prüfen, dann den signierten QR-Code an das verbundene Gerät zurückgeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline signer: verify transfers here, then return the signed QR to the online device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmante sin conexión: revise la transferencia y devuelva el QR firmado al dispositivo conectado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امضاکننده آفلاین: انتقال را بررسی کنید و QR امضاشده را به دستگاه آنلاین برگردانید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline na tagapirma: suriin ang paglilipat at ibalik ang pirmadong QR sa online na device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Signataire hors ligne : vérifiez le transfert, puis renvoyez le QR signé à l’appareil connecté."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai sa hannu ba tare da intanet ba: duba turawar kuɗi, sannan mayar da QR mai sa hannu zuwa na’urar intanet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חותם לא מקוון: בדקו את ההעברה והחזירו את קוד ה־QR החתום למכשיר המקוון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑफ़लाइन हस्ताक्षरकर्ता: हस्तांतरण जाँचें और हस्ताक्षरित QR ऑनलाइन डिवाइस को लौटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penanda tangan offline: periksa transfer, lalu kembalikan QR bertanda tangan ke perangkat online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Firmatario offline: verifica il trasferimento e restituisci il QR firmato al dispositivo online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オフライン署名端末：送金内容を確認し、署名済み QR をオンライン端末に返します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "오프라인 서명 기기: 전송 내용을 확인한 뒤 서명된 QR을 온라인 기기에 전달하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Penandatangan luar talian: semak pindahan dan kembalikan QR bertandatangan kepada peranti dalam talian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Offline ondertekenaar: controleer de overboeking en geef de ondertekende QR terug aan het online apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpisujący offline: sprawdź przelew i przekaż podpisany kod QR urządzeniu online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Assinador offline: confira a transferência e devolva o QR assinado ao dispositivo online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Semnatar offline: verificați transferul și returnați QR-ul semnat dispozitivului online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-подписант: проверьте перевод и верните подписанный QR онлайн-устройству."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mtia saini nje ya mtandao: hakiki uhamisho kisha rudisha QR iliyosainiwa kwa kifaa cha mtandaoni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์ลงนามออฟไลน์: ตรวจสอบการโอนแล้วส่ง QR ที่ลงนามกลับไปยังอุปกรณ์ออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çevrimdışı imzalayıcı: transferi doğrulayın, imzalı QR kodunu çevrimiçi cihaza geri verin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Офлайн-підписувач: перевірте переказ і поверніть підписаний QR онлайн-пристрою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آف لائن دستخط کنندہ: منتقلی کی جانچ کریں، پھر دستخط شدہ QR آن لائن آلے کو واپس دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị ký ngoại tuyến: kiểm tra giao dịch rồi trả mã QR đã ký cho thiết bị trực tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "离线签名端：在此核对转账，再将签名二维码交给在线设备。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "離線簽名端：在此核對轉帳，再將簽名二維碼交給線上裝置。"
          }
        }
      }
    },
