          "stringUnit": {
            "state": "translated",
            "value": "অদলবদল পরিষেবা অবৈধ ডেটা ফেরত দিয়েছে। রিফ্রেশ করে আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Služba směny vrátila neplatná data. Obnovte stránku a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Byttetjenesten returnerede ugyldige data. Opdater og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Tauschdienst hat ungültige Daten zurückgegeben. Aktualisieren Sie die Ansicht und versuchen Sie es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The exchange service returned invalid data. Refresh and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El servicio de intercambio devolvió datos no válidos. Actualiza e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "سرویس مبادله داده‌های نامعتبر برگرداند. تازه‌سازی کنید و دوباره تلاش کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbalik ang serbisyo ng palitan ng hindi wastong data. I-refresh at subukang muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le service d’échange a renvoyé des données invalides. Actualisez et réessayez."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabis ɗin musaya ya dawo da bayanan da ba su inganta ba. Sake sabuntawa sannan a sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שירות ההמרה החזיר נתונים לא תקינים. יש לרענן ולנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "स्वैप सेवा ने अमान्य डेटा लौटाया। रीफ़्रेश करके दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Layanan penukaran mengembalikan data yang tidak valid. Muat ulang dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il servizio di scambio ha restituito dati non validi. Aggiorna e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "交換サービスから無効なデータが返されました。更新して再度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "교환 서비스에서 유효하지 않은 데이터를 반환했습니다. 새로고침한 후 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Perkhidmatan pertukaran mengembalikan data yang tidak sah. Muat semula dan cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De swapdienst heeft ongeldige gegevens teruggestuurd. Vernieuw en probeer het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usługa wymiany zwróciła nieprawidłowe dane. Odśwież i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O serviço de troca retornou dados inválidos. Atualize e tente novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Serviciul de schimb a returnat date nevalide. Reîmprospătează și încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервис обмена вернул некорректные данные. Обновите и попробуйте снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huduma ya kubadilisha imerudisha data isiyo sahihi. Onyesha upya na ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บริการแลกเปลี่ยนส่งข้อมูลที่ไม่ถูกต้องกลับมา โปรดรีเฟรชแล้วลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Takas hizmeti geçersiz veriler döndürdü. Yenileyip tekrar deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сервіс обміну повернув некоректні дані. Оновіть і спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تبادلے کی سروس نے غلط ڈیٹا واپس کیا۔ ریفریش کریں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dịch vụ hoán đổi trả về dữ liệu không hợp lệ. Hãy làm mới và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "兑换服务返回的数据格式异常，请刷新后重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兌換服務傳回的資料格式異常，請重新整理後再試。"
          }
        }
      }
    },
    "wowpay_swap_order_context_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن دفع هذا الطلب حتى يتم التحقق من تفاصيل الدفع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেমেন্টের বিবরণ যাচাই না হওয়া পর্যন্ত এই অর্ডারের পেমেন্ট করা যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuto objednávku nelze zaplatit, dokud nebudou ověřeny její platební údaje."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne ordre kan ikke betales, før betalingsoplysningerne er verificeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieser Auftrag kann erst bezahlt werden, wenn seine Zahlungsdaten verifiziert wurden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This order cannot be paid until its payment details are verified."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta orden no se puede pagar hasta que se verifiquen sus datos de pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا زمانی که جزئیات پرداخت تأیید نشده باشد، پرداخت این سفارش امکان‌پذیر نیست."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mababayaran ang order na ito hangga't hindi napapatunayan ang mga detalye ng pagbabayad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet ordre ne peut pas être payé tant que ses informations de paiement n’ont pas été vérifiées."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba za a iya biyan wannan buƙata ba sai an tabbatar da bayanan biyan kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לשלם עבור הזמנה זו עד שפרטי התשלום שלה יאומתו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान का विवरण सत्यापित होने तक इस ऑर्डर का भुगतान नहीं किया जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesanan ini tidak dapat dibayar sebelum detail pembayarannya diverifikasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è possibile pagare questo ordine finché i dettagli di pagamento non sono stati verificati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払い情報が確認されるまで、この注文の支払いはできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 정보가 확인될 때까지 이 주문을 결제할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pesanan ini tidak boleh dibayar sehingga butiran pembayarannya disahkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze order kan pas worden betaald nadat de betaalgegevens zijn geverifieerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można opłacić tego zlecenia, dopóki dane płatności nie zostaną zweryfikowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta ordem não pode ser paga até que seus dados de pagamento sejam verificados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest ordin nu poate fi plătit până la verificarea detaliilor de plată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Заявку нельзя оплатить, пока платёжные данные не будут проверены."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Agizo hili haliwezi kulipwa hadi maelezo ya malipo yathibitishwe."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องตรวจสอบรายละเอียดการชำระเงินก่อนชำระคำสั่งนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme ayrıntıları doğrulanana kadar bu emir için ödeme yapılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це замовлення не можна оплатити, доки не перевірено його платіжні дані."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ادائیگی کی تفصیلات کی تصدیق ہونے تک اس آرڈر کی ادائیگی نہیں کی جا سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể thanh toán lệnh này cho đến khi thông tin thanh toán được xác minh."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款信息核验完成后，才能支付此订单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款資訊核驗完成後，才能支付此訂單。"
          }
        }
      }
