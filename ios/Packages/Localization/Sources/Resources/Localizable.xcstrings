    "multisig_replacement_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يعيد المقترح البديل المدخلات المحددة إلى هذه المحفظة متعددة التوقيع مع دفع رسوم الشبكة. يتطلب حد التوقيعات الأصلي وقد يتنافس مع المعاملة القديمة؛ النجاح غير مضمون."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিস্থাপন নির্বাচিত ইনপুট এই বহুস্বাক্ষর ওয়ালেটে ফেরত পাঠায় এবং নেটওয়ার্ক ফি লাগে। মূল স্বাক্ষরের সীমাই প্রযোজ্য। পুরোনো লেনদেনের সঙ্গে প্রতিযোগিতা হতে পারে; সফল হওয়ার নিশ্চয়তা নেই।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Náhrada vrací vybrané vstupy do této vícepodpisové peněženky a platí síťový poplatek. Vyžaduje původní počet podpisů a může soutěžit s původní transakcí; úspěch není zaručen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Erstatningen sender de valgte input tilbage til denne multisignaturtegnebog og koster et netværksgebyr. Den kræver den oprindelige underskriftstærskel og kan konkurrere med den gamle transaktion; succes er ikke garanteret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Ersatz sendet die ausgewählten Eingaben an diese Multisig-Wallet zurück und kostet eine Netzwerkgebühr. Die ursprüngliche Signaturschwelle bleibt nötig. Er kann mit der alten Transaktion konkurrieren; der Erfolg ist nicht garantiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A replacement sends the selected inputs back to this multisig wallet and charges a network fee. It requires the original signing threshold and may race with the old transaction; success is not guaranteed."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El reemplazo devuelve las entradas seleccionadas a esta billetera multifirma y cobra una comisión de red. Requiere el umbral original y puede competir con la transacción anterior; no se garantiza el éxito."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "جایگزین، ورودی‌های انتخاب‌شده را به همین کیف پول چندامضایی برمی‌گرداند و کارمزد شبکه دارد. به حد نصاب اصلی امضا نیاز دارد و ممکن است با تراکنش قبلی رقابت کند؛ موفقیت تضمین نمی‌شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibabalik ng pamalit ang napiling mga input sa multisig na wallet na ito at may bayarin sa network. Kailangan pa rin ang orihinal na bilang ng lagda at maaari itong makipag-unahan sa lumang transaksyon; hindi tiyak ang tagumpay."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le remplacement renvoie les entrées sélectionnées vers ce portefeuille multisignature et entraîne des frais réseau. Il exige le seuil de signatures initial et peut entrer en concurrence avec l’ancienne transaction ; son succès n’est pas garanti."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Madadi yana mayar da shigarwar da aka zaɓa zuwa wannan walat kuma yana biyan kuɗin cibiyar sadarwa. Yana bukatar adadin sa hannun asali kuma yana iya yin gasa da tsohuwar ma’amala; ba a tabbatar da nasara ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלופה מחזירה את הקלטים שנבחרו לארנק זה וגובה עמלת רשת. נדרש סף החתימות המקורי, והיא עלולה להתחרות בעסקה הקודמת; הצלחה אינה מובטחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वैकल्पिक लेनदेन चुने गए इनपुट इसी वॉलेट में लौटाता है और नेटवर्क शुल्क लेता है। इसमें मूल हस्ताक्षर सीमा लागू रहती है और पुराने लेनदेन से प्रतिस्पर्धा हो सकती है; सफलता की गारंटी नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengganti mengirim input terpilih kembali ke dompet multitanda tangan ini dan mengenakan biaya jaringan. Ambang tanda tangan awal tetap diperlukan dan transaksi dapat bersaing dengan transaksi lama; keberhasilan tidak dijamin."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La sostituzione rimanda gli input selezionati a questo portafoglio multifirma e paga una commissione di rete. Richiede la soglia di firme originale e può competere con la vecchia transazione; il successo non è garantito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "代替取引は選択した入力をこのウォレットに戻し、ネットワーク手数料を支払います。元の必要署名数を満たす必要があり、古い取引と競合します。成功は保証されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "대체 거래는 선택한 입력을 이 지갑으로 되돌리고 네트워크 수수료를 냅니다. 원래 서명 수가 필요하고 기존 거래와 경쟁할 수 있어 성공을 보장하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengganti menghantar input terpilih kembali ke dompet ini dengan fi rangkaian. Ambang asal diperlukan; ia mungkin bersaing dengan transaksi lama dan kejayaan tidak dijamin."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De vervanging stuurt geselecteerde invoer terug naar deze wallet en betaalt netwerkkosten. Het oorspronkelijke aantal handtekeningen is vereist. De oude transactie kan eerder worden verwerkt; succes is niet gegarandeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastępcza transakcja zwraca wybrane wejścia do tego portfela i pobiera opłatę sieciową. Wymaga pierwotnego progu podpisów i może konkurować ze starą transakcją; powodzenie nie jest gwarantowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A substituta devolve as entradas selecionadas à mesma carteira e cobra uma taxa de rede. Exige o limite original de assinaturas e pode competir com a transação antiga; o sucesso não é garantido."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înlocuirea returnează intrările selectate în același portofel și percepe o taxă de rețea. Necesită pragul inițial de semnături și poate concura cu tranzacția veche; succesul nu este garantat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Замена возвращает выбранные входы в этот кошелёк с комиссией сети. Требуется прежний порог подписей; замена конкурирует со старой транзакцией, и успех не гарантирован."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mbadala unarudisha ingizo kwenye mkoba huu na kutoza ada ya mtandao. Unahitaji kiwango cha awali cha saini na unaweza kushindana na muamala wa zamani; mafanikio hayajahakikishwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อเสนอทดแทนส่งอินพุตที่เลือกกลับสู่กระเป๋านี้และเสียค่าธรรมเนียมเครือข่าย ยังต้องมีลายเซ็นตามเกณฑ์เดิม และอาจแข่งกับธุรกรรมเก่า จึงไม่รับประกันผลสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni öneri seçili girdileri bu cüzdana geri gönderir ve ağ ücreti öder. Özgün imza eşiği gerekir; eski işlemle yarışabilir ve başarı garanti değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заміна повертає вибрані входи в цей гаманець із комісією мережі. Потрібен початковий поріг підписів; вона може змагатися зі старою транзакцією, успіх не гарантовано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "متبادل منتخب ان پٹس واپس اسی والیٹ کو بھیجتا ہے اور نیٹ ورک فیس لیتا ہے۔ اصل دستخطوں کی حد ضروری ہے؛ پرانے لین دین سے مقابلہ ہو سکتا ہے اور کامیابی یقینی نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đề xuất thay thế gửi đầu vào đã chọn về ví này và trả phí mạng. Vẫn cần ngưỡng chữ ký gốc, có thể cạnh tranh với giao dịch cũ và không bảo đảm thành công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "替代提案将相关资金转回本多签钱包并支付网络费，仍需原门槛签名。它可能与原交易竞争，不能保证先被接受。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "替代提案將相關資金轉回本多簽錢包並支付網路費，仍需原門檻簽名。它可能與原交易競爭，不能保證先被接受。"
          }
        }
      }
    },
