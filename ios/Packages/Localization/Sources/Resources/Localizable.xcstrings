    "secret_phrase.confirm.quick_test.title": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل هذا الاختبار السريع للتأكد من أنك قمت بحفظ كل شيء بشكل صحيح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি সঠিকভাবে সবকিছু সংরক্ষণ করেছেন তা নিশ্চিত করতে এই দ্রুত পরীক্ষাটি সম্পূর্ণ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Proveďte tento rychlý test, abyste potvrdili, že jste vše uložili správně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemfør denne hurtige test for at bekræfte, at du har gemt alt korrekt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Führen Sie diesen Kurztest durch, um zu bestätigen, dass Sie alles richtig gespeichert haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete this quick test to confirm you've saved everything correctly."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete esta prueba rápida para confirmar que ha guardado todo correctamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این آزمایش را کامل کنید تا تایید کنید همه چیز را به درسی ذخیره کرده اید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpletuhin ang mabilisang pagsubok na ito upang kumpirmahin na na-save mo nang tama ang lahat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Effectuez ce test rapide pour confirmer que vous avez tout enregistré correctement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kammala wannan gwajin gaggawar don tabbatar da cewa kun adana komai daidai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השלם את הבדיקה המהירה הזו כדי לוודא ששמרת הכל כהלכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह पुष्टि करने के लिए कि आपने सब कुछ सही ढंग से सहेजा है, इस त्वरित परीक्षण को पूरा करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan tes cepat ini untuk memastikan bahwa semua sudah tersimpan dengan benar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa questo rapido test per confermare di aver salvato tutto correttamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この簡単なテストを完了して、すべてが正しく保存されたことを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 빠른 테스트를 완료하여 모든 내용을 올바르게 저장했는지 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengkapkan ujian pantas ini untuk mengesahkan anda telah menyimpan semuanya dengan betul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi deze snelle test om te bevestigen dat je alles correct hebt opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wykonaj ten szybki test, aby potwierdzić, że wszystko zostało poprawnie zapisane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua este teste rápido para confirmar que você salvou tudo corretamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizați acest test rapid pentru a confirma că ați salvat totul corect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдите этот быстрый тест, чтобы убедиться, что вы все сохранили правильно."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamilisha jaribio hili la haraka ili kuthibitisha kuwa umehifadhi kila kitu kwa usahihi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทำการทดสอบด่วนนี้ให้เสร็จสิ้นเพื่อยืนยันว่าคุณได้บันทึกทุกอย่างถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her şeyi doğru şekilde kaydettiğinizi doğrulamak için bu hızlı testi tamamlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пройдіть цей швидкий тест, щоб переконатися, що ви все зберегли правильно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس فوری ٹیسٹ کو مکمل کریں اس بات کی تصدیق کرنے کے لیے کہ آپ نے سب کچھ صحیح طریقے سے محفوظ کر لیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy hoàn thành bài kiểm tra nhanh này để xác nhận rằng bạn đã lưu mọi thứ một cách chính xác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "完成这个快速测试，确认是否已正确保存所有内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "完成這個快速測試，以確認已正確儲存所有內容"
          }
        }
      }
    },
