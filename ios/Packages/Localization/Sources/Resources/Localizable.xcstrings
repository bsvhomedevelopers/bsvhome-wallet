    "multisig_review_check": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجعت الوجهة والشبكة والمبلغ والرسوم وأوافق على توقيع هذه المعاملة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি গন্তব্য, নেটওয়ার্ক, পরিমাণ ও ফি যাচাই করেছি এবং এই লেনদেনে স্বাক্ষর করতে সম্মত।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Cíl, síť, částka a poplatek jsou ověřeny a souhlasím s podpisem této transakce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har kontrolleret modtager, netværk, beløb og gebyr og accepterer at underskrive transaktionen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe Ziel, Netzwerk, Betrag und Gebühr geprüft und stimme der Unterzeichnung dieser Transaktion zu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have checked the destination, network, amount and fee and agree to sign this transaction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He comprobado el destino, la red, el importe y la comisión y acepto firmar esta transacción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مقصد، شبکه، مبلغ و کارمزد را بررسی کرده‌ام و با امضای این تراکنش موافقم."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasuri ko na ang destinasyon, network, halaga at bayarin at pumapayag akong pumirma sa transaksyong ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai vérifié la destination, le réseau, le montant et les frais et j’accepte de signer cette transaction."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na duba inda za a aika, cibiyar sadarwa, adadi da kuɗin caji kuma na amince da sa hannu kan wannan ma’amala."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקתי את היעד, הרשת, הסכום והעמלה ואני מסכים לחתום על העסקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने गंतव्य, नेटवर्क, राशि और शुल्क जाँचे हैं और इस लेनदेन पर हस्ताक्षर करने को सहमत हूँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah memeriksa tujuan, jaringan, jumlah, dan biaya serta setuju menandatangani transaksi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho verificato destinatario, rete, importo e commissione e accetto di firmare questa transazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "受取先、ネットワーク、金額、手数料を確認し、この取引への署名に同意します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신자, 네트워크, 금액과 수수료를 확인했으며 이 거래 서명에 동의합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah menyemak penerima, rangkaian, amaun dan fi serta bersetuju menandatangani transaksi ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb de ontvanger, het netwerk, het bedrag en de kosten gecontroleerd en ga akkoord met ondertekening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdziłem odbiorcę, sieć, kwotę i opłatę oraz zgadzam się podpisać tę transakcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferi o destinatário, a rede, o valor e a taxa e concordo em assinar esta transação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am verificat destinatarul, rețeaua, suma și taxa și accept să semnez această tranzacție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я проверил получателя, сеть, сумму и комиссию и согласен подписать транзакцию."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimehakiki mpokeaji, mtandao, kiasi na ada na ninakubali kusaini muamala huu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันตรวจสอบผู้รับ เครือข่าย จำนวนเงินและค่าธรรมเนียมแล้ว และยอมรับการลงนามธุรกรรมนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Alıcıyı, ağı, tutarı ve ücreti kontrol ettim; bu işlemi imzalamayı kabul ediyorum."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я перевірив одержувача, мережу, суму й комісію та погоджуюся підписати цю транзакцію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں نے وصول کنندہ، نیٹ ورک، رقم اور فیس کی جانچ کی ہے اور اس لین دین پر دستخط کرنے سے متفق ہوں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã kiểm tra người nhận, mạng, số tiền và phí, đồng ý ký giao dịch này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核对收款地址、网络、金额和费用，同意签署这笔交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我已核對收款地址、網路、金額和費用，同意簽署這筆交易。"
          }
        }
      }
    },
    "multisig_review_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من المعاملة بشكل مستقل. أي تغيير في العنوان أو المبلغ أو الرسوم يتطلب جمع التوقيعات مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নিজে লেনদেন যাচাই করুন। ঠিকানা, পরিমাণ বা ফি বদলালে আবার স্বাক্ষর সংগ্রহ করতে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakci ověřte nezávisle. Změna adresy, částky nebo poplatku vyžaduje opětovné shromáždění podpisů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér transaktionen uafhængigt. Enhver ændring af adresse, beløb eller gebyr kræver nye underskrifter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe die Transaktion unabhängig. Änderungen an Adresse, Betrag oder Gebühr erfordern neue Signaturen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify the transaction independently. Any change to the address, amount or fee requires collecting signatures again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la transacción por tu cuenta. Cualquier cambio de dirección, importe o comisión requiere recopilar las firmas de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش را مستقل بررسی کنید. هر تغییر در نشانی، مبلغ یا کارمزد، جمع‌آوری دوبارهٔ امضاها را لازم می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suriin ang transaksyon nang sarili mo. Kailangang mangolekta ulit ng lagda kapag nagbago ang address, halaga o bayarin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez la transaction indépendamment. Toute modification de l’adresse, du montant ou des frais exige de recueillir les signatures à nouveau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba ma’amalar da kanka. Sauya adireshi, adadi ko kuɗin caji yana bukatar sake tattara sa hannu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את העסקה באופן עצמאי. כל שינוי בכתובת, בסכום או בעמלה מחייב איסוף חתימות מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेनदेन की स्वतंत्र जाँच करें। पता, राशि या शुल्क बदलने पर दोबारा हस्ताक्षर इकट्ठा करने होंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifikasi transaksi secara mandiri. Perubahan alamat, jumlah, atau biaya memerlukan pengumpulan tanda tangan kembali."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica la transazione in modo indipendente. Qualsiasi modifica a indirizzo, importo o commissione richiede di raccogliere nuovamente le firme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引を自分で確認してください。アドレス、金額、手数料が変わった場合、署名を集め直す必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래를 직접 확인하세요. 주소, 금액이나 수수료가 바뀌면 서명을 다시 모아야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak transaksi sendiri. Perubahan alamat, amaun atau fi memerlukan pengumpulan tandatangan semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de transactie zelfstandig. Bij wijziging van adres, bedrag of kosten moeten handtekeningen opnieuw worden verzameld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź transakcję niezależnie. Zmiana adresu, kwoty lub opłaty wymaga ponownego zebrania podpisów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira a transação de forma independente. Qualquer alteração no endereço, valor ou taxa exige novas assinaturas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică independent tranzacția. Modificarea adresei, sumei sau taxei necesită colectarea din nou a semnăturilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте транзакцию самостоятельно. Изменение адреса, суммы или комиссии требует заново собрать подписи."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakiki muamala mwenyewe. Kubadili anwani, kiasi au ada kunahitaji kukusanya saini upya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบธุรกรรมด้วยตนเอง หากที่อยู่ จำนวนเงินหรือค่าธรรมเนียมเปลี่ยน ต้องรวบรวมลายเซ็นใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemi bağımsız doğrulayın. Adres, tutar veya ücret değişirse imzalar yeniden toplanmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте транзакцію самостійно. Зміна адреси, суми чи комісії потребує повторного збирання підписів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خود لین دین کی جانچ کریں۔ پتہ، رقم یا فیس بدلے تو تمام دستخط دوبارہ جمع کرنا ضروری ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự kiểm tra giao dịch. Đổi địa chỉ, số tiền hoặc phí đều cần thu thập lại chữ ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请独立核对交易内容。地址、金额或费用发生改变，需要重新收集所有签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請獨立核對交易內容。地址、金額或費用發生改變，需要重新收集所有簽名。"
          }
        }
      }
    },
