    "multisig_join_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على الدعوة من عضو موثوق وتحقق من المحفظة والشبكة وقواعد التوقيع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বিশ্বস্ত সদস্যের কাছ থেকে আমন্ত্রণ নিন এবং ওয়ালেট, নেটওয়ার্ক ও স্বাক্ষরের নিয়ম যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získejte pozvánku od důvěryhodného člena a ověřte peněženku, síť a pravidla podepisování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Få invitationen fra et betroet medlem, og kontrollér tegnebogen, netværket og underskriftsreglerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Beziehe die Einladung von einem vertrauenswürdigen Mitglied und prüfe Wallet, Netzwerk und Signaturregeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Get the invitation from a trusted member and verify the wallet, network and signing rules."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtén la invitación de un miembro de confianza y verifica la billetera, la red y las reglas de firma."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوت‌نامه را از عضوی مورد اعتماد بگیرید و کیف پول، شبکه و قواعد امضا را بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunin ang imbitasyon sa mapagkakatiwalaang miyembro at suriin ang wallet, network at tuntunin sa pagpirma."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenez l’invitation auprès d’un membre fiable et vérifiez le portefeuille, le réseau et les règles de signature."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Karɓi gayyata daga amintaccen mamba kuma duba walat, cibiyar sadarwa da ƙa’idojin sa hannu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קבל את ההזמנה מחבר מהימן ואמת את הארנק, הרשת וכללי החתימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भरोसेमंद सदस्य से आमंत्रण लें और वॉलेट, नेटवर्क और हस्ताक्षर नियम की जाँच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan undangan dari anggota tepercaya lalu verifikasi dompet, jaringan, dan aturan tanda tangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ottieni l’invito da un membro fidato e verifica portafoglio, rete e regole di firma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できるメンバーから招待を受け取り、ウォレット、ネットワーク、ルールを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 구성원에게 초대를 받아 지갑, 네트워크와 규칙을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan jemputan daripada ahli dipercayai dan semak dompet, rangkaian serta peraturan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vraag een vertrouwd lid om een uitnodiging en controleer wallet, netwerk en regels."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzyskaj zaproszenie od zaufanego członka i sprawdź portfel, sieć oraz zasady podpisywania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Obtenha o convite de um membro confiável e confira a carteira, a rede e as regras de assinatura."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Obține invitația de la un membru de încredere și verifică portofelul, rețeaua și regulile de semnare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Получите приглашение от доверенного участника и проверьте кошелёк, сеть и правила."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pata mwaliko kutoka kwa mwanachama anayeaminika; hakiki mkoba, mtandao na kanuni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับคำเชิญจากสมาชิกที่เชื่อถือได้ แล้วตรวจสอบกระเป๋า เครือข่ายและกฎ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Daveti güvenilir bir üyeden alın; cüzdanı, ağı ve imza kurallarını doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримайте запрошення від надійного учасника й перевірте гаманець, мережу та правила."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "قابلِ اعتماد رکن سے دعوت لیں؛ والیٹ، نیٹ ورک اور اصول کی جانچ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lấy lời mời từ người đáng tin cậy và kiểm tra ví, mạng cùng quy tắc ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请从可信成员处获取邀请，核对钱包、网络和签名规则。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請從可信成員處獲取邀請，核對錢包、網路和簽名規則。"
          }
        }
      }
    },
