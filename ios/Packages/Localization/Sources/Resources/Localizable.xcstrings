    "multisig_service_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر إكمال الطلب (%@). حدّث الحالة الحالية قبل المحاولة مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুরোধ সম্পূর্ণ করা যায়নি (%@)। আবার চেষ্টা করার আগে বর্তমান অবস্থা হালনাগাদ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požadavek se nepodařilo dokončit (%@). Před dalším pokusem obnovte aktuální stav."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmodningen kunne ikke fuldføres (%@). Opdatér den aktuelle status, før du prøver igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Anfrage konnte nicht abgeschlossen werden (%@). Aktualisiere den aktuellen Stand vor einem erneuten Versuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The request could not complete (%@). Refresh the current state before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo completar la solicitud (%@). Actualiza el estado actual antes de volver a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست تکمیل نشد (%@). پیش از تلاش دوباره، وضعیت فعلی را تازه کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makumpleto ang kahilingan (%@). I-refresh ang kasalukuyang estado bago subukan muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La requête n’a pas pu aboutir (%@). Actualisez l’état actuel avant de réessayer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kasa kammala buƙatar (%@). Sabunta halin yanzu kafin sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה להשלים את הבקשה (%@). יש לרענן את המצב הנוכחי לפני ניסיון נוסף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अनुरोध पूरा नहीं हो सका (%@)। फिर से कोशिश करने से पहले मौजूदा स्थिति रीफ़्रेश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan tidak dapat diselesaikan (%@). Perbarui status saat ini sebelum mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile completare la richiesta (%@). Aggiorna lo stato corrente prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストを完了できませんでした（%@）。現在の状態を更新してから再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청을 완료하지 못했습니다(%@). 현재 상태를 새로고침한 뒤 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan tidak dapat diselesaikan (%@). Muat semula keadaan semasa sebelum mencuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verzoek kon niet worden voltooid (%@). Vernieuw de huidige status voordat je het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się ukończyć żądania (%@). Odśwież bieżący stan przed ponowną próbą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível concluir a solicitação (%@). Atualize o estado atual antes de tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cererea nu a putut fi finalizată (%@). Reîmprospătează starea curentă înainte de a reîncerca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось завершить запрос (%@). Обновите текущее состояние перед повторной попыткой."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombi halikuweza kukamilika (%@). Sasisha hali ya sasa kabla ya kujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดำเนินการตามคำขอไม่สำเร็จ (%@) โปรดรีเฟรชสถานะปัจจุบันก่อนลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek tamamlanamadı (%@). Yeniden denemeden önce mevcut durumu yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося завершити запит (%@). Оновіть поточний стан перед повторною спробою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست مکمل نہیں ہو سکی (%@)۔ دوبارہ کوشش سے پہلے موجودہ حالت تازہ کریں۔"
