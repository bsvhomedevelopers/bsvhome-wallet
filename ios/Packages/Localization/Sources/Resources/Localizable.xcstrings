    "multisig_invite_code_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رموز الدعوة صالحة لمدة 24 ساعة وتُستخدم مرة واحدة. إنشاء رمز جديد يُبطل الرمز السابق غير المستخدم. ادعُ العضو التالي بعد انضمام العضو الحالي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণ কোড 24 ঘণ্টা বৈধ এবং একবার ব্যবহার করা যায়। নতুন কোড তৈরি করলে আগের অব্যবহৃত কোড বাতিল হয়। বর্তমান সদস্য যোগ দেওয়ার পর পরবর্তী সদস্যকে আমন্ত্রণ জানান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kódy pozvánek platí 24 hodin a lze je použít jednou. Nový kód zneplatní předchozí nepoužitý kód. Dalšího člena pozvěte až po připojení současného."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitationskoder gælder i 24 timer og kan kun bruges én gang. En ny kode gør den tidligere ubrugte kode ugyldig. Invitér næste medlem, når det nuværende er tilmeldt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladungscodes gelten 24 Stunden und sind einmal verwendbar. Ein neuer Code macht den bisherigen unbenutzten Code ungültig. Lade das nächste Mitglied nach dem Beitritt des aktuellen Mitglieds ein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitation codes are valid for 24 hours and can be used once. Generating another code invalidates the previous unused code. Invite the next member after the current member joins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los códigos de invitación son válidos durante 24 horas y se usan una sola vez. Generar otro invalida el anterior sin usar. Invita al siguiente miembro cuando se una el actual."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کد دعوت 24 ساعت اعتبار دارد و یک‌بار مصرف است. ایجاد کد جدید، کد قبلیِ استفاده‌نشده را باطل می‌کند. عضو بعدی را پس از پیوستن عضو فعلی دعوت کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May bisa ang invitation code sa loob ng 24 oras at isang beses lang magagamit. Mawawalan ng bisa ang naunang hindi pa nagamit na code kapag gumawa ng bago. Imbitahan ang susunod na miyembro matapos sumali ang kasalukuyan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les codes d’invitation sont valables 24 heures et à usage unique. Un nouveau code invalide le précédent s’il n’a pas été utilisé. Invitez le membre suivant après l’arrivée du membre actuel."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Lambobin gayyata suna aiki na awa 24 kuma sau ɗaya kawai. Sabuwar lamba tana soke tsohuwar da ba a yi amfani da ita ba. Gayyaci mamba na gaba bayan na yanzu ya shiga."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "קודי הזמנה תקפים ל־24 שעות ולשימוש אחד. יצירת קוד חדש מבטלת את הקוד הקודם שלא נוצל. יש להזמין את החבר הבא אחרי שהחבר הנוכחי מצטרף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रण कोड 24 घंटे तक मान्य है और एक बार इस्तेमाल होता है। नया कोड बनाने पर पिछला अप्रयुक्त कोड अमान्य हो जाता है। मौजूदा सदस्य के जुड़ने के बाद अगले सदस्य को आमंत्रित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kode undangan berlaku 24 jam dan sekali pakai. Kode baru membatalkan kode lama yang belum dipakai. Undang anggota berikutnya setelah anggota saat ini bergabung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I codici d’invito durano 24 ore e sono monouso. Un nuovo codice invalida quello precedente non utilizzato. Invita il prossimo membro dopo l’adesione di quello attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待コードは24時間有効で1回だけ使用できます。新しく生成すると、以前の未使用コードは無効になります。現在のメンバーが参加してから次のメンバーを招待してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대 코드는 24시간 유효하며 한 번만 사용할 수 있습니다. 새 코드를 생성하면 이전 미사용 코드는 무효화됩니다. 현재 구성원이 참여한 뒤 다음 구성원을 초대하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kod jemputan sah selama 24 jam dan boleh digunakan sekali. Kod baharu membatalkan kod lama yang belum digunakan. Jemput ahli seterusnya selepas ahli semasa menyertai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodigingscodes zijn 24 uur geldig en eenmalig te gebruiken. Een nieuwe code maakt de vorige ongebruikte code ongeldig. Nodig het volgende lid uit nadat het huidige lid is toegetreden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kody zaproszeń są ważne 24 godziny i jednorazowe. Nowy kod unieważnia poprzedni niewykorzystany kod. Zaproś następnego członka po dołączeniu obecnego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os códigos de convite valem por 24 horas e só podem ser usados uma vez. Gerar outro invalida o anterior ainda não usado. Convide o próximo membro depois que o atual entrar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Codurile de invitație sunt valabile 24 de ore și se folosesc o singură dată. Un cod nou îl invalidează pe cel anterior nefolosit. Invită următorul membru după ce se alătură cel actual."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Коды приглашений действуют 24 часа и используются один раз. Новый код отменяет предыдущий неиспользованный код. Приглашайте следующего участника после присоединения текущего."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Misimbo ya mwaliko inatumika kwa saa 24 na mara moja tu. Msimbo mpya unabatilisha ule wa awali ambao haujatumika. Alika mwanachama anayefuata baada ya huyu kujiunga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รหัสเชิญใช้ได้ 24 ชั่วโมงและใช้ได้ครั้งเดียว การสร้างรหัสใหม่จะยกเลิกรหัสเดิมที่ยังไม่ได้ใช้ ให้เชิญสมาชิกคนถัดไปหลังคนปัจจุบันเข้าร่วมแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet kodları 24 saat geçerlidir ve tek kullanımlıktır. Yeni kod, önceki kullanılmamış kodu geçersiz kılar. Mevcut üye katıldıktan sonra sonraki üyeyi davet edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Коди запрошень діють 24 години та використовуються один раз. Новий код скасовує попередній невикористаний. Запрошуйте наступного учасника після приєднання поточного."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوتی کوڈ 24 گھنٹے تک درست ہے اور صرف ایک بار استعمال ہوتا ہے۔ نیا کوڈ بنانے سے پچھلا غیر استعمال شدہ کوڈ منسوخ ہو جاتا ہے۔ موجودہ رکن کے شامل ہونے کے بعد اگلے رکن کو دعوت دیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mã mời có hiệu lực 24 giờ và chỉ dùng một lần. Mã mới làm mất hiệu lực mã cũ chưa dùng. Mời thành viên tiếp theo sau khi thành viên hiện tại tham gia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请代码有效期为 24 小时，单次使用。重新生成会让旧的未使用代码失效；请在当前成员加入后再邀请下一位。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請碼有效期為 24 小時，僅能使用一次。重新產生會讓舊的未使用邀請碼失效；請在目前成員加入後再邀請下一位。"
          }
        }
      }
    },
