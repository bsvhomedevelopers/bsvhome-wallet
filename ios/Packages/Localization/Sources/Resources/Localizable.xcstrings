    "wowpay_multisig_method_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدِر BSV مع الآخرين. يراجع عدة أعضاء كل دفعة ويوقّعونها، كلٌّ على حدة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "একসঙ্গে BSV পরিচালনা করুন। প্রতিটি পেমেন্ট একাধিক সদস্য স্বাধীনভাবে যাচাই করে স্বাক্ষর করেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spravujte BSV společně. Každou platbu nezávisle ověřuje a podepisuje více členů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Administrer BSV sammen. Flere medlemmer kontrollerer og underskriver hver betaling uafhængigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV gemeinsam verwalten. Mehrere Mitglieder prüfen und signieren jede Zahlung unabhängig voneinander."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Manage BSV together. Each payment is independently reviewed and signed by multiple members."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestiona BSV en grupo. Varios miembros revisan y firman cada pago de forma independiente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV را گروهی مدیریت کنید. هر پرداخت را چند عضو، مستقل از هم، بررسی و امضا می‌کنند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pamahalaan ang BSV nang sama-sama. Bawat bayad ay hiwalay na sinusuri at nilalagdaan ng maraming miyembro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gérez vos BSV à plusieurs. Chaque paiement est vérifié et signé indépendamment par plusieurs membres."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A sarrafa BSV tare. Mambobi da yawa suna duba kowane biyan kuɗi kuma su sa hannu, kowanne da kansa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניהול BSV משותף. כל תשלום נבדק ונחתם בנפרד על ידי כמה חברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मिलकर BSV प्रबंधित करें। कई सदस्य हर भुगतान की स्वतंत्र रूप से जाँच कर उस पर हस्ताक्षर करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kelola BSV bersama. Setiap pembayaran diperiksa dan ditandatangani secara mandiri oleh beberapa anggota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestisci BSV insieme ad altri. Ogni pagamento viene verificato e firmato in modo indipendente da più membri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV を共同管理します。各支払いは複数のメンバーが個別に確認し、署名します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV를 함께 관리하세요. 여러 구성원이 각 결제를 독립적으로 확인하고 서명합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Urus BSV bersama. Setiap bayaran disemak dan ditandatangani secara berasingan oleh beberapa ahli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Beheer BSV samen. Meerdere leden controleren en ondertekenen elke betaling onafhankelijk van elkaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarządzajcie BSV wspólnie. Każdą płatność niezależnie sprawdza i podpisuje kilku członków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Gerencie BSV em conjunto. Cada pagamento é verificado e assinado de forma independente por vários membros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Gestionați BSV împreună. Fiecare plată este verificată și semnată independent de mai mulți membri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Управляйте BSV совместно. Каждый платёж независимо проверяют и подписывают несколько участников."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Dhibiti BSV kwa pamoja. Kila malipo hukaguliwa na kutiwa saini kwa kujitegemea na wanachama kadhaa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จัดการ BSV ร่วมกัน โดยสมาชิกหลายคนตรวจสอบและลงนามในแต่ละการชำระเงินอย่างเป็นอิสระ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "BSV'yi birlikte yönetin. Her ödeme birden çok üye tarafından bağımsız olarak incelenir ve imzalanır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Керуйте BSV спільно. Кожен платіж незалежно перевіряють і підписують кілька учасників."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مل کر BSV کا انتظام کریں۔ ہر ادائیگی کی کئی ارکان الگ الگ جانچ کرتے اور اس پر دستخط کرتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cùng quản lý BSV. Mỗi khoản thanh toán được nhiều thành viên kiểm tra và ký độc lập."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "共同管理 BSV，每笔支出由多人独立核对与签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "共同管理 BSV，每筆支出由多人獨立核對與簽署。"
          }
        }
      }
    },
