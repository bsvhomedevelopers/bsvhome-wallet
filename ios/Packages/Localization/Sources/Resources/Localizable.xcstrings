    "multisig_backup_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي الإعدادات على المفاتيح العامة للأعضاء وقواعد التوقيع فقط، ولا تتضمن مفاتيح خاصة أو عبارات استرداد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কনফিগারেশনে সদস্যদের প্রকাশ্য কী ও স্বাক্ষরের নিয়ম থাকে, ব্যক্তিগত কী বা পুনরুদ্ধার বাক্যাংশ কখনো থাকে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurace obsahuje veřejné klíče členů a pravidla podepisování, nikdy soukromé klíče ani obnovovací fráze."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurationen indeholder offentlige medlemsnøgler og underskriftsregler, aldrig private nøgler eller gendannelsesfraser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Konfiguration enthält öffentliche Mitgliedsschlüssel und Signaturregeln, niemals private Schlüssel oder Wiederherstellungsphrasen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The configuration contains public member keys and signing rules, never private keys or recovery phrases."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración contiene las claves públicas de los miembros y las reglas de firma, nunca claves privadas ni frases de recuperación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکربندی شامل کلیدهای عمومی اعضا و قواعد امضاست، نه کلید خصوصی یا عبارت بازیابی."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pampublikong susi ng mga miyembro at tuntunin sa pagpirma ang laman ng configuration, hindi pribadong susi o parirala sa pagbawi."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration contient les clés publiques des membres et les règles de signature, jamais de clés privées ni de phrases de récupération."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsarin yana ɗauke da maɓallan jama’a na mambobi da ƙa’idojin sa hannu, ba keɓaɓɓen maɓalli ko kalmomin dawo da walat ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התצורה כוללת מפתחות ציבוריים של החברים וכללי חתימה, ולעולם לא מפתחות פרטיים או מילות שחזור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कॉन्फ़िगरेशन में सदस्यों की सार्वजनिक कुंजी और हस्ताक्षर नियम होते हैं, निजी कुंजी या गुप्त वाक्यांश कभी नहीं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi berisi kunci publik anggota dan aturan tanda tangan, bukan kunci privat atau frasa pemulihan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione contiene chiavi pubbliche dei membri e regole di firma, mai chiavi private o frasi di recupero."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定には公開鍵と署名ルールが含まれ、秘密鍵やリカバリーフレーズは含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성에는 공개 키와 서명 규칙만 포함되며 개인 키나 복구 구문은 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi mengandungi kunci awam dan peraturan tandatangan, bukan kunci peribadi atau frasa pemulihan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De configuratie bevat openbare sleutels en ondertekeningsregels, nooit privésleutels of herstelzinnen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja zawiera publiczne klucze członków i zasady podpisywania, nigdy klucze prywatne ani frazy odzyskiwania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração contém chaves públicas dos membros e regras de assinatura, nunca chaves privadas ou frases de recuperação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurația conține cheile publice și regulile de semnare, niciodată chei private sau fraze de recuperare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфигурация содержит открытые ключи участников и правила, но не закрытые ключи или фразы восстановления."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usanidi una funguo za umma na kanuni za kusaini, si funguo za siri au misemo ya urejeshaji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่ามีคีย์สาธารณะและกฎการลงนาม ไม่มีคีย์ส่วนตัวหรือวลีกู้คืน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yapılandırma açık üye anahtarlarını ve imza kurallarını içerir; özel anahtar veya kurtarma ifadesi içermez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Конфігурація містить публічні ключі учасників і правила, але не приватні ключі чи фрази відновлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ترتیب میں عوامی کلیدیں اور دستخط کے اصول ہوتے ہیں، نجی کلیدیں یا بحالی کے الفاظ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình chứa khóa công khai và quy tắc ký, không chứa khóa riêng hoặc cụm từ khôi phục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "配置备份包含公开的成员公钥和签名规则，不包含任何私钥或助记词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "配置備份包含公開的成員公鑰和簽名規則，不包含任何私鑰或助記詞。"
          }
        }
      }
    },
    "multisig_backup_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب على كل عضو أيضًا نسخ بيانات استرداد محفظته احتياطيًا. ملف الإعدادات وحده لا يتيح إنفاق الأموال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রত্যেক সদস্যকে নিজের ওয়ালেটের পুনরুদ্ধারের তথ্যও ব্যাকআপ করতে হবে। শুধু কনফিগারেশন ফাইল দিয়ে অর্থ খরচ করা যায় না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý člen musí také zálohovat vlastní údaje pro obnovu peněženky. Samotný soubor konfigurace neumožňuje utrácet prostředky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert medlem skal også sikkerhedskopiere sine egne gendannelsesoplysninger. Konfigurationsfilen alene giver ikke adgang til at overføre midler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mitglied muss zusätzlich seine eigenen Wiederherstellungsdaten sichern. Die Konfigurationsdatei allein ermöglicht keine Ausgaben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each member must also back up their own wallet recovery material. The configuration file alone cannot spend funds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada miembro debe respaldar también sus propios datos de recuperación. El archivo de configuración por sí solo no permite gastar fondos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر عضو باید از اطلاعات بازیابی کیف پول خودش نیز پشتیبان بگیرد. فایل پیکربندی به‌تنهایی امکان خرج کردن دارایی را نمی‌دهد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ding i-backup ng bawat miyembro ang sariling impormasyon sa pagbawi ng wallet. Hindi sapat ang configuration file lang para gumastos ng pondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque membre doit aussi sauvegarder ses propres données de récupération. Le fichier de configuration seul ne permet pas de dépenser les fonds."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kowane mamba ya kuma ajiye kwafin bayanan dawo da walat ɗinsa. Fayil ɗin tsarin kaɗai ba ya ba da ikon kashe kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל חבר חייב גם לגבות את נתוני השחזור של הארנק שלו. קובץ התצורה לבדו אינו מאפשר להוציא כספים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सदस्य को अपने वॉलेट की रिकवरी जानकारी का भी बैकअप लेना होगा। केवल कॉन्फ़िगरेशन फ़ाइल से राशि खर्च नहीं की जा सकती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap anggota juga harus mencadangkan data pemulihan dompetnya sendiri. Berkas konfigurasi saja tidak dapat digunakan untuk membelanjakan dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni membro deve anche conservare un backup dei propri dati di recupero. Il solo file di configurazione non permette di spendere fondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各メンバーは自分のウォレットの復元情報も保存してください。設定ファイルだけでは資金を使用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 구성원은 자신의 지갑 복구 자료도 백업해야 합니다. 구성 파일만으로는 자금을 사용할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ahli juga perlu menyandarkan maklumat pemulihan sendiri. Fail konfigurasi sahaja tidak boleh membelanjakan dana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk lid moet ook zijn eigen herstelgegevens bewaren. Het configuratiebestand alleen kan geen geld uitgeven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy członek musi też zachować własne dane odzyskiwania portfela. Sam plik konfiguracji nie pozwala wydać środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada membro também deve fazer backup dos seus dados de recuperação. O arquivo de configuração sozinho não permite gastar fundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare membru trebuie să păstreze și propriile date de recuperare. Fișierul de configurație singur nu permite cheltuirea fondurilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый участник должен сохранить свои данные восстановления. Одного файла конфигурации недостаточно для расходования средств."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila mwanachama lazima ahifadhi taarifa zake za kurejesha mkoba. Faili ya usanidi pekee haiwezi kutumia fedha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมาชิกต้องสำรองข้อมูลกู้คืนกระเป๋าของตนเองด้วย ไฟล์การตั้งค่าอย่างเดียวไม่สามารถใช้จ่ายเงินได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her üye kendi kurtarma bilgilerini de yedeklemelidir. Yapılandırma dosyası tek başına fon harcamaya yetmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен учасник також має зберегти свої дані відновлення. Сам файл конфігурації не дозволяє витрачати кошти."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر رکن اپنے والیٹ کی بحالی کی معلومات بھی محفوظ کرے۔ صرف ترتیب کی فائل سے رقم خرچ نہیں ہو سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi người vẫn phải sao lưu dữ liệu khôi phục ví riêng. Chỉ có tệp cấu hình thì không thể chi tiền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每位成员仍需独立备份自己的钱包恢复资料。仅有配置文件不能单独转出资产。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每位成員仍需獨立備份自己的錢包恢復資料。僅有配置檔案不能單獨轉出資產。"
          }
        }
      }
    },
