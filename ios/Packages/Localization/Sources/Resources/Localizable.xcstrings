    "cold_wallet_pairing_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح هذا الرمز بالجهاز المتصل. قارن أول عنوان استقبال على الجهازين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন ডিভাইসে এই QR স্ক্যান করুন। দুই ডিভাইসের প্রথম গ্রহণের ঠিকানা মিলিয়ে দেখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na online zařízení naskenujte QR. Porovnejte první přijímací adresu na obou zařízeních."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan denne QR på onlineenheden. Sammenlign første modtageradresse på begge enheder."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diesen QR-Code mit dem verbundenen Gerät scannen. Die erste Empfangsadresse auf beiden Geräten vergleichen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan this pairing QR on the online device. Compare the first receive address on both devices."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanee este QR en el dispositivo conectado. Compare la primera dirección de recepción en ambos dispositivos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این QR را با دستگاه آنلاین اسکن کنید. نخستین نشانی دریافت را در هر دو دستگاه مقایسه کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-scan ang QR sa online na device. Ihambing ang unang address ng pagtanggap sa dalawang device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez ce QR sur l’appareil connecté. Comparez la première adresse de réception sur les deux appareils."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba wannan QR da na’urar intanet. Kwatanta adireshin karɓa na farko a na’urorin biyu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו קוד זה במכשיר המקוון. השוו את כתובת הקבלה הראשונה בשני המכשירים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन डिवाइस से यह QR स्कैन करें। दोनों डिवाइस का पहला प्राप्ति पता मिलाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai QR ini pada perangkat online. Bandingkan alamat penerimaan pertama pada kedua perangkat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona questo QR sul dispositivo online. Confronta il primo indirizzo di ricezione sui due dispositivi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン端末でこの QR を読み取り、両端末の最初の受取アドレスが一致することを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 기기로 이 QR을 스캔하고 두 기기의 첫 수신 주소가 같은지 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbas QR ini pada peranti dalam talian. Bandingkan alamat penerimaan pertama pada kedua-dua peranti."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan deze QR op het online apparaat. Vergelijk het eerste ontvangstadres op beide apparaten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj ten kod na urządzeniu online. Porównaj pierwszy adres odbiorczy na obu urządzeniach."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia este QR no dispositivo online. Compare o primeiro endereço de recebimento nos dois dispositivos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanați QR-ul pe dispozitivul online. Comparați prima adresă de primire pe ambele dispozitive."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканируйте QR онлайн-устройством. Сравните первый адрес получения на обоих устройствах."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Changanua QR hii kwa kifaa cha mtandaoni. Linganisha anwani ya kwanza ya kupokea katika vifaa vyote viwili."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกน QR นี้ด้วยอุปกรณ์ออนไลน์ เปรียบเทียบที่อยู่รับเงินแรกของทั้งสองอุปกรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu QR kodunu çevrimiçi cihazda tarayın. İki cihazdaki ilk alım adresini karşılaştırın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте QR онлайн-пристроєм. Порівняйте першу адресу отримання на обох пристроях."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آن لائن آلے سے یہ QR اسکین کریں۔ دونوں آلات کا پہلا وصولی پتہ ملائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét mã QR này bằng thiết bị trực tuyến. So sánh địa chỉ nhận đầu tiên trên cả hai thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用在线设备扫描配对二维码，并核对两台设备的首个收款地址是否一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用線上裝置掃描配對二維碼，並核對兩台裝置的首個收款地址是否一致。"
          }
        }
      }
    },
