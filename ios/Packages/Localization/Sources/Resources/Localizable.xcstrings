            "value": "Cadangkan frasa pemulihan agar dompet Anda tetap aman"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esegui il backup della frase di recupero per proteggere il portafoglio"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットを安全に保つため、リカバリーフレーズをバックアップしてください"
