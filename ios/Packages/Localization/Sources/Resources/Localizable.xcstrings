    "wowpay_address_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر عنوانًا لتلقي المدفوعات، أو انسخه لمشاركته مع المرسل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অর্থ গ্রহণের জন্য একটি ঠিকানা বেছে নিন বা প্রেরককে শেয়ার করতে সেটি কপি করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vyberte adresu pro příjem plateb nebo ji zkopírujte a sdílejte s odesílatelem"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Vælg en adresse til at modtage betalinger, eller kopiér den for at dele den med afsenderen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wähle eine Adresse zum Empfangen von Zahlungen oder kopiere sie, um sie mit dem Absender zu teilen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose an address to receive payments, or copy it to share with the sender"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige una dirección para recibir pagos o cópiala para compartirla con el remitente"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "آدرسی برای دریافت پرداخت انتخاب کنید یا آن را برای اشتراک‌گذاری با فرستنده کپی کنید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Pumili ng address para tumanggap ng bayad, o kopyahin ito para ibahagi sa nagbabayad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez une adresse pour recevoir des paiements ou copiez-la pour la partager avec l’expéditeur"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaɓi adireshi don karɓar kuɗi, ko kwafe shi don raba wa mai aikawa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לבחור כתובת לקבלת תשלומים או להעתיק אותה כדי לשתף עם השולח"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान प्राप्त करने के लिए पता चुनें या भेजने वाले के साथ साझा करने के लिए उसे कॉपी करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih alamat untuk menerima pembayaran, atau salin untuk dibagikan kepada pengirim"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli un indirizzo per ricevere pagamenti o copialo per condividerlo con il mittente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いを受け取るアドレスを選択するか、コピーして送金者と共有してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제를 받을 주소를 선택하거나 복사하여 보내는 사람에게 공유하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih alamat untuk menerima bayaran, atau salin untuk dikongsi dengan pengirim"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies een adres om betalingen te ontvangen of kopieer het om met de afzender te delen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz adres do odbierania płatności lub skopiuj go, aby udostępnić nadawcy"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha um endereço para receber pagamentos ou copie-o para compartilhar com o remetente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alege o adresă pentru a primi plăți sau copiaz-o pentru a o partaja cu expeditorul"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите адрес для получения платежей или скопируйте его, чтобы поделиться с отправителем"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Chagua anwani ya kupokea malipo, au inakili ili kuishiriki na mtumaji"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เลือกที่อยู่เพื่อรับเงิน หรือคัดลอกเพื่อแชร์ให้ผู้ส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme almak için bir adres seçin veya gönderenle paylaşmak için kopyalayın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виберіть адресу для отримання платежів або скопіюйте її, щоб поділитися з відправником"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ادائیگی وصول کرنے کے لیے پتہ منتخب کریں، یا بھیجنے والے کے ساتھ شیئر کرنے کے لیے اسے کاپی کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chọn địa chỉ để nhận tiền hoặc sao chép để chia sẻ với người gửi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择地址收款，或复制后分享给付款方"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "選擇地址收款，或複製後分享給付款方"
          }
        }
      }
    },
