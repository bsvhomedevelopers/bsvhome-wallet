        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет недействителен, не поддерживается или изменён. Проверьте полный пакет и повторите попытку."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifurushi ni batili, hakitumiki au kimebadilishwa. Hakiki kifurushi kizima na ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชุดข้อมูลไม่ถูกต้อง ไม่รองรับหรือถูกเปลี่ยน ตรวจสอบข้อมูลทั้งหมดแล้วลองใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket geçersiz, desteklenmiyor veya değiştirilmiş. Tam paketi kontrol edip yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Пакет недійсний, не підтримується або змінений. Перевірте повний пакет і повторіть спробу."
