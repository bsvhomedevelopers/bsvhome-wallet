    "cold_wallet_online_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المراقب المتصل: يجب أن توقع المحفظة الباردة قبل بث المعاملة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন পর্যবেক্ষক: সম্প্রচারের আগে কোল্ড ওয়ালেটের স্বাক্ষর প্রয়োজন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Online pozorovatel: před odesláním musí studená peněženka podepsat."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Online observatør: den kolde tegnebog skal underskrive før udsendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verbundene Beobachtungswallet: Vor der Übertragung muss die Cold-Wallet signieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online observer: the cold device must sign before you can broadcast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observador conectado: el monedero frío debe firmar antes de transmitir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ناظر آنلاین: پیش از انتشار، کیف پول سرد باید امضا کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Online na observer: kailangang pumirma ang malamig na wallet bago i-broadcast."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observateur connecté : le portefeuille froid doit signer avant la diffusion."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai lura a kan intanet: walat sanyi dole ya sa hannu kafin watsa ma’amala."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צופה מקוון: הארנק הקר חייב לחתום לפני שידור העסקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन पर्यवेक्षक: प्रसारण से पहले कोल्ड वॉलेट का हस्ताक्षर आवश्यक है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengamat online: dompet dingin harus menandatangani sebelum disiarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osservatore online: il portafoglio freddo deve firmare prima della trasmissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン監視端末：配信前にコールドウォレットでの署名が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 관찰 기기: 브로드캐스트 전에 콜드 지갑의 서명이 필요합니다."
          }
        },
        "ms": {
