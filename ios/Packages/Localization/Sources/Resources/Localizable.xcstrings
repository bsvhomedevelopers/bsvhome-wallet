        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert medlem har vægt 1. Mindst %d underskrifter kræves for at overføre midler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mitglied hat Gewicht 1. Für eine Überweisung sind mindestens %d Signaturen nötig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each member has weight 1. At least %d signatures are required to transfer funds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada miembro tiene peso 1. Se necesitan al menos %d firmas para transferir fondos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وزن هر عضو 1 است. انتقال دارایی به دست‌کم %d امضا نیاز دارد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May bigat na 1 ang bawat miyembro. Kailangan ng hindi bababa sa %d lagda para maglipat ng pondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque membre a un poids de 1. Au moins %d signatures sont nécessaires pour transférer les fonds."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Nauyin kowane mamba 1 ne. Ana bukatar aƙalla sa hannu %d don canja kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לכל חבר משקל 1. להעברת כספים נדרשות לפחות %d חתימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सदस्य का भार 1 है। राशि भेजने के लिए कम से कम %d हस्ताक्षर चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bobot setiap anggota 1. Transfer dana membutuhkan setidaknya %d tanda tangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni membro ha peso 1. Servono almeno %d firme per trasferire i fondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各メンバーの重みは 1 です。送金には少なくとも %d 人の署名が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 구성원의 가중치는 1입니다. 이체에는 최소 %d개의 서명이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ahli mempunyai pemberat 1. Pemindahan memerlukan sekurang-kurangnya %d tandatangan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk lid heeft gewicht 1. Een overdracht vereist minstens %d handtekeningen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy członek ma wagę 1. Transfer wymaga co najmniej %d podpisów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada membro tem peso 1. São necessárias pelo menos %d assinaturas para transferir fundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare membru are ponderea 1. Transferul necesită cel puțin %d semnături."
