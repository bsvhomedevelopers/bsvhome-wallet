    "cold_wallet_backup_confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوّنت عبارتي السرية وتحققت منها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি গোপন বাক্যাংশ লিখে যাচাই করেছি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapsal jsem si a ověřil tajnou frázi."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har skrevet min hemmelige frase ned og kontrolleret den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe meine Geheimphrase aufgeschrieben und geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have written down and checked my secret phrase."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He anotado y verificado mi frase secreta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت محرمانه را یادداشت و بررسی کرده‌ام."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naisulat at nasuri ko ang lihim na parirala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai noté et vérifié ma phrase secrète."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na rubuta kuma na duba kalmomin sirrina."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשמתי ובדקתי את הביטוי הסודי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने गुप्त वाक्यांश लिख लिया और जाँच लिया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah menulis dan memeriksa frasa rahasia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho annotato e verificato la frase segreta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットフレーズを書き留め、確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 문구를 기록하고 확인했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah mencatat dan menyemak frasa rahsia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb mijn geheime zin opgeschreven en gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisałem i sprawdziłem tajną frazę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anotei e conferi minha frase secreta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am notat și verificat fraza secretă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я записал и проверил секретную фразу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimeandika na kuhakiki maneno yangu ya siri."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันได้จดและตรวจสอบวลีลับแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli ifademi yazdım ve kontrol ettim."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я записав і перевірив секретну фразу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں نے خفیہ عبارت لکھ لی اور جانچ لی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã ghi và kiểm tra cụm từ bí mật."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已抄写并核对助记词。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我已抄寫並核對助記詞。"
          }
        }
      }
    },
    "cold_wallet_backup_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "دوّن العبارة السرية دون اتصال. يمكن لأي شخص يملكها إنفاق أموالك. لا يمكننا استعادتها نيابة عنك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "গোপন বাক্যাংশ অফলাইনে লিখুন। যার কাছে এটি আছে সে আপনার অর্থ খরচ করতে পারে। আমরা আপনার জন্য এটি পুনরুদ্ধার করতে পারি না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapište si tajnou frázi offline. Každý, kdo ji má, může utratit vaše prostředky. Nemůžeme ji za vás obnovit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Skriv din hemmelige frase ned offline. Enhver med frasen kan bruge dine midler. Den kan ikke gendannes for dig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geheimphrase offline aufschreiben. Wer sie kennt, kann Ihr Guthaben ausgeben. Sie kann nicht für Sie wiederhergestellt werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write down your secret phrase offline. Anyone with it can spend your funds. It cannot be recovered for you."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote su frase secreta sin conexión. Quien la tenga puede gastar sus fondos. No se puede recuperar por usted."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت محرمانه را آفلاین یادداشت کنید. هر کس آن را داشته باشد می‌تواند وجه شما را خرج کند. ما نمی‌توانیم آن را برایتان بازیابی کنیم."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isulat offline ang lihim na parirala. Sinumang mayroon nito ay maaaring gumastos ng iyong pondo. Hindi namin ito maibabalik para sa iyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Notez votre phrase secrète hors ligne. Quiconque la possède peut dépenser vos fonds. Elle ne peut pas être récupérée pour vous."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubuta kalmomin sirri ba tare da intanet ba. Duk mai su zai iya kashe kuɗinka. Ba za mu iya dawo maka da su ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רשמו את הביטוי הסודי ללא חיבור לרשת. מי שמחזיק בו יכול להוציא את כספכם. אין אפשרות לשחזר אותו עבורכם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "गुप्त वाक्यांश ऑफ़लाइन लिखें। जिसके पास यह है वह आपका धन खर्च कर सकता है। हम इसे आपके लिए पुनर्प्राप्त नहीं कर सकते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tulis frasa rahasia secara offline. Siapa pun yang memilikinya dapat menggunakan dana Anda. Kami tidak dapat memulihkannya untuk Anda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Annota offline la frase segreta. Chi la possiede può spendere i tuoi fondi. Non possiamo recuperarla per te."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シークレットフレーズをオフラインで書き留めてください。知っている人は資金を使えます。紛失しても代わりに復元できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "비밀 문구를 오프라인에서 적어 보관하세요. 문구를 아는 사람은 자금을 사용할 수 있습니다. 분실하면 대신 복구할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Catat frasa rahsia di luar talian. Sesiapa yang memilikinya boleh membelanjakan dana anda. Kami tidak dapat memulihkannya untuk anda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schrijf uw geheime zin offline op. Iedereen die deze kent kan uw geld uitgeven. Wij kunnen de zin niet voor u herstellen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisz tajną frazę offline. Każdy, kto ją zna, może wydać Twoje środki. Nie można jej odzyskać za Ciebie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Anote sua frase secreta offline. Quem a possui pode gastar seus fundos. Não é possível recuperá-la para você."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Notați fraza secretă offline. Oricine o deține poate cheltui fondurile. Nu o putem recupera pentru dvs."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишите секретную фразу офлайн. Любой, кто её знает, может потратить ваши средства. Мы не можем восстановить её за вас."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Andika maneno yako ya siri nje ya mtandao. Yeyote mwenye maneno hayo anaweza kutumia fedha zako. Hatuwezi kuyarejesha kwa ajili yako."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จดวลีลับไว้ออฟไลน์ ผู้ที่มีวลีนี้สามารถใช้เงินของคุณได้ เราไม่สามารถกู้คืนให้คุณได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli ifadenizi çevrimdışı yazın. Ona sahip olan herkes paranızı harcayabilir. Sizin için kurtarılamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запишіть секретну фразу офлайн. Кожен, хто її має, може витратити ваші кошти. Ми не можемо відновити її за вас."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "خفیہ عبارت آف لائن لکھیں۔ جس کے پاس یہ ہو وہ آپ کی رقم خرچ کر سکتا ہے۔ ہم اسے آپ کے لیے بحال نہیں کر سکتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi cụm từ bí mật ngoại tuyến. Ai có cụm từ này đều có thể chi tiêu tiền của bạn. Chúng tôi không thể khôi phục giúp bạn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请离线抄写并保管助记词，掌握它的人可以支出你的资产。丢失后无法找回。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請離線抄寫並保管助記詞，掌握它的人可以支出你的資產。遺失後無法找回。"
          }
        }
      }
    },
    "cold_wallet_broadcast_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "التوقيع مطابق للطلب الأصلي. البث ينفق من المحفظة الباردة المرتبطة بهذه المحفظة المراقبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বাক্ষর মূল অনুরোধের সঙ্গে মিলেছে। সম্প্রচার এই পর্যবেক্ষকের কোল্ড ওয়ালেট থেকে অর্থ খরচ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis odpovídá původní žádosti. Odesláním se utratí prostředky přidružené studené peněženky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Underskriften matcher den oprindelige anmodning. Udsendelse bruger midler fra observatørens tilknyttede kolde tegnebog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Signatur entspricht der ursprünglichen Anfrage. Die Übertragung gibt Guthaben der zugehörigen Cold-Wallet aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The signature and original request have been matched. Broadcast spends from this observer's cold wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma coincide con la solicitud original. Transmitir gasta fondos del monedero frío asociado a este observador."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "امضا با درخواست اصلی مطابقت دارد. انتشار، وجه کیف پول سرد مرتبط با این ناظر را خرج می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tugma ang pirma sa orihinal na kahilingan. Gagastos ang broadcast mula sa malamig na wallet na kaugnay ng observer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La signature correspond à la demande originale. La diffusion dépense les fonds du portefeuille froid associé à cet observateur."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sa hannu ya dace da buƙatar asali. Watsawa tana kashe kuɗin walat sanyi da aka haɗa da wannan mai lura."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החתימה תואמת לבקשה המקורית. השידור מוציא כספים מהארנק הקר המשויך לצופה זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हस्ताक्षर मूल अनुरोध से मेल खाता है। प्रसारण इस पर्यवेक्षक से जुड़े कोल्ड वॉलेट का धन खर्च करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tanda tangan cocok dengan permintaan asli. Penyiaran menggunakan dana dompet dingin yang terhubung dengan pengamat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La firma corrisponde alla richiesta originale. La trasmissione spende fondi del portafoglio freddo associato all’osservatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名は元のリクエストと一致しています。配信すると、この監視ウォレットに対応するコールドウォレットから支払われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명이 원래 요청과 일치합니다. 브로드캐스트하면 이 관찰 지갑에 연결된 콜드 지갑의 자금을 사용합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tandatangan sepadan dengan permintaan asal. Penyiaran menggunakan dana dompet sejuk yang dikaitkan dengan pemerhati ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De handtekening komt overeen met het oorspronkelijke verzoek. Uitzenden besteedt geld van de bijbehorende coldwallet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpis pasuje do pierwotnego żądania. Rozgłoszenie wydaje środki zimnego portfela powiązanego z obserwatorem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A assinatura corresponde à solicitação original. A transmissão gasta fundos da carteira fria associada ao observador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Semnătura corespunde cererii originale. Difuzarea cheltuie fonduri din portofelul rece asociat observatorului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подпись соответствует исходному запросу. Отправка расходует средства холодного кошелька, связанного с наблюдателем."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Saini inalingana na ombi la awali. Kutangaza hutumia fedha za pochi baridi inayohusishwa na mtazamaji huyu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ลายเซ็นตรงกับคำขอเดิม การเผยแพร่จะใช้เงินจากกระเป๋าเย็นที่ผูกกับกระเป๋าเฝ้าดูนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İmza, ilk taleple eşleşti. Yayınlama gözlemciye bağlı soğuk cüzdandan harcama yapar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Підпис відповідає початковому запиту. Надсилання витрачає кошти холодного гаманця, пов’язаного зі спостерігачем."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دستخط اصل درخواست سے ملتے ہیں۔ نشر کرنے سے اس نگران سے منسلک کولڈ والیٹ کی رقم خرچ ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chữ ký khớp với yêu cầu ban đầu. Phát giao dịch sẽ chi tiền từ ví lạnh gắn với ví theo dõi này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名已与原始请求匹配，广播将支出此观察钱包对应的冷钱包资金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽名已與原始請求匹配，廣播將支出此觀察錢包對應的冷錢包資金。"
          }
        }
      }
    },
    "cold_wallet_broadcast_retry": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتيجة البث غير معروفة. إعادة المحاولة ترسل المعاملة نفسها؛ لا تنشئ دفعة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্প্রচারের ফল জানা যায়নি। আবার চেষ্টা করলে একই লেনদেন পাঠায়; অন্য অর্থপ্রদান তৈরি করবেন না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledek odeslání není znám. Opakování odešle stejnou transakci; nevytvářejte další platbu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet af udsendelsen er ukendt. Prøv igen med samme transaktion; opret ikke en ny betaling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Übertragungsergebnis unbekannt. Erneut versuchen sendet dieselbe Transaktion. Keine weitere Zahlung erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadcast outcome is unknown. Retrying submits the same transaction; do not create another payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado es desconocido. Reintentar envía la misma transacción; no cree otro pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجه انتشار نامشخص است. تلاش دوباره همان تراکنش را می‌فرستد؛ پرداخت دیگری ایجاد نکنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa alam ang resulta ng broadcast. Ipapadala ng muling pagsubok ang parehong transaksiyon; huwag gumawa ng ibang pagbabayad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la diffusion est inconnu. Réessayer envoie la même transaction. Ne créez pas un autre paiement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a san sakamakon watsawa ba. Sake gwadawa yana aika ma’amala ɗaya; kar ka ƙirƙiri wani biyan kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוצאת השידור אינה ידועה. ניסיון חוזר שולח אותה עסקה; אל תיצרו תשלום נוסף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रसारण का परिणाम अज्ञात है। पुनः प्रयास वही लेनदेन भेजता है; दूसरा भुगतान न बनाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil penyiaran belum diketahui. Percobaan ulang mengirim transaksi yang sama; jangan buat pembayaran lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Esito della trasmissione sconosciuto. Riprova con la stessa transazione; non creare un altro pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "配信結果は未確認です。再試行は同じ取引を送信します。別の支払いを作成しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "브로드캐스트 결과가 확인되지 않았습니다. 재시도는 같은 거래를 제출합니다. 다른 결제를 만들지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil penyiaran belum diketahui. Cuba semula menghantar transaksi yang sama; jangan cipta pembayaran lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitkomst van de uitzending onbekend. Opnieuw proberen verzendt dezelfde transactie; maak geen nieuwe betaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik rozgłoszenia nieznany. Ponowna próba wysyła tę samą transakcję; nie twórz nowej płatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultado da transmissão desconhecido. Tentar novamente envia a mesma transação; não crie outro pagamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatul difuzării este necunoscut. Reîncercarea trimite aceeași tranzacție; nu creați altă plată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат отправки неизвестен. Повторная попытка отправляет ту же транзакцию; не создавайте новый платёж."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Matokeo ya kutangaza hayajulikani. Kujaribu tena hutuma muamala huohuo; usiunde malipo mengine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่ทราบผลการเผยแพร่ การลองใหม่ส่งธุรกรรมเดิม อย่าสร้างการชำระเงินอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınlama sonucu bilinmiyor. Yeniden denemek aynı işlemi gönderir; başka ödeme oluşturmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат надсилання невідомий. Повторна спроба надсилає ту саму транзакцію; не створюйте новий платіж."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نشر کا نتیجہ نامعلوم ہے۔ دوبارہ کوشش وہی لین دین بھیجتی ہے؛ دوسری ادائیگی نہ بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa xác định kết quả phát giao dịch. Thử lại gửi cùng giao dịch; không tạo thanh toán khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广播结果尚未确认。重试提交的是同一笔交易，请勿重新创建付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "廣播結果尚未確認。重試提交的是同一筆交易，請勿重新建立付款。"
          }
        }
      }
    },
    "cold_wallet_broadcast_storage_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بث المعاملة، لكن تعذر حفظ حالتها محليًا. احتفظ بمعرّف المعاملة وتحقق منها قبل إنشاء دفعة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেন সম্প্রচার হয়েছে, কিন্তু স্থানীয়ভাবে এর অবস্থা সংরক্ষণ করা যায়নি। এই লেনদেনের আইডি রাখুন এবং আরেকটি পেমেন্ট করার আগে তা যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce byla odeslána, ale její stav se nepodařilo uložit místně. Uchovejte si ID transakce a před vytvořením další platby ji zkontrolujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen er sendt, men dens status kunne ikke gemmes lokalt. Gem dette transaktions-id, og kontrollér transaktionen, før du opretter en ny betaling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktion gesendet. Ihr Status konnte nicht lokal gespeichert werden. Bewahre diese Transaktions-ID auf und prüfe die Transaktion, bevor du eine weitere Zahlung erstellst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction broadcast. Saving its local status failed. Keep this transaction ID and check it before creating another payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Transacción enviada. No se pudo guardar su estado localmente. Conserva este ID de transacción y compruébala antes de crear otro pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش منتشر شد، اما ذخیره وضعیت آن در دستگاه انجام نشد. این شناسه تراکنش را نگه دارید و پیش از ایجاد پرداختی دیگر، تراکنش را بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-broadcast ang transaksyon, pero hindi na-save ang lokal na status nito. Itabi ang transaction ID na ito at suriin ang transaksyon bago gumawa ng panibagong pagbabayad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaction diffusée. Son état n’a pas pu être enregistré localement. Conservez cet identifiant de transaction et vérifiez la transaction avant de créer un autre paiement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An aika ma’amala, amma ba a iya adana matsayinta a na’urar ba. Ajiye wannan ID na ma’amala, sannan a duba ma’amalar kafin ƙirƙirar wani biyan kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה שודרה, אך שמירת המצב שלה במכשיר נכשלה. יש לשמור את מזהה העסקה ולבדוק אותה לפני יצירת תשלום נוסף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेनदेन प्रसारित हो गया, लेकिन उसकी स्थिति डिवाइस पर सहेजी नहीं जा सकी। इस लेनदेन की आईडी रखें और दूसरा भुगतान करने से पहले इसकी जाँच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi telah disiarkan, tetapi statusnya gagal disimpan secara lokal. Simpan ID transaksi ini dan periksa transaksinya sebelum membuat pembayaran lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Transazione trasmessa. Non è stato possibile salvarne lo stato in locale. Conserva questo ID transazione e verifica la transazione prima di creare un altro pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "取引を送信しましたが、端末内に状態を保存できませんでした。この取引 ID を保管し、次の支払いを作成する前に取引を確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "거래를 전송했지만 기기에 상태를 저장하지 못했습니다. 이 거래 ID를 보관하고 새 결제를 만들기 전에 거래를 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi telah disiarkan, tetapi statusnya gagal disimpan secara setempat. Simpan ID transaksi ini dan semak transaksi sebelum membuat pembayaran lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transactie verzonden. De status kon niet lokaal worden opgeslagen. Bewaar deze transactie-ID en controleer de transactie voordat je een nieuwe betaling maakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja została rozgłoszona, ale nie udało się zapisać jej stanu lokalnie. Zachowaj identyfikator transakcji i sprawdź ją przed utworzeniem kolejnej płatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Transação transmitida. Não foi possível salvar seu status localmente. Guarde este ID de transação e confira a transação antes de criar outro pagamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacția a fost transmisă, dar starea ei nu a putut fi salvată local. Păstrează acest ID de tranzacție și verifică tranzacția înainte de a crea o altă plată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция отправлена, но не удалось сохранить её статус на устройстве. Сохраните ID транзакции и проверьте её перед созданием нового платежа."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala umetumwa, lakini hali yake haikuweza kuhifadhiwa kwenye kifaa. Hifadhi kitambulisho hiki cha muamala na uukague kabla ya kuunda malipo mengine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งธุรกรรมแล้ว แต่บันทึกสถานะลงในเครื่องไม่สำเร็จ โปรดเก็บรหัสธุรกรรมนี้ไว้และตรวจสอบธุรกรรมก่อนสร้างการชำระเงินใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem yayınlandı ancak durumu cihaza kaydedilemedi. Bu işlem kimliğini saklayın ve yeni bir ödeme oluşturmadan önce işlemi kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію надіслано, але не вдалося зберегти її стан на пристрої. Збережіть ID транзакції та перевірте її, перш ніж створювати новий платіж."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانزیکشن نشر ہو گئی، لیکن اس کی حالت مقامی طور پر محفوظ نہیں ہو سکی۔ اس ٹرانزیکشن کی آئی ڈی محفوظ رکھیں اور دوسری ادائیگی بنانے سے پہلے اسے چیک کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đã được phát đi nhưng không thể lưu trạng thái trên thiết bị. Hãy giữ mã giao dịch này và kiểm tra giao dịch trước khi tạo khoản thanh toán khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已广播，但本地状态保存失败。请保留交易 ID，核对后再创建新付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已廣播，但本機狀態儲存失敗。請保留交易 ID，核對後再建立新付款。"
          }
        }
      }
    },
