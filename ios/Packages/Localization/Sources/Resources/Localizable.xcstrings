    "multisig_local_review_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتحقّق هذا الجهاز من الإعدادات العامة. تحقّق بنفسك من جميع مفاتيح الأعضاء وحد التوقيعات قبل التأكيد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে প্রকাশ্য কনফিগারেশন যাচাই হয়নি। নিশ্চিত করার আগে সব সদস্যের কী ও প্রয়োজনীয় স্বাক্ষরের সংখ্যা নিজে যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto zařízení neověřilo veřejnou konfiguraci. Před potvrzením nezávisle zkontrolujte všechny klíče členů a požadovaný počet podpisů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne enhed har ikke verificeret den offentlige konfiguration. Kontrollér alle medlemsnøgler og underskriftstærsklen uafhængigt, før du bekræfter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dieses Gerät hat die öffentliche Konfiguration noch nicht geprüft. Prüfe alle Mitgliedsschlüssel und die Signaturschwelle unabhängig, bevor du bestätigst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device has not verified the public configuration. Independently check all member keys and the signing threshold before confirming."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo no ha verificado la configuración pública. Comprueba de forma independiente todas las claves de los miembros y el umbral de firmas antes de confirmar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این دستگاه پیکربندی عمومی را بررسی نکرده است. پیش از تأیید، همهٔ کلیدهای اعضا و حد نصاب امضا را مستقل بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa nasusuri sa device na ito ang pampublikong configuration. Suriin nang hiwalay ang lahat ng susi ng miyembro at bilang ng lagda bago kumpirmahin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cet appareil n’a pas vérifié la configuration publique. Vérifiez indépendamment toutes les clés des membres et le seuil de signatures avant de confirmer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan na’ura ba ta tantance tsarin jama’a ba. Duba duk maɓallan mambobi da adadin sa hannun da kanka kafin tabbatarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המכשיר הזה לא אימת את התצורה הציבורית. לפני האישור יש לבדוק באופן עצמאי את כל מפתחות החברים ואת סף החתימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस ने सार्वजनिक कॉन्फ़िगरेशन सत्यापित नहीं किया है। पुष्टि से पहले सभी सदस्यों की कुंजियाँ और ज़रूरी हस्ताक्षरों की संख्या स्वतंत्र रूप से जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Perangkat ini belum memverifikasi konfigurasi publik. Periksa sendiri semua kunci anggota dan ambang tanda tangan sebelum mengonfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo dispositivo non ha verificato la configurazione pubblica. Controlla autonomamente tutte le chiavi dei membri e la soglia di firme prima di confermare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末では公開設定が未確認です。すべてのメンバーの公開鍵と必要署名数を独立して確認してから承認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기는 공개 구성을 확인하지 않았습니다. 승인하기 전에 모든 구성원 공개 키와 필요 서명 수를 독립적으로 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peranti ini belum mengesahkan konfigurasi awam. Semak sendiri semua kunci ahli dan ambang tandatangan sebelum mengesahkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit apparaat heeft de openbare configuratie nog niet geverifieerd. Controleer alle sleutels van de leden en het vereiste aantal handtekeningen onafhankelijk voordat je bevestigt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To urządzenie nie zweryfikowało konfiguracji publicznej. Przed potwierdzeniem niezależnie sprawdź wszystkie klucze członków i próg podpisów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este dispositivo não verificou a configuração pública. Confira de forma independente todas as chaves dos membros e o mínimo de assinaturas antes de confirmar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acest dispozitiv nu a verificat configurația publică. Verifică independent toate cheile membrilor și pragul de semnături înainte de confirmare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это устройство ещё не проверило открытую конфигурацию. Перед подтверждением независимо проверьте все ключи участников и порог подписей."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kifaa hiki hakijahakiki usanidi wa umma. Hakiki mwenyewe funguo zote za wanachama na kiwango cha saini kabla ya kuthibitisha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อุปกรณ์นี้ยังไม่ได้ตรวจสอบการตั้งค่าสาธารณะ โปรดตรวจสอบคีย์สมาชิกทั้งหมดและเกณฑ์จำนวนลายเซ็นด้วยตนเองก่อนยืนยัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihaz açık yapılandırmayı doğrulamadı. Onaylamadan önce tüm üye anahtarlarını ve imza eşiğini bağımsız olarak kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Цей пристрій не перевірив публічну конфігурацію. Перед підтвердженням незалежно перевірте всі ключі учасників і поріг підписів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس ڈیوائس نے عوامی ترتیب کی تصدیق نہیں کی۔ منظوری سے پہلے تمام اراکین کی کلیدیں اور دستخط کی مطلوبہ حد خود جانچیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này chưa xác minh cấu hình công khai. Tự kiểm tra mọi khóa thành viên và ngưỡng chữ ký trước khi xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此设备尚未核对公开配置。请独立核对全部成员公钥及签名门槛后确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此裝置尚未核對公開配置。請獨立核對全部成員公鑰及簽名門檻後確認。"
          }
        }
      }
    },
