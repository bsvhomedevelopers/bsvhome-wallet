    "wowpay_import_watch_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عنوان محفظة على الشبكة المحددة لمراقبتها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্বাচিত নেটওয়ার্কের একটি ওয়ালেট ঠিকানা লিখুন, শুধু দেখার জন্য"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte adresu peněženky ve vybrané síti pro její sledování"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast en tegnebogsadresse på det valgte netværk for at overvåge den"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie eine Wallet-Adresse im gewählten Netzwerk zur Beobachtung ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a wallet address for the selected network to watch it"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce una dirección de billetera en la red seleccionada para observarla"
