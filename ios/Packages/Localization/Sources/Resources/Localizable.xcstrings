    "multisig_proposal_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إنشاء مقترح لا يرسل الأموال. يراجع الأعضاء ويوقّعون كلٌ على حدة، ويلزم بلوغ حد التوقيعات قبل البث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রস্তাব তৈরি করলে অর্থ পাঠানো হয় না। সদস্যরা আলাদাভাবে যাচাই ও স্বাক্ষর করেন; নেটওয়ার্কে পাঠানোর আগে প্রয়োজনীয় স্বাক্ষরের সংখ্যা পূরণ হতে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vytvoření návrhu neodesílá prostředky. Členové ověřují a podepisují samostatně; před odesláním do sítě musí být dosažen požadovaný počet podpisů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Et forslag sender ikke midler. Medlemmerne gennemgår og underskriver hver for sig; tærsklen skal nås før udsendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Vorschlag sendet noch kein Geld. Mitglieder prüfen und unterschreiben einzeln; vor der Übermittlung muss die Signaturschwelle erreicht sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Creating a proposal does not send funds. Members review and sign separately; the threshold must be reached before broadcast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Crear una propuesta no envía fondos. Cada miembro revisa y firma por separado; debe alcanzarse el umbral antes de transmitir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ساخت پیشنهاد دارایی را ارسال نمی‌کند. اعضا جداگانه بررسی و امضا می‌کنند؛ پیش از انتشار باید حد نصاب امضا تأمین شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi nagpapadala ng pondo ang paggawa ng panukala. Hiwalay na nagsusuri at pumipirma ang mga miyembro; kailangang kumpleto ang kinakailangang lagda bago ipadala sa network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Créer une proposition n’envoie pas de fonds. Chaque membre vérifie et signe séparément ; le seuil doit être atteint avant la diffusion."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙirƙirar shawara ba ta aika kuɗi. Mambobi suna dubawa da sa hannu daban-daban; sai an cika adadin sa hannu kafin watsawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יצירת הצעה אינה שולחת כספים. החברים בודקים וחותמים בנפרד; לפני השידור חייבים להגיע לסף החתימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रस्ताव बनाने से राशि नहीं भेजी जाती। सदस्य अलग-अलग जाँच और हस्ताक्षर करते हैं; नेटवर्क पर भेजने से पहले ज़रूरी संख्या में हस्ताक्षर चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Membuat usulan tidak mengirim dana. Anggota memeriksa dan menandatangani secara terpisah; ambang harus tercapai sebelum penyiaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Creare una proposta non invia fondi. Ogni membro verifica e firma separatamente; la soglia deve essere raggiunta prima della trasmissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "提案を作成しても送金されません。各メンバーが個別に確認して署名し、必要数が揃ってから送信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제안을 만들어도 자금이 전송되지 않습니다. 구성원이 각자 확인하고 서명하며, 필요 서명 수를 채운 뒤 전송할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Mencipta cadangan tidak menghantar dana. Ahli menyemak dan menandatangani secara berasingan; ambang mesti dicapai sebelum siaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een voorstel maken verzendt geen geld. Leden controleren en ondertekenen apart; pas met voldoende handtekeningen kan worden verzonden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Utworzenie propozycji nie wysyła środków. Członkowie sprawdzają i podpisują osobno; przed rozgłoszeniem trzeba osiągnąć próg."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Criar uma proposta não envia fundos. Os membros verificam e assinam separadamente; o limite deve ser atingido antes da transmissão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Crearea propunerii nu trimite fonduri. Membrii verifică și semnează separat; pragul trebuie atins înainte de difuzare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создание предложения не отправляет средства. Участники проверяют и подписывают отдельно; перед отправкой в сеть нужно достичь порога."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuunda pendekezo hakutumi fedha. Wanachama wanahakiki na kusaini tofauti; kiwango lazima kifikiwe kabla ya kutangaza."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสร้างข้อเสนอไม่ส่งเงิน สมาชิกตรวจสอบและลงนามแยกกัน ต้องมีลายเซ็นครบตามเกณฑ์ก่อนส่งธุรกรรม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Öneri oluşturmak fon göndermez. Üyeler ayrı ayrı doğrular ve imzalar; yayınlama öncesi eşik sağlanmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Створення пропозиції не надсилає кошти. Учасники перевіряють і підписують окремо; до надсилання в мережу потрібно досягти порогу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تجویز بنانے سے رقم نہیں جاتی۔ اراکین الگ الگ جانچ اور دستخط کرتے ہیں؛ نشر کرنے سے پہلے مطلوبہ حد پوری ہونی چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạo đề xuất chưa chuyển tiền. Mỗi người kiểm tra và ký riêng; phải đủ ngưỡng chữ ký mới phát lên mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发起提案不会立即转账。成员分别核对并签名，达到门槛后才能广播。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "發起提案不會立即轉賬。成員分別核對並簽名，達到門檻後才能廣播。"
          }
        }
      }
    },
