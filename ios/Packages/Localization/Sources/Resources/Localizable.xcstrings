    "rewards.create_referral_code.info": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيكون هذا هو اسمك المستعار الشخصي للمحفظة الحالية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এটি আপনার বর্তমান ওয়ালেটের ব্যক্তিগত ডাকনাম হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto bude vaše osobní přezdívka pro aktuální peněženku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette vil være dit personlige kaldenavn for den nuværende tegnebog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies wird Ihr persönlicher Spitzname für die aktuelle Wallet sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This will be your personal nickname for the current wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Este será tu apodo personal para la billetera actual."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این نام مستعار شخصی شما برای کیف پول فعلی خواهد بود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ito ang magiging personal mong palayaw para sa kasalukuyang wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ce sera le surnom personnel que vous donnerez à votre portefeuille actuel."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan zai zama sunan barkwancinka na sirri don walat ɗin da ke yanzu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זה יהיה הכינוי האישי שלך לארנק הנוכחי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह आपके वर्तमान वॉलेट के लिए आपका व्यक्तिगत उपनाम होगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menjadi nama panggilan pribadi Anda untuk dompet saat ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo sarà il tuo soprannome personale per il portafoglio attuale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは現在のウォレットの個人的なニックネームになります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 현재 지갑에 사용할 개인 별명입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini akan menjadi nama panggilan peribadi anda untuk dompet semasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit wordt je persoonlijke bijnaam voor de huidige portemonnee."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To będzie Twój osobisty pseudonim dla obecnego portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Este será o seu apelido pessoal para a carteira atual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Aceasta va fi porecla ta personală pentru portofelul curent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это будет ваш никнейм для текущего кошелька."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hili litakuwa jina lako la utani la pochi ya sasa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่จะเป็นชื่อเล่นส่วนตัวของคุณสำหรับกระเป๋าเงินดิจิทัลปัจจุบัน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu, mevcut cüzdanınız için kullanacağınız kişisel takma adınız olacak."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це буде ваш особистий псевдонім для поточного гаманця."
