          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این دستگاه را از شبکه قطع کردم"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nadiskonekta ko na ang device"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai déconnecté cet appareil"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na katse haɗin wannan na’ura"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ניתקתי את המכשיר מהרשת"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने डिवाइस का नेटवर्क कनेक्शन बंद कर दिया है"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah memutus koneksi perangkat ini"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho disconnesso il dispositivo"
          }
