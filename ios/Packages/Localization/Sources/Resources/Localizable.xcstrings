    "wowpay_import_phrase_security_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل عبارة الاسترداد في مكان خاص. لا تشاركها مع أي شخص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্জন স্থানে পুনরুদ্ধার বাক্যাংশ লিখুন। এটি কখনো কারও সঙ্গে শেয়ার করবেন না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Obnovovací frázi zadávejte v soukromí. Nikomu ji nesdělujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast din gendannelsesfrase et privat sted. Del den aldrig med andre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihre Wiederherstellungsphrase an einem ungestörten Ort ein. Geben Sie sie niemals an andere weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your recovery phrase in a private place. Never share it with anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu frase de recuperación en un lugar privado. No la compartas con nadie."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عبارت بازیابی خود را در مکانی خصوصی وارد کنید. هرگز آن را با کسی به اشتراک نگذارید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang recovery phrase sa pribadong lugar. Huwag itong ibahagi kaninuman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre phrase de récupération à l'abri des regards. Ne la partagez jamais."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku shigar da kalmomin dawo da walat ɗinku a keɓantaccen wuri. Kada ku taɓa raba su da kowa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו את ביטוי השחזור במקום פרטי. לעולם אל תשתפו אותו עם אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपना रिकवरी फ़्रेज़ निजी स्थान पर दर्ज करें। इसे किसी के साथ साझा न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan frasa pemulihan di tempat yang tidak terlihat orang lain. Jangan pernah membagikannya kepada siapa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la frase di recupero in un luogo privato. Non condividerla mai con nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リカバリーフレーズは人目につかない場所で入力し、誰にも共有しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 문구는 다른 사람이 볼 수 없는 곳에서 입력하세요. 누구에게도 공유하지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan frasa pemulihan di tempat yang tidak dapat dilihat orang lain. Jangan sesekali kongsikannya dengan sesiapa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je herstelzin op een privéplek in. Deel deze nooit met anderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz frazę odzyskiwania w miejscu zapewniającym prywatność. Nigdy nikomu jej nie udostępniaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua frase de recuperação em um local privado. Nunca a compartilhe com ninguém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu fraza secretă într-un loc ferit de priviri. Nu o divulga nimănui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводите секретную фразу в уединённом месте. Никому её не сообщайте."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka kifungu cha siri mahali pa faragha. Usikishiriki na mtu yeyote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนวลีลับในที่เป็นส่วนตัว ห้ามเปิดเผยให้ผู้อื่นทราบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gizli ifadeyi kimsenin görmeyeceği bir yerde girin. Kimseyle paylaşmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводьте секретну фразу в усамітненому місці. Нікому її не повідомляйте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بحالی کا جملہ کسی نجی جگہ پر درج کریں۔ اسے کسی کو نہ بتائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập cụm từ khôi phục ở nơi riêng tư. Không chia sẻ với bất kỳ ai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在安全环境中输入助记词，切勿向他人透露。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在安全環境中輸入助記詞，切勿向他人透露。"
          }
        }
      }
    },
    "wowpay_import_phrase_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل 12 أو 15 أو 18 أو 21 أو 24 كلمة استرداد، مع فصل الكلمات بمسافات"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "১২, ১৫, ১৮, ২১ বা ২৪টি পুনরুদ্ধারের শব্দ লিখুন; প্রতিটি শব্দের মাঝে স্পেস দিন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte 12, 15, 18, 21 nebo 24 slov obnovovací fráze oddělených mezerami"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast 12, 15, 18, 21 eller 24 gendannelsesord adskilt af mellemrum"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie 12, 15, 18, 21 oder 24 Wiederherstellungswörter mit Leerzeichen dazwischen ein"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter 12, 15, 18, 21, or 24 recovery words separated by spaces"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce 12, 15, 18, 21 o 24 palabras de recuperación separadas por espacios"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "۱۲، ۱۵، ۱۸، ۲۱ یا ۲۴ کلمهٔ بازیابی را با فاصله از هم وارد کنید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang 12, 15, 18, 21, o 24 na salita ng recovery phrase na pinaghihiwalay ng espasyo"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez 12, 15, 18, 21 ou 24 mots de récupération séparés par des espaces"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shigar da kalmomi 12, 15, 18, 21 ko 24 na dawo da walat, ku raba kowace da tazara"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו 12, 15, 18, 21 או 24 מילות שחזור, עם רווח בין המילים"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "रिकवरी फ़्रेज़ के 12, 15, 18, 21 या 24 शब्द स्पेस से अलग करके दर्ज करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan 12, 15, 18, 21, atau 24 kata pemulihan yang dipisahkan spasi"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci 12, 15, 18, 21 o 24 parole di recupero separate da spazi"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "12、15、18、21、24語のリカバリーフレーズをスペースで区切って入力してください"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "12, 15, 18, 21 또는 24개 단어로 된 복구 문구를 공백으로 구분해 입력하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan 12, 15, 18, 21 atau 24 perkataan pemulihan yang dipisahkan dengan ruang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer 12, 15, 18, 21 of 24 herstelwoorden in, gescheiden door spaties"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz 12, 15, 18, 21 lub 24 słowa frazy odzyskiwania, oddzielając je spacjami"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite 12, 15, 18, 21 ou 24 palavras de recuperação separadas por espaços"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu 12, 15, 18, 21 sau 24 de cuvinte, separate prin spații"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите секретную фразу выбранной длины (12, 15, 18, 21 или 24), разделяя слова пробелами"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka kifungu cha siri chenye maneno 12, 15, 18, 21 au 24; tenganisha maneno kwa nafasi"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนวลีลับ 12, 15, 18, 21 หรือ 24 คำ โดยเว้นวรรคแต่ละคำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "12, 15, 18, 21 veya 24 kelimelik gizli ifadeyi, kelimeleri boşlukla ayırarak girin"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Введіть секретну фразу з 12, 15, 18, 21 або 24 слів, розділяючи слова пробілами"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "12، 15، 18، 21 یا 24 الفاظ درج کریں، ہر لفظ کے درمیان فاصلہ رکھیں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập 12, 15, 18, 21 hoặc 24 từ, cách nhau bằng dấu cách"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "输入 12、15、18、21 或 24 个助记词，用空格分隔"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "輸入 12、15、18、21 或 24 個助記詞，使用空格分隔"
          }
        }
      }
    },
