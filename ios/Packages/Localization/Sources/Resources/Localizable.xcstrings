    "rewards.invite_friends.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يكسب %@ نقاط لكل صديق ينضم."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আয় করুন %@ যোগদানকারী প্রতিটি বন্ধুর জন্য পয়েন্ট।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Získejte %@ bodů za každého přítele, který se připojí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Optjen %@ point for hver ven, der tilmelder sig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdienen %@ Punkte für jeden geworbenen Freund."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Earn %@ points for each friend who joins."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganar %@ puntos por cada amigo que se una."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کسب درآمد %@ امتیاز برای هر دوستی که عضو می‌شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumita %@ puntos para sa bawat kaibigang sasali."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gagner %@ Des points pour chaque ami qui s'inscrit."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sami %@ maki ga kowane aboki da ya shiga."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לִזכּוֹת %@ נקודות לכל חבר שמצטרף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कमाना %@ जितने दोस्त जुड़ेंगे, उतने ही पॉइंट्स मिलेंगे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghasilkan %@ poin untuk setiap teman yang bergabung."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagnare %@ punti per ogni amico che si iscrive."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "友達が1人参加するごとに、%@ ポイントを獲得できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "벌다 %@ 친구가 가입할 때마다 포인트를 획득합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan %@ mata untuk setiap rakan yang menyertai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdienen %@ punten voor elke vriend die meedoet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zarabiaj %@ punktów za każdego dołączonego znajomego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhar %@ Pontos para cada amigo que se inscrever."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câştiga %@ puncte pentru fiecare prieten care se alătură."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарабатывай %@ баллов за каждого друга, который присоединится."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pata %@ pointi kwa kila rafiki anayejiunga."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ได้รับ %@ รับคะแนนสะสมสำหรับเพื่อนแต่ละคนที่เข้าร่วม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para kazanmak %@ Katılan her arkadaş için puan kazanacaksınız."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Отримуйте %@ балів за кожного друга, який долучиться."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کمائیں %@ شامل ہونے والے ہر دوست کے لیے پوائنٹس۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiếm %@ Điểm thưởng cho mỗi người bạn tham gia."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "每邀请一位好友加入，即可赚取 %@ 积分。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "每邀請一位好友加入，即可獲得 %@ 積分。"
          }
        }
      }
    },
