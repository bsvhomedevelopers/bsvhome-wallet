          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail a renvoyé des données non valides. Actualisez et réessayez."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail ya dawo da bayanai marasa inganci. Sabunta kuma ka sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail החזיר נתונים לא תקינים. יש לרענן ולנסות שוב."
