    "paymail_disable_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيبقى اسمك محجوزًا لك. سيُعلَّق البحث العام عن عنوان الدفع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার নাম সংরক্ষিত থাকবে। সর্বজনীন পেমেন্ট ঠিকানা খোঁজা সাময়িকভাবে বন্ধ থাকবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vaše jméno zůstane rezervováno. Veřejné vyhledávání platební adresy bude pozastaveno."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit navn forbliver reserveret. Offentligt opslag af betalingsadressen sættes på pause."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dein Name bleibt reserviert. Die öffentliche Abfrage der Zahlungsadresse wird pausiert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your name stays reserved. Public payment lookup will be paused."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tu nombre seguirá reservado. La consulta pública de la dirección de pago se pausará."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نام شما همچنان محفوظ می‌ماند. جست‌وجوی عمومی نشانی پرداخت موقتاً متوقف می‌شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mananatiling nakalaan sa iyo ang pangalan. Pansamantalang ihihinto ang pampublikong paghahanap ng address para sa pagbabayad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Votre nom reste réservé. La recherche publique de l’adresse de paiement sera suspendue."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sunanka zai ci gaba da kasancewa naka. Za a dakatar da gano adireshin biyan kuɗi ga jama’a."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השם שלך יישאר שמור. חיפוש ציבורי של יעד התשלום יושהה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपका नाम आरक्षित रहेगा। सार्वजनिक भुगतान पता खोज रोक दी जाएगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama Anda tetap dicadangkan. Pencarian alamat pembayaran publik akan dijeda."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il tuo nome rimane riservato. La ricerca pubblica dell’indirizzo di pagamento verrà sospesa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "名前の所有権は維持されます。公開の支払い先検索は一時停止されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이름은 계속 보유됩니다. 공개 결제 수신 주소 조회는 일시 중지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nama anda kekal dikhaskan. Carian alamat pembayaran awam akan dijeda."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je naam blijft gereserveerd. Het openbaar opzoeken van het betaaladres wordt gepauzeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoja nazwa pozostanie zarezerwowana. Publiczne wyszukiwanie adresu płatności zostanie wstrzymane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seu nome continuará reservado. A consulta pública do endereço de pagamento será pausada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Numele tău rămâne rezervat. Căutarea publică a adresei de plată va fi suspendată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше имя останется закреплено за вами. Публичный поиск платёжного адреса будет приостановлен."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jina lako litaendelea kuhifadhiwa. Utafutaji wa anwani ya malipo kwa umma utasitishwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ชื่อของคุณยังคงสงวนไว้ การค้นหาที่อยู่รับชำระเงินแบบสาธารณะจะหยุดชั่วคราว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Adınız size ayrılmış olarak kalır. Herkese açık ödeme adresi sorgulaması duraklatılır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваше ім’я залишиться закріпленим за вами. Публічний пошук платіжної адреси буде призупинено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کا نام محفوظ رہے گا۔ عوامی ادائیگی کے پتے کی تلاش عارضی طور پر روک دی جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tên của bạn vẫn được giữ lại. Việc tra cứu địa chỉ thanh toán công khai sẽ tạm dừng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "名称仍归你所有，公开收款查询将暂停。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "名稱仍歸你所有，公開收款查詢將暫停。"
          }
        }
      }
    },
