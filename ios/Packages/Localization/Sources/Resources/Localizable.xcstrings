            "value": "送信前にすべての入力で異なるメンバーの署名が必要数に達する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송 전에 모든 입력에서 서로 다른 구성원의 서명이 필요한 수에 도달해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap input mesti mencapai ambang tandatangan daripada ahli berbeza sebelum siaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke invoer vereist voldoende handtekeningen van verschillende leden vóór verzending."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każde wejście musi osiągnąć próg podpisów różnych członków przed rozgłoszeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada entrada precisa atingir o limite de assinaturas de membros diferentes antes da transmissão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare intrare trebuie să atingă pragul de semnături de la membri diferiți înainte de difuzare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый вход должен достичь порога подписей разных участников перед отправкой в сеть."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila ingizo linahitaji kiwango cha saini kutoka wanachama tofauti kabla ya kutangaza."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกอินพุตต้องมีลายเซ็นของสมาชิกต่างคนครบตามเกณฑ์ก่อนส่งธุรกรรม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınlama öncesi her girdide farklı üyelerin imzaları eşiğe ulaşmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед надсиланням кожен вхід має досягти порогу підписів різних учасників."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نشر کرنے سے پہلے ہر ان پٹ پر مختلف اراکین کے دستخطوں کی حد پوری ہونی چاہیے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi đầu vào phải đạt ngưỡng chữ ký của các thành viên khác nhau trước khi phát giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "广播前，每个输入都需要达到不同成员的签名门槛。"
