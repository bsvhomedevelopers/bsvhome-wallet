        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دارایی هایی که اخیراً استفاده کرده اید در اینجا ظاهر می شوند"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
