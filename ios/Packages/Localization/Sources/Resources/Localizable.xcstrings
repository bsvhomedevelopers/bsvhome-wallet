    "banner.stake.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احصل على مكافآت %@ على حصتك أثناء نومك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনি যখন ঘুমান তখন আপনার বাজিতে %@ পুরষ্কার অর্জন করুন।"
