          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Touchez une carte pour changer. Les actions ci-dessous utilisent le portefeuille sélectionné."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Taɓa kati don sauyawa. Ayyukan da ke ƙasa suna amfani da walat ɗin da aka zaɓa."
