        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể hoàn tất yêu cầu (%@). Làm mới trạng thái hiện tại trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
