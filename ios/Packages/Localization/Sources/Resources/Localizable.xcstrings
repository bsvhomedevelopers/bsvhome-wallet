          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Trop de tentatives. Réessayez dans cinq minutes."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An yi ƙoƙari da yawa. A sake gwadawa bayan mintuna biyar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יותר מדי ניסיונות. נסו שוב בעוד חמש דקות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
