    "errors.network_offline": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يبدو أن الاتصال بالإنترنت غير متاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ইন্টারনেট সংযোগটি অফলাইন বলে মনে হচ্ছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdá se, že je internetové připojení offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Internetforbindelsen ser ud til at være offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Internetverbindung scheint unterbrochen zu sein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Internet connection appears to be offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La conexión a Internet parece estar fuera de línea."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به نظر می‌رسد اتصال اینترنت آفلاین است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mukhang offline ang koneksyon sa internet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La connexion Internet semble être hors ligne."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Da alama haɗin intanet ɗin ya katse."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נראה שחיבור האינטרנט אינו מקוון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इंटरनेट कनेक्शन ऑफ़लाइन प्रतीत हो रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Koneksi internet tampaknya sedang offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La connessione Internet risulta offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インターネット接続が切断されているようです。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "인터넷 연결이 끊긴 것 같습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sambungan Internet nampaknya di luar talian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De internetverbinding lijkt offline te zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Połączenie internetowe wydaje się być niedostępne."
          }
