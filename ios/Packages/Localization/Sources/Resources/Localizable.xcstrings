          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "حداکثر تعداد سکه‌هایی که تا به حال وجود خواهد داشت."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
