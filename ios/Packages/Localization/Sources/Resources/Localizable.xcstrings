    "cold_wallet_review_confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحققت من المستلم والمبلغ والرسوم والمبلغ المتبقي."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি প্রাপক, পরিমাণ, ফি ও ফেরত অর্থ যাচাই করেছি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřil jsem příjemce, částku, poplatek a vrácenou částku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har kontrolleret modtager, beløb, gebyr og byttepenge."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe Empfänger, Betrag, Gebühr und Wechselgeld geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have checked the recipient, amount, fee, and change."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He verificado destinatario, importe, comisión y cambio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "گیرنده، مبلغ، کارمزد و باقیمانده را بررسی کرده‌ام."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasuri ko ang tatanggap, halaga, bayarin at sukli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai vérifié le destinataire, le montant, les frais et la monnaie rendue."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tabbatar da mai karɓa, adadi, kuɗin sabis da canji."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקתי נמען, סכום, עמלה ועודף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने प्राप्तकर्ता, राशि, शुल्क और लौटने वाले शेष की जाँच कर ली है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah memeriksa penerima, jumlah, biaya, dan kembalian."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho verificato destinatario, importo, commissione e resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金先、金額、手数料、お釣りを確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신자, 금액, 수수료, 거스름돈을 확인했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah menyemak penerima, jumlah, fi dan baki pulangan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb ontvanger, bedrag, kosten en wisselgeld gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdziłem odbiorcę, kwotę, opłatę i resztę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conferi destinatário, valor, taxa e troco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am verificat destinatarul, suma, taxa și restul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я проверил получателя, сумму, комиссию и сдачу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimehakiki mpokeaji, kiasi, ada na chenji."
