    "wowpay_bsv_address_allocation_paused": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إيقاف تخصيص العناوين مؤقتًا حتى اكتمال استرداد المحفظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেট পুনরুদ্ধার অসম্পূর্ণ থাকায় ঠিকানা বরাদ্দ স্থগিত আছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Přidělování adres je pozastaveno, dokud nebude obnova peněženky dokončena."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tildeling af adresser er sat på pause, mens gendannelsen af tegnebogen er ufuldstændig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Adresszuweisung ist pausiert, bis die Wiederherstellung der Wallet abgeschlossen ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Address allocation is paused while wallet recovery is incomplete."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La asignación de direcciones está pausada hasta completar la recuperación de la billetera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تا تکمیل بازیابی کیف پول، تخصیص آدرس متوقف شده است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naka-pause ang paglalaan ng address habang hindi pa kumpleto ang pagbawi ng wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’attribution d’adresses est suspendue tant que la récupération du portefeuille est incomplète."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An dakatar da rabon adireshi har sai an kammala dawo da walat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הקצאת הכתובות מושהית עד להשלמת שחזור הארנק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट की रिकवरी अधूरी होने के कारण पते आवंटित करना रुका हुआ है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alokasi alamat dijeda sampai pemulihan dompet selesai."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’assegnazione degli indirizzi è sospesa finché il recupero del wallet non sarà completato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットの復元が完了するまで、アドレスの割り当てを一時停止しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑 복구가 완료될 때까지 주소 할당이 일시 중지됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peruntukan alamat dijeda sehingga pemulihan dompet selesai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het toewijzen van adressen is gepauzeerd tot het herstel van de wallet is voltooid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przydzielanie adresów jest wstrzymane do zakończenia odzyskiwania portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A alocação de endereços está pausada até concluir a recuperação da carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alocarea adreselor este suspendată până la finalizarea recuperării portofelului."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделение адресов приостановлено до завершения восстановления кошелька."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugawaji wa anwani umesitishwa hadi urejeshaji wa pochi ukamilike."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "พักการจัดสรรที่อยู่ไว้จนกว่าจะกู้คืนกระเป๋าเงินเสร็จสมบูรณ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdan kurtarma tamamlanana kadar adres atama duraklatıldı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Виділення адрес призупинено до завершення відновлення гаманця."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والیٹ کی بحالی مکمل ہونے تک پتوں کی تخصیص رکی ہوئی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tạm dừng cấp địa chỉ cho đến khi hoàn tất khôi phục ví."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包恢复尚未完成，已暂停分配地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錢包復原尚未完成，已暫停分配地址。"
          }
        }
      }
    },
    "wowpay_bsv_address_limit_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم عنوانًا موجودًا قبل إضافة المزيد من العناوين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আরও ঠিকানা যোগ করার আগে বিদ্যমান একটি ঠিকানা ব্যবহার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před přidáním dalších adres použijte některou ze stávajících."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en eksisterende adresse, før du tilføjer flere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende eine vorhandene Adresse, bevor du weitere hinzufügst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an existing address before adding more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa una dirección existente antes de añadir más."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از افزودن آدرس‌های بیشتر، از یک آدرس موجود استفاده کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumamit muna ng kasalukuyang address bago magdagdag ng iba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez une adresse existante avant d’en ajouter d’autres."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da adireshin da ake da shi kafin ƙara wasu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשתמש בכתובת קיימת לפני הוספת כתובות נוספות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "और पते जोड़ने से पहले किसी मौजूदा पते का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan alamat yang sudah ada sebelum menambah alamat baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un indirizzo esistente prima di aggiungerne altri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "アドレスを追加する前に、既存のアドレスを使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "주소를 추가하기 전에 기존 주소를 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan alamat sedia ada sebelum menambah alamat baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een bestaand adres voordat je meer adressen toevoegt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj istniejącego adresu przed dodaniem kolejnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um endereço existente antes de adicionar outros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește o adresă existentă înainte de a adăuga altele."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте существующий адрес, прежде чем добавлять новые."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia anwani iliyopo kabla ya kuongeza nyingine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "โปรดใช้ที่อยู่ที่มีอยู่ก่อนเพิ่มที่อยู่ใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yeni adresler eklemeden önce mevcut bir adresi kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скористайтеся наявною адресою, перш ніж додавати нові."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مزید پتے شامل کرنے سے پہلے موجودہ پتہ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hãy sử dụng địa chỉ hiện có trước khi thêm địa chỉ mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先使用已有地址，再添加新地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先使用既有地址，再新增地址。"
          }
        }
      }
    },
