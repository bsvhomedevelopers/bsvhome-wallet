    "multisig_broadcast_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يرسل البث المعاملة الموقّعة إلى شبكة BSV. تحقق من تفاصيل الدفع مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এতে স্বাক্ষরিত লেনদেন BSV নেটওয়ার্কে জমা দেওয়া হবে। পেমেন্টের তথ্য আবার যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odeslání předá podepsanou transakci síti BSV. Znovu ověřte údaje platby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Udsendelse indsender den underskrevne transaktion til BSV-netværket. Kontrollér betalingsoplysningerne igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Übermittlung reicht die signierte Transaktion im BSV-Netzwerk ein. Prüfe die Zahlungsdetails erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Broadcast submits the signed transaction to the BSV network. Check the payment details once more."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transmisión envía la transacción firmada a la red BSV. Comprueba de nuevo los detalles del pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "انتشار، تراکنش امضاشده را به شبکهٔ BSV می‌فرستد. جزئیات پرداخت را دوباره بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ipapadala ang napirmahang transaksyon sa BSV network. Suriin ulit ang detalye ng bayad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La diffusion soumet la transaction signée au réseau BSV. Vérifiez encore les détails du paiement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Watsawa tana aika ma’amalar da aka sa wa hannu zuwa cibiyar BSV. Sake duba bayanan biyan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השידור שולח את העסקה החתומה לרשת BSV. בדוק שוב את פרטי התשלום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इससे हस्ताक्षरित लेनदेन BSV नेटवर्क पर जमा किया जाएगा। भुगतान का विवरण फिर जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Penyiaran mengirim transaksi bertanda tangan ke jaringan BSV. Periksa kembali rincian pembayaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La trasmissione invia la transazione firmata alla rete BSV. Controlla ancora i dettagli del pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名済みの取引を BSV ネットワークへ送信します。支払い内容をもう一度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명된 거래를 BSV 네트워크에 전송합니다. 결제 정보를 한 번 더 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Siaran menghantar transaksi bertandatangan ke rangkaian BSV. Semak semula butiran bayaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De ondertekende transactie wordt naar het BSV-netwerk verzonden. Controleer de betaling nogmaals."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozgłoszenie przesyła podpisaną transakcję do sieci BSV. Sprawdź szczegóły płatności ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transmissão envia a transação assinada à rede BSV. Confira os detalhes do pagamento novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Difuzarea trimite tranzacția semnată în rețeaua BSV. Verifică încă o dată detaliile plății."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписанная транзакция будет отправлена в сеть BSV. Ещё раз проверьте данные платежа."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kutangaza kunawasilisha muamala uliosainiwa kwenye mtandao wa BSV. Hakiki malipo tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การส่งจะนำธุรกรรมที่ลงนามแล้วเข้าสู่เครือข่าย BSV โปรดตรวจสอบการชำระเงินอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yayınlama, imzalı işlemi BSV ağına iletir. Ödeme bilgilerini bir kez daha kontrol edin."
          }
        },
