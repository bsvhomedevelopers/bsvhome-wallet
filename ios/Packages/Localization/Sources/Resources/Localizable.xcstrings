      }
    },
    "multisig_error_stale_chain": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من حالة السلسلة، أو لم تعد المدخلات مؤكدة وغير منفقة. حدّث البيانات قبل التوقيع أو البث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্লকচেইনের অবস্থা যাচাই করা যায়নি, অথবা ইনপুট আর নিশ্চিত ও অব্যবহৃত অবস্থায় নেই। স্বাক্ষর বা নেটওয়ার্কে পাঠানোর আগে রিফ্রেশ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stav blockchainu nelze ověřit nebo vstupy již nejsou potvrzené a neutracené. Před podpisem nebo odesláním do sítě stav aktualizujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Blockchainstatus kunne ikke verificeres, eller input er ikke længere bekræftede og ubrugte. Opdater før underskrift eller udsendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Blockchain-Status ist nicht verifizierbar oder die Eingaben sind nicht mehr bestätigt und ungenutzt. Aktualisiere ihn vor der Unterzeichnung oder Übermittlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The chain state could not be verified or the inputs are no longer confirmed and unspent. Refresh before signing or broadcasting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo verificar el estado de la cadena o las entradas ya no están confirmadas y sin gastar. Actualiza antes de firmar o transmitir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "وضعیت زنجیره قابل تأیید نیست یا ورودی‌ها دیگر تأییدشده و خرج‌نشده نیستند. پیش از امضا یا انتشار تازه‌سازی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mapatunayan ang katayuan ng blockchain, o hindi na kumpirmado ang mga input o nagastos na ang mga ito. I-refresh bago pumirma o magpadala sa network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’état de la chaîne n’a pas pu être vérifié ou les entrées ne sont plus confirmées et non dépensées. Actualisez avant de signer ou de diffuser."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya tabbatar da matsayin sarkar ba, ko shigarwar ba ta da tabbaci ko an riga an kashe ta. Sabunta kafin sa hannu ko watsawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לאמת את מצב הבלוקצ'יין, או שהקלטים אינם מאושרים עוד או כבר הוצאו. רענן לפני חתימה או שידור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ब्लॉकचेन की स्थिति सत्यापित नहीं हो सकी, या इनपुट अब अपुष्ट हैं या खर्च हो चुके हैं। हस्ताक्षर या नेटवर्क पर भेजने से पहले रीफ़्रेश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Status blockchain tidak dapat diverifikasi, atau input belum terkonfirmasi atau sudah dibelanjakan. Perbarui sebelum menandatangani atau menyiarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare lo stato della blockchain, oppure gli input non sono più confermati e non spesi. Aggiorna prima di firmare o trasmettere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チェーンを確認できないか、入力が承認済みかつ未使用ではありません。署名・送信前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "체인 상태를 확인하지 못했거나 입력이 확인된 미사용 상태가 아닙니다. 서명 또는 전송 전에 새로고침하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Rantaian tidak dapat disahkan atau input tidak lagi disahkan dan belum dibelanjakan. Segarkan sebelum menandatangani atau menyiarkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De blockchain kon niet worden gecontroleerd of de invoer is niet meer bevestigd en onuitgegeven. Vernieuw vóór ondertekening of verzending."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zweryfikować łańcucha lub wejścia nie są już potwierdzone i niewydane. Odśwież przed podpisaniem lub rozgłoszeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar a blockchain ou as entradas não estão mais confirmadas e não gastas. Atualize antes de assinar ou transmitir."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Starea lanțului nu poate fi verificată sau intrările nu mai sunt confirmate și necheltuite. Actualizează înainte de semnare sau difuzare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось проверить блокчейн, либо входы больше не подтверждены и не потрачены. Обновите данные перед подписанием или отправкой."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hali ya blockchain haijahakikiwa au ingizo halijathibitishwa na bado halijatumika. Sasisha kabla ya kusaini au kutangaza."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบเชนไม่ได้ หรืออินพุตไม่อยู่ในสถานะยืนยันแล้วและยังไม่ถูกใช้ รีเฟรชก่อนลงนามหรือส่ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Zincir doğrulanamadı veya girdiler artık onaylanmış ve harcanmamış durumda değil. İmza veya yayınlama öncesi yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стан блокчейну не перевірено, або входи більше не підтверджені й невитрачені. Оновіть дані перед підписанням чи надсиланням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "چین کی حالت تصدیق نہیں ہو سکی یا ان پٹس اب تصدیق شدہ اور غیر خرچ شدہ نہیں ہیں۔ دستخط یا نشر سے پہلے تازہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể kiểm tra chuỗi hoặc đầu vào không còn được xác nhận và chưa chi. Làm mới trước khi ký hay phát giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "链上状态无法核实，或输入不再满足已确认且未花费的条件。请刷新后再签名或广播。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "鏈上狀態無法核實，或輸入不再滿足已確認且未花費的條件。請重新整理後再簽名或廣播。"
          }
        }
      }
    },
    "multisig_error_storage": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر حفظ بيانات التوقيع المتعدد بأمان. لا تبدأ بثًا جديدًا قبل حفظ السجل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বহুস্বাক্ষরের তথ্য নিরাপদে সংরক্ষণ করা যায়নি। রেকর্ড সংরক্ষণের আগে নতুন করে নেটওয়ার্কে পাঠাবেন না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vícepodpisová data se nepodařilo bezpečně uložit. Neodesílejte novou transakci, dokud není záznam uložen."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Multisignaturdata kunne ikke gemmes sikkert. Start ikke en ny udsendelse, før posten er gemt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Multisig-Daten konnten nicht sicher gespeichert werden. Übermittle keine neue Transaktion, bevor der Datensatz gespeichert ist."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Multisig data could not be saved safely. Do not start a new broadcast until the record is saved."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron guardar los datos multifirma de forma segura. No inicies una nueva transmisión hasta guardar el registro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده‌های چندامضایی به‌صورت امن ذخیره نشد. تا ذخیرهٔ رکورد، پخش تراکنش تازه‌ای را شروع نکنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi ligtas na na-save ang multisig na data. Huwag magsimula ng bagong pagpapadala hangga’t hindi naka-save ang record."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données multisignature n’ont pas pu être enregistrées en toute sécurité. Ne lancez pas de nouvelle diffusion avant l’enregistrement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An kasa adana bayanan sa hannu da yawa cikin aminci. Kada ka fara sabon watsawa kafin a adana bayanan."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן היה לשמור את נתוני החתימות בבטחה. אין להתחיל שידור חדש לפני שמירת הרשומה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बहु-हस्ताक्षर डेटा सुरक्षित रूप से सहेजा नहीं जा सका। रिकॉर्ड सहेजे जाने तक नया प्रसारण शुरू न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data multitanda tangan tidak dapat disimpan dengan aman. Jangan mulai siaran baru sebelum catatan tersimpan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare in modo sicuro i dati multifirma. Non avviare una nuova trasmissione finché il record non è salvato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マルチシグのデータを安全に保存できませんでした。記録が保存されるまで新たな送信を行わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "다중 서명 데이터를 안전하게 저장하지 못했습니다. 기록이 저장되기 전에는 새 전송을 시작하지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data pelbagai tandatangan tidak dapat disimpan dengan selamat. Jangan mulakan siaran baharu sehingga rekod disimpan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Multisig-gegevens konden niet veilig worden opgeslagen. Start geen nieuwe uitzending voordat het record is opgeslagen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie udało się bezpiecznie zapisać danych wielopodpisowych. Nie wysyłaj nowej transakcji, dopóki zapis nie zostanie ukończony."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar os dados de múltiplas assinaturas com segurança. Não inicie uma nova transmissão até o registro ser salvo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele cu semnături multiple nu au putut fi salvate în siguranță. Nu începe o nouă difuzare înainte de salvarea înregistrării."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось безопасно сохранить данные мультиподписи. Не отправляйте новую транзакцию, пока запись не сохранена."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Data za saini nyingi hazikuweza kuhifadhiwa kwa usalama. Usianze kutangaza muamala mpya kabla ya rekodi kuhifadhiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "บันทึกข้อมูลหลายลายเซ็นอย่างปลอดภัยไม่ได้ อย่าเริ่มส่งธุรกรรมใหม่จนกว่าจะบันทึกข้อมูลสำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Çoklu imza verileri güvenle kaydedilemedi. Kayıt kaydedilene kadar yeni bir yayın başlatmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Не вдалося безпечно зберегти дані мультипідпису. Не надсилайте нову транзакцію, доки запис не збережено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کثیر دستخط کا ڈیٹا محفوظ طریقے سے محفوظ نہیں ہو سکا۔ ریکارڈ محفوظ ہونے تک نیا نشر شروع نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể lưu dữ liệu đa chữ ký an toàn. Không bắt đầu phát giao dịch mới cho đến khi lưu được bản ghi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "多签数据无法安全保存。在记录保存成功前，请勿发起新的广播。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "多簽資料無法安全儲存。在紀錄儲存成功前，請勿發起新的廣播。"
          }
        }
      }
    },
