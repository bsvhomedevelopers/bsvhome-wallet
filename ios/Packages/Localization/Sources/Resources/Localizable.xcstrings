        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Danh tính ký vẫn được liên kết với ví đa chữ ký này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "签名身份与此多签钱包关联，不随个人钱包切换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "簽名身分與此多簽錢包關聯，不隨個人錢包切換。"
          }
        }
      }
    },
    "multisig_immutable_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تغيير أعضاء المحفظة المفعّلة أو حد التوقيعات محليًا. استبدال الأعضاء وتغيير القواعد غير متاحين في هذا الإصدار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সক্রিয় ওয়ালেটের সদস্য ও স্বাক্ষরের সীমা এই ডিভাইসে বদলানো যায় না। এই সংস্করণে সদস্য বদলানো বা নিয়ম পরিবর্তন করা যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Členy a požadovaný počet podpisů aktivní peněženky nelze místně změnit. Tato verze nepodporuje výměnu členů ani změnu pravidel."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En aktiveret tegnebogs medlemmer og tærskel kan ikke ændres lokalt. Udskiftning af medlemmer og regelændringer er ikke tilgængelige i denne version."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Mitglieder und Signaturschwelle einer aktivierten Wallet lassen sich nicht lokal ändern. Mitgliedsaustausch und Regeländerungen sind in dieser Version nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An enabled wallet’s members and threshold cannot be changed locally. Member replacement and rule changes are not available in this release."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los miembros y el umbral de una billetera activada no pueden cambiarse localmente. Esta versión no permite reemplazar miembros ni cambiar las reglas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اعضا و حد نصاب کیف پول فعال را نمی‌توان روی دستگاه تغییر داد. جایگزینی اعضا و تغییر قواعد در این نسخه در دسترس نیست."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mababago sa device ang mga miyembro at kinakailangang bilang ng lagda ng aktibong wallet. Hindi pa magagamit sa bersyong ito ang pagpapalit ng miyembro o tuntunin."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les membres et le seuil d’un portefeuille activé ne peuvent pas être modifiés localement. Le remplacement de membres et la modification des règles sont indisponibles dans cette version."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya sauya mambobi ko adadin sa hannu na walat da aka kunna a wannan na’urar. Sauya mambobi ko ƙa’idoji ba ya samuwa a wannan sigar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אי אפשר לשנות מקומית את החברים ואת סף החתימות בארנק פעיל. החלפת חברים ושינוי כללים אינם זמינים בגרסה זו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सक्रिय वॉलेट के सदस्य या हस्ताक्षर सीमा इस डिवाइस पर नहीं बदली जा सकती। इस संस्करण में सदस्य बदलना या नियम बदलना उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Anggota dan ambang dompet aktif tidak dapat diubah pada perangkat. Penggantian anggota dan perubahan aturan belum tersedia dalam versi ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Membri e soglia di un portafoglio attivo non possono essere modificati localmente. Questa versione non consente sostituzioni di membri o modifiche delle regole."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効なウォレットのメンバーや必要署名数はローカルで変更できません。このバージョンではメンバー交代やルール変更はできません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성 지갑의 구성원과 필요 서명 수는 로컬에서 변경할 수 없습니다. 이 버전은 구성원 교체나 규칙 변경을 지원하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ahli dan ambang dompet aktif tidak boleh diubah secara setempat. Versi ini belum menyokong penggantian ahli atau perubahan peraturan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Leden en het vereiste aantal handtekeningen van een actieve wallet kunnen niet lokaal worden gewijzigd. Deze versie ondersteunt geen vervanging van leden of regelwijzigingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Członków i progu aktywnego portfela nie można zmienić lokalnie. Ta wersja nie obsługuje wymiany członków ani zmiany zasad."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os membros e o limite de uma carteira ativada não podem ser alterados localmente. Esta versão não permite substituir membros nem alterar regras."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Membrii și pragul unui portofel activat nu pot fi modificați local. Această versiune nu permite înlocuirea membrilor sau schimbarea regulilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Участников и порог активного кошелька нельзя менять локально. Эта версия не поддерживает замену участников или изменение правил."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanachama na kiwango cha mkoba uliowezeshwa haviwezi kubadilishwa hapa. Toleo hili haliruhusu kubadilisha wanachama au kanuni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่สามารถแก้สมาชิกหรือเกณฑ์ของกระเป๋าที่เปิดใช้แล้วในเครื่องได้ รุ่นนี้ยังไม่รองรับการเปลี่ยนสมาชิกหรือกฎ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkin cüzdanın üyeleri ve eşiği yerel olarak değiştirilemez. Bu sürümde üye değiştirme ve kural değişiklikleri desteklenmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Учасників і поріг активованого гаманця не можна змінити локально. Ця версія не підтримує заміну учасників чи зміну правил."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال والیٹ کے اراکین یا حد مقامی طور پر تبدیل نہیں ہو سکتی۔ اس نسخے میں رکن یا اصول بدلنے کی سہولت نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể sửa thành viên hoặc ngưỡng của ví đã kích hoạt tại máy. Phiên bản này chưa cho thay thành viên hay đổi quy tắc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已启用钱包的成员和门槛不能在本地直接修改。本期暂不开放成员替换和规则变更。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已啟用錢包的成員和門檻不能在本地直接修改。本期暫不開放成員替換和規則變更。"
          }
        }
      }
    },
