    "cold_wallet_unified_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم التطبيق نفسه على الهاتفين. افصل هاتف التوقيع عن الشبكة بنفسك، واستورد بيانات الاقتران العامة فقط على هاتف المراقبة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দুই ফোনে একই অ্যাপ ব্যবহার করুন। স্বাক্ষরের ফোনের নেটওয়ার্ক নিজে বন্ধ করুন; পর্যবেক্ষক ফোনে শুধু প্রকাশ্য পেয়ারিং তথ্য আমদানি করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte stejnou aplikaci na obou telefonech. Podepisující telefon sami odpojte od sítě; do sledovacího telefonu importujte pouze veřejné údaje pro párování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug samme app på begge telefoner. Afbryd selv netværket på telefonen til underskrift; importer kun offentlige parringsdata på observationstelefonen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwenden Sie dieselbe App auf beiden Telefonen. Trennen Sie das Signiergerät selbst vom Netz; importieren Sie auf dem Beobachtergerät nur öffentliche Kopplungsdaten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the same app on both phones. Disconnect the signing phone yourself; import only public pairing data on the observer phone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la misma app en ambos teléfonos. Desconecta el teléfono que firma; importa solo los datos públicos de vinculación en el teléfono observador."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "در هر دو گوشی از یک برنامه استفاده کنید. اتصال شبکهٔ گوشی امضاکننده را خودتان قطع کنید و فقط اطلاعات عمومی جفت‌سازی را در گوشی ناظر وارد کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang parehong app sa dalawang telepono. Ikaw ang magdiskonekta sa network ng teleponong pumipirma; pampublikong datos ng pagpapares lamang ang i-import sa teleponong tagamasid."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez la même application sur les deux téléphones. Déconnectez vous-même le téléphone de signature ; importez uniquement les données publiques sur le téléphone observateur."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da manhaja ɗaya a wayoyin biyu. Ka katse intanet na wayar sa hannu da kanka; ka shigo da bayanan haɗawa na jama’a kawai a wayar sa ido."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו באותה אפליקציה בשני הטלפונים. נתקו בעצמכם את טלפון החתימה מהרשת; ייבאו לטלפון הצפייה רק נתוני צימוד ציבוריים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "दोनों फ़ोन पर एक ही ऐप इस्तेमाल करें। हस्ताक्षर करने वाले फ़ोन का नेटवर्क स्वयं बंद करें; निगरानी वाले फ़ोन पर केवल सार्वजनिक पेयरिंग जानकारी आयात करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan aplikasi yang sama di kedua ponsel. Putuskan sendiri jaringan ponsel penandatangan; impor hanya data pemasangan publik di ponsel pengamat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la stessa app su entrambi i telefoni. Disconnetti il telefono che firma; importa solo i dati pubblici di abbinamento sul telefono osservatore."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "両方のスマートフォンで同じアプリを使用します。署名する端末の通信はご自身で切断し、監視用端末には公開ペアリング情報のみを取り込んでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "두 휴대폰에서 같은 앱을 사용하세요. 서명용 휴대폰의 네트워크는 직접 끊고, 관찰용 휴대폰에는 공개 페어링 정보만 가져오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan aplikasi yang sama pada kedua-dua telefon. Putuskan sendiri rangkaian telefon penandatangan; import hanya data gandingan awam pada telefon pemerhati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik dezelfde app op beide telefoons. Verbreek zelf de netwerkverbinding van de ondertekenende telefoon; importeer alleen openbare koppelgegevens op de observatietelefoon."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj tej samej aplikacji na obu telefonach. Samodzielnie odłącz telefon podpisujący od sieci; na telefon obserwacyjny importuj tylko publiczne dane parowania."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o mesmo app nos dois celulares. Desconecte o celular de assinatura; importe apenas os dados públicos de pareamento no celular observador."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosiți aceeași aplicație pe ambele telefoane. Deconectați manual telefonul de semnare; importați doar datele publice de asociere pe telefonul de observare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте одно приложение на обоих телефонах. Самостоятельно отключите телефон для подписи от сети; на телефон наблюдения импортируйте только открытые данные сопряжения."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia programu ileile kwenye simu zote mbili. Kata mtandao wa simu ya kusaini mwenyewe; ingiza data za umma za kuoanisha pekee kwenye simu ya uangalizi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้แอปเดียวกันบนโทรศัพท์ทั้งสองเครื่อง โปรดตัดเครือข่ายของเครื่องที่ใช้ลงนามด้วยตนเอง และนำเข้าเฉพาะข้อมูลจับคู่สาธารณะในเครื่องที่ใช้ดูข้อมูล"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İki telefonda da aynı uygulamayı kullanın. İmza telefonunun ağ bağlantısını kendiniz kesin; izleme telefonuna yalnızca herkese açık eşleştirme verilerini aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте один застосунок на обох телефонах. Самостійно відключіть телефон для підпису від мережі; на телефон спостереження імпортуйте лише відкриті дані сполучення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دونوں فونز پر ایک ہی ایپ استعمال کریں۔ دستخط کرنے والے فون کا نیٹ ورک خود بند کریں؛ نگرانی والے فون پر صرف عوامی پیئرنگ معلومات درآمد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng cùng một ứng dụng trên hai điện thoại. Tự ngắt mạng điện thoại ký; chỉ nhập dữ liệu ghép nối công khai trên điện thoại theo dõi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "两部手机使用同一个 App。请自行断开签名手机的网络；观察手机只导入公开配对信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "兩部手機使用同一個 App。請自行中斷簽名手機的網絡；觀察手機只匯入公開配對資料。"
          }
        }
      }
    },
    "cold_wallet_use_observer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم محفظة المراقبة المتصلة لإرسال المدفوعات واستلامها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অর্থ পাঠাতে ও গ্রহণ করতে অনলাইন পর্যবেক্ষণ ওয়ালেট ব্যবহার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "K odesílání a přijímání plateb použijte online sledovací peněženku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug online observationspungen til at sende og modtage betalinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende die Online-Beobachtungswallet zum Senden und Empfangen von Zahlungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use the online watch wallet to send and receive payments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa la cartera de observación en línea para enviar y recibir pagos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ارسال و دریافت پرداخت از کیف پول نظارتی آنلاین استفاده کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang online na watch wallet para magpadala at tumanggap ng bayad."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez le portefeuille de surveillance en ligne pour envoyer et recevoir des paiements."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da walat na sa ido na kan intanet don aikawa da karɓar kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר לשלוח ולקבל תשלומים בארנק המעקב המקוון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान भेजने और पाने के लिए ऑनलाइन वॉच वॉलेट का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan dompet pantau online untuk mengirim dan menerima pembayaran."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa il portafoglio di osservazione online per inviare e ricevere pagamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金と受取にはオンラインの閲覧専用ウォレットを使ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 송금과 수신에는 온라인 관찰 지갑을 사용하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan dompet pemerhatian dalam talian untuk menghantar dan menerima bayaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik de online kijkwallet om betalingen te verzenden en te ontvangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Do wysyłania i odbierania płatności używaj portfela obserwacyjnego online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a carteira de observação online para enviar e receber pagamentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește portofelul de observare online pentru a trimite și primi plăți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для отправки и получения платежей используйте онлайн-кошелёк для наблюдения."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia pochi ya ufuatiliaji iliyo mtandaoni kutuma na kupokea malipo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้กระเป๋าสังเกตการณ์ที่ออนไลน์เพื่อส่งและรับเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme göndermek ve almak için çevrimiçi izleme cüzdanını kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Для надсилання й отримання платежів використовуйте гаманець спостереження онлайн."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ادائیگیاں بھیجنے اور وصول کرنے کے لیے آن لائن نگرانی والا والیٹ استعمال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng ví theo dõi trực tuyến để gửi và nhận thanh toán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收付款请在在线观察钱包操作"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收付款請在連線的觀察錢包操作"
          }
        }
      }
    },
