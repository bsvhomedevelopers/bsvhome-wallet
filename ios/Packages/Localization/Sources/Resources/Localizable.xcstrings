    "cold_wallet_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تبقى المفاتيح دون اتصال. تستقبل محفظة مراقبة xPub المتصلة الأموال وتجهز التحويلات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কীগুলো অফলাইনে থাকে। অনলাইন xPub পর্যবেক্ষক অর্থ গ্রহণ করে এবং স্থানান্তর প্রস্তুত করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klíče zůstávají offline. Online pozorovatel xPub přijímá prostředky a připravuje převody."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Nøgler forbliver offline. En online xPub-observatør modtager midler og forbereder overførsler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Schlüssel bleiben offline. Eine verbundene xPub-Beobachtungswallet empfängt Guthaben und bereitet Überweisungen vor."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep keys offline. Use an online xPub observer to receive and prepare transfers."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las claves permanecen sin conexión. El observador xPub conectado recibe fondos y prepara transferencias."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیدها آفلاین می‌مانند. ناظر آنلاین xPub وجه دریافت می‌کند و انتقال‌ها را آماده می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nananatiling offline ang mga key. Tumatanggap ng pondo at naghahanda ng paglilipat ang online na xPub observer."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les clés hors ligne. L’observateur xPub connecté reçoit les fonds et prépare les transferts."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Maɓallai suna kasancewa ba tare da intanet ba. Mai lura da xPub a kan intanet yana karɓar kuɗi da shirya turawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "המפתחות נשארים לא מקוונים. צופה xPub מקוון מקבל כספים ומכין העברות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजियाँ ऑफ़लाइन रहती हैं। ऑनलाइन xPub पर्यवेक्षक धन प्राप्त करता है और हस्तांतरण तैयार करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tetap offline. Pengamat xPub online menerima dana dan menyiapkan transfer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le chiavi restano offline. L’osservatore xPub online riceve fondi e prepara trasferimenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "秘密鍵はオフラインで保管します。オンラインの xPub 監視ウォレットで受取と送金準備を行います。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인키는 오프라인에 보관합니다. 온라인 xPub 관찰 지갑에서 수신과 전송 준비를 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci kekal luar talian. Pemerhati xPub dalam talian menerima dana dan menyediakan pindahan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleutels blijven offline. Een online xPub-observer ontvangt geld en bereidt overboekingen voor."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Klucze pozostają offline. Obserwator xPub online odbiera środki i przygotowuje przelewy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As chaves ficam offline. O observador xPub online recebe fundos e prepara transferências."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheile rămân offline. Observatorul xPub online primește fonduri și pregătește transferuri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключи остаются офлайн. Онлайн-наблюдатель xPub принимает средства и готовит переводы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Funguo hubaki nje ya mtandao. Mtazamaji wa xPub mtandaoni hupokea fedha na kuandaa uhamisho."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บกุญแจไว้ออฟไลน์ กระเป๋าเฝ้าดู xPub ออนไลน์รับเงินและเตรียมการโอน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarlar çevrimdışı kalır. Çevrimiçi xPub gözlemcisi para alır ve transferleri hazırlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ключі залишаються офлайн. Онлайн-спостерігач xPub отримує кошти й готує перекази."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیدیں آف لائن رہتی ہیں۔ آن لائن xPub نگران رقم وصول کرتا اور منتقلی تیار کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Khóa được giữ ngoại tuyến. Ví theo dõi xPub trực tuyến nhận tiền và chuẩn bị chuyển tiền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "私钥保留在离线设备，在线 xPub 观察钱包负责收款和构建转账。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "私鑰保留在離線裝置，線上 xPub 觀察錢包負責收款和建立轉帳。"
          }
        }
      }
    },
    "cold_wallet_home_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المحافظ الباردة لا تدعم هذا الإجراء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কোল্ড ওয়ালেটে এই কাজটি সমর্থিত নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Studené peněženky tuto akci nepodporují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kolde wallets understøtter ikke denne handling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Cold Wallets unterstützen diese Aktion nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cold wallets do not support this action."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las carteras frías no admiten esta acción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول‌های سرد از این عملیات پشتیبانی نمی‌کنند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi sinusuportahan ng mga cold wallet ang pagkilos na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les portefeuilles froids ne prennent pas en charge cette action."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Walat ɗin sanyi ba ya goyon bayan wannan aikin."
