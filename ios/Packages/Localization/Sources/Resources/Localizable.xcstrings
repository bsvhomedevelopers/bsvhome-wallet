        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sauvegardez votre phrase de récupération pour protéger votre portefeuille"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajiye kwafin kalmomin dawo da asusu don kare walat ɗinka"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
