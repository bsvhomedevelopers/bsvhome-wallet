          "stringUnit": {
            "state": "translated",
            "value": "Výsledek čeká na ověření. Po obnovení připojení aktualizujte údaje, než zkusíte další operaci."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet afventer bekræftelse. Opdatér, når netværket er tilbage, før du prøver en anden handling."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis muss noch geprüft werden. Aktualisiere nach Wiederherstellung der Verbindung, bevor du eine andere Aktion versuchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Result pending verification. Refresh after the network is restored before trying another operation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado está pendiente de verificación. Actualiza cuando se restablezca la red antes de intentar otra operación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجه در انتظار تأیید است. پس از برقراری دوبارهٔ شبکه، تازه‌سازی کنید و سپس عملیات دیگری را امتحان کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hinihintay ang pag-verify ng resulta. I-refresh kapag bumalik na ang koneksyon bago subukan ang ibang operasyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat est en attente de vérification. Actualisez une fois le réseau rétabli avant de tenter une autre opération."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana jiran tabbatar da sakamakon. Sabunta bayan haɗin yanar gizo ya dawo kafin yin wani aiki."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוצאה ממתינה לאימות. יש לרענן לאחר שהרשת חוזרת לפעול, לפני ניסיון לבצע פעולה נוספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिणाम का सत्यापन बाकी है। कोई और कार्रवाई करने से पहले नेटवर्क बहाल होने पर रीफ़्रेश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil menunggu verifikasi. Muat ulang setelah jaringan pulih sebelum mencoba operasi lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato è in attesa di verifica. Aggiorna dopo il ripristino della rete prima di tentare un’altra operazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果の確認待ちです。ネットワーク復旧後に更新してから、次の操作を行ってください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과 확인이 필요합니다. 네트워크가 복구되면 새로고침한 후 다른 작업을 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keputusan menunggu pengesahan. Muat semula selepas rangkaian pulih sebelum mencuba operasi lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resultaat moet nog worden geverifieerd. Vernieuw zodra het netwerk is hersteld voordat je een andere handeling probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik czeka na weryfikację. Po przywróceniu sieci odśwież dane, zanim spróbujesz kolejnej operacji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado está aguardando verificação. Atualize quando a rede voltar antes de tentar outra operação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatul așteaptă verificarea. Reîmprospătează după restabilirea rețelei înainte de a încerca altă operațiune."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат ожидает проверки. После восстановления сети обновите данные, прежде чем выполнять другую операцию."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Matokeo yanasubiri uthibitishaji. Onyesha upya mtandao ukirejea kabla ya kujaribu operesheni nyingine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลลัพธ์อยู่ระหว่างรอการตรวจสอบ โปรดรีเฟรชหลังเครือข่ายกลับมาใช้งานได้ก่อนลองดำเนินการอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç doğrulama bekliyor. Başka bir işlem denemeden önce ağ bağlantısı düzeldikten sonra yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат очікує перевірки. Після відновлення мережі оновіть дані, перш ніж виконувати іншу операцію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجے کی تصدیق باقی ہے۔ نیٹ ورک بحال ہونے پر ریفریش کریں، پھر کوئی اور کارروائی آزمائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả đang chờ xác minh. Hãy làm mới sau khi có mạng trở lại trước khi thử thao tác khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果待核验。请在网络恢复后刷新，再尝试其他操作。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果待驗證。請在網路恢復後重新整理，再嘗試其他操作。"
          }
        }
      }
    },
    "paymail_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
