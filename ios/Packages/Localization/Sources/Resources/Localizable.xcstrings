    "multisig_funding_review_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه المراجعة صالحة لمدة 5 دقائق. تحقّق من المحفظتين ومفاتيح الأعضاء وحد التوقيعات والمبلغ والرسوم والباقي. تمنح محفظة الدفع الإذن بهذا التحويل بشكل مستقل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই পর্যালোচনা 5 মিনিট বৈধ। দুই ওয়ালেট, সদস্যদের কী, স্বাক্ষরের সংখ্যা, অর্থ, ফি ও ফেরত অর্থ যাচাই করুন। পেমেন্ট ওয়ালেট স্বাধীনভাবে এই স্থানান্তরের অনুমোদন দেয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrola platí 5 minut. Ověřte obě peněženky, klíče členů, počet podpisů, částku, poplatek a zbytek. Platící peněženka schvaluje převod samostatně."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Denne kontrol gælder i 5 minutter. Kontrollér begge tegnebøger, medlemsnøgler, underskriftstærskel, beløb, gebyr og byttepenge. Den betalende tegnebog godkender overførslen selvstændigt."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Prüfung gilt 5 Minuten. Prüfe beide Wallets, Mitgliedsschlüssel, Signaturschwelle, Betrag, Gebühr und Wechselgeld. Die zahlende Wallet autorisiert diese Übertragung eigenständig."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This review is valid for 5 minutes. Verify both wallets, member keys, signing threshold, amount, fee and change. The payment wallet authorizes this transfer independently."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta revisión es válida durante 5 minutos. Verifica ambas billeteras, las claves de los miembros, el umbral, el importe, la comisión y el cambio. La billetera pagadora autoriza la transferencia de forma independiente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این بررسی 5 دقیقه اعتبار دارد. هر دو کیف پول، کلیدهای اعضا، حد نصاب امضا، مبلغ، کارمزد و باقی‌مانده را بررسی کنید. کیف پول پرداخت‌کننده به‌طور مستقل این انتقال را مجاز می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May bisa ang pagsusuring ito sa loob ng 5 minuto. Suriin ang dalawang wallet, mga susi ng miyembro, bilang ng lagda, halaga, bayad at sukli. Ang wallet na magbabayad ang hiwalay na mag-aapruba sa paglipat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette vérification est valable 5 minutes. Vérifiez les deux portefeuilles, les clés des membres, le seuil de signatures, le montant, les frais et la monnaie. Le portefeuille payeur autorise ce transfert indépendamment."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wannan dubawa yana aiki na minti 5. Duba walat biyu, maɓallan mambobi, adadin sa hannu, kuɗi, caji da ragowar kuɗi. Walat mai biya yana amincewa da wannan turawa da kansa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבדיקה תקפה ל־5 דקות. יש לבדוק את שני הארנקים, מפתחות החברים, סף החתימות, הסכום, העמלה והעודף. הארנק המשלם מאשר את ההעברה באופן עצמאי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह समीक्षा 5 मिनट तक मान्य है। दोनों वॉलेट, सदस्यों की कुंजियाँ, ज़रूरी हस्ताक्षर, राशि, शुल्क और बची हुई राशि जाँचें। भुगतान वॉलेट स्वतंत्र रूप से इस ट्रांसफ़र को अधिकृत करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peninjauan ini berlaku 5 menit. Periksa kedua dompet, kunci anggota, ambang tanda tangan, jumlah, biaya, dan kembalian. Dompet pembayar mengizinkan transfer ini secara mandiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questa verifica è valida per 5 minuti. Controlla entrambi i portafogli, le chiavi dei membri, la soglia, l’importo, la commissione e il resto. Il portafoglio pagante autorizza il trasferimento autonomamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "確認内容は5分間有効です。両方のウォレット、メンバーの公開鍵、必要署名数、金額、手数料、お釣りを確認してください。支払い元ウォレットが単独でこの送金を承認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "검토 정보는 5분간 유효합니다. 두 지갑, 구성원 공개 키, 필요 서명 수, 금액, 수수료, 잔돈을 확인하세요. 결제 지갑이 독립적으로 이체를 승인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakan ini sah selama 5 minit. Semak kedua-dua dompet, kunci ahli, ambang tandatangan, jumlah, fi dan baki pulangan. Dompet pembayar membenarkan pindahan ini secara berasingan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deze controle is 5 minuten geldig. Controleer beide wallets, de sleutels van de leden, het vereiste aantal handtekeningen, bedrag, kosten en wisselgeld. De betalende wallet machtigt deze overdracht zelfstandig."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weryfikacja jest ważna przez 5 minut. Sprawdź oba portfele, klucze członków, próg podpisów, kwotę, opłatę i resztę. Portfel płatnika samodzielnie autoryzuje ten przelew."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta revisão vale por 5 minutos. Confira as duas carteiras, as chaves dos membros, o mínimo de assinaturas, o valor, a taxa e o troco. A pagadora autoriza a transferência de forma independente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Această verificare este valabilă 5 minute. Verifică ambele portofele, cheile membrilor, pragul, suma, comisionul și restul. Portofelul plătitor autorizează transferul independent."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверка действительна 5 минут. Проверьте оба кошелька, ключи участников, порог подписей, сумму, комиссию и сдачу. Кошелёк плательщика самостоятельно разрешает перевод."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ukaguzi huu unatumika kwa dakika 5. Hakiki mikoba yote miwili, funguo za wanachama, kiwango cha saini, kiasi, ada na chenji. Mkoba unaolipa unaidhinisha uhamisho huu kivyake."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลนี้ใช้ได้ 5 นาที โปรดตรวจสอบทั้งสองกระเป๋า คีย์สมาชิก เกณฑ์ลายเซ็น จำนวนเงิน ค่าธรรมเนียม และเงินทอน กระเป๋าที่ชำระอนุมัติการโอนนี้ได้ด้วยตนเอง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu inceleme 5 dakika geçerlidir. İki cüzdanı, üye anahtarlarını, imza eşiğini, tutarı, ücreti ve para üstünü doğrulayın. Ödeme cüzdanı bu transfere bağımsız olarak yetki verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірка дійсна 5 хвилин. Перевірте обидва гаманці, ключі учасників, поріг, суму, комісію та решту. Гаманець платника самостійно дозволяє переказ."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ جانچ 5 منٹ کے لیے درست ہے۔ دونوں والیٹ، اراکین کی کلیدیں، دستخط کی حد، رقم، فیس اور باقی رقم جانچیں۔ ادائیگی کا والیٹ اس منتقلی کی الگ سے اجازت دیتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin này có hiệu lực 5 phút. Kiểm tra cả hai ví, khóa thành viên, ngưỡng chữ ký, số tiền, phí và tiền thừa. Ví thanh toán tự mình cho phép giao dịch chuyển này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "核对信息在 5 分钟内有效。请核对两个钱包、成员公钥、门槛、金额、费用及找零。本次入金由付款钱包独立授权。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "核對資訊在 5 分鐘內有效。請核對兩個錢包、成員公鑰、門檻、金額、費用及找零。本次轉入由付款錢包獨立授權。"
          }
        }
      }
    },
    "multisig_funding_sync_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بث المعاملة، لكن تعذّر تحديث الأرصدة أو السجل. أعد محاولة المزامنة؛ لا تدفع مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেনটি পাঠানো হয়েছে, কিন্তু ব্যালেন্স বা ইতিহাস হালনাগাদ হয়নি। আবার সিঙ্ক করুন; নতুন করে পেমেন্ট করবেন না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce byla odeslána, ale zůstatky nebo historie se neaktualizovaly. Opakujte synchronizaci; neplaťte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen er sendt, men saldi eller historik kunne ikke opdateres. Prøv synkronisering igen; betal ikke igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion wurde gesendet, aber Guthaben oder Verlauf konnten nicht aktualisiert werden. Wiederhole die Synchronisierung; zahle nicht erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction was broadcast, but balances or history could not refresh. Retry synchronization; do not pay again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción se transmitió, pero no se pudieron actualizar los saldos o el historial. Reintenta la sincronización; no vuelvas a pagar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش پخش شد، اما موجودی یا تاریخچه به‌روز نشد. همگام‌سازی را دوباره امتحان کنید؛ دوباره پرداخت نکنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naipadala na ang transaksyon, pero hindi na-refresh ang balanse o kasaysayan. Subukan muli ang pag-sync; huwag magbayad muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction a été diffusée, mais les soldes ou l’historique n’ont pas pu être actualisés. Réessayez la synchronisation ; ne payez pas à nouveau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An watsa ma’amalar, amma an kasa sabunta ragowar kuɗi ko tarihi. Sake gwada daidaitawa; kada ka sake biya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה שודרה, אבל היתרות או ההיסטוריה לא עודכנו. יש לנסות לסנכרן שוב; אין לשלם שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेनदेन प्रसारित हो गया, लेकिन बैलेंस या इतिहास अपडेट नहीं हुआ। सिंक फिर से आज़माएँ; दोबारा भुगतान न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi sudah disiarkan, tetapi saldo atau riwayat tidak bisa diperbarui. Coba sinkronisasi lagi; jangan membayar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione è stata trasmessa, ma non è stato possibile aggiornare saldi o cronologia. Riprova la sincronizzazione; non pagare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションは送信済みですが、残高または履歴を更新できませんでした。同期だけを再試行し、再度支払わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랜잭션은 전송되었지만 잔액이나 내역을 새로고침하지 못했습니다. 동기화만 다시 시도하고, 다시 결제하지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi telah disiarkan, tetapi baki atau sejarah tidak dapat dikemas kini. Cuba penyegerakan semula; jangan bayar lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactie is uitgezonden, maar saldi of geschiedenis konden niet worden bijgewerkt. Probeer opnieuw te synchroniseren; betaal niet opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja została wysłana, ale nie udało się odświeżyć sald lub historii. Ponów synchronizację; nie płać ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação foi transmitida, mas não foi possível atualizar os saldos ou o histórico. Tente sincronizar novamente; não pague de novo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacția a fost difuzată, dar soldurile sau istoricul nu s-au actualizat. Reîncearcă sincronizarea; nu plăti din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция отправлена, но балансы или история не обновились. Повторите синхронизацию; не платите заново."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala umetangazwa, lakini salio au historia haikuweza kusasishwa. Jaribu kusawazisha tena; usilipe tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งธุรกรรมแล้ว แต่รีเฟรชยอดเงินหรือประวัติไม่ได้ ให้ลองซิงค์อีกครั้ง อย่าชำระเงินซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem yayımlandı, ancak bakiyeler veya geçmiş yenilenemedi. Eşitlemeyi yeniden deneyin; tekrar ödeme yapmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію надіслано, але баланси або історію не вдалося оновити. Повторіть синхронізацію; не сплачуйте знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانزیکشن نشر ہوگئی، مگر بیلنس یا تاریخچہ تازہ نہیں ہو سکا۔ ہم وقت سازی دوبارہ آزمائیں؛ دوبارہ ادائیگی نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đã phát lên mạng nhưng không cập nhật được số dư hoặc lịch sử. Thử đồng bộ lại; không thanh toán lần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已广播，但余额或记录刷新失败。请重试同步，不要重新付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已廣播，但餘額或紀錄更新失敗。請重試同步，不要重新付款。"
          }
        }
      }
    },
