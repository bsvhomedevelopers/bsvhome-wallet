    "wowpay_import_method_safety_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل أصولك تحت سيطرتك. استورد محفظتك في مكان آمن."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সম্পদের নিয়ন্ত্রণ আপনার হাতেই থাকে। নিরাপদ পরিবেশে ওয়ালেট আমদানি করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Svá aktiva máte stále pod kontrolou. Peněženku importujte v bezpečném prostředí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Du bevarer kontrollen over dine aktiver. Importér din tegnebog i sikre omgivelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sie behalten die Kontrolle über Ihre Vermögenswerte. Importieren Sie Ihre Wallet in einer sicheren Umgebung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "You remain in control of your assets. Import your wallet in a secure environment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus activos siguen bajo tu control. Importa tu billetera en un lugar seguro."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کنترل دارایی‌هایتان همچنان در دست شماست. کیف پول را در محیطی امن وارد کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikaw pa rin ang may kontrol sa iyong mga asset. Mag-import ng wallet sa ligtas na lugar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vous gardez le contrôle de vos actifs. Importez votre portefeuille dans un environnement sûr."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Har yanzu kuna da ikon sarrafa kadarorinku. Shigo da walat ɗinku a wuri mai tsaro."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הנכסים שלכם נשארים בשליטתכם. ייבאו את הארנק בסביבה מאובטחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आपकी संपत्तियाँ आपके नियंत्रण में रहती हैं। वॉलेट को सुरक्षित स्थान पर इम्पोर्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aset Anda tetap berada dalam kendali Anda. Impor dompet di tempat yang aman."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantieni il controllo dei tuoi fondi. Importa il portafoglio in un ambiente sicuro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "資産は引き続きご自身で管理できます。安全な環境でウォレットをインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자산은 계속 본인이 관리합니다. 안전한 환경에서 지갑을 가져오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Aset anda kekal di bawah kawalan anda. Import dompet dalam persekitaran yang selamat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je houdt de controle over je tegoeden. Importeer je portemonnee in een veilige omgeving."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zachowujesz kontrolę nad swoimi aktywami. Importuj portfel w bezpiecznym miejscu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Seus ativos continuam sob seu controle. Importe sua carteira em um ambiente seguro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Activele tale rămân sub controlul tău. Importă portofelul într-un loc sigur."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши активы остаются под вашим контролем. Импортируйте кошелёк в безопасном месте."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mali zako zinasalia chini ya udhibiti wako. Ingiza pochi katika sehemu salama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คุณยังคงควบคุมสินทรัพย์ของคุณเอง โปรดนำเข้ากระเป๋าเงินในที่ปลอดภัย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Varlıklarınızın kontrolü her zaman sizdedir. Cüzdanınızı güvenli bir ortamda içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші активи залишаються під вашим контролем. Імпортуйте гаманець у безпечному місці."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آپ کے اثاثوں کا کنٹرول ہمیشہ آپ کے پاس رہتا ہے۔ والیٹ کو محفوظ ماحول میں درآمد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bạn luôn kiểm soát tài sản của mình. Hãy nhập ví ở nơi an toàn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你的资产始终由你掌控。请在安全环境中导入钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "你的資產始終由你掌控。請在安全環境中匯入錢包。"
          }
        }
      }
    },
