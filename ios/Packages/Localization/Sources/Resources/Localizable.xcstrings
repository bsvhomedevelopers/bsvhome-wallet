    "price_alerts.auto_footer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتم تشغيل التنبيهات عند حدوث تحركات كبيرة في الأسعار."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উল্লেখযোগ্য মূল্য পরিবর্তনের সময় সতর্কতাগুলি ট্রিগার করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Upozornění se spouštějí při významných cenových pohybech."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Advarsler udløses ved betydelige prisbevægelser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei erheblichen Preisbewegungen werden Warnungen ausgelöst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerts trigger on significant price moves."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las alertas se activan ante movimientos de precios significativos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هشدارها در صورت حرکت قابل توجه قیمت فعال می‌شوند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagti-trigger ang mga alerto sa mga makabuluhang galaw ng presyo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les alertes se déclenchent en cas de mouvements de prix importants."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Faɗakarwa yana haifar da ƙaƙƙarfan motsin farashi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התראות מופעלות על תנודות משמעותיות במחיר."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "महत्वपूर्ण मूल्य परिवर्तन पर अलर्ट सक्रिय हो जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peringatan dipicu pada pergerakan harga yang signifikan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli avvisi vengono attivati in caso di movimenti significativi dei prezzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "大幅な価格変動が発生するとアラートが発動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가격이 크게 변동하면 알림이 울립니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Makluman mencetuskan pergerakan harga yang ketara."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Waarschuwingen worden geactiveerd bij aanzienlijke prijsbewegingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alerty uruchamiają się w przypadku znacznych wahań cen."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertas são acionados em movimentos significativos de preços."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alertele se declanșează la mișcări semnificative ale prețurilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Оповещения срабатывают при значительных изменениях цены."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Arifa hutumwa kunapokuwa na mabadiliko makubwa ya bei."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การแจ้งเตือนจะเกิดขึ้นเมื่อราคามีการเปลี่ยนแปลงอย่างมีนัยสำคัญ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önemli fiyat hareketlerinde uyarılar tetiklenir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Сповіщення спрацьовують у разі значних змін цін."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "انتباہات اہم قیمت کی چالوں پر متحرک ہوتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cảnh báo sẽ được kích hoạt khi giá biến động đáng kể."
          }
        },
        "zh-Hans": {
          "stringUnit": {
