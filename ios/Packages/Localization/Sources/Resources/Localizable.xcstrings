    "cold_wallet_signed_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "امسح جميع الإطارات بمحفظة المراقبة المتصلة للتحقق من المعاملة وبثها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন পর্যবেক্ষক দিয়ে সব ফ্রেম স্ক্যান করে লেনদেন যাচাই ও সম্প্রচার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Online pozorovatelem naskenujte všechny snímky pro ověření a odeslání transakce."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan alle billeder med onlineobservatøren for at kontrollere og udsende transaktionen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Bilder mit der verbundenen Beobachtungswallet scannen, um die Transaktion zu prüfen und zu übertragen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan every frame with the online observer to validate and broadcast this transaction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Escanee todos los fotogramas con el observador conectado para verificar y transmitir la transacción."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همه فریم‌ها را با ناظر آنلاین اسکن کنید تا تراکنش بررسی و منتشر شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-scan ang lahat ng frame sa online na observer upang suriin at i-broadcast ang transaksiyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Scannez toutes les images avec l’observateur connecté pour vérifier et diffuser la transaction."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba dukkan sassan da mai lura na intanet don tabbatarwa da watsa ma’amala."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "סרקו את כל הפריימים בצופה המקוון כדי לבדוק ולשדר את העסקה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन पर्यवेक्षक से सभी फ़्रेम स्कैन करके लेनदेन जाँचें और प्रसारित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pindai semua bingkai dengan pengamat online untuk memverifikasi dan menyiarkan transaksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scansiona tutti i fotogrammi con l’osservatore online per verificare e trasmettere la transazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン監視ウォレットですべてのフレームを読み取り、取引を検証して配信してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 관찰 지갑으로 모든 프레임을 스캔해 거래를 검증하고 브로드캐스트하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbas semua bingkai dengan pemerhati dalam talian untuk mengesahkan dan menyiarkan transaksi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Scan alle beelden met de online observer om de transactie te controleren en uit te zenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zeskanuj wszystkie klatki obserwatorem online, aby sprawdzić i rozgłosić transakcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Leia todos os quadros com o observador online para verificar e transmitir a transação."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Scanați toate cadrele cu observatorul online pentru verificarea și difuzarea tranzacției."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сканируйте все кадры онлайн-наблюдателем для проверки и отправки транзакции."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Changanua fremu zote kwa mtazamaji mtandaoni ili kuhakiki na kutangaza muamala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สแกนทุกเฟรมด้วยกระเป๋าเฝ้าดูออนไลน์เพื่อตรวจสอบและเผยแพร่ธุรกรรม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlemi doğrulamak ve yayınlamak için tüm kareleri çevrimiçi gözlemciyle tarayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Скануйте всі кадри онлайн-спостерігачем для перевірки й надсилання транзакції."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "آن لائن نگران سے تمام فریم اسکین کریں تاکہ لین دین کی جانچ اور نشر ہو سکے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Quét tất cả khung bằng ví theo dõi trực tuyến để xác minh và phát giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用在线观察钱包扫描完整的签名二维码，校验后广播此交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用線上觀察錢包掃描完整的簽名二維碼，驗證後廣播此交易。"
          }
        }
      }
    },
    "cold_wallet_signer_role": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحفظ المحفظة الباردة على هذا الجهاز المفاتيح وتوقّع المعاملات دون اتصال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসের কোল্ড ওয়ালেট কী সংরক্ষণ করে এবং অফলাইনে লেনদেন স্বাক্ষর করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Studená peněženka v tomto zařízení uchovává klíče a podepisuje transakce offline."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den kolde tegnebog på denne enhed opbevarer nøgler og underskriver transaktioner offline."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Cold Wallet auf diesem Gerät verwahrt die Schlüssel und signiert Transaktionen offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This device's cold wallet stores keys and signs transactions offline."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La cartera fría de este dispositivo guarda las claves y firma las transacciones sin conexión."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول سرد این دستگاه کلیدها را نگه می‌دارد و تراکنش‌ها را آفلاین امضا می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iniimbak ng cold wallet sa device na ito ang mga key at lumalagda ito sa mga transaksyon nang offline."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille froid de cet appareil conserve les clés et signe les transactions hors ligne."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Walat na wajen intanet a wannan na’ura yana adana maɓallai kuma yana sa hannu kan ma’amaloli ba tare da intanet ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארנק הקר במכשיר הזה שומר את המפתחות וחותם על עסקאות במצב לא מקוון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस का कोल्ड वॉलेट कुंजियाँ रखता है और लेनदेन पर ऑफ़लाइन हस्ताक्षर करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet dingin di perangkat ini menyimpan kunci dan menandatangani transaksi secara offline."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio freddo su questo dispositivo conserva le chiavi e firma le transazioni offline."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末のコールドウォレットは鍵を保管し、取引にオフラインで署名します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기의 콜드 지갑은 키를 보관하고 오프라인으로 거래에 서명합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
