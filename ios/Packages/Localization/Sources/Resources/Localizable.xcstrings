    "multisig_withdraw_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع سحب المقترح إلا منشئه ما دام جمع التوقيعات مستمرًا. إنهاء التعاون لا يُبطل التوقيعات التي سبق مشاركتها أو تجميعها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বাক্ষর সংগ্রহ চলাকালীন শুধু প্রস্তাবের তৈরিকারী সেটি প্রত্যাহার করতে পারেন। সহযোগিতা শেষ করলে ইতিমধ্যে শেয়ার করা বা একত্র করা স্বাক্ষর বাতিল হয় না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Návrh může stáhnout pouze jeho autor, dokud se sbírají podpisy. Ukončení spolupráce nezruší již sdílené nebo sestavené podpisy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun opretteren kan trække et forslag tilbage, mens underskrifter indsamles. Afslutning af samarbejdet tilbagekalder ikke underskrifter, der allerede er delt eller samlet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Ersteller kann einen Vorschlag zurückziehen, solange noch Unterschriften gesammelt werden. Das Beenden der Zusammenarbeit widerruft bereits geteilte oder zusammengefügte Signaturen nicht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only the creator can withdraw a proposal that is still collecting signatures. Closing collaboration does not revoke signatures already shared or assembled on-chain."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo el autor puede retirar una propuesta mientras se recopilan firmas. Terminar la colaboración no revoca las firmas ya compartidas o ensambladas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط سازندهٔ پیشنهاد می‌تواند آن را در زمان جمع‌آوری امضا پس بگیرد. پایان همکاری، امضاهای از قبل اشتراک‌گذاشته‌شده یا تجمیع‌شده را باطل نمی‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang gumawa lang ang puwedeng bumawi sa panukala habang nangongolekta pa ng mga lagda. Hindi binabawi ng pagtatapos ng pagtutulungan ang mga lagdang naibahagi o nabuo na."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seul l’auteur peut retirer une proposition tant que les signatures sont en cours de collecte. Mettre fin à la collaboration ne révoque pas les signatures déjà partagées ou assemblées."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wanda ya ƙirƙiri shawarar ne kawai zai iya janye ta yayin da ake tara sa hannu. Ƙare haɗin gwiwa ba ya soke sa hannun da an riga an raba ko haɗa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק יוצר ההצעה יכול למשוך אותה כל עוד נאספות חתימות. סיום שיתוף הפעולה לא מבטל חתימות שכבר שותפו או הורכבו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल प्रस्ताव बनाने वाला उसे वापस ले सकता है, जब हस्ताक्षर अभी इकट्ठे हो रहे हों। सहयोग समाप्त करने से पहले से साझा या जोड़े गए हस्ताक्षर रद्द नहीं होते।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pembuat yang dapat menarik proposal selama tanda tangan masih dikumpulkan. Mengakhiri kolaborasi tidak membatalkan tanda tangan yang sudah dibagikan atau digabungkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo l’autore può ritirare una proposta mentre raccoglie firme. Chiudere la collaborazione non revoca le firme già condivise o assemblate."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名を収集中の提案を取り下げられるのは、その提案の作成者だけです。協力を終了しても、共有済みや組み立て済みの署名は無効になりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명을 수집 중인 제안은 해당 제안의 생성자만 철회할 수 있습니다. 협업을 종료해도 이미 공유되거나 조합된 서명은 취소되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya pencipta boleh menarik balik cadangan semasa tandatangan masih dikumpulkan. Menamatkan kerjasama tidak membatalkan tandatangan yang telah dikongsi atau digabungkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen de maker kan een voorstel intrekken zolang er handtekeningen worden verzameld. Het beëindigen van samenwerking trekt al gedeelde of samengestelde handtekeningen niet in."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko autor może wycofać propozycję, gdy nadal zbierane są podpisy. Zakończenie współpracy nie unieważnia już udostępnionych ani połączonych podpisów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Só o autor pode retirar uma proposta que ainda está coletando assinaturas. Encerrar a colaboração não revoga assinaturas já compartilhadas ou reunidas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Doar autorul poate retrage o propunere care încă strânge semnături. Încheierea colaborării nu revocă semnăturile deja distribuite sau asamblate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только автор может отозвать предложение, пока собираются подписи. Завершение сотрудничества не отменяет уже переданные или объединённые подписи."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ni mtayarishaji wa pendekezo pekee anayeweza kuliondoa wakati saini bado zinakusanywa. Kumaliza ushirikiano hakubatilishi saini ambazo tayari zimeshirikiwa au kuunganishwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีเพียงผู้สร้างข้อเสนอที่ถอนข้อเสนอได้ขณะยังรวบรวมลายเซ็น การสิ้นสุดความร่วมมือไม่ยกเลิกลายเซ็นที่แชร์หรือประกอบไว้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca öneriyi oluşturan kişi, imza toplama sürerken öneriyi geri çekebilir. İş birliğini bitirmek, önceden paylaşılmış veya birleştirilmiş imzaları iptal etmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише автор може відкликати пропозицію, доки збираються підписи. Завершення співпраці не скасовує вже передані або об’єднані підписи."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف تجویز بنانے والا اسے واپس لے سکتا ہے، جب دستخط ابھی جمع ہو رہے ہوں۔ تعاون ختم کرنے سے پہلے سے مشترک یا یکجا کیے گئے دستخط منسوخ نہیں ہوتے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ người tạo mới có thể rút lại đề xuất đang thu thập chữ ký. Dừng cộng tác không thu hồi chữ ký đã chia sẻ hoặc kết hợp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅发起人可撤回尚未齐签的提案。关闭协作不会在链上撤销已分享或已组装的签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅發起人可撤回尚未完成簽名的提案。關閉協作不會在鏈上撤銷已分享或已組裝的簽名。"
          }
        }
      }
    },
