    "multisig_invite_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتوي الدعوات على قواعد المحفظة ومعلومات الأعضاء العامة فقط، ولا تتضمن مفاتيح خاصة أو عبارات استرداد. تحقق من القواعد عبر قناة موثوقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণে ওয়ালেটের নিয়ম ও সদস্যদের প্রকাশ্য তথ্য থাকে, ব্যক্তিগত কী বা পুনরুদ্ধার বাক্যাংশ কখনো থাকে না। বিশ্বস্ত মাধ্যমে নিয়ম যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozvánky obsahují pravidla peněženky a veřejné údaje členů, nikdy soukromé klíče ani obnovovací fráze. Pravidla ověřte důvěryhodným kanálem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitationer indeholder tegnebogens regler og offentlige medlemsoplysninger, aldrig private nøgler eller gendannelsesfraser. Kontrollér reglerne via en betroet kanal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladungen enthalten Wallet-Regeln und öffentliche Mitgliedsdaten, niemals private Schlüssel oder Wiederherstellungsphrasen. Prüfe die Regeln über einen vertrauenswürdigen Kanal."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitations contain wallet rules and public member information, never private keys or recovery phrases. Verify the rules through a trusted channel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las invitaciones contienen las reglas de la billetera y datos públicos de los miembros, nunca claves privadas ni frases de recuperación. Verifica las reglas por un canal de confianza."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوت‌نامه فقط شامل قواعد کیف پول و اطلاعات عمومی اعضاست، نه کلید خصوصی یا عبارت بازیابی. قواعد را از یک مسیر مورد اعتماد بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tuntunin ng wallet at pampublikong impormasyon ng mga miyembro lang ang laman ng imbitasyon, hindi pribadong susi o parirala sa pagbawi. Suriin ang tuntunin sa mapagkakatiwalaang paraan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les invitations contiennent les règles du portefeuille et les informations publiques des membres, jamais de clés privées ni de phrases de récupération. Vérifiez les règles par un canal fiable."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Gayyata tana ɗauke da ƙa’idojin walat da bayanan mambobi na jama’a kawai, ba keɓaɓɓen maɓalli ko kalmomin dawo da walat ba. Duba ƙa’idoji ta hanyar da aka amince da ita."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההזמנות כוללות את כללי הארנק ומידע ציבורי על החברים, ולעולם לא מפתחות פרטיים או מילות שחזור. אמת את הכללים בערוץ מהימן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रण में वॉलेट नियम और सदस्यों की सार्वजनिक जानकारी होती है, निजी कुंजी या गुप्त वाक्यांश कभी नहीं। भरोसेमंद माध्यम से नियम की जाँच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undangan berisi aturan dompet dan informasi publik anggota, bukan kunci privat atau frasa pemulihan. Verifikasi aturan melalui saluran tepercaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli inviti contengono regole del portafoglio e informazioni pubbliche sui membri, mai chiavi private o frasi di recupero. Verifica le regole tramite un canale fidato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待にはルールと公開メンバー情報のみ含まれ、秘密鍵やリカバリーフレーズは含まれません。信頼できる経路でルールを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대에는 규칙과 공개 정보만 포함되며 개인 키나 복구 구문은 없습니다. 신뢰할 수 있는 경로로 규칙을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemputan mengandungi peraturan dan maklumat awam ahli, bukan kunci peribadi atau frasa pemulihan. Semak melalui saluran yang dipercayai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Uitnodigingen bevatten regels en openbare ledengegevens, nooit privésleutels of herstelzinnen. Controleer de regels via een vertrouwd kanaal."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaproszenia zawierają zasady i publiczne dane członków, nigdy klucze prywatne ani frazy odzyskiwania. Sprawdź zasady zaufanym kanałem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os convites contêm regras e informações públicas dos membros, nunca chaves privadas ou frases de recuperação. Verifique as regras por um canal confiável."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitațiile conțin reguli și date publice ale membrilor, niciodată chei private sau fraze de recuperare. Verifică regulile printr-un canal de încredere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашения содержат правила и открытые данные участников, но не закрытые ключи или фразы восстановления. Проверьте правила по доверенному каналу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mialiko ina kanuni na taarifa za umma za wanachama, si funguo za siri au misemo ya urejeshaji. Hakiki kanuni kupitia njia inayoaminika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำเชิญมีเพียงกฎและข้อมูลสาธารณะของสมาชิก ไม่มีคีย์ส่วนตัวหรือวลีกู้คืน ตรวจสอบกฎผ่านช่องทางที่เชื่อถือได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davetler kuralları ve üyelerin açık bilgilerini içerir; özel anahtar veya kurtarma ifadesi içermez. Kuralları güvenilir bir kanaldan doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрошення містять правила та публічні дані учасників, але не приватні ключі чи фрази відновлення. Перевірте правила довіреним каналом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوت میں اصول اور اراکین کی عوامی معلومات ہوتی ہیں، نجی کلید یا بحالی کے الفاظ نہیں۔ قابلِ اعتماد ذریعے سے اصول کی تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời mời chứa quy tắc và thông tin công khai, không chứa khóa riêng hay cụm từ khôi phục. Kiểm tra quy tắc qua kênh tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请信息只包含钱包与成员规则，不包含私钥或助记词。请通过可信渠道核对规则后接受邀请。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請資訊只包含錢包與成員規則，不包含私鑰或助記詞。請透過可信渠道核對規則後接受邀請。"
          }
        }
      }
    },
    "multisig_invite_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد جميع الأعضاء لقواعد المحفظة نفسها"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সব সদস্য একই ওয়ালেটের নিয়ম নিশ্চিত করুন"
          }
