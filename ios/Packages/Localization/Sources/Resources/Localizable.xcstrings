    "bsv_hd_settings_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل جذر الحساب وليس المسار الكامل لعنوان الاستقبال. تضيف عناوين الاستقبال والباقي /0/index و/1/index. احتفظ بإعدادات النسخة الأصلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অ্যাকাউন্টের মূল পথ লিখুন, সম্পূর্ণ গ্রহণের ঠিকানার পথ নয়। গ্রহণ ও ফেরত অর্থের ঠিকানা /0/index এবং /1/index যোগ করে। মূল ব্যাকআপের সেটিং রাখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zadejte kořen účtu, ne celou cestu přijímací adresy. Adresy příjmu a vrácení přidávají /0/index a /1/index. Zachovejte původní nastavení."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiv kontoroden, ikke hele modtageradressens sti. Modtager- og byttepengeadresser tilføjer /0/index og /1/index. Bevar de oprindelige indstillinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Kontowurzel eingeben, nicht den vollständigen Empfangspfad. Empfangs- und Wechselgeldadressen hängen /0/index und /1/index an. Ursprüngliche Sicherungseinstellungen beibehalten."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Set the account root, not the complete receive-address path. Receive and change addresses are derived below /0/index and /1/index. Keep the original backup settings."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduzca la raíz de cuenta, no la ruta completa de recepción. Las direcciones de recepción y cambio añaden /0/index y /1/index. Conserve los ajustes originales."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ریشه حساب را وارد کنید، نه مسیر کامل نشانی دریافت. نشانی‌های دریافت و باقیمانده /0/index و /1/index را اضافه می‌کنند. تنظیمات پشتیبان اصلی را حفظ کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang root ng account, hindi ang buong path ng address ng pagtanggap. Nagdadagdag ng /0/index at /1/index ang mga address ng pagtanggap at sukli. Panatilihin ang orihinal na setting ng backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez la racine du compte, pas le chemin complet de réception. Les adresses de réception et de monnaie rendue ajoutent /0/index et /1/index. Gardez les paramètres de la sauvegarde originale."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Rubuta tushen hanyar asusu, ba cikakkiyar hanyar adireshin karɓa ba. Adiresoshin karɓa da canji suna ƙara /0/index da /1/index. Riƙe saitunan ajiyar asali."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו את שורש החשבון, לא את הנתיב המלא של כתובת הקבלה. כתובות קבלה ועודף מוסיפות /0/index ו־/1/index. שמרו את הגדרות הגיבוי המקוריות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "खाते का मूल पथ दर्ज करें, पूरा प्राप्ति पता पथ नहीं। प्राप्ति और वापसी के पते /0/index और /1/index जोड़ते हैं। मूल बैकअप की सेटिंग रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan akar akun, bukan jalur lengkap alamat penerimaan. Alamat penerimaan dan kembalian menambahkan /0/index dan /1/index. Pertahankan pengaturan cadangan asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la radice dell’account, non il percorso completo di ricezione. Gli indirizzi di ricezione e del resto aggiungono /0/index e /1/index. Mantieni le impostazioni originali."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な受取アドレスのパスではなく、アカウントのルートを入力します。受取とお釣りは /0/index と /1/index を追加して派生します。元のバックアップ設定を保持してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 수신 주소 경로가 아닌 계정 루트를 입력하세요. 수신 주소와 거스름돈 주소는 /0/index와 /1/index를 추가해 파생됩니다. 원래 백업 설정을 보존하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan akar akaun, bukan laluan penuh alamat penerimaan. Alamat penerimaan dan baki pulangan menambah /0/index dan /1/index. Kekalkan tetapan sandaran asal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer de accountwortel in, niet het volledige ontvangstadrespad. Ontvangst- en wisselgeldadressen voegen /0/index en /1/index toe. Behoud de oorspronkelijke instellingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Podaj korzeń konta, nie pełną ścieżkę adresu odbiorczego. Adresy odbioru i reszty dodają /0/index i /1/index. Zachowaj pierwotne ustawienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informe a raiz da conta, não o caminho completo de recebimento. Endereços de recebimento e troco acrescentam /0/index e /1/index. Preserve os ajustes originais."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduceți rădăcina contului, nu calea completă a adresei de primire. Adresele de primire și rest adaugă /0/index și /1/index. Păstrați setările originale."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажите корень счёта, а не полный путь адреса получения. Для получения и сдачи добавляются /0/index и /1/index. Сохраните исходные настройки."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka njia ya mzizi wa akaunti, si njia kamili ya anwani ya kupokea. Anwani za kupokea na chenji huongeza /0/index na /1/index. Hifadhi mipangilio ya nakala ya awali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กรอกเส้นทางรากบัญชี ไม่ใช่เส้นทางที่อยู่รับเงินแบบเต็ม ที่อยู่รับเงินและเงินทอนเพิ่ม /0/index และ /1/index เก็บการตั้งค่าจากข้อมูลสำรองเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam alım adresi yolunu değil, hesap kökünü girin. Alım ve para üstü adresleri /0/index ve /1/index ekler. Orijinal yedek ayarlarını koruyun."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Укажіть корінь рахунку, а не повний шлях адреси отримання. Для отримання й решти додаються /0/index і /1/index. Збережіть початкові налаштування."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اکاؤنٹ کا بنیادی راستہ لکھیں، مکمل وصولی پتے کا راستہ نہیں۔ وصولی اور واپس آنے والی رقم کے پتے /0/index اور /1/index شامل کرتے ہیں۔ اصل بیک اپ کی ترتیبات رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập đường dẫn gốc tài khoản, không phải đường dẫn đầy đủ của địa chỉ nhận. Địa chỉ nhận và tiền thừa thêm /0/index và /1/index. Giữ cài đặt của bản sao lưu gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这里填写账户根路径，不是完整收款地址路径。收款和找零地址分别在其下追加 /0/index 和 /1/index，请保留原备份中的设置。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "這裡填寫帳戶根路徑，不是完整收款地址路徑。收款和找零地址分別在其下追加 /0/index 和 /1/index，請保留原備份中的設定。"
          }
        }
      }
    },
