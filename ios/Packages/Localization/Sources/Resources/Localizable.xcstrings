    "multisig_funding_broadcast_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أُرسلت المعاملة إلى الشبكة. انتظر تأكيدها على سلسلة الكتل. يتطلب الإنفاق لاحقًا بلوغ الحد المطلوب للتوقيعات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "লেনদেনটি নেটওয়ার্কে পাঠানো হয়েছে। ব্লকচেইনে নিশ্চিতকরণের জন্য অপেক্ষা করুন। পরে খরচ করতে প্রয়োজনীয় স্বাক্ষরের সংখ্যা পূরণ করতে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakce byla odeslána do sítě. Vyčkejte na potvrzení v blockchainu. Další výdaje vyžadují stanovený počet podpisů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaktionen er sendt til netværket. Vent på bekræftelse på blockchainen. Senere forbrug kræver det fastsatte antal underskrifter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Transaktion wurde an das Netzwerk übermittelt. Warte auf die Bestätigung in der Blockchain. Für spätere Ausgaben gilt die Signaturschwelle."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The transaction was submitted to the network. Wait for on-chain confirmation. Future spending requires the multisig threshold."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La transacción se envió a la red. Espera la confirmación en la cadena. Para gastar los fondos después, se debe alcanzar el umbral de firmas."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش به شبکه ارسال شد. منتظر تأیید روی بلاک‌چین بمانید. خرج کردن بعدی نیازمند رسیدن به حد نصاب امضا است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naipadala na ang transaksyon sa network. Hintayin ang kumpirmasyon sa blockchain. Kailangan pa rin ang itinakdang bilang ng lagda sa susunod na paggastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction a été envoyée au réseau. Attendez sa confirmation sur la blockchain. Toute dépense ultérieure devra atteindre le seuil de signatures."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An tura ma’amalar zuwa hanyar sadarwa. Jira tabbatarwa a blockchain. Kashe kuɗin daga baya na bukatar adadin sa hannun da aka kayyade."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "העסקה נשלחה לרשת. יש להמתין לאישור בבלוקצ׳יין. הוצאות עתידיות מחייבות עמידה בסף החתימות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लेनदेन नेटवर्क को भेज दिया गया है। ब्लॉकचेन पर पुष्टि की प्रतीक्षा करें। बाद में खर्च करने के लिए ज़रूरी हस्ताक्षरों की संख्या पूरी करनी होगी।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi telah dikirim ke jaringan. Tunggu konfirmasi di blockchain. Pengeluaran berikutnya harus memenuhi ambang tanda tangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La transazione è stata inviata alla rete. Attendi la conferma sulla blockchain. Per spendere i fondi in seguito serve raggiungere la soglia di firme."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トランザクションをネットワークに送信しました。ブロックチェーンの承認をお待ちください。今後の支出には必要署名数を満たす必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트랜잭션을 네트워크에 제출했습니다. 블록체인 확인을 기다리세요. 이후 지출에는 필요 서명 수를 충족해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Transaksi telah dihantar ke rangkaian. Tunggu pengesahan pada blockchain. Perbelanjaan seterusnya mesti memenuhi ambang tandatangan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De transactie is naar het netwerk gestuurd. Wacht op bevestiging in de blockchain. Voor latere uitgaven geldt het vereiste aantal handtekeningen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja została wysłana do sieci. Poczekaj na potwierdzenie w blockchainie. Późniejsze wydatki wymagają osiągnięcia progu podpisów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A transação foi enviada à rede. Aguarde a confirmação na blockchain. Os gastos futuros exigem o número mínimo de assinaturas."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Tranzacția a fost trimisă în rețea. Așteaptă confirmarea în blockchain. Cheltuielile ulterioare necesită atingerea pragului de semnături."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакция отправлена в сеть. Дождитесь подтверждения в блокчейне. Для дальнейших расходов нужно достичь порога подписей."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala umetumwa kwenye mtandao. Subiri uthibitisho kwenye blockchain. Matumizi ya baadaye yanahitaji kiwango cha saini kilichowekwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งธุรกรรมไปยังเครือข่ายแล้ว โปรดรอการยืนยันบนบล็อกเชน การใช้เงินภายหลังยังต้องมีลายเซ็นครบตามเกณฑ์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem ağa gönderildi. Zincir üzerindeki onayı bekleyin. Sonraki harcamalar için imza eşiğine ulaşılmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Транзакцію надіслано в мережу. Дочекайтеся підтвердження в блокчейні. Для подальших витрат потрібно досягти порогу підписів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرانزیکشن نیٹ ورک کو بھیج دی گئی ہے۔ بلاک چین پر تصدیق کا انتظار کریں۔ بعد کے اخراجات کے لیے دستخطوں کی مطلوبہ حد پوری کرنا ضروری ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch đã được gửi lên mạng. Hãy chờ xác nhận trên chuỗi. Các khoản chi sau này phải đạt ngưỡng chữ ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已提交网络，仍需等待链上确认。后续支出须达到多签门槛。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "交易已提交網路，仍需等待鏈上確認。後續支出須達到多簽門檻。"
          }
        }
      }
    },
