        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci un indirizzo del portafoglio sulla rete selezionata per osservarlo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選択したネットワークのウォレットアドレスを入力して閲覧専用で追加します"
