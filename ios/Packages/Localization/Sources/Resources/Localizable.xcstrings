    "cold_wallet_choose_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط على بطاقة للتبديل. تستخدم الإجراءات أدناه المحفظة المحددة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "বদলাতে কার্ডে ট্যাপ করুন। নিচের কাজগুলি নির্বাচিত ওয়ালেটে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Klepnutím na kartu přepnete peněženku. Akce níže používají vybranou peněženku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tryk på et kort for at skifte. Handlingerne nedenfor bruger den valgte wallet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zum Wechseln auf eine Karte tippen. Die Aktionen unten verwenden die ausgewählte Wallet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap a card to switch. The actions below use the selected wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Toca una tarjeta para cambiar. Las acciones siguientes usan la billetera seleccionada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای تغییر، روی کارت بزنید. عملیات زیر از کیف پول انتخاب‌شده استفاده می‌کنند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
