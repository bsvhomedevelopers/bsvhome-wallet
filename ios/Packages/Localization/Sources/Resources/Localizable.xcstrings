    "multisig_creation_no_matches": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لم يتم العثور على محفظة مطابقة حتى الآن. يمكنك التحقق مجددًا؛ لن يُعاد إرسال طلب الإنشاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মিলে যাওয়া কোনো ওয়ালেট এখনও পাওয়া যায়নি। আবার খুঁজতে পারেন; তৈরির অনুরোধ আবার পাঠানো হবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatím nebyla nalezena odpovídající peněženka. Můžete hledání zopakovat; požadavek na vytvoření se znovu neodešle."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Der blev endnu ikke fundet en matchende tegnebog. Du kan tjekke igen; anmodningen om oprettelse sendes ikke igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Noch keine passende Wallet gefunden. Du kannst erneut suchen; die Erstellung wird nicht erneut angefordert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No matching wallet was found. You can check again; the creation will not be resent."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Aún no se encontró ninguna billetera coincidente. Puedes volver a consultar; no se reenviará la solicitud de creación."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنوز کیف پول مطابقی پیدا نشده است. می‌توانید دوباره بررسی کنید؛ درخواست ایجاد دوباره ارسال نمی‌شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Wala pang nakitang katugmang wallet. Maaari mong tingnan muli; hindi muling ipapadala ang kahilingan sa paglikha."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun portefeuille correspondant trouvé pour le moment. Vous pouvez vérifier à nouveau ; la demande de création ne sera pas renvoyée."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Har yanzu ba a sami walat da ya dace ba. Za a iya sake dubawa; ba za a sake aika buƙatar ƙirƙira ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדיין לא נמצא ארנק תואם. אפשר לבדוק שוב; בקשת היצירה לא תישלח מחדש."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अभी कोई मेल खाने वाला वॉलेट नहीं मिला। आप फिर से जाँच सकते हैं; बनाने का अनुरोध दोबारा नहीं भेजा जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Belum ditemukan dompet yang cocok. Anda dapat memeriksa lagi; permintaan pembuatan tidak akan dikirim ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Non è stato ancora trovato un portafoglio corrispondente. Puoi controllare di nuovo; la richiesta di creazione non verrà inviata nuovamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "一致するウォレットはまだ見つかっていません。再確認できます。作成リクエストは再送信されません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 일치하는 지갑을 찾지 못했습니다. 다시 확인할 수 있으며, 생성 요청은 재전송되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet yang sepadan belum ditemui. Anda boleh menyemak lagi; permintaan penciptaan tidak akan dihantar semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is nog geen overeenkomende wallet gevonden. Je kunt opnieuw zoeken; de aanvraag om een wallet aan te maken wordt niet opnieuw verstuurd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono jeszcze pasującego portfela. Możesz sprawdzić ponownie; żądanie utworzenia nie zostanie wysłane ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma carteira correspondente foi encontrada ainda. Você pode verificar novamente; a solicitação de criação não será reenviada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu a fost găsit încă niciun portofel corespunzător. Poți verifica din nou; cererea de creare nu va fi retrimisă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подходящий кошелёк пока не найден. Можно проверить ещё раз; запрос на создание повторно отправлен не будет."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bado hakuna pochi inayolingana iliyopatikana. Unaweza kuangalia tena; ombi la kuunda halitatumwa tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่พบกระเป๋าเงินที่ตรงกัน คุณตรวจสอบอีกครั้งได้ โดยคำขอสร้างจะไม่ถูกส่งซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Henüz eşleşen bir cüzdan bulunamadı. Tekrar kontrol edebilirsiniz; oluşturma isteği yeniden gönderilmeyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Відповідний гаманець поки не знайдено. Можна перевірити ще раз; запит на створення не надсилатиметься повторно."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ابھی کوئی مماثل والیٹ نہیں ملا۔ آپ دوبارہ دیکھ سکتے ہیں؛ بنانے کی درخواست دوبارہ نہیں بھیجی جائے گی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chưa tìm thấy ví khớp thông tin. Bạn có thể kiểm tra lại; yêu cầu tạo sẽ không được gửi lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "暂未找到匹配的钱包，可再次查询；不会重新提交创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "暫未找到相符的錢包，可再次查詢；不會重新提交建立。"
          }
        }
      }
    },
    "multisig_creation_uncertain_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "نتيجة إنشاء المحفظة غير مؤكدة. تحقق من وجود محفظة مطابقة قبل إنشاء محفظة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেট তৈরির ফলাফল নিশ্চিত নয়। আরেকটি ওয়ালেট তৈরি করার আগে মিলে যাওয়া কোনো ওয়ালেট আছে কি না দেখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledek vytvoření není jistý. Než začnete vytvářet další peněženku, vyhledejte odpovídající peněženku."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet af oprettelsen er usikkert. Se efter en matchende tegnebog, før du opretter en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis der Erstellung ist unklar. Suche nach einer passenden Wallet, bevor du eine weitere erstellst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The creation result is uncertain. Check for a matching wallet before starting another creation."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El resultado de la creación es incierto. Busca una billetera coincidente antes de crear otra."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجهٔ ایجاد مشخص نیست. پیش از ایجاد کیف پولی دیگر، بررسی کنید آیا کیف پول مطابقی وجود دارد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi pa tiyak ang resulta ng paglikha. Maghanap muna ng katugmang wallet bago lumikha ng panibago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat de la création est incertain. Recherchez un portefeuille correspondant avant d’en créer un autre."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a tabbatar da sakamakon ƙirƙirar walat ba. Bincika walat da ya dace kafin ƙirƙirar wani."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוצאת היצירה אינה ודאית. יש לבדוק אם קיים ארנק תואם לפני יצירת ארנק נוסף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट बनाने का परिणाम अभी निश्चित नहीं है। दूसरा वॉलेट बनाने से पहले मेल खाने वाला वॉलेट खोजें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil pembuatan belum pasti. Cari dompet yang cocok sebelum membuat dompet lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’esito della creazione è incerto. Cerca un portafoglio corrispondente prima di crearne un altro."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "作成結果を確認できません。別のウォレットを作成する前に、一致するウォレットがないか確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "생성 결과가 불확실합니다. 다른 지갑을 만들기 전에 일치하는 지갑이 있는지 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil penciptaan belum pasti. Semak dompet yang sepadan sebelum mencipta dompet lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resultaat van het aanmaken is onzeker. Zoek eerst naar een overeenkomende wallet voordat je een nieuwe aanmaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik utworzenia jest niepewny. Przed utworzeniem kolejnego portfela sprawdź, czy istnieje pasujący portfel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado da criação é incerto. Procure uma carteira correspondente antes de criar outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatul creării este incert. Caută un portofel corespunzător înainte de a crea altul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат создания пока неясен. Найдите подходящий кошелёк, прежде чем создавать новый."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Matokeo ya kuunda pochi hayana uhakika. Tafuta pochi inayolingana kabla ya kuunda nyingine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยังไม่แน่ใจผลการสร้าง โปรดตรวจหากระเป๋าเงินที่ตรงกันก่อนสร้างกระเป๋าเงินใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Oluşturma sonucu belirsiz. Yeni bir cüzdan oluşturmadan önce eşleşen bir cüzdan olup olmadığını kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат створення поки невідомий. Перш ніж створювати інший гаманець, перевірте, чи є відповідний гаманець."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والیٹ بنانے کا نتیجہ ابھی غیر یقینی ہے۔ دوسرا والیٹ بنانے سے پہلے مماثل والیٹ تلاش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả tạo chưa xác định. Hãy tìm ví khớp thông tin trước khi tạo ví khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建结果尚未确定，请先查询匹配的钱包，再开始新的创建。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立結果尚未確定，請先查詢相符的錢包，再建立新的錢包。"
          }
        }
      }
    },
