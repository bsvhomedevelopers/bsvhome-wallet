    "multisig_invalid_invite": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الدعوة غير صالحة أو منتهية أو مستخدمة أو تغيّرت. اطلب رمزًا جديدًا من المنشئ، ثم عاينه وراجعه مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণটি অবৈধ, মেয়াদোত্তীর্ণ, ব্যবহৃত বা পরিবর্তিত। তৈরিকারীর কাছে নতুন কোড চান, তারপর আবার পূর্বরূপ দেখে যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pozvánka je neplatná, vypršela, byla použita nebo změněna. Požádejte tvůrce o nový kód a znovu zkontrolujte náhled."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitationen er ugyldig, udløbet, brugt eller ændret. Bed opretteren om en ny kode, og kontrollér forhåndsvisningen igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einladung ist ungültig, abgelaufen, verwendet oder geändert. Bitte den Ersteller um einen neuen Code und prüfe dessen Vorschau erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The invitation is invalid, expired, used or changed. Ask the creator for a new code, then preview and review it again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La invitación no es válida, venció, se usó o cambió. Pide un nuevo código al creador y vuelve a previsualizarlo y revisarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوت نامعتبر، منقضی، استفاده‌شده یا تغییرکرده است. از سازنده کد تازه‌ای بخواهید، سپس پیش‌نمایش آن را دوباره بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi valid, nag-expire, nagamit o nabago ang imbitasyon. Humingi ng bagong code sa gumawa, saka i-preview at suriin muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’invitation est invalide, expirée, utilisée ou modifiée. Demandez un nouveau code au créateur, puis prévisualisez et vérifiez-le à nouveau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Gayyatar ba ta inganta ba, ta ƙare, an yi amfani da ita ko ta canza. Nemi sabuwar lamba daga wanda ya ƙirƙire ta, sannan ka sake dubawa da tantancewa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההזמנה לא תקפה, פגה, נוצלה או השתנתה. יש לבקש מהיוצר קוד חדש, ואז לעיין בתצוגה המקדימה ולבדוק שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रण अमान्य, समाप्त, इस्तेमाल किया हुआ या बदला हुआ है। बनाने वाले से नया कोड माँगें, फिर पूर्वावलोकन देखकर दोबारा जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undangan tidak valid, kedaluwarsa, sudah digunakan, atau berubah. Minta kode baru dari pembuat, lalu pratinjau dan tinjau lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’invito non è valido, è scaduto, è stato usato o è cambiato. Chiedi un nuovo codice al creatore e controllane nuovamente l’anteprima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待が無効、期限切れ、使用済み、または変更されています。作成者に新しいコードを依頼し、プレビューから再確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대가 유효하지 않거나 만료, 사용 또는 변경되었습니다. 생성자에게 새 코드를 요청한 뒤 미리 보고 다시 검토하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemputan tidak sah, tamat tempoh, telah digunakan atau berubah. Minta kod baharu daripada pencipta, kemudian pratonton dan semak semula."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De uitnodiging is ongeldig, verlopen, gebruikt of gewijzigd. Vraag de maker om een nieuwe code en bekijk en controleer die opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zaproszenie jest nieprawidłowe, wygasło, zostało użyte lub zmienione. Poproś twórcę o nowy kod i ponownie sprawdź podgląd."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O convite é inválido, expirou, foi usado ou mudou. Peça um novo código ao criador e confira novamente a prévia."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitația este nevalidă, expirată, folosită sau modificată. Cere creatorului un cod nou, apoi previzualizează-l și verifică-l din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Приглашение недействительно, истекло, использовано или изменилось. Попросите создателя прислать новый код и заново просмотрите и проверьте его."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mwaliko si halali, muda wake umeisha, umetumiwa au umebadilika. Mwombe mwanzilishi msimbo mpya, kisha uangalie na uhakiki tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำเชิญไม่ถูกต้อง หมดอายุ ใช้แล้ว หรือเปลี่ยนแปลง โปรดขอรหัสใหม่จากผู้สร้าง แล้วดูตัวอย่างและตรวจสอบอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet geçersiz, süresi dolmuş, kullanılmış veya değişmiş. Oluşturandan yeni kod isteyin, ardından önizleyip yeniden inceleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрошення недійсне, прострочене, використане або змінене. Попросіть творця надати новий код і знову перегляньте та перевірте його."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوت غلط، زائد المیعاد، استعمال شدہ یا تبدیل شدہ ہے۔ بنانے والے سے نیا کوڈ لیں، پھر پیش نظارہ دیکھ کر دوبارہ جانچیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Lời mời không hợp lệ, hết hạn, đã dùng hoặc thay đổi. Xin mã mới từ người tạo, rồi xem trước và kiểm tra lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "邀请无效、过期、已使用或已变化。请向创建者获取新代码，重新预览并核对。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "邀請無效、過期、已使用或已變更。請向建立者取得新邀請碼，重新預覽並核對。"
          }
        }
      }
    },
