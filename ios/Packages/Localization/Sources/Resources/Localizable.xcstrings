    "multisig_create_confirmation_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ادعُ جميع الأعضاء للتأكيد قبل استقبال الأموال. يجب ألا يجمع أي عضو المفاتيح الخاصة للأعضاء الآخرين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অর্থ গ্রহণের আগে সব সদস্যকে নিশ্চিত করতে আমন্ত্রণ জানান। কেউ অন্য সদস্যের ব্যক্তিগত কী সংগ্রহ করবেন না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před příjmem prostředků pozvěte všechny členy k potvrzení. Nikdo nesmí shromažďovat soukromé klíče ostatních členů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Inviter alle medlemmer til at bekræfte før modtagelse af midler. Ingen må indsamle andre medlemmers private nøgler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lade alle Mitglieder zur Bestätigung ein, bevor du Geld empfängst. Niemand darf die privaten Schlüssel anderer Mitglieder sammeln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invite all members to confirm before receiving funds. No member should collect another member’s private key."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita a todos los miembros a confirmar antes de recibir fondos. Ningún miembro debe recopilar las claves privadas de los demás."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از دریافت دارایی، از همهٔ اعضا برای تأیید دعوت کنید. هیچ عضوی نباید کلید خصوصی دیگران را جمع‌آوری کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Imbitahan ang lahat na magkumpirma bago tumanggap ng pondo. Walang miyembrong dapat mangolekta ng pribadong susi ng iba."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Invitez tous les membres à confirmer avant de recevoir des fonds. Aucun membre ne doit recueillir les clés privées des autres."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Gayyaci dukkan mambobi su tabbatar kafin karɓar kuɗi. Kada wani mamba ya tattara keɓaɓɓen maɓallin wani."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזמן את כל החברים לאשר לפני קבלת כספים. אסור לאף חבר לאסוף מפתחות פרטיים של חברים אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राशि प्राप्त करने से पहले सभी सदस्यों को पुष्टि के लिए आमंत्रित करें। कोई भी सदस्य दूसरे की निजी कुंजी इकट्ठा न करे।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Undang semua anggota untuk mengonfirmasi sebelum menerima dana. Anggota tidak boleh mengumpulkan kunci privat anggota lain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Invita tutti i membri a confermare prima di ricevere fondi. Nessuno deve raccogliere le chiavi private degli altri membri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入金前に全員を招待して確認してください。他のメンバーの秘密鍵を集めてはいけません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "자금을 받기 전에 전원을 초대해 확인하세요. 다른 구성원의 개인 키를 수집하면 안 됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Jemput semua ahli mengesahkan sebelum menerima dana. Jangan kumpulkan kunci peribadi ahli lain."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Laat alle leden bevestigen voordat u geld ontvangt. Verzamel nooit de privésleutel van een ander lid."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed odbieraniem środków poproś wszystkich o potwierdzenie. Żaden członek nie powinien zbierać cudzych kluczy prywatnych."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Convide todos a confirmar antes de receber fundos. Nenhum membro deve coletar a chave privada de outro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Invită toți membrii să confirme înainte de a primi fonduri. Nimeni nu trebuie să colecteze cheia privată a altui membru."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед приёмом средств пригласите всех подтвердить правила. Никто не должен собирать закрытые ключи других участников."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Alika wote wathibitishe kabla ya kupokea fedha. Hakuna anayepaswa kukusanya funguo za siri za wengine."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เชิญทุกคนให้ยืนยันก่อนรับเงิน สมาชิกไม่ควรเก็บคีย์ส่วนตัวของคนอื่น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fon almadan önce tüm üyeleri onaya davet edin. Hiçbir üye diğerinin özel anahtarını toplamamalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До отримання коштів запросіть усіх підтвердити правила. Ніхто не має збирати приватні ключі інших учасників."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رقم وصول کرنے سے پہلے سب سے تصدیق لیں۔ کوئی رکن دوسرے کی نجی کلید جمع نہ کرے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mời tất cả xác nhận trước khi nhận tiền. Không thành viên nào được thu thập khóa riêng của người khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建后邀请所有成员确认，再开始收款。任何一位成员都不应收集其他成员的私钥。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立後邀請所有成員確認，再開始收款。任何一位成員都不應收集其他成員的私鑰。"
          }
        }
      }
    },
