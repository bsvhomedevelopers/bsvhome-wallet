    "wowpay_receive_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "شارك رمز QR أو عنوان المحفظة لتلقي المدفوعات بسرعة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দ্রুত পেমেন্ট পেতে আপনার QR কোড বা ওয়ালেট ঠিকানা শেয়ার করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Sdílejte QR kód nebo adresu peněženky pro rychlý příjem plateb"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Del din QR-kode eller walletadresse for hurtigt at modtage betalinger"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Teile deinen QR-Code oder deine Wallet-Adresse, um schnell Zahlungen zu empfangen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Share your QR code or wallet address to receive payments quickly"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Comparte tu código QR o dirección de billetera para recibir pagos rápidamente"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای دریافت سریع پرداخت، کد QR یا آدرس کیف پول خود را به اشتراک بگذارید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ibahagi ang QR code o address ng wallet mo para mabilis na makatanggap ng bayad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Partagez votre code QR ou votre adresse de portefeuille pour recevoir des paiements rapidement"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Raba lambar QR ko adireshin walat ɗinka don karɓar kuɗi cikin sauri"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שתף קוד QR או כתובת ארנק כדי לקבל תשלומים במהירות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जल्दी भुगतान पाने के लिए अपना QR कोड या वॉलेट पता साझा करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bagikan kode QR atau alamat dompet Anda untuk menerima pembayaran dengan cepat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Condividi il codice QR o l’indirizzo del wallet per ricevere pagamenti rapidamente"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QRコードや受取アドレスを共有して、すばやく受け取り"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 코드나 지갑 주소를 공유하여 빠르게 결제를 받으세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kongsi kod QR atau alamat dompet anda untuk menerima bayaran dengan cepat"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Deel je QR-code of walletadres om snel betalingen te ontvangen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Udostępnij kod QR lub adres portfela, aby szybko otrzymywać płatności"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compartilhe seu código QR ou endereço da carteira para receber pagamentos rapidamente"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Distribuie codul QR sau adresa portofelului pentru a primi plăți rapid"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Поделитесь QR-кодом или адресом кошелька для быстрого получения платежей"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiriki msimbo wako wa QR au anwani ya pochi ili upokee malipo haraka"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
