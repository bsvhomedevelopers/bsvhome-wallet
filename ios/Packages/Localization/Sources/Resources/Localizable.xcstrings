    "wowpay_import_private_key_security_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أدخل مفتاحك الخاص في مكان خاص. لا تشاركه مع أي شخص."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নির্জন স্থানে ব্যক্তিগত কী লিখুন। এটি কখনো কারও সঙ্গে শেয়ার করবেন না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Soukromý klíč zadávejte v soukromí. Nikomu jej nesdělujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indtast din private nøgle et privat sted. Del den aldrig med andre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Geben Sie Ihren privaten Schlüssel an einem ungestörten Ort ein. Geben Sie ihn niemals an andere weiter."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter your private key in a private place. Never share it with anyone."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce tu clave privada en un lugar privado. No la compartas con nadie."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کلید خصوصی خود را در مکانی خصوصی وارد کنید. هرگز آن را با کسی به اشتراک نگذارید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ilagay ang pribadong susi sa pribadong lugar. Huwag itong ibahagi kaninuman."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Saisissez votre clé privée à l'abri des regards. Ne la partagez jamais."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ku shigar da keɓaɓɓen maɓallinku a keɓantaccen wuri. Kada ku taɓa raba shi da kowa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הזינו את המפתח הפרטי במקום פרטי. לעולם אל תשתפו אותו עם אחרים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अपनी निजी कुंजी निजी स्थान पर दर्ज करें। इसे किसी के साथ साझा न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kunci privat di tempat yang tidak terlihat orang lain. Jangan pernah membagikannya kepada siapa pun."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Inserisci la chiave privata in un luogo privato. Non condividerla mai con nessuno."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プライベートキーは人目につかない場所で入力し、誰にも共有しないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "개인 키는 다른 사람이 볼 수 없는 곳에서 입력하세요. 누구에게도 공유하지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan kunci peribadi di tempat yang tidak dapat dilihat orang lain. Jangan sesekali kongsikannya dengan sesiapa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer je privésleutel op een privéplek in. Deel deze nooit met anderen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz klucz prywatny w miejscu zapewniającym prywatność. Nigdy nikomu go nie udostępniaj."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite sua chave privada em um local privado. Nunca a compartilhe com ninguém."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu cheia privată într-un loc ferit de priviri. Nu o divulga nimănui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводите приватный ключ в уединённом месте. Никому его не сообщайте."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Weka ufunguo wa kibinafsi mahali pa faragha. Usiushiriki na mtu yeyote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ป้อนคีย์ส่วนตัวในที่เป็นส่วนตัว ห้ามเปิดเผยให้ผู้อื่นทราบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel anahtarı kimsenin görmeyeceği bir yerde girin. Kimseyle paylaşmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вводьте приватний ключ в усамітненому місці. Нікому його не повідомляйте."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نجی کلید کسی نجی جگہ پر درج کریں۔ اسے کسی کو نہ بتائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Nhập khóa riêng ở nơi riêng tư. Không chia sẻ với bất kỳ ai."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请在安全环境中输入私钥，切勿向他人透露。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請在安全環境中輸入私鑰，切勿向他人透露。"
          }
        }
      }
    },
    "wowpay_import_private_key_subtitle": {
