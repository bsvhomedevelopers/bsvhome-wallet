    "cold_wallet_storage_error": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من البيانات المحفوظة. احتفظ بالرمز الموقّع وراجع سجل المعاملات قبل المتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষিত তথ্য যাচাই করা যায়নি। স্বাক্ষরিত QR রাখুন এবং এগোনোর আগে ইতিহাস দেখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uložená data nelze ověřit. Uchovejte podepsaný QR a před pokračováním zkontrolujte historii."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gemte data kunne ikke kontrolleres. Behold den underskrevne QR og kontrollér historikken, før du fortsætter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Daten konnten nicht geprüft werden. Signierten QR-Code behalten und vor dem Fortfahren den Verlauf prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved transaction data could not be verified. Keep the signed QR and check transaction history before continuing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron verificar los datos guardados. Conserve el QR firmado y revise el historial antes de continuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده ذخیره‌شده قابل بررسی نیست. QR امضاشده را نگه دارید و پیش از ادامه سابقه را بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi masuri ang naka-save na data. Itago ang pirmadong QR at suriin ang kasaysayan bago magpatuloy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données enregistrées ne peuvent pas être vérifiées. Conservez le QR signé et vérifiez l’historique avant de continuer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya tabbatar da bayanan da aka adana ba. Riƙe QR mai sa hannu kuma duba tarihin ma’amala kafin ci gaba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת את הנתונים השמורים. שמרו את הקוד החתום ובדקו היסטוריה לפני שתמשיכו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजे गए डेटा का सत्यापन नहीं हुआ। हस्ताक्षरित QR रखें और आगे बढ़ने से पहले इतिहास जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tersimpan tidak dapat diverifikasi. Simpan QR bertanda tangan dan periksa riwayat sebelum melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile verificare i dati salvati. Conserva il QR firmato e controlla la cronologia prima di continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存された取引データを検証できません。署名済み QR を保管し、履歴を確認してから続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 거래 데이터를 검증할 수 없습니다. 서명된 QR을 보관하고 기록을 확인한 뒤 계속하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data tersimpan tidak dapat disahkan. Simpan QR bertandatangan dan semak sejarah sebelum meneruskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Opgeslagen gegevens konden niet worden gecontroleerd. Bewaar de ondertekende QR en controleer de geschiedenis voordat u doorgaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zweryfikować zapisanych danych. Zachowaj podpisany QR i sprawdź historię przed kontynuowaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar os dados salvos. Guarde o QR assinado e confira o histórico antes de continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele salvate nu pot fi verificate. Păstrați QR-ul semnat și verificați istoricul înainte de continuare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые данные не прошли проверку. Сохраните подписанный QR и проверьте историю перед продолжением."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Data iliyohifadhiwa haikuweza kuhakikiwa. Hifadhi QR iliyosainiwa na kagua historia kabla ya kuendelea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบข้อมูลที่บันทึกไว้ไม่ได้ เก็บ QR ที่ลงนามแล้วและตรวจสอบประวัติก่อนดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı veriler doğrulanamadı. İmzalı QR kodunu saklayın, devam etmeden işlem geçmişini kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Збережені дані не пройшли перевірку. Збережіть підписаний QR і перевірте історію перед продовженням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ ڈیٹا کی تصدیق نہیں ہو سکی۔ دستخط شدہ QR رکھیں اور جاری رکھنے سے پہلے تاریخ دیکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh dữ liệu đã lưu. Giữ mã QR đã ký và kiểm tra lịch sử trước khi tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的交易数据无法验证。请保留签名二维码，核对交易记录后再继续。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已儲存的交易資料無法驗證。請保留簽名二維碼，核對交易記錄後再繼續。"
          }
        }
      }
    },
    "cold_wallet_storage_protection_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استيراد المحفظة، لكن تعذر التأكد من حماية البيانات المحلية. أبقِ هذا الجهاز غير متصل بالإنترنت وحاول مجددًا. لم يتم حذف محفظتك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেট আমদানি হয়েছে, কিন্তু স্থানীয় তথ্যের সুরক্ষা নিশ্চিত করা যায়নি। ডিভাইসটি অফলাইনে রেখে আবার চেষ্টা করুন। আপনার ওয়ালেট মুছে ফেলা হয়নি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peněženka byla importována, ale ochranu místních dat se nepodařilo potvrdit. Ponechte toto zařízení offline a zkuste to znovu. Vaše peněženka nebyla smazána."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnebogen er importeret, men beskyttelsen af lokale data kunne ikke bekræftes. Hold denne enhed offline, og prøv igen. Din tegnebog er ikke blevet slettet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet importiert, aber der Schutz der lokalen Daten konnte nicht bestätigt werden. Lass dieses Gerät offline und versuche es erneut. Deine Wallet wurde nicht gelöscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet imported, but local data protection could not be confirmed. Keep this device offline and retry. Your wallet has not been deleted."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La billetera se ha importado, pero no se pudo confirmar la protección de los datos locales. Mantén este dispositivo sin conexión e inténtalo de nuevo. Tu billetera no se ha eliminado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول وارد شد، اما محافظت از داده‌های محلی تأیید نشد. این دستگاه را آفلاین نگه دارید و دوباره تلاش کنید. کیف پول شما حذف نشده است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-import ang wallet, pero hindi makumpirma ang proteksyon ng lokal na data. Panatilihing offline ang device na ito at subukang muli. Hindi nabura ang iyong wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le portefeuille a été importé, mais la protection des données locales n’a pas pu être confirmée. Gardez cet appareil hors ligne et réessayez. Votre portefeuille n’a pas été supprimé."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An shigo da walat, amma ba a iya tabbatar da kariyar bayanan da ke na’urar ba. A bar wannan na’urar ba tare da intanet ba, sannan a sake gwadawa. Ba a goge walat ɗinka ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארנק יובא, אך לא ניתן היה לאמת את ההגנה על הנתונים המקומיים. יש להשאיר מכשיר זה במצב לא מקוון ולנסות שוב. הארנק שלך לא נמחק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट आयात हो गया, लेकिन स्थानीय डेटा की सुरक्षा की पुष्टि नहीं हो सकी। इस डिवाइस को ऑफ़लाइन रखें और फिर से कोशिश करें। आपका वॉलेट हटाया नहीं गया है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet berhasil diimpor, tetapi perlindungan data lokal belum dapat dipastikan. Biarkan perangkat ini tetap offline dan coba lagi. Dompet Anda tidak dihapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il portafoglio è stato importato, ma non è stato possibile confermare la protezione dei dati locali. Mantieni questo dispositivo offline e riprova. Il portafoglio non è stato eliminato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットをインポートしましたが、端末内のデータ保護を確認できませんでした。この端末をオフラインにしたまま、もう一度お試しください。ウォレットは削除されていません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑을 가져왔지만 로컬 데이터 보호를 확인하지 못했습니다. 이 기기를 오프라인으로 유지한 채 다시 시도하세요. 지갑은 삭제되지 않았습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet telah diimport, tetapi perlindungan data setempat tidak dapat disahkan. Pastikan peranti ini kekal di luar talian dan cuba lagi. Dompet anda tidak dipadamkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De wallet is geïmporteerd, maar de bescherming van lokale gegevens kon niet worden bevestigd. Houd dit apparaat offline en probeer het opnieuw. Je wallet is niet verwijderd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel został zaimportowany, ale nie udało się potwierdzić ochrony danych lokalnych. Pozostaw to urządzenie offline i spróbuj ponownie. Twój portfel nie został usunięty."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira foi importada, mas não foi possível confirmar a proteção dos dados locais. Mantenha este dispositivo offline e tente novamente. Sua carteira não foi excluída."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portofelul a fost importat, dar protecția datelor locale nu a putut fi confirmată. Păstrează acest dispozitiv offline și încearcă din nou. Portofelul tău nu a fost șters."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелёк импортирован, но не удалось подтвердить защиту локальных данных. Оставьте это устройство без подключения к сети и повторите попытку. Ваш кошелёк не удалён."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi imeingizwa, lakini ulinzi wa data za ndani haukuweza kuthibitishwa. Weka kifaa hiki bila muunganisho wa intaneti na ujaribu tena. Pochi yako haijafutwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้ากระเป๋าแล้ว แต่ไม่สามารถยืนยันการปกป้องข้อมูลในเครื่องได้ โปรดให้อุปกรณ์นี้ออฟไลน์ไว้แล้วลองอีกครั้ง กระเป๋าของคุณยังไม่ถูกลบ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdan içe aktarıldı ancak yerel verilerin korunduğu doğrulanamadı. Bu cihazı çevrimdışı tutun ve yeniden deneyin. Cüzdanınız silinmedi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець імпортовано, але не вдалося підтвердити захист локальних даних. Залиште цей пристрій без підключення до мережі та повторіть спробу. Ваш гаманець не видалено."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والیٹ درآمد ہو گیا، لیکن مقامی ڈیٹا کے تحفظ کی تصدیق نہیں ہو سکی۔ اس ڈیوائس کو آف لائن رکھیں اور دوبارہ کوشش کریں۔ آپ کا والیٹ حذف نہیں کیا گیا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã nhập ví nhưng chưa thể xác nhận việc bảo vệ dữ liệu cục bộ. Hãy giữ thiết bị này ngoại tuyến và thử lại. Ví của bạn chưa bị xóa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包已导入，但无法确认本地数据保护。请保持设备离线并重试，钱包未被删除。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錢包已匯入，但無法確認本機資料保護。請保持裝置離線並重試，錢包並未被刪除。"
          }
        }
      }
    },
