    "wowpay_transfer_password_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذّر التحقق من كلمة مرور التحويل. حاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রান্সফার পাসওয়ার্ড যাচাই করা যাচ্ছে না। আবার চেষ্টা করুন।"
          }
        },
