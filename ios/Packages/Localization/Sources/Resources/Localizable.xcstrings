    "wowpay_cold_observer_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المراقب المتصل: يلزم توقيع المحفظة الباردة قبل بث التحويل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনলাইন পর্যবেক্ষক: সম্প্রচারের আগে স্থানান্তরে কোল্ড ওয়ালেটের স্বাক্ষর প্রয়োজন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Online pozorovatel: před odesláním do sítě musí převod podepsat offline peněženka."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-observatør: Overførsler kræver en underskrift fra den kolde tegnebog før udsendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Online-Beobachter: Vor dem Senden ins Netzwerk muss die Cold Wallet den Transfer signieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Online observer: transfers require a cold wallet signature before broadcasting."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Observador en línea: las transferencias requieren la firma de la billetera fría antes de difundirse."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ناظر آنلاین: پیش از پخش تراکنش، امضای کیف پول سرد لازم است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Online observer: kailangan ang lagda ng cold wallet bago i-broadcast ang paglilipat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Observateur en ligne : les transferts doivent être signés par le portefeuille hors ligne avant leur diffusion."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Mai lura a kan intanet: sai walat na wajen intanet ya sa hannu kafin a watsa turawar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארנק צפייה מקוון: נדרשת חתימה מהארנק הקר לפני שידור העברה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ऑनलाइन पर्यवेक्षक: प्रसारण से पहले ट्रांसफ़र पर कोल्ड वॉलेट के हस्ताक्षर ज़रूरी हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengamat online: transfer memerlukan tanda tangan dompet dingin sebelum disiarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Osservatore online: i trasferimenti richiedono la firma del portafoglio offline prima della trasmissione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "オンライン監視用：送信前にコールドウォレットでの署名が必要です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "온라인 관찰 지갑: 전송을 브로드캐스트하려면 콜드 지갑의 서명이 필요합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
