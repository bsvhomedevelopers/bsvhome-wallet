    "bsv_hd_invalid": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر التحقق من بيانات الاستعادة أو إعدادات الاشتقاق. تحقق من النسخة الأصلية والعنوان الأول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পুনরুদ্ধার তথ্য বা ডেরিভেশন সেটিং যাচাই করা যায়নি। মূল ব্যাকআপ ও প্রথম ঠিকানা দেখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Data obnovení nebo nastavení odvození nelze ověřit. Ověřte původní zálohu a první adresu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gendannelsesdata eller afledningsindstillinger kunne ikke kontrolleres. Kontrollér oprindelig sikkerhedskopi og første adresse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wiederherstellungsdaten oder Ableitungseinstellungen konnten nicht geprüft werden. Ursprüngliche Sicherung und erste Adresse prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The recovery data or derivation settings could not be verified. Check the original backup and first address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudieron verificar los datos o ajustes de derivación. Revise la copia original y la primera dirección."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده بازیابی یا تنظیمات مشتق‌سازی قابل بررسی نیست. پشتیبان اصلی و نخستین نشانی را بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi masuri ang recovery data o setting ng derivation. Suriin ang orihinal na backup at unang address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les données de restauration ou paramètres de dérivation ne peuvent pas être vérifiés. Vérifiez la sauvegarde originale et la première adresse."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ba a iya tabbatar da bayanan dawo da walat ko saitunan samarwa ba. Duba ajiyar asali da adireshin farko."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לא ניתן לאמת נתוני שחזור או הגדרות גזירה. בדקו את הגיבוי המקורי והכתובת הראשונה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पुनर्प्राप्ति डेटा या व्युत्पादन सेटिंग सत्यापित नहीं हुई। मूल बैकअप और पहला पता जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data pemulihan atau pengaturan derivasi tidak dapat diverifikasi. Periksa cadangan asli dan alamat pertama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati di ripristino o impostazioni non verificabili. Controlla backup originale e primo indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "復元データや派生設定を検証できません。元のバックアップと最初のアドレスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "복구 데이터나 파생 설정을 검증할 수 없습니다. 원래 백업과 첫 주소를 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data pemulihan atau tetapan derivasi tidak dapat disahkan. Semak sandaran asal dan alamat pertama."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Herstelgegevens of afleidingsinstellingen konden niet worden gecontroleerd. Controleer de oorspronkelijke back-up en het eerste adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zweryfikować danych odzyskiwania lub ustawień. Sprawdź oryginalną kopię i pierwszy adres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível verificar os dados ou ajustes de derivação. Confira o backup original e o primeiro endereço."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Datele de recuperare sau setările nu pot fi verificate. Verificați copia originală și prima adresă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные восстановления или настройки выведения не прошли проверку. Проверьте исходную резервную копию и первый адрес."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ya urejeshaji au mipangilio haikuweza kuhakikiwa. Kagua nakala ya awali na anwani ya kwanza."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบข้อมูลกู้คืนหรือการตั้งค่าสร้างคีย์ไม่ได้ ตรวจสอบข้อมูลสำรองเดิมและที่อยู่แรก"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kurtarma verileri veya türetme ayarları doğrulanamadı. Orijinal yedeği ve ilk adresi kontrol edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані відновлення чи налаштування не пройшли перевірку. Перевірте початкову копію та першу адресу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بحالی ڈیٹا یا اخذ کرنے کی ترتیبات کی تصدیق نہیں ہو سکی۔ اصل بیک اپ اور پہلا پتہ جانچیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không thể xác minh dữ liệu khôi phục hoặc cài đặt dẫn xuất. Kiểm tra bản sao lưu gốc và địa chỉ đầu tiên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法验证恢复数据或派生设置，请检查原始备份和首个地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法驗證恢復資料或派生設定，請檢查原始備份和首個地址。"
          }
        }
      }
    },
