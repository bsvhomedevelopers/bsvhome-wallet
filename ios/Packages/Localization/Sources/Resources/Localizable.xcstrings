    "wowpay_bsv_scan_range_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تشمل النتائج النطاق الذي تم فحصه. تابع الفحص للتحقق من المزيد من العناوين."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলাফল শুধু স্ক্যান করা পরিসর অন্তর্ভুক্ত করে। আরও ঠিকানা পরীক্ষা করতে স্ক্যান চালিয়ে যান।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledky pokrývají prohledaný rozsah. Další adresy ověříte pokračováním hledání."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultaterne dækker det scannede område. Fortsæt scanningen for at tjekke flere adresser."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Ergebnisse umfassen den geprüften Bereich. Scannen Sie weiter, um zusätzliche Adressen zu prüfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Discovery covers the scanned range. Continue scanning to check more addresses."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los resultados abarcan el rango escaneado. Continúa para comprobar más direcciones."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتایج فقط محدوده اسکن‌شده را پوشش می‌دهند. برای بررسی آدرس‌های بیشتر اسکن را ادامه دهید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Saklaw lang ng resulta ang na-scan na hanay. Magpatuloy para suriin ang iba pang address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les résultats couvrent la plage analysée. Continuez pour vérifier davantage d’adresses."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sakamakon ya ƙunshi kewayon da aka duba. Ci gaba don bincika ƙarin adireshi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התוצאות מכסות את הטווח שנסרק. המשך לסרוק כדי לבדוק כתובות נוספות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिणाम स्कैन की गई सीमा तक हैं। अधिक पते जाँचने के लिए स्कैन जारी रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil mencakup rentang yang dipindai. Lanjutkan untuk memeriksa lebih banyak alamat."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I risultati coprono l’intervallo scansionato. Continua per controllare altri indirizzi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "検索結果はスキャン済みの範囲のみです。続けてスキャンすると、さらに多くのアドレスを確認できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과는 스캔한 범위에 한정됩니다. 더 많은 주소를 확인하려면 계속 스캔하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil merangkumi julat yang diimbas. Teruskan untuk menyemak lebih banyak alamat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De resultaten omvatten het gescande bereik. Scan verder om meer adressen te controleren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyniki obejmują przeskanowany zakres. Kontynuuj, aby sprawdzić kolejne adresy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os resultados abrangem o intervalo verificado. Continue para conferir mais endereços."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatele acoperă intervalul scanat. Continuă pentru a verifica mai multe adrese."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результаты охватывают проверенный диапазон. Продолжите сканирование, чтобы проверить другие адреса."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Matokeo yanahusu anwani zilizochanganuliwa. Endelea ili kukagua anwani zaidi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ผลลัพธ์ครอบคลุมเฉพาะช่วงที่สแกนแล้ว สแกนต่อเพื่อตรวจสอบที่อยู่เพิ่มเติม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuçlar taranan aralığı kapsar. Daha fazla adresi kontrol etmek için taramaya devam edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результати охоплюють перевірений діапазон. Продовжте сканування, щоб перевірити більше адрес."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نتائج صرف اسکین شدہ حد تک ہیں۔ مزید پتے جانچنے کے لیے اسکین جاری رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kết quả chỉ bao gồm phạm vi đã quét. Tiếp tục để kiểm tra thêm địa chỉ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "发现结果仅覆盖已扫描范围。继续扫描可检查更多地址。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "探索結果僅涵蓋已掃描範圍。繼續掃描可檢查更多地址。"
          }
        }
      }
    },
    "wowpay_bsv_single_address_notice": {
