    "paymail_binding_changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تغيّر ربط Paymail. حدّث وأكّد مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail-এর সংযোগ বদলে গেছে। রিফ্রেশ করে আবার নিশ্চিত করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Propojení Paymail se změnilo. Aktualizujte údaje a znovu potvrďte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail-tilknytningen er ændret. Opdatér og bekræft igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Paymail-Verknüpfung wurde geändert. Aktualisiere und bestätige erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Paymail binding changed. Refresh and confirm again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La vinculación de Paymail ha cambiado. Actualiza y confirma de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اتصال Paymail تغییر کرده است. تازه‌سازی و دوباره تأیید کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nagbago ang pagkakaugnay ng Paymail. I-refresh at kumpirmahin muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’association Paymail a changé. Actualisez et confirmez à nouveau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An sauya haɗin Paymail. Sabunta kuma ka sake tabbatarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השיוך של Paymail השתנה. יש לרענן ולאשר שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail का जुड़ाव बदल गया है। रीफ़्रेश करके फिर से पुष्टि करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pengikatan Paymail berubah. Muat ulang dan konfirmasikan lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’associazione Paymail è cambiata. Aggiorna e conferma di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail の紐付けが変更されました。更新して再度確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail 연결 정보가 변경되었습니다. 새로고침한 후 다시 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pautan Paymail telah berubah. Muat semula dan sahkan sekali lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De Paymail-koppeling is gewijzigd. Vernieuw en bevestig opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Powiązanie Paymail uległo zmianie. Odśwież dane i potwierdź ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A vinculação do Paymail mudou. Atualize e confirme novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Asocierea Paymail s-a schimbat. Reîmprospătează și confirmă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Привязка Paymail изменилась. Обновите данные и подтвердите снова."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muunganisho wa Paymail umebadilika. Onyesha upya na uthibitishe tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การผูก Paymail เปลี่ยนแปลงแล้ว โปรดรีเฟรชและยืนยันอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail bağlantısı değişti. Yenileyin ve tekrar onaylayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Прив’язка Paymail змінилася. Оновіть дані й підтвердьте знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail کا تعلق تبدیل ہو گیا ہے۔ ریفریش کر کے دوبارہ تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Liên kết Paymail đã thay đổi. Hãy làm mới và xác nhận lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail 绑定已变更，请刷新后重新确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail 綁定已變更，請重新整理後再次確認。"
          }
        }
      }
    },
