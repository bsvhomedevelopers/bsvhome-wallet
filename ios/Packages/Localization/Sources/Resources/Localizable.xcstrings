    "multisig_paymail_disable_confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد إيقاف الاستلام عبر Paymail هذا وعنوان النظام الأصلي؟ ستظل المحفظة قادرة على الاستلام عبر رمز QR الخاص بها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Paymail ও সিস্টেমের মূল ঠিকানায় পেমেন্ট গ্রহণ বন্ধ করবেন? ওয়ালেটের QR কোড দিয়ে পেমেন্ট গ্রহণ করা যাবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavit příjem plateb přes tento Paymail a původní systémovou adresu? Peněženka může nadále přijímat platby přes svůj QR kód."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop modtagelse via denne Paymail og den oprindelige systemadresse? Tegnebogen kan stadig modtage via sin QR-kode."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zahlungseingänge über diese Paymail und die ursprüngliche Systemadresse deaktivieren? Die Wallet kann weiterhin Zahlungen über ihren QR-Code empfangen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stop receiving through this Paymail and the original system address? The wallet can still receive through its QR code."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Dejar de recibir pagos mediante este Paymail y la dirección original del sistema? La billetera podrá seguir recibiendo pagos mediante su código QR."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دریافت وجه از طریق این Paymail و نشانی اصلی سیستم متوقف شود؟ کیف پول همچنان می‌تواند از طریق کد QR خود وجه دریافت کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihinto ang pagtanggap gamit ang Paymail na ito at ang orihinal na address ng system? Makakatanggap pa rin ang wallet gamit ang QR code nito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Désactiver la réception via ce Paymail et l’adresse système d’origine ? Le portefeuille pourra toujours recevoir des paiements via son code QR."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A dakatar da karɓar kuɗi ta wannan Paymail da adireshin tsarin na asali? Har yanzu walat zai iya karɓar kuɗi ta lambar QR ɗinsa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להפסיק לקבל תשלומים דרך ה-Paymail הזה וכתובת המערכת המקורית? הארנק עדיין יוכל לקבל תשלומים דרך קוד ה-QR שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस Paymail और सिस्टम के मूल पते पर भुगतान पाना बंद करें? वॉलेट अपने QR कोड से भुगतान पाता रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan penerimaan melalui Paymail ini dan alamat asli sistem? Dompet masih dapat menerima pembayaran melalui kode QR-nya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Disattivare la ricezione tramite questo Paymail e l’indirizzo originale del sistema? Il portafoglio potrà ancora ricevere tramite il suo codice QR."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この Paymail と元のシステムアドレスでの受取を停止しますか？ウォレットの QR コードでは引き続き受け取れます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 Paymail과 기존 시스템 주소를 통한 수신을 중지할까요? 지갑의 QR 코드로는 계속 받을 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hentikan penerimaan melalui Paymail ini dan alamat sistem asal? Dompet masih boleh menerima melalui kod QR-nya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen betalingen meer ontvangen via deze Paymail en het oorspronkelijke systeemadres? De wallet kan nog steeds betalingen ontvangen via de QR-code."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wyłączyć odbieranie płatności przez ten Paymail i pierwotny adres systemowy? Portfel nadal będzie mógł odbierać płatności przez swój kod QR."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Desativar o recebimento por este Paymail e pelo endereço original do sistema? A carteira ainda poderá receber pelo código QR."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprești încasările prin acest Paymail și adresa inițială a sistemului? Portofelul poate primi în continuare plăți prin codul său QR."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Отключить получение платежей через этот Paymail и исходный системный адрес? Кошелёк по-прежнему сможет получать платежи по QR-коду."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usitishe kupokea malipo kupitia Paymail hii na anwani ya awali ya mfumo? Mkoba bado utaweza kupokea kupitia msimbo wake wa QR."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "หยุดรับเงินผ่าน Paymail นี้และที่อยู่เดิมของระบบหรือไม่? กระเป๋าเงินยังรับเงินผ่านรหัส QR ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu Paymail ve ilk sistem adresi üzerinden ödeme almayı durdurmak istiyor musunuz? Cüzdan QR koduyla ödeme almaya devam edebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вимкнути отримання платежів через цей Paymail і початкову системну адресу? Гаманець і далі зможе отримувати платежі за QR-кодом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس Paymail اور سسٹم کے اصل پتے پر ادائیگیاں وصول کرنا بند کریں؟ والیٹ اپنے QR کوڈ سے ادائیگیاں وصول کرتا رہے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng nhận thanh toán qua Paymail này và địa chỉ hệ thống ban đầu? Ví vẫn có thể nhận qua mã QR."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停用当前 Paymail 和原系统地址？钱包仍可通过收款码接收。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停用目前 Paymail 和原系統地址？錢包仍可透過收款碼接收。"
          }
        }
      }
    },
