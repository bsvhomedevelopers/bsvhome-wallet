    "cold_wallet_receive_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذا عنوان عادي على شبكة BSV الرئيسية. يمكن للمحافظ العادية إرسال BSV إليه."
