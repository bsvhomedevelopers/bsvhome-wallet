    "bsv_hd_backup_unavailable": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "معلومات النسخة غير متاحة. تحقق من التخزين المحلي أو استعد النسخة الأصلية."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যাকআপ তথ্য পাওয়া যাচ্ছে না। স্থানীয় সংরক্ষণ যাচাই করুন বা মূল ব্যাকআপ পুনরুদ্ধার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Informace o záloze nejsou dostupné. Ověřte místní úložiště nebo obnovte původní zálohu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhedskopioplysninger er ikke tilgængelige. Kontrollér lokal lagring eller gendan den oprindelige sikkerhedskopi."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sicherungsinformationen nicht verfügbar. Lokalen Speicher prüfen oder ursprüngliche Sicherung wiederherstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet backup information is unavailable. Restore the original backup or retry after checking local storage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos de copia no disponibles. Revise el almacenamiento local o restaure la copia original."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات پشتیبان در دسترس نیست. حافظه محلی را بررسی کنید یا پشتیبان اصلی را بازیابی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi mabasa ang impormasyon ng backup. Suriin ang lokal na imbakan o ibalik ang orihinal na backup."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Informations de sauvegarde indisponibles. Vérifiez le stockage local ou restaurez la sauvegarde originale."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayanan ajiya ba su samuwa. Duba ajiyar na’ura ko mayar da ajiyar asali."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מידע הגיבוי לא זמין. בדקו אחסון מקומי או שחזרו מהגיבוי המקורי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैकअप जानकारी उपलब्ध नहीं है। स्थानीय संग्रह जाँचें या मूल बैकअप पुनर्स्थापित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Informasi cadangan tidak tersedia. Periksa penyimpanan lokal atau pulihkan cadangan asli."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Informazioni di backup non disponibili. Controlla l’archiviazione locale o ripristina il backup originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "バックアップ情報を読み取れません。端末内ストレージを確認するか元のバックアップから復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "백업 정보를 읽을 수 없습니다. 로컬 저장소를 확인하거나 원래 백업에서 복구하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Maklumat sandaran tidak tersedia. Semak storan tempatan atau pulihkan sandaran asal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Back-upinformatie niet beschikbaar. Controleer lokale opslag of herstel de oorspronkelijke back-up."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dane kopii niedostępne. Sprawdź pamięć lokalną lub odzyskaj z oryginalnej kopii."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Informações de backup indisponíveis. Verifique o armazenamento local ou restaure o backup original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Informațiile copiei nu sunt disponibile. Verificați stocarea locală sau restaurați copia originală."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Данные резервной копии недоступны. Проверьте локальное хранилище или восстановите исходную копию."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maelezo ya nakala hayapatikani. Kagua hifadhi ya ndani au rejesha nakala ya awali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อ่านข้อมูลสำรองไม่ได้ ตรวจสอบพื้นที่จัดเก็บในเครื่องหรือกู้คืนจากข้อมูลสำรองเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yedek bilgileri kullanılamıyor. Yerel depolamayı kontrol edin veya orijinal yedeği kurtarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дані копії недоступні. Перевірте локальне сховище або відновіть початкову копію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیک اپ معلومات دستیاب نہیں۔ مقامی ذخیرہ جانچیں یا اصل بیک اپ بحال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không đọc được thông tin sao lưu. Kiểm tra bộ nhớ cục bộ hoặc khôi phục bản sao lưu gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取钱包备份信息，请检查本机存储或使用原始备份恢复。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "無法讀取錢包備份資訊，請檢查本機儲存或使用原始備份恢復。"
          }
        }
      }
    },
    "bsv_hd_bsv_only_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الاشتقاق المخصص ونسخ الاستعادة يستوردان محفظة BSV. الكلمات العادية مع الإعدادات الافتراضية تحافظ على الاستيراد متعدد العملات المعتاد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "কাস্টম BSV ডেরিভেশন ও পুনরুদ্ধার ব্যাকআপ BSV ওয়ালেট আমদানি করে। ডিফল্ট সেটিংসহ সাধারণ শব্দ প্রচলিত বহুমুদ্রা আমদানি বজায় রাখে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vlastní odvození BSV a zálohy importují peněženku BSV. Samotná slova s výchozím nastavením zachovají obvyklý import více měn."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Egen BSV-afledning og sikkerhedskopier importerer en BSV-tegnebog. Almindelige ord med standardindstillinger bevarer normal import af flere valutaer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eigene BSV-Ableitung und Sicherungen importieren eine BSV-Wallet. Reine Wörter mit Standardeinstellungen behalten den üblichen Import mehrerer Währungen bei."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Custom BSV derivation and recovery backups import a BSV wallet. Plain words with default settings keep the usual multicoin import."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La derivación BSV personalizada y las copias importan un monedero BSV. Las palabras con ajustes predeterminados conservan la importación multimoneda habitual."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مشتق‌سازی سفارشی و پشتیبان بازیابی، کیف پول BSV وارد می‌کنند. کلمات عادی با تنظیمات پیش‌فرض ورود چندارزی معمول را حفظ می‌کنند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-i-import ng BSV wallet ang pasadyang derivation at recovery backup. Pinapanatili ng mga salita at default na setting ang karaniwang multicoin import."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La dérivation BSV personnalisée et les sauvegardes importent un portefeuille BSV. Des mots simples avec les réglages par défaut conservent l’importation multidevise habituelle."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Samarwa ta BSV na musamman da ajiyar dawo da walat suna shigo da walat BSV. Kalmomi na yau da kullum da saitunan tsoho suna kiyaye shigo da tsabar kuɗi da yawa kamar yadda aka saba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "גזירת BSV מותאמת וגיבויי שחזור מייבאים ארנק BSV. מילים רגילות עם ברירות מחדל שומרות על הייבוא הרגיל של מספר מטבעות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कस्टम BSV व्युत्पादन और पुनर्प्राप्ति बैकअप BSV वॉलेट आयात करते हैं। डिफ़ॉल्ट सेटिंग वाले सामान्य शब्द मौजूदा बहु-मुद्रा आयात रखते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivasi BSV khusus dan cadangan pemulihan mengimpor dompet BSV. Kata biasa dengan pengaturan default mempertahankan impor multikoin biasa."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La derivazione BSV personalizzata e i backup importano un portafoglio BSV. Le sole parole con impostazioni predefinite mantengono l’importazione multivaluta abituale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カスタム BSV 派生や復元バックアップは BSV ウォレットをインポートします。単語だけでデフォルト設定の場合は通常の複数通貨インポートを維持します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "사용자 지정 BSV 파생이나 복구 백업은 BSV 지갑을 가져옵니다. 일반 단어와 기본 설정은 기존 다중 통화 가져오기를 유지합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivasi BSV tersuai dan sandaran pemulihan mengimport dompet BSV. Perkataan biasa dengan tetapan lalai mengekalkan import berbilang syiling biasa."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aangepaste BSV-afleiding en back-ups importeren een BSV-wallet. Alleen woorden met standaardinstellingen behouden de gebruikelijke import met meerdere munten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Własna derywacja BSV i kopie importują portfel BSV. Same słowa z domyślnymi ustawieniami zachowują zwykły import wielu walut."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A derivação BSV personalizada e os backups importam uma carteira BSV. Palavras simples com ajustes padrão mantêm a importação multimoeda habitual."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Derivarea BSV personalizată și copiile importă un portofel BSV. Cuvintele simple cu setările implicite păstrează importul multimonedă obișnuit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Собственное выведение BSV и резервные копии импортируют кошелёк BSV. Обычные слова с настройками по умолчанию сохраняют стандартный многовалютный импорт."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzalishaji maalum wa BSV na nakala za urejeshaji huingiza pochi ya BSV. Maneno ya kawaida na mipangilio chaguomsingi huhifadhi uingizaji wa sarafu nyingi wa kawaida."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การสร้างคีย์ BSV ที่กำหนดเองและข้อมูลสำรองกู้คืนนำเข้ากระเป๋า BSV คำธรรมดาที่ใช้ค่าเริ่มต้นยังคงนำเข้าหลายสกุลเงินตามเดิม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel BSV türetme ve kurtarma yedekleri BSV cüzdanı aktarır. Varsayılan ayarlardaki sade sözcükler olağan çoklu para içe aktarımını korur."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Власне виведення BSV та резервні копії імпортують гаманець BSV. Звичайні слова з типовими налаштуваннями зберігають звичайний багатовалютний імпорт."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اپنی مرضی کے BSV اخذ اور بحالی بیک اپ BSV والیٹ درآمد کرتے ہیں۔ ڈیفالٹ ترتیبات کے ساتھ عام الفاظ معمول کی متعدد سکوں کی درآمد رکھتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dẫn xuất BSV tùy chỉnh và bản sao lưu khôi phục nhập ví BSV. Các từ thông thường với cài đặt mặc định giữ cách nhập nhiều loại tiền hiện có."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自定义 BSV 派生和恢复备份将导入 BSV 钱包。原始助记词使用默认设置时，保留原有多币种导入方式。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自訂 BSV 派生和恢復備份將匯入 BSV 錢包。原始助記詞使用預設設定時，保留原有多幣種匯入方式。"
          }
        }
      }
    },
