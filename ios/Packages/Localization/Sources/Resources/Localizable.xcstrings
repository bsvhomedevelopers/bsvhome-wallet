    "multisig_funding_expired": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انتهت صلاحية مراجعة الإيداع. ارجع وأعد مراجعة جديدة قبل التوقيع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অর্থ জমার পর্যালোচনার মেয়াদ শেষ। ফিরে যান এবং স্বাক্ষরের আগে নতুন পর্যালোচনা প্রস্তুত করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platnost kontroly vkladu vypršela. Vraťte se a před podpisem připravte novou kontrolu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollen af indbetalingen er udløbet. Gå tilbage, og forbered en ny kontrol, før du underskriver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Prüfung der Einzahlung ist abgelaufen. Gehe zurück und prüfe einen neuen Entwurf vor dem Signieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The funding review expired. Go back and prepare a new review before signing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La revisión del depósito venció. Vuelve atrás y prepara una nueva revisión antes de firmar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "مهلت بررسی واریز تمام شد. برگردید و پیش از امضا، بررسی تازه‌ای آماده کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nag-expire na ang pagsusuri ng deposito. Bumalik at maghanda ng bagong pagsusuri bago lumagda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La vérification du dépôt a expiré. Revenez en arrière et préparez une nouvelle vérification avant de signer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wa’adin duba saka kuɗin ya ƙare. Koma ka shirya sabon dubawa kafin sa hannu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "תוקף בדיקת ההפקדה פג. יש לחזור ולהכין בדיקה חדשה לפני החתימה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जमा की समीक्षा का समय समाप्त हो गया। वापस जाएँ और हस्ताक्षर से पहले नई समीक्षा तैयार करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Peninjauan setoran sudah kedaluwarsa. Kembali dan siapkan peninjauan baru sebelum menandatangani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La verifica del versamento è scaduta. Torna indietro e prepara una nuova verifica prima di firmare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "入金内容の確認期限が切れました。戻って内容を再取得してから署名してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "입금 검토가 만료되었습니다. 돌아가서 새 검토 정보를 준비한 뒤 서명하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semakan deposit telah tamat tempoh. Kembali dan sediakan semakan baharu sebelum menandatangani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De controle van de storting is verlopen. Ga terug en bereid een nieuwe controle voor voordat je ondertekent."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Weryfikacja wpłaty wygasła. Wróć i przygotuj nową weryfikację przed podpisaniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A revisão do depósito expirou. Volte e prepare uma nova revisão antes de assinar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificarea depunerii a expirat. Revino și pregătește o nouă verificare înainte de semnare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Срок проверки пополнения истёк. Вернитесь и подготовьте новую проверку перед подписанием."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muda wa ukaguzi wa kuweka fedha umeisha. Rudi na uandae ukaguzi mpya kabla ya kusaini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูลตรวจสอบการเติมเงินหมดอายุแล้ว โปรดย้อนกลับและเตรียมข้อมูลใหม่ก่อนลงนาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Para yatırma incelemesinin süresi doldu. Geri dönüp imzalamadan önce yeni bir inceleme hazırlayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Термін перевірки поповнення минув. Поверніться та підготуйте нову перевірку перед підписанням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "رقم جمع کرنے کی جانچ کی میعاد ختم ہوگئی۔ واپس جائیں اور دستخط سے پہلے نئی جانچ تیار کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thông tin kiểm tra nạp tiền đã hết hạn. Quay lại và chuẩn bị thông tin mới trước khi ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "入金核对已过期，请返回并重新准备后再签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉入核對已過期，請返回並重新準備後再簽名。"
          }
        }
      }
    },
    "multisig_funding_no_payer": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد محفظة BSV شخصية يمكن الدفع منها. أنشئ محفظة أو استوردها أولًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেমেন্ট করার উপযোগী ব্যক্তিগত BSV ওয়ালেট নেই। আগে একটি তৈরি বা আমদানি করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Není k dispozici osobní BSV peněženka, ze které lze platit. Nejprve ji vytvořte nebo importujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen personlig BSV-tegnebog kan bruges til betaling. Opret eller importér en først."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine persönliche BSV-Wallet zum Bezahlen verfügbar. Erstelle oder importiere zuerst eine Wallet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No spendable personal BSV wallet. Create or import one first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay ninguna billetera personal de BSV desde la que se pueda pagar. Crea o importa una primero."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول شخصی BSV که بتوان از آن پرداخت کرد وجود ندارد. ابتدا یک کیف پول بسازید یا وارد کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang personal na BSV wallet na maaaring magbayad. Gumawa o mag-import muna ng isa."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun portefeuille BSV personnel ne permet de payer. Créez-en ou importez-en un d’abord."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu walat na BSV na kashin kai da za a iya biya daga gare shi. Da farko ƙirƙiri ko shigo da walat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין ארנק BSV אישי שניתן לשלם ממנו. יש ליצור או לייבא ארנק תחילה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान करने योग्य कोई निजी BSV वॉलेट नहीं है। पहले एक वॉलेट बनाएँ या आयात करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada dompet BSV pribadi yang dapat digunakan untuk membayar. Buat atau impor dompet terlebih dahulu."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessun portafoglio BSV personale può essere usato per pagare. Creane o importane uno prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いに使える個人の BSV ウォレットがありません。先に作成またはインポートしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제에 사용할 수 있는 개인 BSV 지갑이 없습니다. 먼저 지갑을 만들거나 가져오세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada dompet BSV peribadi yang boleh membuat bayaran. Cipta atau import dompet dahulu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er is geen persoonlijke BSV-wallet beschikbaar om mee te betalen. Maak of importeer eerst een wallet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Brak osobistego portfela BSV, z którego można płacić. Najpierw utwórz lub zaimportuj portfel."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Nenhuma carteira pessoal de BSV pode ser usada para pagar. Crie ou importe uma primeiro."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există un portofel BSV personal din care să poți plăti. Creează sau importă mai întâi unul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нет личного BSV-кошелька, с которого можно оплатить. Сначала создайте или импортируйте кошелёк."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna mkoba binafsi wa BSV unaoweza kulipa. Unda au ingiza mkoba kwanza."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีกระเป๋า BSV ส่วนบุคคลที่ใช้ชำระเงินได้ กรุณาสร้างหรือนำเข้ากระเป๋าก่อน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme yapılabilecek kişisel bir BSV cüzdanı yok. Önce bir cüzdan oluşturun veya içe aktarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Немає особистого BSV-гаманця, з якого можна платити. Спочатку створіть або імпортуйте гаманець."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ادائیگی کے قابل کوئی ذاتی BSV والیٹ نہیں ہے۔ پہلے ایک والیٹ بنائیں یا درآمد کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Không có ví BSV cá nhân có thể dùng để thanh toán. Hãy tạo hoặc nhập ví trước."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可付款的普通 BSV 钱包，请先创建或导入钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "没有可付款的普通 BSV 钱包，请先创建或导入钱包。"
          }
        }
      }
    },
