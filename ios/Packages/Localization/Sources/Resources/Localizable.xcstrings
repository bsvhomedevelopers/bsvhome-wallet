    "cold_wallet_invalid_data": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "بيانات QR غير صالحة أو غير مطابقة. أعد المسح بالجهاز الصحيح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "QR তথ্য অবৈধ বা অমিল। সঠিক ডিভাইস দিয়ে আবার স্ক্যান করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Neplatná nebo nesouhlasící QR data. Znovu skenujte správným zařízením."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ugyldige eller uoverensstemmende QR-data. Start scanning igen med den rigtige enhed."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ungültige oder unpassende QR-Daten. Mit dem richtigen Gerät neu scannen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Invalid or mismatched QR data. Restart scanning with the correct device."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Datos QR inválidos o incompatibles. Reinicie el escaneo con el dispositivo correcto."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "داده QR نامعتبر یا ناسازگار است. با دستگاه درست دوباره اسکن کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi wasto o hindi tugma ang QR data. Simulang muli ang pag-scan gamit ang tamang device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Données QR invalides ou incompatibles. Recommencez avec le bon appareil."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bayanan QR ba daidai ba ne ko ba su dace ba. Fara dubawa da na’urar da ta dace."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "נתוני QR לא תקינים או לא תואמים. התחילו לסרוק מחדש עם המכשיר הנכון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "QR डेटा अमान्य या बेमेल है। सही डिवाइस से दोबारा स्कैन करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Data QR tidak valid atau tidak cocok. Ulangi pemindaian dengan perangkat yang benar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Dati QR non validi o incompatibili. Ripeti la scansione con il dispositivo corretto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "QR データが無効、または一致しません。正しい端末で読み取り直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "QR 데이터가 잘못되었거나 일치하지 않습니다. 올바른 기기로 다시 스캔하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Data QR tidak sah atau tidak sepadan. Mulakan semula imbasan dengan peranti yang betul."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeldige of niet-overeenkomende QR-gegevens. Scan opnieuw met het juiste apparaat."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nieprawidłowe lub niedopasowane dane QR. Rozpocznij skanowanie właściwym urządzeniem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Dados QR inválidos ou incompatíveis. Reinicie a leitura com o dispositivo correto."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Date QR nevalide sau nepotrivite. Reluați scanarea cu dispozitivul corect."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-данные неверны или не совпадают. Начните сканирование нужным устройством заново."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Data ya QR si halali au hailingani. Anza kuchanganua tena kwa kifaa sahihi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ข้อมูล QR ไม่ถูกต้องหรือไม่ตรงกัน เริ่มสแกนใหม่ด้วยอุปกรณ์ที่ถูกต้อง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Geçersiz veya eşleşmeyen QR verisi. Doğru cihazla taramayı yeniden başlatın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "QR-дані недійсні або не збігаються. Почніть сканування правильним пристроєм знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "QR ڈیٹا غلط یا غیر مطابق ہے۔ درست آلے سے دوبارہ اسکین کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dữ liệu QR không hợp lệ hoặc không khớp. Quét lại với đúng thiết bị."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "二维码无效或不匹配，请重新扫描正确设备的二维码。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "二維碼無效或不匹配，請重新掃描正確裝置的二維碼。"
          }
        }
      }
    },
