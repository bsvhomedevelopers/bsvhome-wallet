    "swap.slippage_auto_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحدد تلقائيًا أفضل انزلاق لإتمام المبادلة بنجاح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সফল সোয়াপের জন্য স্বয়ংক্রিয়ভাবে সেরা স্লিপেজ নির্ধারণ করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Automaticky nastaví nejlepší skluz pro úspěšný swap."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Angiver automatisk den bedste slippage for en vellykket swap."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Legt automatisch die beste Slippage für einen erfolgreichen Swap fest."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatically set the best slippage for a successful swap."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Establece automáticamente el mejor deslizamiento para un swap exitoso."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌طور خودکار بهترین لغزش را برای مبادله موفق تنظیم می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Awtomatikong itinatakda ang pinakamahusay na pagkadulas para sa matagumpay na swap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définit automatiquement le meilleur glissement pour un échange réussi."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yana saita mafi kyawun zamewa ta atomatik don samun nasarar musaya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מגדיר אוטומטית את ההחלקה הטובה ביותר להחלפה מוצלחת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सफल स्वैप के लिए स्वचालित रूप से सर्वोत्तम स्लिपेज सेट करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Secara otomatis menetapkan slippage terbaik untuk swap yang berhasil."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Imposta automaticamente lo slippage migliore per uno swap riuscito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スワップを成功させるための最適なスリッページを自動的に設定します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "성공적인 스왑을 위해 최적의 슬리피지를 자동으로 설정합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menetapkan gelinciran terbaik secara automatik untuk pertukaran yang berjaya."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelt automatisch de beste slippage in voor een succesvolle swap."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Automatycznie ustawia najlepszy poślizg dla udanej wymiany."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Define automaticamente o melhor deslizamento para uma troca bem-sucedida."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Setează automat cea mai bună alunecare pentru un swap reușit."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматически устанавливает оптимальное проскальзывание для успешного обмена."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Huweka kuteleza bora kiotomatiki kwa ubadilishaji uliofaulu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตั้งค่าสลิปเพจที่ดีที่สุดโดยอัตโนมัติเพื่อการสว็อปที่สำเร็จ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Başarılı bir takas için en iyi kaymayı otomatik olarak ayarlar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Автоматично встановлює найкраще прослизання для успішного обміну."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کامیاب سویپ کے لیے بہترین سلیپج خودکار طور پر مقرر کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tự động đặt mức trượt giá tốt nhất để hoán đổi thành công."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "自动设置最佳滑点以确保兑换成功。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "自動設定最佳滑點以確保兌換成功。"
          }
        }
      }
    },
    "swap.slippage_warning": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "انزلاق مرتفع. قد يُنفَّذ التبادل بسعر أسوأ من المتوقع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "উচ্চ স্লিপেজ। আপনার সোয়াপ প্রত্যাশার চেয়ে খারাপ দামে সম্পন্ন হতে পারে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vysoký skluz. Vaše směna může proběhnout za horší cenu, než se očekávalo."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Høj slippage. Din swap kan blive udført til en dårligere pris end forventet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hohe Slippage. Dein Swap wird möglicherweise zu einem schlechteren Preis als erwartet ausgeführt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "High slippage. Your swap may be executed at a worse price than expected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizamiento alto. Tu swap podría ejecutarse a un precio peor de lo esperado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "لغزش بالا. ممکن است سواپ شما با قیمتی بدتر از حد انتظار انجام شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mataas na slippage. Maaaring maisagawa ang iyong swap sa mas masamang presyo kaysa inaasahan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glissement élevé. Votre échange pourrait s'exécuter à un prix pire que prévu."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Zamewa mai yawa. Wataƙila a aiwatar da musayar ku a farashi mafi muni fiye da yadda ake tsammani."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החלקה גבוהה. ההמרה שלך עלולה להתבצע במחיר גרוע מהצפוי."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "उच्च स्लिपेज। आपका स्वैप अपेक्षा से खराब मूल्य पर निष्पादित हो सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage tinggi. Swap Anda mungkin dieksekusi pada harga yang lebih buruk dari yang diharapkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Slippage elevato. Il tuo swap potrebbe essere eseguito a un prezzo peggiore del previsto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "スリッページが大きいです。スワップが予想より悪い価格で実行される可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "슬리피지가 높습니다. 스왑이 예상보다 나쁜 가격에 체결될 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelinciran tinggi. Pertukaran anda mungkin dilaksanakan pada harga yang lebih buruk daripada dijangka."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoge slippage. Je swap wordt mogelijk uitgevoerd tegen een slechtere prijs dan verwacht."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wysoki poślizg. Twoja zamiana może zostać wykonana po gorszej cenie niż oczekiwano."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Deslizamento alto. Sua troca pode ser executada a um preço pior do que o esperado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alunecare mare. Schimbul tău ar putea fi executat la un preț mai prost decât cel așteptat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Высокое проскальзывание. Обмен может пройти по цене хуже ожидаемой."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuteleza kwa juu. Ubadilishaji wako unaweza kutekelezwa kwa bei mbaya zaidi kuliko ilivyotarajiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สลิปเพจสูง การสว็อปของคุณอาจดำเนินการที่ราคาที่แย่กว่าที่คาดไว้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yüksek kayma. Takasınız beklenenden daha kötü bir fiyattan gerçekleşebilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Високе прослизання. Обмін може відбутися за гіршою ціною, ніж очікувалося."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "زیادہ سلیپج۔ آپ کا سویپ متوقع سے خراب قیمت پر انجام پا سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trượt giá cao. Giao dịch hoán đổi của bạn có thể được thực hiện ở mức giá tệ hơn dự kiến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "滑点过高。兑换可能以比预期更差的价格成交。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "滑點過高。兌換可能以比預期更差的價格成交。"
          }
        }
      }
    },
