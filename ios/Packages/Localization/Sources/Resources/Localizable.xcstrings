    "multisig_join_check": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجعت قواعد المحفظة مع الأعضاء الآخرين وأؤكد الانضمام باستخدام محفظتي الخاصة."
