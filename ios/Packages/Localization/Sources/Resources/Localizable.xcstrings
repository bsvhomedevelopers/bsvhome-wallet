        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail ने अमान्य डेटा लौटाया है। रीफ़्रेश करके फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail mengembalikan data yang tidak valid. Muat ulang dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail ha restituito dati non validi. Aggiorna e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail が無効なデータを返しました。更新して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail에서 잘못된 데이터를 반환했습니다. 새로고침한 후 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
