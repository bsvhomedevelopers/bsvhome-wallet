        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบชื่อกระเป๋าเงิน กฎการลงนาม และสมาชิกก่อนเลือกกระเป๋าเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdan seçmeden önce adını, imzalama kurallarını ve üyelerini doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед вибором гаманця перевірте його назву, правила підписування та учасників."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والیٹ منتخب کرنے سے پہلے نام، دستخط کے اصول اور اراکین کی تصدیق کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra tên ví, quy tắc ký và thành viên trước khi chọn ví."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先核对钱包名称、签名规则及成员，再选择钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
