    "multisig_create_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل الإنشاء، تأكد من قدرة كل عضو على استخدام محفظته للتوقيع. لا تستقبل الأموال إلا بعد تأكيد جميع الأعضاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "তৈরির আগে নিশ্চিত করুন যে প্রত্যেক সদস্য নিজের ওয়ালেট দিয়ে স্বাক্ষর করতে পারেন। সব সদস্য নিশ্চিত করার পরেই অর্থ গ্রহণ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před vytvořením ověřte, že každý člen může podepisovat vlastní peněženkou. Prostředky přijímejte až po potvrzení všech členů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér før oprettelse, at alle medlemmer kan underskrive med deres egen tegnebog. Modtag først midler, når alle har bekræftet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe vor dem Erstellen, ob jedes Mitglied mit seiner eigenen Wallet unterschreiben kann. Empfange erst Geld, nachdem alle Mitglieder bestätigt haben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Before creating, check that every member can use their own signing wallet. Receive funds only after every member confirms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de crearla, comprueba que cada miembro pueda firmar con su propia billetera. Recibe fondos solo cuando todos hayan confirmado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از ساخت، مطمئن شوید هر عضو می‌تواند با کیف پول خودش امضا کند. تنها پس از تأیید همهٔ اعضا دارایی دریافت کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bago gumawa, tiyaking kayang pumirma ng bawat miyembro gamit ang sariling wallet. Tumanggap lang ng pondo kapag nakumpirma na ng lahat."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant de créer le portefeuille, vérifiez que chaque membre peut utiliser son portefeuille de signature. Ne recevez des fonds qu’après confirmation de tous les membres."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kafin ƙirƙira, tabbatar kowane mamba zai iya sa hannu da walat ɗinsa. Karɓi kuɗi bayan dukkan mambobi sun tabbatar kawai."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני היצירה, ודא שכל חבר יכול לחתום בארנק שלו. קבל כספים רק לאחר שכל החברים אישרו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बनाने से पहले जाँचें कि हर सदस्य अपने वॉलेट से हस्ताक्षर कर सकता है। सभी सदस्यों की पुष्टि के बाद ही राशि प्राप्त करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Sebelum membuat, pastikan setiap anggota dapat menandatangani dengan dompetnya sendiri. Terima dana hanya setelah semua anggota mengonfirmasi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di creare, verifica che ogni membro possa firmare con il proprio portafoglio. Ricevi fondi solo dopo la conferma di tutti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員が自分のウォレットで署名できることを確認してください。全員の確認が完了してから入金してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모두 자신의 지갑으로 서명할 수 있는지 확인하세요. 전원이 확인한 뒤 자금을 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan semua ahli boleh menandatangani dengan dompet sendiri. Terima dana hanya selepas semua mengesahkan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer of iedereen zijn eigen wallet kan gebruiken. Ontvang pas geld nadat alle leden hebben bevestigd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź, czy każdy może używać własnego portfela podpisującego. Odbieraj środki dopiero po potwierdzeniu wszystkich członków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique se todos podem usar sua própria carteira signatária. Receba fundos somente após a confirmação de todos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică dacă fiecare membru își poate folosi portofelul pentru semnare. Primește fonduri numai după confirmarea tuturor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Убедитесь, что каждый может использовать свой кошелёк для подписания. Принимайте средства только после подтверждения всех участников."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakikisha kila mwanachama anaweza kutumia mkoba wake kusaini. Pokea fedha baada ya wote kuthibitisha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบว่าทุกคนใช้กระเป๋าของตนเองลงนามได้ รับเงินหลังจากสมาชิกทุกคนยืนยันแล้วเท่านั้น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Herkesin kendi imza cüzdanını kullanabildiğini doğrulayın. Ancak tüm üyeler onayladıktan sonra fon alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте, чи кожен може підписувати власним гаманцем. Приймайте кошти лише після підтвердження всіх учасників."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دیکھیں کہ ہر رکن اپنے والیٹ سے دستخط کر سکتا ہے۔ سب کی تصدیق کے بعد ہی رقم وصول کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đảm bảo mọi thành viên đều có thể ký bằng ví riêng. Chỉ nhận tiền sau khi tất cả đã xác nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "创建前请确认所有成员能够使用自己的签名钱包。完成成员确认后再接收资金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "建立前請確認所有成員能夠使用自己的簽名錢包。完成成員確認後再接收資金。"
          }
        }
      }
    },
