            "state": "translated",
            "value": "سب اراکین ایک ہی والیٹ کے اصول کی تصدیق کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Các thành viên xác nhận cùng quy tắc ví"
