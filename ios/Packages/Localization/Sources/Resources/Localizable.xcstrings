        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampas sa suportadong laki ang pakete. Humingi sa nagpadala ng suportadong pakete."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet dépasse la taille prise en charge. Demandez un paquet compatible à l’expéditeur."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunshin ya wuce girman da ake tallafawa. Nemi kunshin da ya dace daga mai aikawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "החבילה חורגת מהגודל הנתמך. בקש מהשולח חבילה נתמכת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पैकेज समर्थित आकार से बड़ा है। भेजने वाले से समर्थित पैकेज लें।"
