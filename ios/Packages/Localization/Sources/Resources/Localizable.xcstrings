    "wowpay_about_bsv_body": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV هو أصل الشبكة الأصلي للمدفوعات العالمية منخفضة التكلفة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV হলো কম খরচে বিশ্বব্যাপী পেমেন্টের জন্য নেটিভ অ্যাসেট।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV je nativní aktivum pro levné globální platby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV er kædens eget aktiv til globale betalinger med lave omkostninger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV ist ein nativer Vermögenswert für kostengünstige weltweite Zahlungen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV native asset for low-cost global payments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV es el activo nativo para pagos globales de bajo costo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV دارایی بومی شبکه برای پرداخت‌های جهانی کم‌هزینه است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang Bitcoin SV ay katutubong asset para sa mga pandaigdigang pagbabayad na mababa ang gastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV est un actif natif pour les paiements mondiaux à faible coût."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV kadara ce ta asali ta cibiyar sadarwa don biyan kuɗi a duk duniya da ƙananan kuɗaɗen caji."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV הוא נכס מקורי של הרשת לתשלומים גלובליים בעלות נמוכה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV कम लागत वाले वैश्विक भुगतान के लिए नेटिव एसेट है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV adalah aset asli untuk pembayaran global berbiaya rendah."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV è l’asset nativo per pagamenti globali a basso costo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SVは、低コストのグローバル決済に対応するネイティブ資産です。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV는 저비용 글로벌 결제를 위한 네이티브 자산입니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV ialah aset asli untuk pembayaran global berkos rendah."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV is een native activum voor goedkope wereldwijde betalingen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV to natywne aktywo do tanich płatności na całym świecie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV é o ativo nativo para pagamentos globais de baixo custo."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV este un activ nativ pentru plăți globale cu costuri reduse."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV — нативный актив для недорогих платежей по всему миру."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV ni mali asilia ya mtandao kwa malipo ya kimataifa yenye gharama nafuu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV เป็นสินทรัพย์หลักของเครือข่ายสำหรับการชำระเงินทั่วโลกด้วยต้นทุนต่ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV, düşük maliyetli küresel ödemeler için yerel varlıktır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV — нативний актив для недорогих платежів у всьому світі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV کم لاگت کی عالمی ادائیگیوں کے لیے نیٹ ورک کا اصل اثاثہ ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV là tài sản gốc dành cho thanh toán toàn cầu với chi phí thấp."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Bitcoin SV 主链资产，支持低成本交易与全球支付。"
          }
        },
