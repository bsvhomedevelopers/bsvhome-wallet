    "info.network_fee.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتطلب كل معاملة على شبكة %@ رسومًا بعملة %@ تُدفع لعمال المناجم لمعالجة معاملتك، وليس BsvHome Wallet. تختلف رسوم الشبكة حسب استخدام الشبكة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ নেটওয়ার্কে প্রতিটি লেনদেনের জন্য আপনার লেনদেন প্রক্রিয়া করার জন্য %@-এ ফি দিতে হবে, BsvHome Wallet নয়। নেটওয়ার্ক ফি নেটওয়ার্ক ব্যবহারের উপর ভিত্তি করে পরিবর্তিত হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každá transakce v síti %@ vyžaduje poplatek ve výši %@ zaplacený těžařům za zpracování vaší transakce, nikoli BsvHome Wallet. Síťové poplatky se liší podle využití sítě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver transaktion på %@ netværket kræver et gebyr i %@ betalt til minearbejdere for at behandle din transaktion, ikke BsvHome Wallet. Netværksgebyrer varierer afhængigt af netværksbrug."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Für jede Transaktion im %@-Netzwerk wird eine Gebühr in %@ an die Miner gezahlt, um Ihre Transaktion abzuwickeln, nicht an BsvHome Wallet. Die Netzwerkgebühren variieren je nach Netzwerknutzung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every transaction on the %@ network requires a fee in %@ paid to miners to process your transaction, not BsvHome Wallet. Network fees varies based on network usage."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada transacción en la red %@ requiere una tarifa en %@ pagada a los mineros para procesar su transacción, no a BsvHome Wallet. Las tarifas de red varían según el uso de la red."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر تراکنش در شبکه %@ نیاز به کارمزدی در %@ دارد که برای پردازش تراکنش شما به استخراج کنندگان پرداخت می شود، نه BsvHome Wallet. هزینه های شبکه بر اساس استفاده از شبکه متفاوت است."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ang bawat transaksyon sa %@ network ay nangangailangan ng bayad sa %@ na binabayaran sa mga minero upang maproseso ang iyong transaksyon, hindi ang BsvHome Wallet. Nag-iiba-iba ang mga bayarin sa network batay sa paggamit ng network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque transaction sur le réseau %@ nécessite des frais en %@ payés aux mineurs pour traiter votre transaction, et non à BsvHome Wallet. Les frais de réseau varient en fonction de l'utilisation du réseau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kowace ciniki akan hanyar sadarwar %@ tana buƙatar kuɗi a cikin %@ da aka biya ga masu hakar ma'adinai don aiwatar da kasuwancin ku, ba BsvHome Wallet ba. Kudaden hanyar sadarwa sun bambanta dangane da amfani da hanyar sadarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל עסקה ברשת %@ דורשת עמלה ב-%@ ששולם לכורים על מנת לעבד את העסקה שלך, לא ארנק BsvHome. עמלות הרשת משתנות בהתאם לשימוש ברשת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ नेटवर्क पर प्रत्येक लेनदेन के लिए आपके लेनदेन को संसाधित करने के लिए खनिकों को भुगतान किए जाने वाले %@ शुल्क की आवश्यकता होती है, BsvHome Wallet की नहीं। नेटवर्क शुल्क नेटवर्क उपयोग के आधार पर भिन्न होता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap transaksi di jaringan %@ memerlukan biaya sebesar %@ yang dibayarkan kepada penambang untuk memproses transaksi Anda, bukan BsvHome Wallet. Biaya jaringan bervariasi berdasarkan penggunaan jaringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni transazione sulla rete %@ richiede una commissione in %@ pagata ai minatori per elaborare la transazione, non a BsvHome Wallet. Le tariffe di rete variano in base all'utilizzo della rete."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ネットワーク上のすべての取引には、取引処理のためにマイナーに支払われる %@ の手数料が必要であり、BsvHome Wallet には支払われません。ネットワーク手数料はネットワークの使用状況により変動します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ 네트워크의 모든 거래에는 BsvHome Wallet이 아닌 거래를 처리하기 위해 채굴자에게 지불되는 %@ 수수료가 필요합니다. 네트워크 요금은 네트워크 사용량에 따라 다릅니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap transaksi pada rangkaian %@ memerlukan bayaran dalam %@ dibayar kepada pelombong untuk memproses transaksi anda, bukan BsvHome Wallet. Yuran rangkaian berbeza-beza berdasarkan penggunaan rangkaian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voor elke transactie op het %@ netwerk is een vergoeding van %@ vereist, betaald aan mijnwerkers om uw transactie te verwerken, niet aan BsvHome Wallet. De netwerkkosten variëren afhankelijk van het netwerkgebruik."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każda transakcja w sieci %@ wymaga opłaty w wysokości %@ płaconej górnikom za przetworzenie Twojej transakcji, a nie BsvHome Wallet. Opłaty sieciowe różnią się w zależności od wykorzystania sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada transação na rede %@ exige uma taxa em %@ paga aos mineradores para processar sua transação, não à BsvHome Wallet. As taxas de rede variam de acordo com o uso da rede."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare tranzacție din rețeaua %@ necesită o taxă în %@ plătită minerilor pentru a vă procesa tranzacția, nu BsvHome Wallet. Taxele de rețea variază în funcție de utilizarea rețelei."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждая транзакция в сети %@ требует плату в %@ выплачиваемую майнерам за обработку вашей транзакции, а не BsvHome Wallet. Сетевые сборы варьируются в зависимости от использования сети."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila muamala kwenye mtandao wa %@ unahitaji ada ya %@ kulipwa kwa wachimbaji ili kushughulikia muamala wako, si BsvHome Wallet. Ada za mtandao hutofautiana kulingana na matumizi ya mtandao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกธุรกรรมบนเครือข่าย %@ ต้องเสียค่าธรรมเนียมเป็น %@ ที่จ่ายให้กับนักขุดเพื่อดำเนินการธุรกรรมของคุณ ไม่ใช่ BsvHome Wallet ค่าธรรมเนียมเครือข่ายจะแตกต่างกันไปตามการใช้งานเครือข่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ağındaki her işlem, işleminizi gerçekleştirmek için madencilere BsvHome Wallet'a değil, %@ tutarında bir ücret ödenmesini gerektirir. Ağ ücretleri ağ kullanımına göre değişir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожна транзакція в мережі %@ вимагає комісію в %@, яка сплачується майнерам за обробку вашої транзакції, а не BsvHome Wallet. Розмір мережевої комісії залежить від використання мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ نیٹ ورک پر ہر ٹرانزیکشن کے لیے %@ میں فیس کی ضرورت ہوتی ہے جو کان کنوں کو آپ کے لین دین پر کارروائی کرنے کے لیے ادا کی جاتی ہے، BsvHome Wallet کی نہیں۔ نیٹ ورک فیس نیٹ ورک کے استعمال کی بنیاد پر مختلف ہوتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mọi giao dịch trên mạng %@ đều yêu cầu một khoản phí bằng %@ trả cho người khai thác để xử lý giao dịch của bạn, không phải Ví BsvHome. Phí mạng thay đổi tùy theo mức sử dụng mạng."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 网络上的每笔交易都需要以 %@ 支付给矿工的手续费，以处理交易，BsvHome Wallet 不收取此费用。网络手续费根据网络使用情况而变化。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "在 %@ 網路上的每筆交易都需要以 %@ 支付給礦工的手續費，以處理交易，BsvHome Wallet 不收取此費用。網路手續費會根據網路使用情況而有所不同。"
          }
        }
      }
    },
