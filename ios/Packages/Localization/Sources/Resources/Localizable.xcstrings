    "multisig_creation_candidate_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من اسم المحفظة وقواعد التوقيع والأعضاء قبل اختيار محفظة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেট বেছে নেওয়ার আগে নাম, স্বাক্ষরের নিয়ম ও সদস্যদের যাচাই করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před výběrem peněženky ověřte její název, pravidla podepisování a členy."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér tegnebogens navn, underskriftsregler og medlemmer, før du vælger den."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe den Namen, die Signaturregeln und die Mitglieder, bevor du eine Wallet auswählst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify the name, signing rules and members before choosing a wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica el nombre, las reglas de firma y los miembros antes de elegir una billetera."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از انتخاب کیف پول، نام، قواعد امضا و اعضای آن را بررسی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suriin ang pangalan, mga tuntunin sa pagpirma, at mga miyembro bago pumili ng wallet."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez le nom, les règles de signature et les membres avant de choisir un portefeuille."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabbatar da sunan walat, ƙa’idojin sa hannu da mambobi kafin zaɓen walat."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לבדוק את שם הארנק, כללי החתימה והחברים לפני בחירת ארנק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट चुनने से पहले उसका नाम, हस्ताक्षर के नियम और सदस्यों की जाँच करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa nama, aturan penandatanganan, dan anggota sebelum memilih dompet."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica nome, regole di firma e membri prima di scegliere un portafoglio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットを選択する前に、名前、署名ルール、メンバーを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑을 선택하기 전에 이름, 서명 규칙과 구성원을 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak nama, peraturan tandatangan dan ahli sebelum memilih dompet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer de naam, ondertekeningsregels en leden voordat je een wallet kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed wyborem portfela sprawdź jego nazwę, zasady podpisywania i członków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o nome, as regras de assinatura e os membros antes de escolher uma carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică numele, regulile de semnare și membrii înainte de a alege un portofel."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед выбором кошелька проверьте название, правила подписи и участников."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Thibitisha jina la pochi, kanuni za kusaini na wanachama kabla ya kuchagua pochi."
          }
