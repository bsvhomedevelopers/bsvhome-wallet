    "bsv_hd_compare_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قبل الاستيراد قارن العنوان الأول كاملًا بالمحفظة الأصلية. مسار أو عبارة مرور أو إعداد قديم مختلف ينشئ محفظة مختلفة. يجب أن تطابق الإعدادات المحددة النسخة أو الاقتران."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমদানির আগে সম্পূর্ণ প্রথম ঠিকানা মূল ওয়ালেটের সঙ্গে মিলিয়ে দেখুন। আলাদা পথ, পাসফ্রেজ বা পুরোনো সেটিং ভিন্ন ওয়ালেট তৈরি করে। নির্দিষ্ট সেটিং ব্যাকআপ বা জোড়ার তথ্যের সঙ্গে মিলতে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před importem porovnejte celou první adresu s původní peněženkou. Jiná cesta, heslová fráze či starší nastavení vytváří jinou peněženku. Výslovná nastavení musí odpovídat záloze nebo párování."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sammenlign hele første adresse med den oprindelige tegnebog før import. En anden sti, adgangsfrase eller ældre indstilling giver en anden tegnebog. Udtrykkelige indstillinger skal svare til sikkerhedskopien eller parringen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vor dem Import die vollständige erste Adresse mit der ursprünglichen Wallet vergleichen. Anderer Pfad, Passphrase oder alter Modus ergibt eine andere Wallet. Explizite Einstellungen müssen der Sicherung oder Kopplung entsprechen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare the full first address with the original wallet before importing. A different path, passphrase, or legacy setting creates a different wallet. Explicit settings must match an embedded backup or pairing."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Antes de importar, compare la primera dirección completa con el monedero original. Otra ruta, contraseña o modo antiguo crea otro monedero. Los ajustes explícitos deben coincidir con la copia o el enlace."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از ورود، نخستین نشانی کامل را با کیف پول اصلی مقایسه کنید. مسیر، عبارت عبور یا تنظیم قدیمی متفاوت کیف پول دیگری می‌سازد. تنظیمات مشخص باید با پشتیبان یا جفت‌سازی مطابقت داشته باشند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Ihambing ang buong unang address sa orihinal na wallet bago mag-import. Ibang path, password o lumang setting ay gumagawa ng ibang wallet. Dapat tumugma ang tahasang setting sa backup o pagpares."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Avant l’importation, comparez la première adresse complète au portefeuille original. Un autre chemin, passphrase ou mode ancien crée un autre portefeuille. Les paramètres explicites doivent correspondre à la sauvegarde ou à l’association."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kwatanta cikakken adireshin farko da walat na asali kafin shigo da shi. Hanya, kalmar sirri ko tsohon saiti daban yana samar da walat daban. Saitunan da aka bayyana dole su dace da ajiya ko haɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לפני הייבוא השוו את הכתובת הראשונה המלאה לארנק המקורי. נתיב, סיסמה או הגדרה ישנה שונים יוצרים ארנק אחר. ההגדרות המפורשות חייבות להתאים לגיבוי או לצימוד."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आयात से पहले पूरा पहला पता मूल वॉलेट से मिलाएँ। अलग पथ, पासफ़्रेज़ या पुरानी सेटिंग अलग वॉलेट बनाती है। स्पष्ट सेटिंग बैकअप या पेयरिंग से मेल खानी चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan alamat pertama lengkap dengan dompet asli sebelum impor. Jalur, frasa sandi, atau pengaturan lama berbeda menghasilkan dompet berbeda. Pengaturan eksplisit harus cocok dengan cadangan atau pemasangan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima di importare, confronta il primo indirizzo completo con il portafoglio originale. Un altro percorso, passphrase o modalità precedente crea un altro portafoglio. Le impostazioni esplicite devono corrispondere al backup o all’associazione."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "インポート前に完全な最初のアドレスを元のウォレットと比較してください。パス、パスフレーズ、旧式設定が異なると別のウォレットになります。明示した設定はバックアップやペアリング情報と一致する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "가져오기 전에 전체 첫 주소를 원래 지갑과 비교하세요. 경로, 추가 암호, 이전 설정이 다르면 다른 지갑이 됩니다. 명시한 설정은 백업이나 페어링 정보와 일치해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandingkan alamat pertama penuh dengan dompet asal sebelum import. Laluan, frasa laluan atau tetapan lama berbeza menghasilkan dompet berbeza. Tetapan nyata mesti sepadan dengan sandaran atau pemadanan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Vergelijk vóór import het volledige eerste adres met de oorspronkelijke wallet. Ander pad, wachtzin of oude modus maakt een andere wallet. Expliciete instellingen moeten overeenkomen met de back-up of koppeling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przed importem porównaj pełny pierwszy adres z oryginalnym portfelem. Inna ścieżka, hasło lub dawne ustawienie tworzy inny portfel. Jawne ustawienia muszą odpowiadać kopii lub parowaniu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Compare o primeiro endereço completo com a carteira original antes de importar. Outro caminho, senha ou modo antigo gera outra carteira. Os ajustes explícitos devem corresponder ao backup ou pareamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Înainte de import, comparați prima adresă completă cu portofelul original. O altă cale, parolă sau setare veche creează alt portofel. Setările explicite trebuie să corespundă copiei sau asocierii."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "До импорта сравните полный первый адрес с исходным кошельком. Другой путь, парольная фраза или старый режим создаёт другой кошелёк. Явные настройки должны совпадать с резервной копией или сопряжением."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Linganisha anwani ya kwanza kamili na pochi ya awali kabla ya kuingiza. Njia, nenosiri au mpangilio wa zamani tofauti huunda pochi tofauti. Mipangilio wazi lazima ilingane na nakala au uoanishaji."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ก่อนนำเข้า เปรียบเทียบที่อยู่แรกแบบเต็มกับกระเป๋าเดิม เส้นทาง รหัสผ่าน หรือการตั้งค่าเก่าที่ต่างกันสร้างกระเป๋าคนละใบ การตั้งค่าที่ระบุต้องตรงกับข้อมูลสำรองหรือการจับคู่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İçe aktarmadan önce tam ilk adresi orijinal cüzdanla karşılaştırın. Farklı yol, ek parola veya eski ayar farklı cüzdan oluşturur. Açık ayarlar yedek veya eşleştirmeyle uyuşmalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До імпорту порівняйте повну першу адресу з початковим гаманцем. Інший шлях, парольна фраза чи старе налаштування створює інший гаманець. Явні налаштування мають відповідати копії або сполученню."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درآمد سے پہلے مکمل پہلا پتہ اصل والیٹ سے ملائیں۔ مختلف راستہ، پاس فریز یا پرانی ترتیب مختلف والیٹ بناتی ہے۔ واضح ترتیبات بیک اپ یا جوڑنے کی معلومات سے ملنی چاہئیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Trước khi nhập, so sánh toàn bộ địa chỉ đầu tiên với ví gốc. Đường dẫn, mật khẩu hoặc cài đặt cũ khác nhau tạo ví khác. Cài đặt chỉ định phải khớp với bản sao lưu hoặc thông tin ghép nối."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入前请与原钱包核对完整首地址。路径、附加密码或旧版设置不同，会得到不同的钱包。显式设置必须与恢复字符串或配对信息中的设置一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入前請與原錢包核對完整首地址。路徑、附加密碼或舊版設定不同，會得到不同的錢包。明確設定必須與恢復字串或配對資訊中的設定一致。"
          }
        }
      }
    },
