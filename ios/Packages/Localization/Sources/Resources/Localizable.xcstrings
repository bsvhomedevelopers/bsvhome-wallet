    "cold_wallet_import_refresh_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم استيراد المحفظة. تعذر تحديث الرصيد أو السجل. حاول التحديث مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেট আমদানি হয়েছে। ব্যালেন্স বা ইতিহাস রিফ্রেশ করা যায়নি। আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peněženka byla importována. Zůstatek nebo historii se nepodařilo obnovit. Zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnebogen er importeret. Saldo eller historik kunne ikke opdateres. Prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet importiert. Guthaben oder Verlauf konnten nicht aktualisiert werden. Bitte erneut aktualisieren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet imported. Balance or history could not refresh. Try refreshing again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Billetera importada. No se pudo actualizar el saldo o el historial. Inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول وارد شد. موجودی یا تاریخچه به‌روز نشد. دوباره تلاش کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Na-import na ang wallet. Hindi ma-refresh ang balanse o history. Subukang i-refresh muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Portefeuille importé. Le solde ou l’historique n’a pas pu être actualisé. Réessayez."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An shigo da walat. Ba a iya sabunta ma’auni ko tarihi ba. Sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הארנק יובא. לא ניתן היה לרענן את היתרה או ההיסטוריה. יש לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट आयात हो गया। बैलेंस या इतिहास रीफ़्रेश नहीं हो सका। फिर से कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet berhasil diimpor. Saldo atau riwayat gagal dimuat ulang. Coba muat ulang lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Portafoglio importato. Impossibile aggiornare saldo o cronologia. Riprova ad aggiornare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ウォレットをインポートしました。残高または履歴を更新できませんでした。再度更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "지갑을 가져왔습니다. 잔액 또는 내역을 새로고침하지 못했습니다. 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet telah diimport. Baki atau sejarah gagal dimuat semula. Cuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wallet geïmporteerd. Saldo of geschiedenis kon niet worden vernieuwd. Probeer opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfel zaimportowany. Nie udało się odświeżyć salda lub historii. Spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carteira importada. Não foi possível atualizar o saldo ou o histórico. Tente atualizar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portofel importat. Soldul sau istoricul nu a putut fi actualizat. Încearcă din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошелёк импортирован. Не удалось обновить баланс или историю. Повторите обновление."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi imeingizwa. Salio au historia haikuweza kuonyeshwa upya. Jaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นำเข้ากระเป๋าแล้ว แต่รีเฟรชยอดคงเหลือหรือประวัติไม่ได้ โปรดลองรีเฟรชอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cüzdan içe aktarıldı. Bakiye veya geçmiş yenilenemedi. Yeniden yenilemeyi deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманець імпортовано. Не вдалося оновити баланс або історію. Спробуйте ще раз."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "والیٹ درآمد ہو گیا۔ بیلنس یا تاریخچہ ریفریش نہیں ہو سکا۔ دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đã nhập ví. Không thể làm mới số dư hoặc lịch sử. Vui lòng thử làm mới lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "钱包已导入，余额或历史刷新失败，请稍后重试刷新。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "錢包已匯入，餘額或交易紀錄重新整理失敗，請稍後重試。"
          }
        }
      }
    },
