          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan alamat dompet pada rangkaian yang dipilih untuk memantaunya"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voer een portemonneeadres op het gekozen netwerk in om het te volgen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wpisz adres portfela w wybranej sieci, aby go obserwować"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Digite um endereço de carteira da rede selecionada para observá-la"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Introdu o adresă de portofel din rețeaua selectată pentru a o monitoriza"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Введите адрес кошелька в выбранной сети, чтобы следить за ним"
