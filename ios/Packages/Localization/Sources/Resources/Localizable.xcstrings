    "multisig_paymail_rename_confirm": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هل تريد استخدام %@ لاستلام الدفعات عبر Paymail؟ سيتوقف العنوان المخصّص السابق عن قبول الدفعات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেমেন্ট গ্রহণের Paymail হিসেবে %@ ব্যবহার করবেন? আগের কাস্টম ঠিকানায় আর পেমেন্ট গ্রহণ করা হবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Používat %@ jako Paymail pro příjem plateb? Předchozí vlastní adresa přestane přijímat platby."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug %@ som Paymail til modtagelse? Den tidligere tilpassede adresse vil ikke længere modtage betalinger."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ als Paymail für Zahlungseingänge verwenden? Die bisherige benutzerdefinierte Adresse nimmt dann keine Zahlungen mehr an."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use %@ as the receiving Paymail? The previous custom address will stop accepting payments."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "¿Usar %@ como Paymail para recibir pagos? La dirección personalizada anterior dejará de aceptar pagos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از %@ به‌عنوان Paymail دریافت وجه استفاده شود؟ نشانی سفارشی قبلی دیگر پرداختی دریافت نخواهد کرد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gamitin ang %@ bilang Paymail para sa pagtanggap? Hindi na tatanggap ng bayad ang dating custom na address."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utiliser %@ comme Paymail de réception ? L’ancienne adresse personnalisée n’acceptera plus de paiements."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "A yi amfani da %@ a matsayin Paymail na karɓar kuɗi? Adireshin musamman na baya zai daina karɓar kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "להשתמש ב-%@ כ-Paymail לקבלת תשלומים? הכתובת המותאמת הקודמת תפסיק לקבל תשלומים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान पाने के लिए %@ को Paymail के रूप में इस्तेमाल करें? पिछले कस्टम पते पर भुगतान पाना बंद हो जाएगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan %@ sebagai Paymail penerima? Alamat kustom sebelumnya tidak akan menerima pembayaran lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usare %@ come Paymail per ricevere pagamenti? Il precedente indirizzo personalizzato non accetterà più pagamenti."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ を受取用 Paymail に設定しますか？以前のカスタムアドレスでは受け取れなくなります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%@을(를) 수신용 Paymail로 사용할까요? 이전 사용자 지정 주소로는 더 이상 받을 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan %@ sebagai Paymail penerimaan? Alamat tersuai sebelumnya tidak akan menerima bayaran lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ gebruiken als Paymail voor ontvangst? Het vorige aangepaste adres accepteert dan geen betalingen meer."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używać %@ jako Paymail do odbierania płatności? Poprzedni niestandardowy adres przestanie przyjmować płatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Usar %@ como Paymail de recebimento? O endereço personalizado anterior deixará de aceitar pagamentos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosești %@ ca Paymail pentru încasări? Adresa personalizată anterioară nu va mai accepta plăți."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Использовать %@ как Paymail для получения платежей? Прежний пользовательский адрес перестанет принимать платежи."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Utumie %@ kama Paymail ya kupokea malipo? Anwani maalumu ya awali haitaendelea kupokea malipo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ %@ เป็น Paymail สำหรับรับเงินหรือไม่? ที่อยู่ที่กำหนดเองก่อนหน้าจะหยุดรับเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ödeme almak için Paymail olarak kullanılsın mı? Önceki özel adres artık ödeme kabul etmeyecek."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовувати %@ як Paymail для отримання платежів? Попередня власна адреса перестане приймати платежі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ادائیگیاں وصول کرنے کے لیے %@ کو Paymail کے طور پر استعمال کریں؟ پچھلا حسبِ ضرورت پتہ ادائیگیاں قبول کرنا بند کر دے گا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng %@ làm Paymail nhận thanh toán? Địa chỉ tùy chỉnh trước đó sẽ ngừng nhận thanh toán."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "将收款 Paymail 改为 %@？原自定义地址将停止收款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "將收款 Paymail 改為 %@？原自訂地址將停止收款。"
          }
        }
      }
    },
