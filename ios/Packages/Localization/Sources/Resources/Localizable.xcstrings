          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बदलने के लिए कार्ड पर टैप करें। नीचे के कार्य चुने हुए वॉलेट का उपयोग करते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketuk kartu untuk beralih. Tindakan di bawah menggunakan dompet yang dipilih."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tocca una scheda per cambiare. Le azioni seguenti usano il portafoglio selezionato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "カードをタップして切り替えます。以下の操作には選択中のウォレットを使用します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "카드를 눌러 전환하세요. 아래 작업은 선택한 지갑에 적용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ketik kad untuk bertukar. Tindakan di bawah menggunakan dompet yang dipilih."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tik op een kaart om te wisselen. De acties hieronder gebruiken de geselecteerde wallet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dotknij karty, aby przełączyć. Poniższe działania używają wybranego portfela."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Toque em um cartão para alternar. As ações abaixo usam a carteira selecionada."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Atinge un card pentru a schimba. Acțiunile de mai jos folosesc portofelul selectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Нажмите на карточку для переключения. Действия ниже используют выбранный кошелёк."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Gusa kadi kubadilisha. Vitendo vilivyo hapa chini hutumia pochi iliyochaguliwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แตะการ์ดเพื่อสลับ การดำเนินการด้านล่างจะใช้กระเป๋าเงินที่เลือก"
          }
        },
        "tr": {
          "stringUnit": {
