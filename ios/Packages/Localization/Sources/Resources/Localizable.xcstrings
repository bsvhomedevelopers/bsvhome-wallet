    "price_alerts.state.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "قم بتمكينهم عن طريق إضافة عملات معدنية للتتبع"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
