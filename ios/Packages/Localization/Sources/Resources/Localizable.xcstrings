    "paymail_identity_mismatch": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استعد المحفظة الأصلية لإدارة هوية Paymail هذه."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই Paymail পরিচয় পরিচালনা করতে মূল ওয়ালেট পুনরুদ্ধার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
