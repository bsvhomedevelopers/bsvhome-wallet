          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Заробляйте %@ винагороди на свій стейк, поки ви спите."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سوتے وقت اپنے اسٹیک پر %@ انعامات حاصل کریں۔"
