        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chạm vào thẻ để chuyển. Các thao tác bên dưới sử dụng ví đã chọn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
