        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiếm %@ phần thưởng cho số tiền đặt cược của bạn khi bạn ngủ."
          }
        },
        "zh-Hans": {
          "stringUnit": {
