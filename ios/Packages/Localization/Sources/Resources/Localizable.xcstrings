    "wowpay_offline_signing_password_rate_limited": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محاولات كثيرة جدًا. حاول مجددًا بعد خمس دقائق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনেকবার চেষ্টা করা হয়েছে। পাঁচ মিনিট পর আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Příliš mnoho pokusů. Zkuste to znovu za pět minut."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "For mange forsøg. Prøv igen om fem minutter."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zu viele Versuche. Versuche es in fünf Minuten erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Too many attempts. Try again in five minutes."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Demasiados intentos. Inténtalo de nuevo en cinco minutos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تعداد تلاش‌ها بیش از حد است. پنج دقیقه دیگر دوباره امتحان کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
