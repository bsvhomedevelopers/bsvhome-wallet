        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تبدیل کرنے کے لیے کارڈ پر ٹیپ کریں۔ نیچے کی کارروائیاں منتخب والیٹ استعمال کرتی ہیں۔"
