        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutaj pojawią się ostatnio używane zasoby"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Os recursos que você usou recentemente aparecerão aqui"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Elementele pe care le-ați folosit recent vor apărea aici"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Здесь будут отображаться активы, которые вы недавно использовали"
