    "wowpay_swap_broadcast_report_pending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم بث معاملة الدفع. إرسال بياناتها إلى مزود الخدمة ما زال معلقًا؛ حدّث الطلب لإعادة المحاولة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পেমেন্টের লেনদেন নেটওয়ার্কে পাঠানো হয়েছে। প্রদানকারীকে জানানো এখনও বাকি; আবার চেষ্টা করতে অর্ডার রিফ্রেশ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Platba byla odeslána do sítě. Její nahlášení poskytovateli zatím čeká; obnovte objednávku a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Betalingen er sendt til netværket. Den mangler at blive rapporteret til udbyderen; opdater ordren for at prøve igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Zahlung wurde an das Netzwerk übertragen. Die Meldung an den Anbieter steht noch aus; aktualisiere den Auftrag, um es erneut zu versuchen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Payment was broadcast. Reporting it to the provider is pending; refresh the order to retry."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El pago se ha transmitido a la red. Falta comunicarlo al proveedor; actualiza la orden para reintentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تراکنش پرداخت به شبکه ارسال شده است. گزارش آن به ارائه‌دهنده هنوز انجام نشده؛ برای تلاش مجدد سفارش را تازه‌سازی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naipadala na sa network ang bayad. Nakabinbin pa ang pag-uulat nito sa provider; i-refresh ang order para subukang muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La transaction de paiement a été diffusée. Sa notification au prestataire reste à effectuer ; actualisez l’ordre pour réessayer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An watsa biyan kuɗin zuwa cibiyar sadarwa. Ba a sanar da mai bayarwa ba tukuna; sabunta buƙatar don sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התשלום שודר לרשת. הדיווח עליו לספק עדיין ממתין; יש לרענן את ההזמנה כדי לנסות שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भुगतान का लेनदेन नेटवर्क पर भेज दिया गया है। सेवा प्रदाता को इसकी सूचना देना अभी बाकी है; दोबारा कोशिश करने के लिए ऑर्डर रीफ़्रेश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran telah disiarkan ke jaringan. Pelaporan kepada penyedia masih tertunda; perbarui pesanan untuk mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pagamento è stato trasmesso alla rete. La segnalazione al fornitore è ancora in sospeso; aggiorna l'ordine per riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "支払いトランザクションを送信しました。サービス提供者への報告は未完了です。注文を更新して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결제 거래가 네트워크에 전송되었습니다. 공급자에게 보고하는 작업이 남아 있습니다. 주문을 새로 고쳐 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembayaran telah disiarkan ke rangkaian. Pelaporan kepada pembekal masih belum selesai; muat semula pesanan untuk mencuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De betalingstransactie is verzonden. De melding aan de aanbieder is nog niet voltooid; vernieuw de order om opnieuw te proberen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Transakcja płatności została wysłana do sieci. Zgłoszenie jej dostawcy jeszcze nie zostało ukończone; odśwież zlecenie, aby spróbować ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O pagamento foi transmitido à rede. O envio da informação ao provedor está pendente; atualize a ordem para tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Plata a fost transmisă în rețea. Raportarea ei către furnizor este în așteptare; actualizează ordinul pentru a reîncerca."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Платёжная транзакция отправлена в сеть. Передача данных провайдеру ещё не завершена; обновите заявку для повторной попытки."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Muamala wa malipo umetumwa kwenye mtandao. Taarifa kwa mtoa huduma bado haijatumwa; onyesha upya agizo ili ujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งธุรกรรมการชำระเงินแล้ว แต่ยังรายงานให้ผู้ให้บริการไม่สำเร็จ โปรดรีเฟรชคำสั่งเพื่อลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödeme işlemi yayınlandı. Sağlayıcıya bildirim henüz tamamlanmadı; yeniden denemek için emri yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Платіж надіслано в мережу. Провайдера ще не повідомлено про нього; оновіть замовлення, щоб повторити спробу."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ادائیگی کی ٹرانزیکشن نشر ہو گئی ہے۔ فراہم کنندہ کو اطلاع دینا ابھی باقی ہے؛ دوبارہ کوشش کے لیے آرڈر تازہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giao dịch thanh toán đã được phát lên mạng. Chưa hoàn tất báo cho nhà cung cấp; làm mới lệnh để thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "付款已广播，尚未完成向服务商上报；请刷新订单重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "付款已廣播，尚未完成向服務商回報；請重新整理訂單重試。"
          }
        }
      }
    },
