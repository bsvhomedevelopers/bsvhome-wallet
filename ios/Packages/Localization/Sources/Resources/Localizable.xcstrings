        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکیج غلط، غیر معاون یا تبدیل شدہ ہے۔ مکمل پیکیج جانچیں اور دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Gói không hợp lệ, không được hỗ trợ hoặc đã thay đổi. Kiểm tra toàn bộ gói và thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
