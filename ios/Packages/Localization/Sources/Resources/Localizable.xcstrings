    "recent_activity.state.empty.description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ستظهر هنا الأصول التي استخدمتها مؤخرًا"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার সম্প্রতি ব্যবহার করা সম্পদ এখানে প্রদর্শিত হবে"
          }
