    "multisig_no_local_identity": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا توجد هوية توقيع على هذا الجهاز. استعد الهوية المطابقة للتوقيع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই ডিভাইসে স্বাক্ষর পরিচয় নেই। স্বাক্ষর করতে সংশ্লিষ্ট পরিচয় পুনরুদ্ধার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tomto zařízení není podpisová identita. Pro podepisování obnovte odpovídající identitu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Ingen signeringsidentitet på denne enhed. Gendan den tilhørende identitet for at signere."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Auf diesem Gerät ist keine Signaturidentität verfügbar. Stelle die passende Identität zum Signieren wieder her."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No signing identity on this device. Restore the matching identity to sign."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No hay una identidad de firma en este dispositivo. Restaura la identidad correspondiente para firmar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هویت امضایی در این دستگاه نیست. برای امضا، هویت مرتبط را بازیابی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Walang pagkakakilanlan sa paglagda sa device na ito. I-restore ang kaukulang pagkakakilanlan para lumagda."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucune identité de signature sur cet appareil. Restaurez l’identité correspondante pour signer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Babu shaidar sa hannu a wannan na’ura. Dawo da shaidar da ta dace domin sa hannu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אין זהות חתימה במכשיר זה. יש לשחזר את הזהות המתאימה כדי לחתום."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस डिवाइस पर हस्ताक्षर पहचान नहीं है। हस्ताक्षर करने के लिए संबंधित पहचान पुनर्स्थापित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada identitas penandatanganan di perangkat ini. Pulihkan identitas yang sesuai untuk menandatangani."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Nessuna identità di firma su questo dispositivo. Ripristina l’identità corrispondente per firmare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末には署名IDがありません。署名するには対応するIDを復元してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 서명 ID가 없습니다. 서명하려면 해당 ID를 복원하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiada identiti tandatangan pada peranti ini. Pulihkan identiti yang sepadan untuk menandatangani."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Geen ondertekeningsidentiteit op dit apparaat. Herstel de bijbehorende identiteit om te ondertekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Na tym urządzeniu nie ma tożsamości podpisującej. Przywróć odpowiednią tożsamość, aby podpisywać."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não há identidade de assinatura neste dispositivo. Restaure a identidade correspondente para assinar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nu există o identitate de semnare pe acest dispozitiv. Restaurează identitatea corespunzătoare pentru a semna."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "На устройстве нет подписывающей личности. Восстановите соответствующую личность для подписи."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakuna utambulisho wa kusaini kwenye kifaa hiki. Rejesha utambulisho husika ili kusaini."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ไม่มีตัวตนผู้ลงนามในอุปกรณ์นี้ โปรดกู้คืนตัวตนที่ตรงกันเพื่อลงนาม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazda imzalama kimliği yok. İmzalamak için ilgili kimliği geri yükleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "На цьому пристрої немає особи для підпису. Відновіть відповідну особу, щоб підписувати."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے پر دستخطی شناخت نہیں ہے۔ دستخط کرنے کے لیے متعلقہ شناخت بحال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thiết bị này không có danh tính ký. Hãy khôi phục danh tính tương ứng để ký."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机无可用签名身份，请恢复对应身份后再签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機無可用簽名身分，請恢復對應身分後再簽名。"
          }
        }
      }
    },
    "multisig_note_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُحفظ هذه الملاحظة لدى المنصة وليست جزءًا من التوقيع على السلسلة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "নোটটি প্ল্যাটফর্মে থাকে, অন-চেইন স্বাক্ষরের অংশ নয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Poznámku ukládá platforma a není součástí podpisu na blockchainu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Noten gemmes af platformen og indgår ikke i underskriften på blockchainen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Notiz wird von der Plattform gespeichert und ist kein Teil der On-Chain-Signatur."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This note is stored by the platform and is not part of the on-chain signature."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La plataforma guarda la nota; no forma parte de la firma en la cadena."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "یادداشت در پلتفرم ذخیره می‌شود و بخشی از امضای روی زنجیره نیست."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nakaimbak sa platform ang tala at hindi bahagi ng pirma sa blockchain."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La note est conservée par la plateforme et ne fait pas partie de la signature sur la chaîne."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana adana bayanin a dandamali, ba ya cikin sa hannun kan sarkar."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ההערה נשמרת בפלטפורמה ואינה חלק מהחתימה בבלוקצ׳יין."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "नोट प्लेटफ़ॉर्म पर सहेजा जाता है और ऑन-चेन हस्ताक्षर का हिस्सा नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Catatan disimpan oleh platform dan bukan bagian dari tanda tangan on-chain."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La nota è memorizzata dalla piattaforma e non fa parte della firma sulla blockchain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メモはプラットフォームが保存し、オンチェーン署名には含まれません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "메모는 플랫폼에 저장되며 온체인 서명의 일부가 아닙니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota disimpan oleh platform dan bukan sebahagian daripada tandatangan pada rantaian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De notitie wordt door het platform opgeslagen en maakt geen deel uit van de blockchainhandtekening."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Notatkę przechowuje platforma; nie jest częścią podpisu w blockchainie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A nota é armazenada pela plataforma e não faz parte da assinatura na blockchain."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Nota este stocată de platformă și nu face parte din semnătura pe blockchain."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Примечание хранится платформой и не входит в подпись в блокчейне."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ujumbe huhifadhiwa na jukwaa na si sehemu ya saini kwenye blockchain."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "แพลตฟอร์มเก็บบันทึกนี้ไว้ ไม่ใช่ส่วนหนึ่งของลายเซ็นบนเชน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Not platformda saklanır ve zincir üzerindeki imzanın parçası değildir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Примітку зберігає платформа; вона не входить до підпису в блокчейні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نوٹ پلیٹ فارم پر محفوظ ہوتا ہے اور آن چین دستخط کا حصہ نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ghi chú được nền tảng lưu và không thuộc chữ ký trên chuỗi."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说明由平台记录，不属于链上签名内容。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "說明由平台記錄，不屬於鏈上簽名內容。"
          }
        }
      }
