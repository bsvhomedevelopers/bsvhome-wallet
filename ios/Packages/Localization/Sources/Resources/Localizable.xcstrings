    "wowpay_import_method_watch_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عرض الأرصدة والمعاملات فقط، دون إرسال"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ব্যালেন্স ও লেনদেন দেখুন, পাঠানো যাবে না"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pouze zobrazení zůstatků a transakcí, bez odesílání"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Se saldi og transaktioner uden at kunne sende"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Guthaben und Transaktionen ansehen, ohne senden zu können"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "View balances and transactions without sending"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulta saldos y transacciones, sin poder enviar"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط مشاهدهٔ موجودی و تراکنش‌ها، بدون امکان ارسال"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tingnan lang ang balanse at mga transaksyon; hindi makakapagpadala"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Consultez les soldes et transactions, sans pouvoir envoyer"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba ragowar kuɗi da cinikayya kawai, ba za a iya turawa ba"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צפייה ביתרות ובעסקאות בלבד, ללא שליחה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल बैलेंस और लेनदेन देखें, भेज नहीं सकते"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya lihat saldo dan transaksi, tanpa dapat mengirim"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Visualizza saldi e transazioni, senza poter inviare"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高と取引の確認のみ可能。送金はできません"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액과 거래 조회만 가능하며 전송할 수 없습니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lihat baki dan transaksi sahaja, tanpa boleh menghantar"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekijk saldi en transacties, zonder te kunnen versturen"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Tylko podgląd sald i transakcji, bez wysyłania"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Consulte saldos e transações, sem poder enviar"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Vezi solduri și tranzacții, fără a putea trimite"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Только просмотр баланса и транзакций, без отправки"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tazama salio na miamala pekee, bila kutuma"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ดูได้เฉพาะยอดคงเหลือและธุรกรรม ไม่สามารถส่งได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca bakiye ve işlemleri görüntüleyin; gönderim yapılamaz"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Лише перегляд балансу й транзакцій, без надсилання"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف بیلنس اور لین دین دیکھیں، بھیج نہیں سکتے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ xem số dư và giao dịch, không thể gửi"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "仅查看余额与交易，无法发送"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "僅查看餘額與交易，無法發送"
          }
        }
      }
    },
