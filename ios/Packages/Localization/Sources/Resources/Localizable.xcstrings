    "multisig_action_sync_failed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تم إرسال الإجراء، لكن تعذّر تحديث البيانات المحلية. حدّث البيانات قبل المحاولة مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অনুরোধটি জমা হয়েছে, কিন্তু ডিভাইসের তথ্য হালনাগাদ করা যায়নি। আবার চেষ্টা করার আগে তথ্য রিফ্রেশ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Akce byla odeslána, ale místní data se nepodařilo aktualizovat. Před dalším pokusem data aktualizujte."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Handlingen er sendt, men de lokale data kunne ikke opdateres. Opdater dataene, før du prøver igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Aktion wurde übermittelt, aber die lokalen Daten konnten nicht aktualisiert werden. Aktualisiere die Daten, bevor du es erneut versuchst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The action was submitted, but local data could not refresh. Refresh before trying again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La acción se ha enviado, pero no se han podido actualizar los datos locales. Actualiza los datos antes de volver a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست ارسال شد، اما داده‌های محلی به‌روز نشدند. پیش از تلاش دوباره، داده‌ها را تازه‌سازی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naipadala na ang kahilingan, pero hindi ma-refresh ang lokal na datos. I-refresh muna bago subukan muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "L’action a été envoyée, mais les données locales n’ont pas pu être actualisées. Actualisez-les avant de réessayer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "An aika buƙatar, amma an kasa sabunta bayanan da ke kan na’urar. Sabunta bayanan kafin sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפעולה נשלחה, אך לא ניתן היה לרענן את הנתונים המקומיים. יש לרענן לפני ניסיון נוסף."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कार्रवाई का अनुरोध भेज दिया गया है, लेकिन स्थानीय डेटा रीफ़्रेश नहीं हो सका। दोबारा कोशिश करने से पहले डेटा रीफ़्रेश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan telah dikirim, tetapi data lokal gagal diperbarui. Perbarui data sebelum mencoba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L’azione è stata inviata, ma non è stato possibile aggiornare i dati locali. Aggiorna i dati prima di riprovare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "操作は送信されましたが、ローカルデータを更新できませんでした。再試行する前に更新してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청은 제출되었지만 로컬 데이터를 새로고침하지 못했습니다. 다시 시도하기 전에 새로고침하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan telah dihantar, tetapi data tempatan tidak dapat dikemas kini. Kemas kini data sebelum mencuba lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De actie is verzonden, maar de lokale gegevens konden niet worden vernieuwd. Vernieuw ze voordat u het opnieuw probeert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Operacja została wysłana, ale nie udało się odświeżyć danych lokalnych. Odśwież dane przed ponowną próbą."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A ação foi enviada, mas não foi possível atualizar os dados locais. Atualize os dados antes de tentar novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acțiunea a fost trimisă, dar datele locale nu au putut fi actualizate. Actualizează datele înainte de a încerca din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Действие отправлено, но локальные данные не удалось обновить. Обновите данные перед повторной попыткой."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombi limetumwa, lakini data kwenye kifaa haikuweza kusasishwa. Sasisha kabla ya kujaribu tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ส่งคำขอแล้ว แต่ไม่สามารถรีเฟรชข้อมูลในอุปกรณ์ได้ โปรดรีเฟรชก่อนลองอีกครั้ง"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İşlem gönderildi, ancak yerel veriler yenilenemedi. Yeniden denemeden önce verileri yenileyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Дію надіслано, але локальні дані не вдалося оновити. Оновіть дані перед повторною спробою."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست بھیج دی گئی ہے، مگر مقامی ڈیٹا تازہ نہیں ہو سکا۔ دوبارہ کوشش کرنے سے پہلے ڈیٹا ریفریش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thao tác đã được gửi nhưng không thể làm mới dữ liệu trên thiết bị. Hãy làm mới trước khi thử lại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已提交，但本地数据未能刷新。请先刷新，再决定是否重试。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "操作已送出，但本機資料未能更新。請先重新整理，再決定是否重試。"
          }
        }
      }
    },
