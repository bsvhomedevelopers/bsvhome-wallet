    "wowpay_paymail_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم اسمًا سهل التذكر لتلقي المدفوعات بدلًا من عنوان طويل"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "দীর্ঘ ঠিকানার বদলে অর্থ গ্রহণের জন্য সহজে মনে রাখার মতো নাম ব্যবহার করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Místo dlouhé adresy používejte snadno zapamatovatelný název pro příjem plateb"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug et betalingsnavn, der er nemt at huske, i stedet for en lang adresse"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende einen leicht merkbaren Zahlungsnamen statt einer langen Adresse"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use an easy-to-remember payment name instead of a long address"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un nombre de cobro fácil de recordar en lugar de una dirección larga"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌جای آدرس طولانی، از نامی به‌یادماندنی برای دریافت پرداخت استفاده کنید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumamit ng madaling tandaang pangalan sa pagtanggap ng bayad sa halip na mahabang address"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un nom de paiement facile à retenir plutôt qu’une longue adresse"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da sunan karɓar kuɗi mai sauƙin tunawa maimakon dogon adireshi"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אפשר להשתמש בשם קל לזכירה לקבלת תשלומים במקום בכתובת ארוכה"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "लंबे पते की जगह भुगतान प्राप्त करने के लिए आसानी से याद रहने वाला नाम इस्तेमाल करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan nama penerima yang mudah diingat sebagai pengganti alamat panjang"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un nome facile da ricordare per ricevere pagamenti al posto di un indirizzo lungo"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "長いアドレスの代わりに、覚えやすい受取名を使用できます"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "긴 주소 대신 기억하기 쉬운 수취 이름을 사용하세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan nama penerima bayaran yang mudah diingati menggantikan alamat yang panjang"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een makkelijk te onthouden betaalnaam in plaats van een lang adres"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Używaj łatwej do zapamiętania nazwy do odbierania płatności zamiast długiego adresu"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um nome fácil de lembrar para receber pagamentos em vez de um endereço longo"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește un nume de plată ușor de reținut în locul unei adrese lungi"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте запоминающееся имя для получения платежей вместо длинного адреса"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia jina rahisi kukumbuka kupokea malipo badala ya anwani ndefu"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ชื่อรับเงินที่จดจำง่ายแทนที่อยู่แบบยาว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Uzun bir adres yerine kolay hatırlanan bir ödeme alma adı kullanın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте ім’я для отримання платежів, яке легко запам’ятати, замість довгої адреси"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "طویل پتے کے بجائے ادائیگی وصول کرنے کے لیے آسانی سے یاد رہنے والا نام استعمال کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng tên nhận tiền dễ nhớ thay cho địa chỉ dài"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "使用易记的收款名称，替代长地址"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用易記的收款名稱，取代冗長地址"
          }
        }
      }
    },
