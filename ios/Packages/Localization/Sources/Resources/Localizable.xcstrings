        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All members must approve the same final configuration before sending or receiving funds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los miembros deben aprobar la misma configuración final antes de enviar o recibir fondos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیش از ارسال یا دریافت دارایی، همهٔ اعضا باید همان پیکربندی نهایی را تأیید کنند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangang aprubahan ng lahat ang parehong huling configuration bago magpadala o tumanggap ng pondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les membres doivent approuver la même configuration finale avant d’envoyer ou de recevoir des fonds."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dukkan mambobi su amince da tsarin ƙarshe iri ɗaya kafin aikawa ko karɓar kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל החברים חייבים לאשר אותה תצורה סופית לפני שליחת כספים או קבלתם."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "राशि भेजने या प्राप्त करने से पहले सभी सदस्य एक ही अंतिम कॉन्फ़िगरेशन मंज़ूर करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua anggota harus menyetujui konfigurasi akhir yang sama sebelum mengirim atau menerima dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i membri devono approvare la stessa configurazione finale prima di inviare o ricevere fondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金や受取の前に全員が同じ最終設定を承認する必要があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전송이나 수신 전에 전원이 같은 최종 구성을 승인해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ahli mesti meluluskan konfigurasi akhir yang sama sebelum menghantar atau menerima dana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle leden moeten dezelfde definitieve configuratie goedkeuren voordat geld wordt verzonden of ontvangen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszyscy muszą zatwierdzić tę samą ostateczną konfigurację przed wysyłaniem lub odbieraniem środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos devem aprovar a mesma configuração final antes de enviar ou receber fundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toți membrii trebuie să aprobe aceeași configurație finală înainte de trimitere sau primire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Перед отправкой или приёмом все участники должны подтвердить одну окончательную конфигурацию."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wote lazima waidhinishe usanidi wa mwisho uleule kabla ya kutuma au kupokea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมาชิกทุกคนต้องยืนยันการตั้งค่าขั้นสุดท้ายชุดเดียวกันก่อนส่งหรือรับเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Fon gönderme veya alma öncesi herkes aynı son yapılandırmayı onaylamalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До надсилання або отримання всі мають схвалити ту саму остаточну конфігурацію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بھیجنے یا وصول کرنے سے پہلے سب کو ایک ہی حتمی ترتیب منظور کرنی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả phải phê duyệt cùng cấu hình cuối cùng trước khi gửi hay nhận tiền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有成员须确认同一份最终配置后，才能发送或接收资金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有成員須確認同一份最終配置後，才能傳送或接收資金。"
          }
        }
      }
    },
    "multisig_error_package_size": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تتجاوز الحزمة الحجم المدعوم. اطلب حزمة مدعومة من المرسل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্যাকেজ সমর্থিত আকারের চেয়ে বড়। প্রেরকের কাছ থেকে সমর্থিত প্যাকেজ নিন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Balíček překračuje podporovanou velikost. Vyžádejte si od odesílatele podporovaný balíček."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakken overstiger den understøttede størrelse. Bed afsenderen om en understøttet pakke."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Paket überschreitet die unterstützte Größe. Bitte den Absender um ein unterstütztes Paket."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The package exceeds the supported size. Obtain a supported package from the sender."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete supera el tamaño admitido. Solicita un paquete compatible al remitente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بسته از اندازهٔ پشتیبانی‌شده بزرگ‌تر است. بسته‌ای با اندازهٔ مجاز از فرستنده بگیرید."
