    "multisig_stop_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "إيقاف التنسيق لا يلغي توقيعًا صالحًا تمت مشاركته. قد يبث عضو آخر المعاملة الأصلية رغم ذلك."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সহযোগিতা বন্ধ করলে আগে শেয়ার করা বৈধ স্বাক্ষর বাতিল হয় না। অন্য সদস্য এখনও মূল লেনদেন নেটওয়ার্কে পাঠাতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Zastavení spolupráce nezruší platný podpis, který již byl sdílen. Jiný člen může stále odeslat původní transakci do sítě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "At stoppe samarbejdet tilbagekalder ikke en gyldig underskrift, der allerede er delt. Et andet medlem kan stadig udsende den oprindelige transaktion."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Beenden der Zusammenarbeit widerruft keine bereits geteilte gültige Signatur. Andere Mitglieder können die ursprüngliche Transaktion weiterhin übermitteln."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Stopping collaboration cannot revoke a valid signature already shared. Another member may still broadcast the original transaction."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Detener la colaboración no revoca una firma válida ya compartida. Otro miembro aún podría transmitir la transacción original."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "توقف همکاری، امضای معتبرِ قبلاً اشتراک‌گذاری‌شده را باطل نمی‌کند. عضو دیگر همچنان می‌تواند تراکنش اصلی را منتشر کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi binabawi ng pagtigil ang wastong lagdang naibahagi na. Maaari pa ring ipadala ng ibang miyembro sa network ang orihinal na transaksyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrêter la collaboration ne révoque pas une signature valide déjà partagée. Un autre membre peut encore diffuser la transaction initiale."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dakatar da haɗin kai ba ya soke ingantaccen sa hannun da aka riga aka raba. Wani mamba zai iya watsa ma’amalar asali har yanzu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הפסקת שיתוף הפעולה אינה מבטלת חתימה תקפה שכבר שותפה. חבר אחר עדיין יכול לשדר את העסקה המקורית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहयोग रोकने से पहले से साझा किया गया वैध हस्ताक्षर रद्द नहीं होता। कोई दूसरा सदस्य अब भी मूल लेनदेन नेटवर्क पर भेज सकता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan kolaborasi tidak membatalkan tanda tangan sah yang sudah dibagikan. Anggota lain masih dapat menyiarkan transaksi awal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Interrompere la collaborazione non revoca una firma valida già condivisa. Un altro membro potrebbe ancora trasmettere la transazione originale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "共同作業を停止しても、共有済みの有効な署名は取り消せません。他のメンバーが元の取引を送信する可能性があります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "협업을 중단해도 이미 공유한 유효한 서명은 취소되지 않습니다. 다른 구성원이 원래 거래를 전송할 수 있습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Menghentikan kerjasama tidak membatalkan tandatangan sah yang sudah dikongsi. Ahli lain masih boleh menyiarkan transaksi asal."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stoppen trekt een geldige, gedeelde handtekening niet in. Een ander lid kan de oorspronkelijke transactie nog verzenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zatrzymanie współpracy nie unieważnia udostępnionego ważnego podpisu. Inny członek nadal może rozgłosić pierwotną transakcję."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Interromper a colaboração não revoga uma assinatura válida já compartilhada. Outro membro ainda pode transmitir a transação original."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Oprirea colaborării nu revocă o semnătură validă deja partajată. Alt membru poate încă difuza tranzacția inițială."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Остановка работы не отзывает уже переданную действительную подпись. Другой участник всё ещё может отправить исходную транзакцию."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kusitisha ushirikiano hakufuti saini halali iliyoshirikiwa. Mwanachama mwingine bado anaweza kutangaza muamala wa awali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การหยุดไม่เพิกถอนลายเซ็นที่ใช้ได้ซึ่งแชร์ไปแล้ว สมาชิกคนอื่นยังอาจส่งธุรกรรมเดิมได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İş birliğini durdurmak paylaşılmış geçerli imzayı iptal etmez. Başka bir üye özgün işlemi hâlâ yayınlayabilir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зупинка співпраці не скасовує вже переданий дійсний підпис. Інший учасник досі може надіслати початкову транзакцію."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "تعاون روکنے سے پہلے شیئر شدہ درست دستخط منسوخ نہیں ہوتا۔ دوسرا رکن اصل لین دین اب بھی نشر کر سکتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dừng phối hợp không thu hồi chữ ký hợp lệ đã chia sẻ. Thành viên khác vẫn có thể phát giao dịch gốc."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "停止协作不能撤销已经分享的有效签名。其他成员仍可能广播原交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "停止協作不能撤銷已經分享的有效簽名。其他成員仍可能廣播原交易。"
          }
        }
      }
    },
