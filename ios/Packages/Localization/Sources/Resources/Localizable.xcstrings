        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Piyasada şu anda mevcut olan ve işlem gören kripto para birimi sayısı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кількість монет, що наразі доступні та торгуються на ринку."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سککوں کی تعداد جو فی الحال دستیاب ہے اور مارکیٹ میں تجارت کر رہے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lượng tiền điện tử hiện có và đang được giao dịch trên thị trường."
          }
        },
        "zh-Hans": {
