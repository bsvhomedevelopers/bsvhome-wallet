        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Assets you've recently used will appear here"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los recursos que has usado recientemente aparecerán aquí"
