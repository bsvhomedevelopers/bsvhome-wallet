    "multisig_configuration_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يؤكد جميع الأعضاء إعدادات المفاتيح العامة الكاملة نفسها قبل تفعيل المحفظة. الرد على الدعوة وحده لا يفعّلها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ওয়ালেট সক্রিয় হওয়ার আগে সব সদস্যকে একই সম্পূর্ণ প্রকাশ্য কী কনফিগারেশন নিশ্চিত করতে হবে। শুধু আমন্ত্রণের জবাবে এটি সক্রিয় হয় না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všichni členové musí před aktivací potvrdit stejnou úplnou konfiguraci veřejných klíčů. Samotná odpověď na pozvánku nestačí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle medlemmer skal bekræfte den samme komplette konfiguration af offentlige nøgler før aktivering. Et invitationssvar alene aktiverer ikke tegnebogen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle Mitglieder müssen dieselbe vollständige Konfiguration der öffentlichen Schlüssel bestätigen, bevor die Wallet aktiviert wird. Eine Einladungsantwort allein reicht nicht aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "All members must confirm the same complete public-key configuration before the wallet becomes active. An invitation response alone does not activate it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos los miembros deben confirmar la misma configuración completa de claves públicas antes de activar la billetera. Una respuesta a la invitación no basta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ اعضا باید پیش از فعال شدن کیف پول، همان پیکربندی کامل کلیدهای عمومی را تأیید کنند. پاسخ دعوت‌نامه به‌تنهایی کیف پول را فعال نمی‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangang kumpirmahin ng lahat ang parehong kumpletong configuration ng pampublikong susi bago maging aktibo ang wallet. Hindi sapat ang tugon sa imbitasyon lang."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tous les membres doivent confirmer la même configuration complète de clés publiques avant l’activation. Une réponse à l’invitation seule ne suffit pas."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Dukkan mambobi su tabbatar da cikakken tsarin maɓallan jama’a iri ɗaya kafin kunna walat. Amsar gayyata kaɗai ba ta kunna shi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל החברים חייבים לאשר אותה תצורה מלאה של מפתחות ציבוריים לפני הפעלת הארנק. תגובה להזמנה לבדה אינה מפעילה אותו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वॉलेट सक्रिय होने से पहले सभी सदस्य एक ही पूर्ण सार्वजनिक कुंजी कॉन्फ़िगरेशन की पुष्टि करें। केवल आमंत्रण का जवाब देने से वॉलेट सक्रिय नहीं होता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua anggota harus mengonfirmasi konfigurasi lengkap kunci publik yang sama sebelum dompet aktif. Balasan undangan saja tidak mengaktifkannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tutti i membri devono confermare la stessa configurazione completa delle chiavi pubbliche prima dell’attivazione. La sola risposta all’invito non basta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "全員が同じ完全な公開鍵設定を確認してから有効になります。招待への応答だけでは有効になりません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "활성화 전에 전원이 같은 완전한 공개 키 구성을 확인해야 합니다. 초대 응답만으로 활성화되지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semua ahli mesti mengesahkan konfigurasi kunci awam lengkap yang sama sebelum pengaktifan. Jawapan jemputan sahaja tidak mengaktifkan dompet."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle leden moeten vóór activering dezelfde volledige configuratie met openbare sleutels bevestigen. Een antwoord op de uitnodiging alleen activeert de wallet niet."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wszyscy muszą potwierdzić tę samą pełną konfigurację kluczy publicznych przed aktywacją. Sama odpowiedź na zaproszenie jej nie aktywuje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Todos os membros devem confirmar a mesma configuração completa de chaves públicas antes da ativação. A resposta ao convite sozinha não ativa a carteira."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Toți membrii trebuie să confirme aceeași configurație completă de chei publice înainte de activare. Răspunsul la invitație singur nu activează portofelul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Для активации все участники должны подтвердить одну полную конфигурацию открытых ключей. Одного ответа на приглашение недостаточно."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Wote lazima wathibitishe usanidi kamili uleule wa funguo za umma kabla ya kuwezesha mkoba. Jibu la mwaliko pekee halitoshi."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ทุกคนต้องยืนยันการตั้งค่าคีย์สาธารณะที่ครบถ้วนชุดเดียวกันก่อนเปิดใช้ การตอบรับคำเชิญอย่างเดียวยังไม่เปิดใช้กระเป๋า"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Etkinleştirme öncesi herkes aynı eksiksiz açık anahtar yapılandırmasını onaylamalıdır. Davet yanıtı tek başına etkinleştirmez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "До активації всі мають підтвердити одну повну конфігурацію публічних ключів. Самої відповіді на запрошення недостатньо."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "فعال ہونے سے پہلے سب کو عوامی کلیدوں کی ایک ہی مکمل ترتیب کی تصدیق کرنی ہے۔ دعوت کا جواب اکیلا والیٹ فعال نہیں کرتا۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tất cả phải xác nhận cùng cấu hình khóa công khai đầy đủ trước khi kích hoạt. Phản hồi lời mời không đủ để kích hoạt ví."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有成员需要确认同一份完整公钥配置后，钱包才可启用。接受邀请的回执不能代替最终配置确认。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "所有成員需要確認同一份完整公鑰配置後，錢包才可啟用。接受邀請的回執不能代替最終配置確認。"
          }
        }
      }
    },
