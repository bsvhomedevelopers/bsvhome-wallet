    "wowpay_swap_account_required": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أضف حساب الشبكة المطلوبة إلى هذه المحفظة للمتابعة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "চালিয়ে যেতে এই ওয়ালেটে প্রয়োজনীয় নেটওয়ার্কের অ্যাকাউন্ট যোগ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Pro pokračování přidejte do této peněženky účet v požadované síti."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tilføj en konto på det påkrævede netværk til denne tegnebog for at fortsætte."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Füge dieser Wallet ein Konto im erforderlichen Netzwerk hinzu, um fortzufahren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Add the required network account to this wallet to continue."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Añade a esta billetera la cuenta de la red necesaria para continuar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "برای ادامه، حساب شبکه مورد نیاز را به این کیف پول اضافه کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Idagdag sa wallet na ito ang account sa kinakailangang network para magpatuloy."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajoutez le compte du réseau requis à ce portefeuille pour continuer."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ƙara asusun cibiyar sadarwar da ake buƙata zuwa wannan walat don ci gaba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להוסיף לארנק זה חשבון ברשת הנדרשת כדי להמשיך."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जारी रखने के लिए इस वॉलेट में आवश्यक नेटवर्क का खाता जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan akun jaringan yang diperlukan ke dompet ini untuk melanjutkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiungi a questo portafoglio un account sulla rete richiesta per continuare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "必要なネットワークのアカウントをこのウォレットに追加して続けてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "계속하려면 필요한 네트워크의 계정을 이 지갑에 추가하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tambahkan akaun pada rangkaian yang diperlukan ke dompet ini untuk meneruskan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voeg het account voor het vereiste netwerk toe aan deze wallet om door te gaan."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dodaj do tego portfela konto wymaganej sieci, aby kontynuować."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Adicione a esta carteira uma conta na rede necessária para continuar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Adaugă în acest portofel contul pentru rețeaua necesară pentru a continua."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Добавьте в этот кошелёк аккаунт нужной сети, чтобы продолжить."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ongeza akaunti ya mtandao unaohitajika kwenye pochi hii ili kuendelea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เพิ่มบัญชีเครือข่ายที่จำเป็นในกระเป๋านี้ก่อนดำเนินการต่อ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Devam etmek için bu cüzdana gerekli ağ hesabını ekleyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Додайте до цього гаманця обліковий запис у потрібній мережі, щоб продовжити."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "جاری رکھنے کے لیے اس والیٹ میں مطلوبہ نیٹ ورک کا اکاؤنٹ شامل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Thêm tài khoản của mạng cần dùng vào ví này để tiếp tục."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请先为当前钱包添加所需网络账户。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請先為目前錢包新增所需網路帳戶。"
          }
        }
      }
    },
    "wowpay_swap_acquisition_pending_order": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يزال طلب إنشاء أمر تبادل سابق بانتظار التأكيد. افتح علامة تبويب التبادل لاستعادة الطلب قبل إنشاء أمر جديد."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগের একটি বিনিময় অর্ডার তৈরির অনুরোধ এখনও নিশ্চিত হয়নি। নতুন অর্ডার তৈরির আগে বিনিময় ট্যাব খুলে আগের অনুরোধটি পুনরুদ্ধার করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Předchozí požadavek na vytvoření směny čeká na potvrzení. Než vytvoříte další objednávku, otevřete kartu Směna a obnovte předchozí požadavek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En tidligere anmodning om at oprette en veksling afventer bekræftelse. Åbn fanen Veksling for at gendanne den, før du opretter en ny ordre."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine frühere Anfrage zum Erstellen eines Tauschauftrags wartet auf Bestätigung. Öffne den Tab „Tausch“, um sie wiederherzustellen, bevor du einen neuen Auftrag erstellst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A previous exchange request is pending. Open the Exchange tab to recover it before creating another order."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una solicitud anterior para crear una orden de intercambio está pendiente de confirmación. Abre la pestaña Intercambio para recuperarla antes de crear otra orden."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست قبلی برای ایجاد سفارش تبدیل هنوز در انتظار تأیید است. پیش از ایجاد سفارش جدید، زبانهٔ تبدیل را باز کنید و درخواست قبلی را بازیابی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Naghihintay pa ng kumpirmasyon ang naunang kahilingan na gumawa ng exchange order. Buksan ang tab na Exchange para mabawi ito bago gumawa ng panibagong order."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une précédente demande de création d’ordre d’échange est en attente de confirmation. Ouvrez l’onglet Échange pour la récupérer avant de créer un nouvel ordre."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Wata buƙatar ƙirƙirar odar musanya da ta gabata tana jiran tabbaci. Buɗe shafin Musanya don dawo da ita kafin ƙirƙirar wata oda."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשה קודמת ליצירת הזמנת החלפה עדיין ממתינה לאישור. יש לפתוח את לשונית ההחלפה כדי לשחזר אותה לפני יצירת הזמנה נוספת."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक पिछला एक्सचेंज ऑर्डर बनाने का अनुरोध अभी पुष्टि की प्रतीक्षा में है। नया ऑर्डर बनाने से पहले एक्सचेंज टैब खोलकर पिछले अनुरोध को पुनः प्राप्त करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan sebelumnya untuk membuat pesanan pertukaran masih menunggu konfirmasi. Buka tab Tukar untuk memulihkannya sebelum membuat pesanan baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una precedente richiesta di creazione di un ordine di scambio è in attesa di conferma. Apri la scheda Scambio per recuperarla prima di creare un nuovo ordine."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "以前の交換注文の作成リクエストが確認待ちです。新しい注文を作成する前に、交換タブを開いて以前のリクエストを復旧してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이전 교환 주문 생성 요청이 확인 대기 중입니다. 새 주문을 만들기 전에 교환 탭을 열어 이전 요청을 복구하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan terdahulu untuk membuat pesanan pertukaran masih menunggu pengesahan. Buka tab Tukar untuk memulihkannya sebelum membuat pesanan baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een eerder verzoek om een wisselorder aan te maken wacht nog op bevestiging. Open het tabblad Wisselen om het te herstellen voordat je een nieuwe order aanmaakt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Poprzednie żądanie utworzenia zlecenia wymiany czeka na potwierdzenie. Otwórz kartę Wymiana, aby je odzyskać przed utworzeniem kolejnego zlecenia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma solicitação anterior de criação de ordem de troca está aguardando confirmação. Abra a aba Troca para recuperá-la antes de criar uma nova ordem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "O cerere anterioară de creare a unui ordin de schimb așteaptă confirmarea. Deschide fila Schimb pentru a o recupera înainte de a crea un nou ordin."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Предыдущий запрос на создание заявки на обмен ожидает подтверждения. Откройте вкладку «Обмен», чтобы восстановить его, прежде чем создавать новую заявку."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombi la awali la kuunda agizo la kubadilisha bado linasubiri uthibitisho. Fungua kichupo cha Kubadilisha ili kulirejesha kabla ya kuunda agizo jipya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอสร้างคำสั่งแลกเปลี่ยนก่อนหน้ายังรอการยืนยัน โปรดเปิดแท็บแลกเปลี่ยนเพื่อกู้คืนคำขอนั้นก่อนสร้างคำสั่งใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önceki bir takas emri oluşturma isteği onay bekliyor. Yeni bir emir oluşturmadan önce Takas sekmesini açarak önceki isteği kurtarın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Попередній запит на створення замовлення на обмін очікує підтвердження. Відкрийте вкладку «Обмін», щоб відновити його, перш ніж створювати нове замовлення."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایکسچینج آرڈر بنانے کی ایک پچھلی درخواست ابھی تصدیق کی منتظر ہے۔ نیا آرڈر بنانے سے پہلے ایکسچینج ٹیب کھول کر پچھلی درخواست بحال کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một yêu cầu tạo lệnh đổi trước đó đang chờ xác nhận. Mở tab Đổi để khôi phục yêu cầu đó trước khi tạo lệnh mới."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "有一笔兑换下单请求尚待确认，请先前往兑换 TAB 恢复处理，再创建新订单。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "有一筆兌換下單請求尚待確認，請先前往兌換分頁恢復處理，再建立新訂單。"
          }
        }
      }
    },
