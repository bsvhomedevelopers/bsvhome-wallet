    "multisig_identity_source_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تظل هوية التوقيع مرتبطة بهذه المحفظة متعددة التوقيعات."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "স্বাক্ষর পরিচয় এই মাল্টিসিগ ওয়ালেটের সঙ্গে যুক্ত থাকে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Podpisová identita zůstává propojena s touto multisig peněženkou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Signeringsidentiteten forbliver knyttet til denne multisig-tegnebog."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Signaturidentität bleibt mit dieser Multisig-Wallet verknüpft."
          }
        },
        "en": {
