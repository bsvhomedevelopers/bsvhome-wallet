    "multisig_inactive_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أكمل تأكيد جميع الأعضاء أولًا. الإرسال والاستقبال غير متاحين حاليًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আগে সব সদস্যের নিশ্চিতকরণ সম্পন্ন করুন। এখন অর্থ পাঠানো ও গ্রহণ করা যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nejprve dokončete potvrzení všech členů. Odesílání a příjem zatím nejsou dostupné."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Alle medlemmer skal først bekræfte. Afsendelse og modtagelse er endnu ikke tilgængelig."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Zuerst müssen alle Mitglieder bestätigen. Senden und Empfangen sind derzeit nicht verfügbar."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Complete all member confirmations first. Sending and receiving are currently unavailable."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Primero deben confirmar todos los miembros. El envío y la recepción no están disponibles por ahora."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "ابتدا تأیید همهٔ اعضا را کامل کنید. ارسال و دریافت فعلاً در دسترس نیست."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpletuhin muna ang kumpirmasyon ng lahat. Hindi pa magagamit ang pagpapadala at pagtanggap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Terminez d’abord toutes les confirmations des membres. L’envoi et la réception sont actuellement indisponibles."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kammala tabbatarwar dukkan mambobi tukuna. Ba a iya aikawa ko karɓa yanzu."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשלים קודם את האישורים של כל החברים. שליחה וקבלה עדיין אינן זמינות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पहले सभी सदस्यों की पुष्टि पूरी करें। फ़िलहाल भेजना और प्राप्त करना उपलब्ध नहीं है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Selesaikan konfirmasi semua anggota terlebih dahulu. Pengiriman dan penerimaan belum tersedia."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Completa prima le conferme di tutti i membri. Invio e ricezione non sono ancora disponibili."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "先に全員の確認を完了してください。現在は送金と受取を利用できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "먼저 모든 구성원의 확인을 완료하세요. 현재 송금과 수신을 사용할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengkapkan semua pengesahan dahulu. Penghantaran dan penerimaan belum tersedia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Voltooi eerst alle bevestigingen. Verzenden en ontvangen zijn nog niet beschikbaar."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Najpierw zbierz wszystkie potwierdzenia. Wysyłanie i odbieranie są obecnie niedostępne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Conclua todas as confirmações primeiro. O envio e o recebimento ainda não estão disponíveis."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Finalizează întâi toate confirmările. Trimiterea și primirea nu sunt încă disponibile."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сначала получите все подтверждения. Отправка и приём пока недоступны."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kamilisha uthibitisho wa wote kwanza. Kutuma na kupokea bado hakupatikani."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ให้สมาชิกยืนยันครบก่อน ขณะนี้ยังส่งหรือรับไม่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Önce tüm üye onaylarını tamamlayın. Gönderme ve alma şu anda kullanılamıyor."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Спершу зберіть усі підтвердження. Надсилання й отримання ще недоступні."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "پہلے تمام اراکین کی تصدیق مکمل کریں۔ بھیجنا اور وصول کرنا ابھی دستیاب نہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Hoàn tất xác nhận của tất cả trước. Hiện chưa thể gửi hoặc nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请邀请剩余成员完成确认。此时接收和发送入口暂不可用。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
