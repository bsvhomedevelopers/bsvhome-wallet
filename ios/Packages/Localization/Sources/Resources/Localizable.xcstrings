        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "זכה בתגמולים של %@ על ההימור שלך בזמן שאתה ישן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सोते समय अपने स्टेक पर %@ पुरस्कार अर्जित करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapatkan hadiah %@ dari staking ketika anda istirahat"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Guadagna %@ premi sulla tua puntata mentre dormi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ をステーキングして、寝ている間も報酬を獲得できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잠자는 동안 스테이크에 대한 %@ 보상을 받으세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Peroleh %@ ganjaran pada pertaruhan anda semasa anda tidur."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Verdien %@ beloningen op uw inzet terwijl u slaapt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zdobądź %@ nagród na swojej stawce podczas snu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Ganhe recompensas %@ no seu stake enquanto você dorme."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Câștigă %@ recompense pe miza ta în timp ce dormi."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Зарабатывайте %@ наград за свою стейк, пока спите."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pata zawadi %@ kwenye hisa yako unapolala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "รับรางวัล %@ จากการสเตคของคุณในขณะที่คุณนอนหลับ"
