    "multisig_import_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "راجع المعلومات المستوردة قبل الحفظ. استيراد حزمة لا يوقّع أو يبث معاملة تلقائيًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সংরক্ষণের আগে আমদানি করা তথ্য যাচাই করুন। প্যাকেজ আমদানি কখনো নিজে থেকে লেনদেন স্বাক্ষর বা নেটওয়ার্কে পাঠায় না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před uložením zkontrolujte importované údaje. Import nikdy automaticky nepodepíše ani neodešle transakci do sítě."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Gennemgå importerede oplysninger før lagring. Import af en pakke underskriver eller udsender aldrig en transaktion automatisk."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Prüfe importierte Informationen vor dem Speichern. Ein Import unterschreibt oder übermittelt niemals automatisch eine Transaktion."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Review imported information before saving. Importing a package never signs or broadcasts a transaction automatically."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Revisa la información importada antes de guardarla. Importar un paquete nunca firma ni transmite una transacción automáticamente."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اطلاعات واردشده را پیش از ذخیره بررسی کنید. وارد کردن بسته هرگز به‌طور خودکار تراکنش را امضا یا منتشر نمی‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suriin ang na-import na impormasyon bago i-save. Hindi awtomatikong pumipirma o nagpapadala ng transaksyon sa network ang pag-import."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez les informations importées avant de les enregistrer. L’importation ne signe ni ne diffuse jamais automatiquement une transaction."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Duba bayanan da aka shigo da su kafin adanawa. Shigo da kunshi ba ya sa hannu ko watsa ma’amala da kansa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדוק את המידע המיובא לפני השמירה. ייבוא חבילה לעולם אינו חותם או משדר עסקה אוטומטית."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजने से पहले आयात की गई जानकारी जाँचें। पैकेज आयात करने से कभी अपने-आप हस्ताक्षर या नेटवर्क पर लेनदेन नहीं भेजा जाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa informasi impor sebelum menyimpan. Mengimpor paket tidak pernah otomatis menandatangani atau menyiarkan transaksi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica le informazioni importate prima di salvarle. L’importazione non firma né trasmette mai una transazione automaticamente."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存前に確認してください。インポートによって取引が自動で署名・送信されることはありません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장 전에 확인하세요. 가져오기는 자동으로 서명하거나 거래를 전송하지 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak sebelum menyimpan. Import tidak menandatangani atau menyiarkan transaksi secara automatik."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer vóór opslaan. Importeren ondertekent of verzendt nooit automatisch een transactie."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź dane przed zapisaniem. Import nigdy nie podpisuje ani nie rozgłasza transakcji automatycznie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira os dados antes de salvar. Importar um pacote nunca assina nem transmite uma transação automaticamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifică datele înainte de salvare. Importul nu semnează și nu difuzează niciodată automat o tranzacție."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте данные перед сохранением. Импорт никогда не подписывает и не отправляет транзакцию автоматически."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakiki kabla ya kuhifadhi. Kuingiza kifurushi hakusaini wala kutangaza muamala kiotomatiki."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบข้อมูลก่อนบันทึก การนำเข้าไม่ลงนามหรือส่งธุรกรรมโดยอัตโนมัติ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kaydetmeden önce kontrol edin. Paket içe aktarmak otomatik imza atmaz veya işlem yayınlamaz."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте дані перед збереженням. Імпорт ніколи не підписує й не надсилає транзакцію автоматично."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "محفوظ کرنے سے پہلے جانچیں۔ درآمد خود بخود دستخط یا لین دین نشر نہیں کرتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra trước khi lưu. Nhập gói không tự động ký hay phát giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "导入前请审核信息。导入协作包不会自动签名或广播交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "匯入前請稽核資訊。匯入協作包不會自動簽名或廣播交易。"
          }
        }
      }
    },
    "multisig_import_placeholder": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "الصق حزمة دعوة أو رد أو إعدادات أو مقترح أو توقيع"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণ, জবাব, কনফিগারেশন, প্রস্তাব বা স্বাক্ষরের প্যাকেজ পেস্ট করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Vložte pozvánku, odpověď, konfiguraci, návrh nebo balíček podpisů"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Indsæt en invitation, et svar, en konfiguration, et forslag eller en underskriftspakke"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Einladung, Antwort, Konfiguration, Vorschlag oder Signaturpaket einfügen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paste an invitation, response, configuration, proposal or signature package"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pega una invitación, respuesta, configuración, propuesta o paquete de firmas"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوت‌نامه، پاسخ، پیکربندی، پیشنهاد یا بستهٔ امضا را بچسبانید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "I-paste ang imbitasyon, tugon, configuration, panukala o pakete ng lagda"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Collez une invitation, une réponse, une configuration, une proposition ou un paquet de signatures"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Manna gayyata, amsa, tsari, shawara ko kunshin sa hannu"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הדבק הזמנה, תגובה, תצורה, הצעה או חבילת חתימות"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आमंत्रण, जवाब, कॉन्फ़िगरेशन, प्रस्ताव या हस्ताक्षर पैकेज पेस्ट करें"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tempel undangan, balasan, konfigurasi, usulan, atau paket tanda tangan"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Incolla un invito, una risposta, una configurazione, una proposta o un pacchetto di firme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "招待、応答、設定、提案、署名パッケージを貼り付け"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "초대, 응답, 구성, 제안 또는 서명 패키지를 붙여넣으세요"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Tampal jemputan, jawapan, konfigurasi, cadangan atau pakej tandatangan"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Plak een uitnodiging, antwoord, configuratie, voorstel of handtekeningenpakket"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wklej zaproszenie, odpowiedź, konfigurację, propozycję lub pakiet podpisów"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cole um convite, resposta, configuração, proposta ou pacote de assinaturas"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Lipește invitația, răspunsul, configurația, propunerea sau pachetul de semnături"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставьте приглашение, ответ, конфигурацию, предложение или пакет подписей"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bandika mwaliko, jibu, usanidi, pendekezo au kifurushi cha saini"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "วางคำเชิญ คำตอบ การตั้งค่า ข้อเสนอหรือชุดลายเซ็น"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Davet, yanıt, yapılandırma, öneri veya imza paketini yapıştırın"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Вставте запрошення, відповідь, конфігурацію, пропозицію або пакет підписів"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "دعوت، جواب، ترتیب، تجویز یا دستخط کا پیکیج چسپاں کریں"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dán lời mời, phản hồi, cấu hình, đề xuất hoặc gói chữ ký"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "粘贴邀请、回执、配置、提案或签名包"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "貼上邀請、回執、配置、提案或簽名包"
          }
        }
      }
    },
