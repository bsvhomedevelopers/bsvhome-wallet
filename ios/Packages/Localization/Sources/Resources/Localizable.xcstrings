    "multisig_stale_balance": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فشل تحديث الرصيد. قد تكون البيانات السابقة قديمة؛ أعد المحاولة قبل الإنفاق."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ব্যালেন্স আপডেট ব্যর্থ। আগের তথ্য পুরোনো হতে পারে; খরচের আগে আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizace zůstatku selhala. Předchozí údaje mohou být zastaralé; před utrácením zkuste aktualizaci znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldoen kunne ikke opdateres. De tidligere oplysninger kan være forældede; prøv igen før brug af midler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Kontostand konnte nicht aktualisiert werden. Die bisherigen Daten können veraltet sein; versuche es vor einer Ausgabe erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Balance update failed. The previous snapshot may be outdated; retry before spending."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo actualizar el saldo. Los datos anteriores pueden estar desactualizados; reintenta antes de gastar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "به‌روزرسانی موجودی انجام نشد. اطلاعات قبلی ممکن است قدیمی باشد؛ پیش از خرج کردن دوباره تلاش کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi na-update ang balanse. Maaaring luma na ang naunang datos; subukang muli bago gumastos."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Échec de la mise à jour du solde. Les données précédentes peuvent être périmées ; réessayez avant de dépenser."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Sabunta kuɗin walat ya gaza. Tsohon bayanin na iya zama ya tsufa; sake gwadawa kafin kashe kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "עדכון היתרה נכשל. הנתונים הקודמים עשויים להיות מיושנים; נסה שוב לפני הוצאת כספים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैलेंस अपडेट नहीं हुआ। पिछली जानकारी पुरानी हो सकती है; खर्च करने से पहले दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pembaruan saldo gagal. Data sebelumnya mungkin sudah kedaluwarsa; coba lagi sebelum membelanjakan dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Aggiornamento del saldo non riuscito. I dati precedenti potrebbero essere obsoleti; riprova prima di spendere."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "残高の更新に失敗しました。前の情報は古い可能性があります。支出前に再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "잔액 업데이트에 실패했습니다. 이전 정보가 오래되었을 수 있으니 지출 전에 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Kemas kini baki gagal. Maklumat lama mungkin lapuk; cuba lagi sebelum membelanjakan dana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Saldo bijwerken mislukt. De vorige gegevens kunnen verouderd zijn; probeer opnieuw voordat u geld uitgeeft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Aktualizacja salda nie powiodła się. Poprzednie dane mogą być nieaktualne; ponów próbę przed wydaniem środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Falha ao atualizar o saldo. Os dados anteriores podem estar desatualizados; tente novamente antes de gastar."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Actualizarea soldului a eșuat. Datele anterioare pot fi învechite; reîncearcă înainte de cheltuire."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось обновить баланс. Прежние данные могут устареть; повторите попытку перед расходованием."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Salio halijasasishwa. Taarifa za awali huenda zimepitwa na wakati; jaribu tena kabla ya kutumia fedha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "อัปเดตยอดคงเหลือไม่สำเร็จ ข้อมูลเดิมอาจล้าสมัย โปรดลองใหม่ก่อนใช้จ่าย"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bakiye güncellenemedi. Önceki bilgiler eski olabilir; harcamadan önce yeniden deneyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Баланс не оновлено. Попередні дані можуть застаріти; повторіть спробу перед витрачанням."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بیلنس تازہ نہیں ہو سکا۔ پچھلی معلومات پرانی ہو سکتی ہیں؛ خرچ کرنے سے پہلے دوبارہ کوشش کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cập nhật số dư thất bại. Dữ liệu trước có thể đã cũ; thử lại trước khi chi tiền."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "余额更新失败，先前快照可能已过期，请重试后再发起交易。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "餘額更新失敗，先前快照可能已過期，請重試後再發起交易。"
          }
        }
      }
    },
