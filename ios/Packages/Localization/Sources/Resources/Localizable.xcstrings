    "paymail_invalid_response": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أعاد Paymail بيانات غير صالحة. حدّث وحاول مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail অবৈধ ডেটা ফেরত দিয়েছে। রিফ্রেশ করে আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail vrátil neplatná data. Aktualizujte údaje a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail returnerede ugyldige data. Opdatér og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail hat ungültige Daten zurückgegeben. Aktualisiere und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail returned invalid data. Refresh and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail devolvió datos no válidos. Actualiza e inténtalo de nuevo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "Paymail دادهٔ نامعتبر برگرداند. تازه‌سازی کنید و دوباره امتحان کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
