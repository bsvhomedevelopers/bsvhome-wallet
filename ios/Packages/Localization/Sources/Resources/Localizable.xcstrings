        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันตรวจสอบผู้รับ จำนวนเงิน ค่าธรรมเนียม และเงินทอนแล้ว"
          }
        },
        "tr": {
          "stringUnit": {
