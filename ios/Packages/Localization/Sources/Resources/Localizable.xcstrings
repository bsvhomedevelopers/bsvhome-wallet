          "stringUnit": {
            "state": "translated",
            "value": "একটি অনুরোধ অপেক্ষমাণ। চালিয়ে যান বা স্বাক্ষরের আগে বাতিল করে নতুন অনুরোধ তৈরি করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Žádost čeká. Pokračujte nebo ji před podpisem zrušte a vytvořte novou."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En anmodning afventer. Fortsæt eller annullér før underskrift for at oprette en ny."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine Signaturanfrage ist offen. Fortsetzen oder vor dem Signieren abbrechen, bevor eine neue Anfrage erstellt wird."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A signing request is already pending. Continue it, or cancel it before preparing another unsigned request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay una solicitud pendiente. Continúela o cancélela antes de firmar para crear otra."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواستی در انتظار است. آن را ادامه دهید یا پیش از امضا لغو کنید و سپس درخواست جدیدی بسازید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "May nakabinbing kahilingan. Ipagpatuloy o kanselahin bago pumirma upang makagawa ng bago."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une demande attend. Continuez-la ou annulez-la avant signature pour en créer une nouvelle."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Akwai buƙata mai jiran aiki. Ci gaba ko soke kafin sa hannu don ƙirƙiri wata sabuwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בקשה ממתינה. המשיכו אותה או בטלו לפני חתימה כדי להכין בקשה חדשה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "एक अनुरोध लंबित है। इसे जारी रखें या नया अनुरोध बनाने से पहले बिना हस्ताक्षर वाला अनुरोध रद्द करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan sedang menunggu. Lanjutkan atau batalkan sebelum ditandatangani untuk membuat permintaan baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una richiesta è in sospeso. Continua oppure annullala prima della firma per crearne un’altra."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "署名リクエストが保留中です。続行するか、署名前にキャンセルしてから新規作成してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "서명 요청이 대기 중입니다. 계속 처리하거나 서명 전에 취소한 후 새 요청을 만드세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan masih menunggu. Teruskan atau batalkan sebelum menandatangani untuk mencipta permintaan baharu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wacht een verzoek. Ga verder of annuleer vóór ondertekening om een nieuw verzoek te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie oczekuje. Kontynuuj lub anuluj przed podpisaniem, aby utworzyć nowe."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Há uma solicitação pendente. Continue ou cancele antes de assinar para criar outra."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Există o cerere în așteptare. Continuați sau anulați înainte de semnare pentru a crea alta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Есть ожидающий запрос. Продолжите его или отмените до подписания, чтобы создать новый."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombi linasubiri. Endelea nalo au ulighairi kabla ya kusaini ili kuunda jipya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "มีคำขอรออยู่ ดำเนินการต่อหรือยกเลิกก่อนลงนามแล้วจึงสร้างคำขอใหม่"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekleyen bir talep var. Devam edin veya yeni talep hazırlamadan önce imzalanmamış talebi iptal edin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Є запит в очікуванні. Продовжіть або скасуйте його до підписання, щоб створити новий."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ایک درخواست زیر التوا ہے۔ جاری رکھیں یا دستخط سے پہلے منسوخ کریں، پھر نئی درخواست بنائیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Có yêu cầu đang chờ. Tiếp tục hoặc hủy trước khi ký rồi mới tạo yêu cầu khác."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已有待处理的签名请求。请继续处理，或在未签名前取消请求，再创建新请求。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "已有待處理的簽名請求。請繼續處理，或在未簽名前取消請求，再建立新請求。"
          }
        }
      }
    },
