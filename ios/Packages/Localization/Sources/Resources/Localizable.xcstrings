    "multisig_funding_discard_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "سيُحذف فقط الإعداد الذي لم يُرسل. لا يمكن تجاهل معاملة موقّعة محفوظة من هنا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু জমা না দেওয়া প্রস্তুতিটি সরানো হবে। সংরক্ষিত স্বাক্ষরিত লেনদেন এখানে বাদ দেওয়া যাবে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Odstraní se pouze neodeslaná příprava. Uloženou podepsanou transakci zde nelze zahodit."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun en klargøring, der ikke er sendt, bliver fjernet. En gemt, underskrevet transaktion kan ikke kasseres her."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur eine noch nicht übermittelte Vorbereitung wird entfernt. Eine gespeicherte signierte Transaktion kann hier nicht verworfen werden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Only an unsubmitted preparation will be removed. A saved signed transaction cannot be discarded here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo se eliminará una preparación que no se haya enviado. Aquí no se puede descartar una transacción firmada guardada."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط آماده‌سازی ارسال‌نشده حذف می‌شود. تراکنش امضاشدهٔ ذخیره‌شده را نمی‌توان از اینجا کنار گذاشت."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Paghahandang hindi pa naipapadala lang ang aalisin. Hindi maaaring itapon dito ang naka-save na nilagdaang transaksyon."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Seule une préparation non soumise sera supprimée. Une transaction signée enregistrée ne peut pas être abandonnée ici."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Za a cire shirin da ba a tura ba kawai. Ba za a iya watsi da ma’amala mai sa hannu da aka adana a nan ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "רק הכנה שטרם נשלחה תוסר. לא ניתן לבטל כאן עסקה חתומה שנשמרה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल जमा न की गई तैयारी हटाई जाएगी। सहेजा गया हस्ताक्षरित लेनदेन यहाँ नहीं छोड़ा जा सकता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya persiapan yang belum dikirim yang akan dihapus. Transaksi bertanda tangan yang tersimpan tidak dapat dibuang di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verrà rimossa solo una preparazione non ancora inviata. Una transazione firmata salvata non può essere scartata qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "未送信の準備のみが削除されます。保存済みの署名付きトランザクションはここでは破棄できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "아직 제출하지 않은 준비만 삭제됩니다. 저장된 서명 거래는 여기서 폐기할 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Hanya persediaan yang belum dihantar akan dibuang. Transaksi bertandatangan yang disimpan tidak boleh dibuang di sini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Alleen een nog niet verzonden voorbereiding wordt verwijderd. Een opgeslagen ondertekende transactie kan hier niet worden verworpen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte zostanie tylko niewysłane przygotowanie. Nie można tu odrzucić zapisanej podpisanej transakcji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Apenas uma preparação ainda não enviada será removida. Uma transação assinada salva não pode ser descartada aqui."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Va fi eliminată doar o pregătire care nu a fost trimisă. O tranzacție semnată salvată nu poate fi eliminată de aici."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Будет удалена только неотправленная подготовка. Сохранённую подписанную транзакцию здесь отменить нельзя."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Maandalizi ambayo hayajatumwa pekee ndiyo yataondolewa. Muamala uliotiwa saini na kuhifadhiwa hauwezi kutupwa hapa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จะลบเฉพาะการเตรียมที่ยังไม่ได้ส่งเท่านั้น ไม่สามารถยกเลิกธุรกรรมที่ลงนามและบันทึกไว้ที่นี่ได้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca gönderilmemiş hazırlık kaldırılır. Kaydedilmiş imzalı bir işlem buradan iptal edilemez."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Буде видалено лише ненадіслану підготовку. Збережену підписану транзакцію тут скасувати не можна."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف وہ تیاری ہٹائی جائے گی جو ابھی جمع نہیں کرائی گئی۔ محفوظ دستخط شدہ ٹرانزیکشن یہاں ترک نہیں کی جا سکتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Chỉ bản chuẩn bị chưa được gửi mới bị xóa. Không thể hủy giao dịch đã ký được lưu tại đây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "只会移除尚未提交的准备；已保存的签名交易不能在此放弃。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "只會移除尚未提交的準備；已儲存的簽署交易無法在此放棄。"
          }
        }
      }
    },
