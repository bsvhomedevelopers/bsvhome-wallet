    "multisig_public_key_pending": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد المفتاح العام للعضو بعد قبول الدعوة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণ গ্রহণের পর সদস্যের প্রকাশ্য কী নিশ্চিত করুন"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Po přijetí pozvánky potvrďte veřejný klíč člena"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft medlemmets offentlige nøgle efter accept af invitationen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Öffentlichen Mitgliedsschlüssel nach Annahme der Einladung bestätigen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm the member public key after accepting the invitation"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar la clave pública del miembro tras aceptar la invitación"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پس از پذیرش دعوت‌نامه، کلید عمومی عضو را تأیید کنید"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kumpirmahin ang pampublikong susi ng miyembro matapos tanggapin ang imbitasyon"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmer la clé publique du membre après acceptation de l’invitation"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabbatar da maɓallin jama’a na mamba bayan karɓar gayyata"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אישור המפתח הציבורי של החבר לאחר קבלת ההזמנה"
          }
        },
        "hi": {
          "stringUnit": {
