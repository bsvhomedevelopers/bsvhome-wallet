        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "待簽名"
          }
        }
      }
    },
    "multisig_configuration_changed": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تختلف الإعدادات العامة عن الإعدادات الموثوقة على هذا الجهاز. تم حظر التوقيع والإيداع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রকাশ্য কনফিগারেশন এই ডিভাইসে অনুমোদিত কনফিগারেশন থেকে আলাদা। স্বাক্ষর ও অর্থ জমা বন্ধ করা হয়েছে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Veřejná konfigurace se liší od konfigurace schválené na tomto zařízení. Podepisování a vklady jsou zablokované."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Den offentlige konfiguration afviger fra den godkendte konfiguration på denne enhed. Underskrift og indbetaling er blokeret."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die öffentliche Konfiguration weicht von der auf diesem Gerät bestätigten Konfiguration ab. Signieren und Einzahlen sind gesperrt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The public configuration differs from the configuration trusted on this device. Signing and funding are blocked."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuración pública difiere de la aprobada en este dispositivo. Se han bloqueado las firmas y los depósitos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پیکربندی عمومی با پیکربندی تأییدشده در این دستگاه متفاوت است. امضا و واریز مسدود شده‌اند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Iba ang pampublikong configuration sa inaprubahan sa device na ito. Naka-block ang paglagda at pagdeposito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La configuration publique diffère de celle approuvée sur cet appareil. La signature et les dépôts sont bloqués."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tsarin jama’a ya bambanta da wanda aka amince da shi a wannan na’ura. An hana sa hannu da saka kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "התצורה הציבורית שונה מזו שאושרה במכשיר הזה. החתימה וההפקדה חסומות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सार्वजनिक कॉन्फ़िगरेशन इस डिवाइस पर स्वीकृत कॉन्फ़िगरेशन से अलग है। हस्ताक्षर और जमा रोक दिए गए हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi publik berbeda dari yang disetujui di perangkat ini. Penandatanganan dan penyetoran diblokir."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La configurazione pubblica è diversa da quella approvata su questo dispositivo. Firma e versamenti sono bloccati."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "公開設定がこの端末で承認した設定と異なります。署名と入金は停止されています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "공개 구성이 이 기기에서 승인한 구성과 다릅니다. 서명과 입금이 차단되었습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfigurasi awam berbeza daripada yang diluluskan pada peranti ini. Tandatangan dan deposit disekat."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De openbare configuratie wijkt af van de op dit apparaat goedgekeurde configuratie. Ondertekenen en storten zijn geblokkeerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Konfiguracja publiczna różni się od zatwierdzonej na tym urządzeniu. Podpisywanie i wpłaty są zablokowane."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A configuração pública difere da aprovada neste dispositivo. Assinaturas e depósitos estão bloqueados."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Configurația publică diferă de cea aprobată pe acest dispozitiv. Semnarea și depunerile sunt blocate."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Открытая конфигурация отличается от подтверждённой на этом устройстве. Подписание и пополнение заблокированы."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Usanidi wa umma unatofautiana na uliothibitishwa kwenye kifaa hiki. Kusaini na kuweka fedha kumezuiwa."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "การตั้งค่าสาธารณะต่างจากที่ยืนยันไว้บนอุปกรณ์นี้ จึงระงับการลงนามและการเติมเงิน"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Açık yapılandırma, bu cihazda onaylanan yapılandırmadan farklı. İmzalama ve para yatırma engellendi."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Публічна конфігурація відрізняється від підтвердженої на цьому пристрої. Підписання та поповнення заблоковано."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "عوامی ترتیب اس ڈیوائس پر منظور شدہ ترتیب سے مختلف ہے۔ دستخط اور رقم جمع کرنا روک دیا گیا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cấu hình công khai khác với cấu hình đã được tin cậy trên thiết bị này. Việc ký và nạp tiền bị chặn."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "公开配置与本机信任的配置不一致，已停止签名与入金。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "公開配置與本機信任的配置不一致，已停止簽名與入金。"
          }
        }
      }
    },
    "multisig_configuration_check": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحققت من جميع الأعضاء وحد التوقيعات وبصمة الإعدادات عبر قناة موثوقة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি বিশ্বস্ত মাধ্যমে সব সদস্য, স্বাক্ষরের সীমা ও কনফিগারেশনের ফিঙ্গারপ্রিন্ট যাচাই করেছি।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Všichni členové, požadovaný počet podpisů a otisk konfigurace jsou ověřeny důvěryhodným kanálem."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeg har kontrolleret alle medlemmer, tærsklen og konfigurationsfingeraftrykket via en betroet kanal."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ich habe alle Mitglieder, die Signaturschwelle und den Konfigurationsfingerabdruck über einen vertrauenswürdigen Kanal geprüft."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "I have verified every member, the threshold and the configuration fingerprint through a trusted channel."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "He verificado todos los miembros, el umbral y la huella de la configuración por un canal de confianza."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "همهٔ اعضا، حد نصاب و اثر انگشت پیکربندی را از یک مسیر مورد اعتماد بررسی کرده‌ام."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Nasuri ko na sa mapagkakatiwalaang paraan ang lahat ng miyembro, kinakailangang bilang ng lagda at fingerprint ng configuration."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "J’ai vérifié tous les membres, le seuil et l’empreinte de la configuration par un canal fiable."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Na duba dukkan mambobi, adadin sa hannu da alamar tantance tsarin ta hanyar da aka amince da ita."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אימתתי את כל החברים, את הסף ואת טביעת האצבע של התצורה בערוץ מהימן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "मैंने भरोसेमंद माध्यम से सभी सदस्य, हस्ताक्षर सीमा और कॉन्फ़िगरेशन फ़िंगरप्रिंट जाँचे हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah memverifikasi semua anggota, ambang, dan sidik jari konfigurasi melalui saluran tepercaya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ho verificato tutti i membri, la soglia e l’impronta della configurazione tramite un canale fidato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "信頼できる経路で全メンバー、必要署名数、設定のフィンガープリントを確認しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "신뢰할 수 있는 경로로 모든 구성원, 필요 서명 수와 구성 지문을 확인했습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Saya telah menyemak semua ahli, ambang dan cap jari konfigurasi melalui saluran dipercayai."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ik heb alle leden, het vereiste aantal handtekeningen en de configuratievingerafdruk via een vertrouwd kanaal gecontroleerd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdziłem wszystkich członków, próg i odcisk konfiguracji zaufanym kanałem."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifiquei todos os membros, o limite e a impressão digital da configuração por um canal confiável."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Am verificat membrii, pragul și amprenta configurației printr-un canal de încredere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Я проверил участников, порог и отпечаток конфигурации по доверенному каналу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Nimehakiki wanachama, kiwango na alama ya usanidi kupitia njia inayoaminika."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ฉันตรวจสอบสมาชิกทั้งหมด เกณฑ์และลายนิ้วมือการตั้งค่าผ่านช่องทางที่เชื่อถือได้แล้ว"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Üyeleri, eşiği ve yapılandırma parmak izini güvenilir bir kanaldan doğruladım."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Я перевірив учасників, поріг і відбиток конфігурації довіреним каналом."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "میں نے قابلِ اعتماد ذریعے سے اراکین، حد اور ترتیب کے فنگر پرنٹ کی تصدیق کی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tôi đã kiểm tra tất cả thành viên, ngưỡng và dấu vân tay cấu hình qua kênh tin cậy."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "我已通过可信渠道核对全部成员、签名门槛与配置指纹。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "我已透過可信渠道核對全部成員、簽名門檻與配置指紋。"
          }
        }
      }
    },
