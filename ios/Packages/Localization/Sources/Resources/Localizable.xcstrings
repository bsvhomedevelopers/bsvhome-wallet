    "bsv_hd_backup_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بالنسخة الكاملة دون اتصال. تحفظ السر وعبارة المرور وإعدادات الاشتقاق. لا ترفعها إلى السحابة."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সম্পূর্ণ ব্যাকআপ অফলাইনে রাখুন। এটি গোপন তথ্য, পাসফ্রেজ ও ডেরিভেশন সেটিং রাখে। ক্লাউডে আপলোড করবেন না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Uchovejte úplnou zálohu offline. Zachovává tajný údaj, heslovou frázi a nastavení odvození. Nenahrávejte do cloudu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Opbevar hele sikkerhedskopien offline. Den bevarer hemmelighed, adgangsfrase og afledningsindstillinger. Upload ikke til skyen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die vollständige Sicherung offline behalten. Sie enthält Geheimnis, Passphrase und Ableitungseinstellungen. Nicht in die Cloud hochladen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Keep the full recovery backup offline. It preserves the secret, passphrase, and derivation settings. Do not upload it to cloud services."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde la copia completa sin conexión. Conserva el secreto, la contraseña y los ajustes de derivación. No la suba a la nube."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "پشتیبان کامل را آفلاین نگه دارید. اطلاعات محرمانه، عبارت عبور و تنظیمات مشتق‌سازی را حفظ می‌کند. در فضای ابری بارگذاری نکنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itago offline ang buong backup. Pinapanatili nito ang lihim, password at setting ng derivation. Huwag i-upload sa cloud."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez la sauvegarde complète hors ligne. Elle préserve le secret, la passphrase et les paramètres de dérivation. Ne l’envoyez pas dans le cloud."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Riƙe cikakken ajiya ba tare da intanet ba. Yana kiyaye sirri, kalmar sirri da saitunan samarwa. Kar a loda zuwa ajiyar gajimare."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמרו את הגיבוי המלא ללא חיבור לרשת. הוא שומר סוד, סיסמה והגדרות גזירה. אל תעלו לענן."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "पूरा बैकअप ऑफ़लाइन रखें। यह गुप्त जानकारी, पासफ़्रेज़ और व्युत्पादन सेटिंग रखता है। क्लाउड पर अपलोड न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan cadangan lengkap secara offline. Cadangan mempertahankan rahasia, frasa sandi, dan pengaturan derivasi. Jangan unggah ke cloud."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva il backup completo offline. Mantiene segreto, passphrase e impostazioni di derivazione. Non caricarlo nel cloud."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "完全な復元バックアップをオフラインで保管してください。秘密情報、パスフレーズ、派生設定を保持します。クラウドにアップロードしないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전체 복구 백업을 오프라인으로 보관하세요. 비밀 정보, 추가 암호, 파생 설정을 보존합니다. 클라우드에 업로드하지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan sandaran lengkap di luar talian. Ia mengekalkan rahsia, frasa laluan dan tetapan derivasi. Jangan muat naik ke awan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar de volledige back-up offline. Deze bewaart geheim, wachtzin en afleidingsinstellingen. Upload niet naar de cloud."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowuj pełną kopię offline. Zachowuje sekret, hasło i ustawienia derywacji. Nie wysyłaj do chmury."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde o backup completo offline. Preserva segredo, senha e ajustes de derivação. Não envie à nuvem."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrați copia completă offline. Conservă secretul, parola și setările de derivare. Nu încărcați în cloud."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храните полную копию офлайн. Она сохраняет секрет, парольную фразу и настройки выведения. Не загружайте в облако."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifadhi nakala kamili nje ya mtandao. Inahifadhi siri, nenosiri na mipangilio ya uzalishaji. Usipakie kwenye wingu."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บข้อมูลสำรองครบถ้วนไว้ออฟไลน์ ข้อมูลนี้เก็บความลับ รหัสผ่านเพิ่มเติม และการตั้งค่าสร้างคีย์ อย่าอัปโหลดไปคลาวด์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam yedeği çevrimdışı saklayın. Sırrı, ek parolayı ve türetme ayarlarını korur. Buluta yüklemeyin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте повну копію офлайн. Вона зберігає секрет, парольну фразу й налаштування виведення. Не завантажуйте в хмару."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "مکمل بیک اپ آف لائن رکھیں۔ یہ خفیہ معلومات، پاس فریز اور اخذ کرنے کی ترتیبات رکھتا ہے۔ کلاؤڈ پر اپ لوڈ نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ bản sao lưu đầy đủ ngoại tuyến. Bản sao lưu giữ thông tin bí mật, mật khẩu bổ sung và cài đặt dẫn xuất. Không tải lên đám mây."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请离线保存完整恢复备份，它保留秘密材料、附加密码和派生设置，请勿上传到云端。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請離線保存完整恢復備份，它保留秘密材料、附加密碼和派生設定，請勿上傳到雲端。"
          }
        }
      }
    },
