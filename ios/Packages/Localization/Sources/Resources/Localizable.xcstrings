    "multisig_error_invalid_package": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "حزمة التنسيق غير صالحة أو غير مدعومة أو تم تغييرها. تحقق من الحزمة الكاملة وحاول مجددًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "সহযোগিতার প্যাকেজ অবৈধ, অসমর্থিত বা পরিবর্তিত। সম্পূর্ণ প্যাকেজ যাচাই করে আবার চেষ্টা করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Balíček spolupráce je neplatný, nepodporovaný nebo změněný. Ověřte celý balíček a zkuste to znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Samarbejdspakken er ugyldig, ikke understøttet eller ændret. Kontrollér hele pakken og prøv igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Zusammenarbeitspaket ist ungültig, nicht unterstützt oder verändert. Prüfe das vollständige Paket und versuche es erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The collaboration package is invalid, unsupported or has changed. Check the complete package and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El paquete de colaboración no es válido, no es compatible o ha cambiado. Comprueba el paquete completo y vuelve a intentarlo."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "بستهٔ همکاری نامعتبر، پشتیبانی‌نشده یا تغییریافته است. بستهٔ کامل را بررسی و دوباره تلاش کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi wasto, hindi suportado o nabago ang pakete ng pagtutulungan. Suriin ang buong pakete at subukang muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le paquet de collaboration est invalide, non pris en charge ou a été modifié. Vérifiez le paquet complet et réessayez."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunshin haɗin kai ba ya aiki, ba a goya masa baya ko an sauya shi. Duba cikakken kunshi kuma sake gwadawa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "חבילת שיתוף הפעולה אינה תקפה, אינה נתמכת או שונתה. בדוק את החבילה המלאה ונסה שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहयोग पैकेज अमान्य, असमर्थित या बदला हुआ है। पूरा पैकेज जाँचकर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Paket kolaborasi tidak sah, tidak didukung, atau telah berubah. Periksa paket lengkap dan coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il pacchetto di collaborazione è invalido, non supportato o modificato. Verifica il pacchetto completo e riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "パッケージが無効、未対応、または変更されています。全体を確認して再試行してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "패키지가 잘못되었거나 지원되지 않거나 변경되었습니다. 전체 패키지를 확인하고 다시 시도하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pakej tidak sah, tidak disokong atau telah berubah. Semak pakej penuh dan cuba lagi."
