    "wowpay_swap_entry_asset_unsupported": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن تبديل هذا الأصل حتى الآن. لا يزال بإمكانك تبديل BSV وUSDT."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই সম্পদটি এখনো বিনিময়ের জন্য সমর্থিত নয়। আপনি BSV ও USDT বিনিময় করতে পারবেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Toto aktivum zatím nelze směnit. Stále můžete směňovat BSV a USDT."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
