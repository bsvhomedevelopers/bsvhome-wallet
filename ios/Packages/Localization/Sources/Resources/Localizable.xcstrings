    "errors.perpetual.trigger_price_higher": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يكون سعر التفعيل أعلى من سعر السوق"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ট্রিগার মূল্য বাজার মূল্যের চেয়ে বেশি হওয়া উচিত"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Spouštěcí cena musí být vyšší než tržní cena"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Triggerprisen skal være højere end markedsprisen"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Triggerpreis muss über dem Marktpreis liegen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Trigger price should be higher than market price"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El precio de activación debe ser superior al precio de mercado"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "قیمت فعالسازی باید بیشتر از قیمت بازار باشد"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Dapat mas mataas sa presyo sa merkado ang trigger price"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prix de déclenchement doit être supérieur au prix du marché"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Farashin kunnawa ya kamata ya zama sama da farashin kasuwa"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מחיר ההפעלה צריך להיות גבוה ממחיר השוק"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ट्रिगर मूल्य बाजार मूल्य से अधिक होना चाहिए"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga pemicu harus lebih tinggi dari harga pasar"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prezzo di attivazione deve essere superiore al prezzo di mercato"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "トリガー価格は市場価格より高くする必要があります"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "트리거 가격은 시장 가격보다 높아야 합니다"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Harga pencetus perlu lebih tinggi daripada harga pasaran"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De triggerprijs moet hoger zijn dan de marktprijs"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Cena aktywacji powinna być wyższa niż cena rynkowa"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O preço de acionamento deve ser maior que o preço de mercado"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Prețul de declanșare trebuie să fie mai mare decât prețul pieței"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Цена триггера должна быть выше рыночной цены"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Bei ya kichochezi inapaswa kuwa juu ya bei ya soko"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ราคา Trigger ควรสูงกว่าราคาตลาด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tetikleme fiyatı piyasa fiyatından yüksek olmalıdır"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ціна спрацювання має бути вищою за ринкову ціну"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ٹرگر قیمت مارکیٹ قیمت سے زیادہ ہونی چاہیے"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giá kích hoạt phải cao hơn giá thị trường"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "触发价格应高于市场价格"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觸發價格應高於市場價格"
          }
        }
      }
    },
