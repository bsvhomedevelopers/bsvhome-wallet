        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Služba blockchainu BSV není dostupná nebo vrátila neplatná data. Předchozí zůstatky mohou být zastaralé. Zkuste aktualizaci znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
