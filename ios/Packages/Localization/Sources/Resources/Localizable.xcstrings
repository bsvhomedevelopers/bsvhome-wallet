            "value": "Numărul maxim de monede care vor exista vreodată."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальное количество монет, которое когда-либо будет существовать."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Idadi ya juu zaidi ya sarafu zitakazokuwepo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "จำนวนเหรียญสูงสุดที่จะมีอยู่ตลอดไป"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Var olabilecek maksimum madeni para sayısı."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Максимальна кількість монет, яка коли-небудь існуватиме."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "سکوں کی زیادہ سے زیادہ تعداد جو کبھی موجود ہوں گے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Số lượng tối đa các đồng xu sẽ từng tồn tại."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "该代币可能存在的最大数量。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "代幣可能存在的最大總量。"
          }
        }
      }
    },
