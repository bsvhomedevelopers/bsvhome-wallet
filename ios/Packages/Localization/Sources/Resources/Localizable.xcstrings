          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "היתרות והפעילות עשויות להיות לא מעודכנות."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बैलेंस और गतिविधि पुरानी हो सकती है।"
          }
        },
        "id": {
          "stringUnit": {
