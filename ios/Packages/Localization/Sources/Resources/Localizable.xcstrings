    "multisig_error_not_active": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يجب أن يوافق جميع الأعضاء على الإعدادات النهائية نفسها قبل إرسال الأموال أو استقبالها."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "অর্থ পাঠানো বা গ্রহণের আগে সব সদস্যকে একই চূড়ান্ত কনফিগারেশন অনুমোদন করতে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Před odesíláním nebo příjmem musí všichni členové potvrdit stejnou konečnou konfiguraci."
