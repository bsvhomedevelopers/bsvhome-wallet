    "multisig_qr_too_large": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "طلب الدفع أكبر من سعة رمز QR يمكن مسحه بشكل موثوق. شارك الملف أو انسخ الطلب كاملًا."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এই অনুরোধ নির্ভরযোগ্য QR কোডের জন্য অতিরিক্ত বড়। ফাইল শেয়ার করুন অথবা সম্পূর্ণ অনুরোধ কপি করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Tato žádost je příliš velká pro spolehlivý QR kód. Sdílejte soubor nebo zkopírujte celou žádost."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Anmodningen er for stor til en pålidelig QR-kode. Del filen eller kopiér hele anmodningen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Anforderung ist für einen zuverlässig lesbaren QR-Code zu groß. Teile die Datei oder kopiere die vollständige Anforderung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This request is too large for a reliable QR code. Share the file or copy the full request."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La solicitud es demasiado grande para un código QR fiable. Comparte el archivo o copia la solicitud completa."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این درخواست برای یک کد QR قابل اطمینان بیش از حد بزرگ است. فایل را به اشتراک بگذارید یا درخواست کامل را کپی کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Masyadong malaki ang kahilingan para sa maaasahang QR code. Ibahagi ang file o kopyahin ang buong kahilingan."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette demande est trop volumineuse pour un code QR fiable. Partagez le fichier ou copiez la demande complète."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Buƙatar ta yi girma don lambar QR da za a iya karantawa da tabbas. Raba fayil ko kwafi buƙatar gaba ɗaya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "הבקשה גדולה מדי לקוד QR שאפשר לסרוק באופן מהימן. שתף את הקובץ או העתק את הבקשה המלאה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "यह अनुरोध भरोसेमंद QR कोड के लिए बहुत बड़ा है। फ़ाइल साझा करें या पूरा अनुरोध कॉपी करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan terlalu besar untuk kode QR yang andal. Bagikan berkas atau salin permintaan lengkap."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La richiesta è troppo grande per un codice QR affidabile. Condividi il file o copia la richiesta completa."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "リクエストが大きすぎて安定した QR コードにできません。ファイルを共有するか、全体をコピーしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "요청이 너무 커서 안정적인 QR 코드를 만들 수 없습니다. 파일을 공유하거나 전체 요청을 복사하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Permintaan terlalu besar untuk kod QR yang boleh dipercayai. Kongsi fail atau salin permintaan penuh."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het verzoek is te groot voor een betrouwbare QR-code. Deel het bestand of kopieer het volledige verzoek."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Żądanie jest za duże na niezawodny kod QR. Udostępnij plik lub skopiuj całe żądanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A solicitação é grande demais para um QR confiável. Compartilhe o arquivo ou copie a solicitação completa."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Cererea este prea mare pentru un cod QR fiabil. Partajează fișierul sau copiază cererea completă."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос слишком большой для надёжного QR-кода. Передайте файл или скопируйте запрос полностью."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Ombi ni kubwa mno kwa msimbo wa QR unaotegemewa. Shiriki faili au nakili ombi lote."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "คำขอใหญ่เกินไปสำหรับ QR ที่สแกนได้แน่นอน โปรดแชร์ไฟล์หรือคัดลอกคำขอทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "İstek güvenilir bir QR kodu için çok büyük. Dosyayı paylaşın veya isteğin tamamını kopyalayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Запит завеликий для надійного QR-коду. Поділіться файлом або скопіюйте весь запит."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "درخواست قابلِ اعتماد QR کوڈ کے لیے بہت بڑی ہے۔ فائل شیئر کریں یا پوری درخواست نقل کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Yêu cầu quá lớn để tạo mã QR đáng tin cậy. Chia sẻ tệp hoặc sao chép toàn bộ yêu cầu."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "收款信息超过可稳定扫码的容量，请分享文件或复制完整收款信息。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "收款資訊超過可穩定掃碼的容量，請分享檔案或複製完整收款資訊。"
          }
        }
      }
    },
