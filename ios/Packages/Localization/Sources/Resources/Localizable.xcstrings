    "multisig_funding_payer_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "محافظ المشاهدة فقط لا تستطيع الدفع. اختيار محفظة الدفع لا يغيّر هوية العضو. يتحمل الدافع المبلغ والرسوم، ويعود الباقي إلى محفظته."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু দেখার ওয়ালেট পেমেন্ট করতে পারে না। পেমেন্ট ওয়ালেট বেছে নিলে সদস্যের পরিচয় বদলায় না। অর্থ ও ফি প্রদানকারী বহন করে এবং ফেরত অর্থ সেই ওয়ালেটেই যায়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Peněženky pouze pro sledování nemohou platit. Výběr plátce nemění vaši členskou identitu. Plátce hradí částku i poplatek a dostane zpět zbytek."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Tegnebøger med kun læseadgang kan ikke betale. Valget af betaler ændrer ikke din medlemsidentitet. Betaleren dækker beløb og gebyr og modtager byttepengene."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-only-Wallets können nicht zahlen. Die Auswahl ändert deine Multisig-Mitgliedsidentität nicht. Die zahlende Wallet trägt Betrag und Gebühr und erhält das Wechselgeld."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch wallets cannot pay. Selecting a payment wallet does not change the multisig member identity. The payer covers the amount and fee; change returns to that wallet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las billeteras de solo lectura no pueden pagar. Elegir una billetera pagadora no cambia tu identidad como miembro. La pagadora cubre el importe y la comisión y recibe el cambio."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "کیف پول‌های فقط‌مشاهده نمی‌توانند پرداخت کنند. انتخاب پرداخت‌کننده هویت شما به‌عنوان عضو را تغییر نمی‌دهد. مبلغ و کارمزد بر عهدهٔ پرداخت‌کننده است و باقی‌مانده به کیف پول او برمی‌گردد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Hindi makakabayad ang watch-only na wallet. Hindi binabago ng pagpili ng magbabayad ang iyong identidad bilang miyembro. Siya ang sasagot sa halaga at bayad; sa wallet niya babalik ang sukli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les portefeuilles en lecture seule ne peuvent pas payer. Le choix du payeur ne change pas votre identité de membre. Le payeur règle le montant et les frais et récupère la monnaie."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Walat na kallo kawai ba ya biyan kuɗi. Zaɓen walat mai biya ba ya canza shaidarka ta mamba. Mai biya yana ɗaukar adadi da kuɗin caji; ragowar kuɗi yana komawa walat ɗin."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "ארנקי צפייה בלבד לא יכולים לשלם. בחירת הארנק המשלם לא משנה את זהות החבר שלך. המשלם נושא בסכום ובעמלה, והעודף חוזר לארנק שלו."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल देखने वाले वॉलेट भुगतान नहीं कर सकते। भुगतान वॉलेट चुनने से सदस्य की पहचान नहीं बदलती। भुगतानकर्ता राशि और शुल्क देता है, और बची हुई राशि उसी वॉलेट में लौटती है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet hanya pantau tidak bisa membayar. Memilih pembayar tidak mengubah identitas anggota Anda. Pembayar menanggung jumlah dan biaya; kembalian kembali ke dompet tersebut."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I portafogli di sola osservazione non possono pagare. La scelta del pagante non cambia la tua identità di membro. Il pagante copre importo e commissione e riceve il resto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "閲覧専用ウォレットは支払えません。支払いウォレットを選んでもマルチシグで使うメンバーの識別情報は変わりません。支払い元が金額と手数料を負担し、お釣りも支払い元に戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보기 전용 지갑은 결제할 수 없습니다. 결제 지갑을 선택해도 다중 서명 구성원 신원은 바뀌지 않습니다. 결제 지갑이 금액과 수수료를 부담하고 잔돈도 돌려받습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Dompet paparan sahaja tidak boleh membayar. Memilih pembayar tidak mengubah identiti ahli anda. Pembayar menanggung jumlah dan fi; baki pulangan kembali ke dompet itu."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Watch-only-wallets kunnen niet betalen. De keuze van een betalende wallet verandert je lididentiteit niet. De betaler betaalt bedrag en kosten en ontvangt het wisselgeld."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Portfele tylko do obserwacji nie mogą płacić. Wybór płatnika nie zmienia Twojej tożsamości członka. Płatnik pokrywa kwotę i opłatę oraz otrzymuje resztę."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Carteiras de observação não podem pagar. Escolher a pagadora não altera sua identidade de membro. Ela paga o valor e a taxa e recebe o troco."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portofelele doar pentru vizualizare nu pot plăti. Alegerea plătitorului nu îți schimbă identitatea de membru. Plătitorul acoperă suma și comisionul și primește restul."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Кошельки для наблюдения не могут платить. Выбор плательщика не меняет вашу учётную запись участника. Плательщик оплачивает сумму и комиссию и получает сдачу."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Mikoba ya kutazama tu haiwezi kulipa. Kuchagua mkoba wa malipo hakubadili utambulisho wako wa mwanachama. Mlipaji analipa kiasi na ada; chenji inarudi kwenye mkoba huo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าแบบดูอย่างเดียวชำระเงินไม่ได้ การเลือกกระเป๋าที่ชำระไม่เปลี่ยนตัวตนสมาชิกของคุณ ผู้ชำระรับผิดชอบจำนวนเงินและค่าธรรมเนียม และได้รับเงินทอนกลับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca izleme cüzdanları ödeme yapamaz. Ödeme cüzdanını seçmek üye kimliğinizi değiştirmez. Ödeyen tutarı ve ücreti karşılar; para üstü o cüzdana döner."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Гаманці лише для спостереження не можуть платити. Вибір платника не змінює вашу ідентичність учасника. Платник сплачує суму й комісію та отримує решту."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "صرف دیکھنے والے والیٹ ادائیگی نہیں کر سکتے۔ ادائیگی کا والیٹ چننے سے رکن کی شناخت نہیں بدلتی۔ ادائیگی کرنے والا رقم اور فیس دیتا ہے، اور باقی رقم اسی والیٹ کو لوٹتی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví chỉ xem không thể thanh toán. Chọn ví thanh toán không đổi danh tính thành viên đa chữ ký. Ví này trả số tiền và phí; tiền thừa cũng trở về ví đó."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "观察钱包不可付款。选择付款钱包不会切换多签成员身份；金额和费用由付款钱包支付，找零回到该钱包。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "觀察錢包不可付款。選擇付款錢包不會切換多簽成員身分；金額和費用由付款錢包支付，找零回到該錢包。"
          }
        }
      }
    },
    "multisig_funding_pending_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحتاج النتيجة إلى التحقق. تم حفظ المعاملة الأصلية. تحقّق منها أو أعد إرسال المعاملة نفسها؛ لا تدفع مرة أخرى."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "ফলাফল যাচাই করা দরকার। মূল লেনদেন সংরক্ষিত আছে। একই লেনদেন যাচাই বা আবার পাঠান; নতুন করে পেমেন্ট করবেন না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Výsledek je třeba ověřit. Původní transakce je uložená. Ověřte nebo opakujte tuto stejnou transakci; neplaťte znovu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Resultatet skal kontrolleres. Den oprindelige transaktion er gemt. Kontrollér eller gentag den samme transaktion; betal ikke igen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das Ergebnis muss geprüft werden. Die ursprüngliche Transaktion ist gespeichert. Prüfe oder wiederhole diese Transaktion; zahle nicht erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The result needs verification. The original transaction is saved. Verify or retry that same transaction; do not pay again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Hay que verificar el resultado. La transacción original está guardada. Verifica o reintenta esa misma transacción; no vuelvas a pagar."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجه باید بررسی شود. تراکنش اصلی ذخیره شده است. همان تراکنش را بررسی یا دوباره ارسال کنید؛ دوباره پرداخت نکنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangang tiyakin ang resulta. Naka-save ang orihinal na transaksyon. Tiyakin o ulitin ang mismong transaksyong iyon; huwag magbayad muli."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le résultat doit être vérifié. La transaction initiale est enregistrée. Vérifiez ou renvoyez cette même transaction ; ne payez pas à nouveau."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ana bukatar tantance sakamakon. An adana ma’amalar asali. Tantance ko sake tura wannan ma’amalar; kada ka sake biya."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "צריך לבדוק את התוצאה. העסקה המקורית נשמרה. יש לבדוק או לנסות שוב את אותה עסקה; אין לשלם שוב."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "परिणाम की जाँच ज़रूरी है। मूल लेनदेन सुरक्षित है। उसी लेनदेन की जाँच करें या दोबारा भेजें; फिर से भुगतान न करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hasil perlu diverifikasi. Transaksi asli sudah disimpan. Verifikasi atau coba kirim lagi transaksi yang sama; jangan membayar lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il risultato va verificato. La transazione originale è salvata. Verifica o riprova quella stessa transazione; non pagare di nuovo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "結果の確認が必要です。元のトランザクションは保存済みです。同じトランザクションの確認または再送を行い、再度支払わないでください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "결과를 확인해야 합니다. 원래 트랜잭션이 저장되어 있습니다. 같은 트랜잭션을 확인하거나 재시도하고, 다시 결제하지 마세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Keputusan perlu disahkan. Transaksi asal telah disimpan. Sahkan atau cuba semula transaksi yang sama; jangan bayar lagi."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het resultaat moet worden gecontroleerd. De oorspronkelijke transactie is opgeslagen. Controleer of herhaal diezelfde transactie; betaal niet opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wynik wymaga weryfikacji. Oryginalna transakcja jest zapisana. Zweryfikuj lub ponów tę samą transakcję; nie płać ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O resultado precisa ser verificado. A transação original está salva. Verifique ou tente enviar essa mesma transação; não pague novamente."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Rezultatul trebuie verificat. Tranzacția originală este salvată. Verifică sau reîncearcă aceeași tranzacție; nu plăti din nou."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат нужно проверить. Исходная транзакция сохранена. Проверьте или повторите ту же транзакцию; не платите заново."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Matokeo yanahitaji kuhakikiwa. Muamala wa awali umehifadhiwa. Hakiki au ujaribu tena muamala huo huo; usilipe tena."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ต้องตรวจสอบผลลัพธ์ ระบบบันทึกธุรกรรมเดิมไว้แล้ว ให้ตรวจสอบหรือลองส่งธุรกรรมเดิมอีกครั้ง อย่าชำระเงินซ้ำ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sonuç doğrulanmalı. İlk işlem kaydedildi. Aynı işlemi doğrulayın veya yeniden gönderin; tekrar ödeme yapmayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Результат потрібно перевірити. Початкову транзакцію збережено. Перевірте або повторіть цю саму транзакцію; не сплачуйте знову."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "نتیجے کی تصدیق ضروری ہے۔ اصل ٹرانزیکشن محفوظ ہے۔ اسی ٹرانزیکشن کی تصدیق کریں یا دوبارہ بھیجیں؛ دوبارہ ادائیگی نہ کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Cần xác minh kết quả. Giao dịch gốc đã được lưu. Xác minh hoặc thử lại đúng giao dịch đó; không thanh toán lần nữa."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "结果待核对，已保存原交易。只核对或重试同一笔交易，请勿重复付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "結果待核對，已儲存原交易。只核對或重試同一筆交易，請勿重複付款。"
          }
        }
      }
    },
