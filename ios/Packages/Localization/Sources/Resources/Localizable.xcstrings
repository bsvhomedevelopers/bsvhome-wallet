          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Онлайн-наблюдатель: перед отправкой в сеть перевод должен быть подписан холодным кошельком."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
