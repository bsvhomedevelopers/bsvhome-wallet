        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Sikkerhedskopiér din gendannelsesfrase for at beskytte din wallet"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Sichern Sie Ihre Wiederherstellungsphrase, um Ihre Wallet zu schützen"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Back up your recovery phrase to keep your wallet secure"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Haz una copia de seguridad de tu frase de recuperación para proteger tu billetera"
