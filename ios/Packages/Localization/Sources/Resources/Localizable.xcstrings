          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il numero di monete attualmente disponibili e scambiate sul mercato."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "現在市場で入手可能で取引されているコインの数。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "현재 시장에서 거래되고 있는 코인의 총 수량입니다."
          }
        },
        "ms": {
