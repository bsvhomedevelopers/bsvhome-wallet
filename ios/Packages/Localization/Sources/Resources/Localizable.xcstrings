          "stringUnit": {
            "state": "translated",
            "value": "کلیدها را روی این دستگاه نگه دارید و BSV را آنلاین ارسال و دریافت کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Itago ang mga susi sa device na ito at magpadala at tumanggap ng BSV online."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gardez les clés sur cet appareil pour envoyer et recevoir des BSV en ligne."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Ajiye maɓallai a wannan na’urar; aika da karɓar BSV ta intanet."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "שמור את המפתחות במכשיר הזה ושלח וקבל BSV באופן מקוון."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कुंजियाँ इस डिवाइस पर रखें और ऑनलाइन BSV भेजें व प्राप्त करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan kunci di perangkat ini untuk mengirim dan menerima BSV secara online."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Conserva le chiavi su questo dispositivo e invia e ricevi BSV online."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "この端末で秘密鍵を保管し、オンラインで BSV を送受信します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 기기에 개인키를 보관하고 온라인으로 BSV를 보내고 받습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Simpan kunci pada peranti ini untuk menghantar dan menerima BSV dalam talian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaar sleutels op dit apparaat en verstuur en ontvang BSV online."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przechowuj klucze na tym urządzeniu i wysyłaj oraz odbieraj BSV online."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Guarde as chaves neste dispositivo e envie e receba BSV online."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Păstrează cheile pe acest dispozitiv și trimite și primește BSV online."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Храните ключи на этом устройстве, отправляйте и получайте BSV онлайн."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hifadhi funguo kwenye kifaa hiki, utume na upokee BSV mtandaoni."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เก็บคีย์ไว้บนอุปกรณ์นี้ แล้วส่งและรับ BSV ทางออนไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Anahtarları bu cihazda saklayın, çevrimiçi BSV gönderip alın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Зберігайте ключі на цьому пристрої та надсилайте й отримуйте BSV онлайн."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "کلیدیں اس ڈیوائس پر رکھیں اور آن لائن BSV بھیجیں اور وصول کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Giữ khóa trên thiết bị này để gửi và nhận BSV trực tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
