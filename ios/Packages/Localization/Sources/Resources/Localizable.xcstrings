    "multisig_proposal_history_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "هذه مقترحات إنفاق، وليست السجل الكامل على سلسلة الكتل. يحدّث الإيداع العادي الرصيد وسجل محفظة الدفع دون إنشاء مقترح."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এগুলো খরচের প্রস্তাব, ব্লকচেইনের সম্পূর্ণ ইতিহাস নয়। সাধারণ অর্থ জমা ব্যালেন্স ও প্রদানকারীর ইতিহাস হালনাগাদ করে, প্রস্তাব তৈরি করে না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Jde o návrhy výdajů, nikoli úplnou historii blockchainu. Běžné vklady aktualizují zůstatek a historii plátce bez vytvoření návrhu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Dette er forbrugsforslag, ikke hele blockchainhistorikken. Almindelige indbetalinger opdaterer saldoen og betalerens historik uden at oprette et forslag."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Dies sind Ausgabevorschläge, kein vollständiger Blockchain-Verlauf. Normale Einzahlungen aktualisieren Guthaben und Verlauf der zahlenden Wallet, ohne einen Vorschlag zu erstellen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are spending proposals, not complete on-chain history. Regular funding updates the balance and the payment wallet history without creating a proposal."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas son propuestas de gasto, no el historial completo de la cadena. Los depósitos normales actualizan el saldo y el historial de la billetera pagadora sin crear una propuesta."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "این‌ها پیشنهادهای خرج کردن هستند، نه تاریخچهٔ کامل بلاک‌چین. واریز عادی موجودی و تاریخچهٔ پرداخت‌کننده را بدون ایجاد پیشنهاد به‌روز می‌کند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Mga panukala sa paggastos ito, hindi ang buong kasaysayan sa blockchain. Ina-update ng regular na deposito ang balanse at kasaysayan ng magbabayad nang walang bagong panukala."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Il s’agit des propositions de dépense, pas de l’historique complet de la blockchain. Un dépôt classique actualise le solde et l’historique du payeur sans créer de proposition."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Waɗannan shawarwarin kashe kuɗi ne, ba cikakken tarihin blockchain ba. Saka kuɗi na yau da kullum yana sabunta kuɗi da tarihin mai biya ba tare da ƙirƙirar shawara ba."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "אלה הצעות להוצאה, לא היסטוריית הבלוקצ׳יין המלאה. הפקדה רגילה מעדכנת את היתרה וההיסטוריה של המשלם בלי ליצור הצעה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "ये खर्च के प्रस्ताव हैं, ब्लॉकचेन का पूरा इतिहास नहीं। सामान्य जमा बैलेंस और भुगतान वॉलेट का इतिहास अपडेट करता है, प्रस्ताव नहीं बनाता।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini adalah proposal pengeluaran, bukan seluruh riwayat blockchain. Setoran biasa memperbarui saldo dan riwayat pembayar tanpa membuat proposal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Queste sono proposte di spesa, non la cronologia completa della blockchain. I versamenti normali aggiornano saldo e cronologia del pagante senza creare una proposta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "これは支出提案の履歴であり、ブロックチェーンの全履歴ではありません。通常の入金は残高と支払い元の履歴を更新しますが、提案は作成しません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이것은 지출 제안 내역이며 전체 블록체인 내역이 아닙니다. 일반 입금은 잔액과 결제 지갑 내역을 갱신하지만 제안을 만들지는 않습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Ini ialah cadangan perbelanjaan, bukan sejarah blockchain yang lengkap. Deposit biasa mengemas kini baki dan sejarah pembayar tanpa membuat cadangan."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit zijn uitgavenvoorstellen, geen volledige blockchain-geschiedenis. Gewone stortingen werken het saldo en de geschiedenis van de betalende wallet bij zonder een voorstel te maken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "To propozycje wydatków, nie pełna historia blockchaina. Zwykłe wpłaty aktualizują saldo i historię portfela płatnika bez tworzenia propozycji."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Estas são propostas de gasto, não o histórico completo da blockchain. Depósitos comuns atualizam o saldo e o histórico da pagadora sem criar uma proposta."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Acestea sunt propuneri de cheltuieli, nu istoricul complet al blockchainului. Depunerile obișnuite actualizează soldul și istoricul plătitorului fără a crea o propunere."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Это предложения расходов, а не полная история блокчейна. Обычное пополнение обновляет баланс и историю плательщика без создания предложения."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Haya ni mapendekezo ya matumizi, si historia yote ya blockchain. Kuweka fedha kwa kawaida husasisha salio na historia ya mlipaji bila kuunda pendekezo."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "นี่คือประวัติข้อเสนอใช้เงิน ไม่ใช่ประวัติทั้งหมดบนบล็อกเชน การเติมเงินทั่วไปจะอัปเดตยอดเงินและประวัติของผู้ชำระโดยไม่สร้างข้อเสนอ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bunlar harcama önerileridir; zincir geçmişinin tamamı değildir. Normal yatırımlar, öneri oluşturmadan bakiyeyi ve ödeyen cüzdanın geçmişini günceller."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Це пропозиції витрат, а не повна історія блокчейну. Звичайне поповнення оновлює баланс та історію платника без створення пропозиції."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "یہ اخراجات کی تجاویز ہیں، بلاک چین کی مکمل تاریخ نہیں۔ عام رقم جمع کرنے سے بیلنس اور ادائیگی کے والیٹ کی تاریخ تازہ ہوتی ہے، نئی تجویز نہیں بنتی۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Đây là lịch sử đề xuất chi, không phải toàn bộ lịch sử trên chuỗi. Nạp tiền thông thường cập nhật số dư và lịch sử ví thanh toán mà không tạo đề xuất."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "此处展示支出提案，并非完整链上流水。普通入金更新余额及付款钱包记录，不生成提案。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "此處顯示支出提案，並非完整鏈上明細。一般轉入更新餘額及付款錢包紀錄，不產生提案。"
          }
        }
      }
    },
