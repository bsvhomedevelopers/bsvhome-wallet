          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De cold wallet op dit apparaat bewaart sleutels en ondertekent transacties offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zimny portfel na tym urządzeniu przechowuje klucze i podpisuje transakcje offline."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A carteira fria neste dispositivo guarda as chaves e assina transações offline."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Portofelul rece de pe acest dispozitiv păstrează cheile și semnează tranzacțiile offline."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Холодный кошелёк на этом устройстве хранит ключи и подписывает транзакции офлайн."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Pochi ya nje ya mtandao kwenye kifaa hiki huhifadhi funguo na kusaini miamala bila intaneti."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "กระเป๋าเย็นบนอุปกรณ์นี้เก็บคีย์และลงนามธุรกรรมแบบออฟไลน์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu cihazdaki soğuk cüzdan anahtarları saklar ve işlemleri çevrimdışı imzalar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Холодний гаманець на цьому пристрої зберігає ключі й підписує транзакції офлайн."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس آلے کا کولڈ والیٹ کلیدیں محفوظ رکھتا ہے اور لین دین پر آف لائن دستخط کرتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Ví lạnh trên thiết bị này giữ khóa và ký giao dịch ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机冷钱包负责保管密钥和离线签名。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "本機冷錢包負責保管金鑰和離線簽署。"
          }
        }
      }
    },
