    "wowpay_create_ownership_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "احتفظ بنسخة احتياطية من عبارة الاسترداد للحفاظ على أمان محفظتك"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আপনার ওয়ালেট সুরক্ষিত রাখতে পুনরুদ্ধার বাক্যাংশের ব্যাকআপ রাখুন"
