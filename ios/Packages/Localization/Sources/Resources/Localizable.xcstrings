    "cold_wallet_review_hint": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تحقق من العنوان الكامل والمبلغ مع المستلم. التوقيع يسمح بهذا الدفع."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রাপকের সঙ্গে পুরো ঠিকানা ও পরিমাণ যাচাই করুন। স্বাক্ষর এই অর্থপ্রদান অনুমোদন করে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Ověřte s příjemcem celou adresu a částku. Podpis schvaluje tuto platbu."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér hele adressen og beløbet med modtageren. Underskriften godkender betalingen."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Vollständige Empfängeradresse und Betrag mit dem Empfänger prüfen. Die Signatur autorisiert diese Zahlung."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Verify the complete recipient address and amount with the recipient. Signing authorizes this payment."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifique con el destinatario la dirección completa y el importe. Firmar autoriza este pago."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "نشانی کامل و مبلغ را با گیرنده بررسی کنید. امضا اجازه این پرداخت را می‌دهد."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Suriin ang buong address at halaga kasama ang tatanggap. Pinapahintulutan ng pagpirma ang pagbabayad na ito."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez l’adresse complète et le montant avec le destinataire. La signature autorise ce paiement."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabbatar da cikakken adireshi da adadi tare da mai karɓa. Sa hannu yana ba da izinin wannan biyan kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "בדקו עם הנמען את הכתובת המלאה והסכום. החתימה מאשרת תשלום זה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्राप्तकर्ता से पूरा पता और राशि सत्यापित करें। हस्ताक्षर इस भुगतान को अधिकृत करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Periksa alamat lengkap dan jumlah bersama penerima. Tanda tangan mengizinkan pembayaran ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica indirizzo completo e importo con il destinatario. La firma autorizza questo pagamento."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金先と完全なアドレスと金額を確認してください。署名するとこの支払いを承認します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "수신자와 전체 주소 및 금액을 확인하세요. 서명하면 이 결제를 승인합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Semak alamat penuh dan jumlah dengan penerima. Tandatangan membenarkan pembayaran ini."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer het volledige adres en bedrag met de ontvanger. Ondertekenen geeft toestemming voor deze betaling."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sprawdź pełny adres i kwotę z odbiorcą. Podpis upoważnia do tej płatności."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confira o endereço completo e o valor com o destinatário. A assinatura autoriza este pagamento."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Verificați adresa completă și suma cu destinatarul. Semnătura autorizează plata."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проверьте полный адрес и сумму с получателем. Подпись разрешает этот платёж."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakiki anwani kamili na kiasi pamoja na mpokeaji. Kusaini huidhinisha malipo haya."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ตรวจสอบที่อยู่เต็มและจำนวนเงินกับผู้รับ การลงนามเป็นการอนุญาตการชำระเงินนี้"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Tam adresi ve tutarı alıcıyla doğrulayın. İmzalamak bu ödemeye izin verir."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Перевірте повну адресу й суму з одержувачем. Підпис дозволяє цей платіж."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "وصول کنندہ سے مکمل پتہ اور رقم کی تصدیق کریں۔ دستخط اس ادائیگی کی اجازت دیتے ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Kiểm tra địa chỉ đầy đủ và số tiền với người nhận. Ký là cho phép thanh toán này."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请与收款方核对完整地址和金额，签名即授权这笔付款。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請與收款方核對完整地址和金額，簽名即授權這筆付款。"
          }
        }
      }
    },
