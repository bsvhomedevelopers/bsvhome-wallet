    "multisig_invited_member_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكيد الهوية عبر دعوة؛ لا يلزم تقديم مفتاح خاص"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমন্ত্রণের মাধ্যমে পরিচয় নিশ্চিত করুন; ব্যক্তিগত কী দিতে হবে না"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Potvrdit totožnost pozvánkou; soukromý klíč se nesdílí"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Bekræft identiteten via en invitation; ingen privat nøgle skal deles"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Identität per Einladung bestätigen; kein privater Schlüssel muss weitergegeben werden"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm identity through an invitation; no private key is needed"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmar la identidad mediante una invitación; no hace falta compartir una clave privada"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "تأیید هویت با دعوت‌نامه؛ نیازی به ارائهٔ کلید خصوصی نیست"
          }
        },
        "fil": {
