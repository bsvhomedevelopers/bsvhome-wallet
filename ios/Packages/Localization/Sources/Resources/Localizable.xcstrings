    "device_purpose_cold_preparation": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم جهازًا مخصصًا. فعّل نمط الطيران في الإعدادات وأوقف Wi-Fi والبلوتوث. أبقِ هذا الجهاز غير متصل."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "এ কাজের জন্য আলাদা ডিভাইস ব্যবহার করুন। সেটিংসে এয়ারপ্লেন মোড চালু করুন এবং Wi-Fi ও Bluetooth বন্ধ করুন। ডিভাইসটি সংযোগবিচ্ছিন্ন রাখুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte vyhrazené zařízení. V Nastavení zapněte Letový režim a vypněte Wi-Fi i Bluetooth. Zařízení ponechte odpojené."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug en dedikeret enhed. Slå Flyfunktion til i Indstillinger, og slå Wi-Fi og Bluetooth fra. Hold enheden frakoblet."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende ein separates Gerät. Aktiviere in den Einstellungen den Flugmodus und deaktiviere WLAN und Bluetooth. Halte das Gerät offline."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use a dedicated device. In Settings, turn on Airplane Mode and turn off Wi-Fi and Bluetooth. Keep this device disconnected."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un dispositivo dedicado. En Ajustes, activa el modo avión y desactiva Wi-Fi y Bluetooth. Mantén el dispositivo desconectado."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از یک دستگاه اختصاصی استفاده کنید. در تنظیمات، حالت هواپیما را روشن و Wi-Fi و بلوتوث را خاموش کنید. دستگاه را قطع از شبکه نگه دارید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumamit ng hiwalay na device. Sa Settings, i-on ang Airplane Mode at i-off ang Wi-Fi at Bluetooth. Panatilihing nakadiskonekta ang device."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez un appareil dédié. Dans Réglages, activez le mode Avion et désactivez le Wi-Fi et le Bluetooth. Gardez l’appareil hors ligne."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da na’ura ta musamman. A Saituna, kunna yanayin jirgin sama, sannan kashe Wi-Fi da Bluetooth. Bar na’urar a katse daga hanyar sadarwa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "השתמשו במכשיר ייעודי. בהגדרות, הפעילו מצב טיסה וכבו את ה־Wi-Fi וה־Bluetooth. השאירו את המכשיר מנותק."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इसके लिए अलग डिवाइस इस्तेमाल करें। सेटिंग्स में एयरप्लेन मोड चालू करें और Wi-Fi व Bluetooth बंद करें। इस डिवाइस को नेटवर्क से अलग रखें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan perangkat khusus. Di Pengaturan, aktifkan Mode Pesawat dan nonaktifkan Wi-Fi serta Bluetooth. Biarkan perangkat tetap terputus dari jaringan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa un dispositivo dedicato. In Impostazioni, attiva Uso in aereo e disattiva Wi-Fi e Bluetooth. Tieni il dispositivo disconnesso."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "専用の端末を使用してください。「設定」で機内モードをオンにし、Wi-Fi と Bluetooth をオフにします。この端末はオフラインのままにしてください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "전용 기기를 사용하세요. 설정에서 에어플레인 모드를 켜고 Wi-Fi와 Bluetooth를 끄세요. 이 기기의 연결을 끊은 상태로 유지하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan peranti khusus. Dalam Tetapan, hidupkan Mod Pesawat dan matikan Wi-Fi serta Bluetooth. Pastikan peranti kekal terputus daripada rangkaian."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik een apart apparaat. Schakel in Instellingen de vliegtuigmodus in en wifi en Bluetooth uit. Houd dit apparaat offline."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj osobnego urządzenia. W Ustawieniach włącz tryb samolotowy oraz wyłącz Wi-Fi i Bluetooth. Pozostaw urządzenie odłączone od sieci."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use um dispositivo dedicado. Em Ajustes, ative o Modo Avião e desative o Wi-Fi e o Bluetooth. Mantenha o dispositivo desconectado."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește un dispozitiv dedicat. În Configurări, activează modul Avion și dezactivează Wi-Fi și Bluetooth. Păstrează dispozitivul deconectat."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте отдельное устройство. В Настройках включите Авиарежим и выключите Wi-Fi и Bluetooth. Держите устройство отключённым от сети."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia kifaa maalumu. Katika Mipangilio, washa Hali ya Ndege na uzime Wi-Fi na Bluetooth. Weka kifaa hiki bila muunganisho wa mtandao."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้อุปกรณ์เฉพาะสำหรับกระเป๋าเย็น เปิดโหมดเครื่องบินและปิด Wi-Fi กับ Bluetooth ในการตั้งค่า ให้อุปกรณ์นี้ตัดการเชื่อมต่อไว้ตลอด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bu iş için ayrı bir cihaz kullanın. Ayarlar’da Uçak Modu’nu açıp Wi-Fi ve Bluetooth’u kapatın. Cihazı ağ bağlantısı olmadan kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте окремий пристрій. У Параметрах увімкніть режим польоту й вимкніть Wi-Fi та Bluetooth. Тримайте пристрій від’єднаним від мережі."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "اس مقصد کے لیے الگ آلہ استعمال کریں۔ ترتیبات میں ایئرپلین موڈ آن کریں اور Wi-Fi اور Bluetooth بند کریں۔ اس آلے کو نیٹ ورک سے منقطع رکھیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng một thiết bị riêng. Trong Cài đặt, bật Chế độ máy bay rồi tắt Wi-Fi và Bluetooth. Luôn giữ thiết bị này ngoại tuyến."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请使用专用设备。在系统设置中开启飞行模式，关闭 Wi-Fi 和蓝牙，并让这台设备保持断网。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "請使用專用裝置。在系統設定中開啟飛航模式，關閉 Wi-Fi 和藍牙，並讓這部裝置保持離線。"
          }
        }
      }
    },
    "device_purpose_confirm_cold": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "فصلت هذا الجهاز عن الشبكة"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "আমি এই ডিভাইসের সংযোগ বিচ্ছিন্ন করেছি"
          }
        },
        "cs": {
