    "multisig_policy_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتحكم كل عضو في محفظته الخاصة. للأعضاء وزن متساوٍ، ويلزم توقيع العدد المحدد قبل البث."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রত্যেক সদস্য নিজের ওয়ালেট নিয়ন্ত্রণ করেন। সবার সমান ওজন; নেটওয়ার্কে পাঠানোর আগে নির্ধারিত সংখ্যক সদস্যকে স্বাক্ষর করতে হবে।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý člen ovládá vlastní peněženku. Všichni mají stejnou váhu; před odesláním do sítě musí podepsat požadovaný počet členů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hvert medlem styrer sin egen tegnebog. Alle har samme vægt; det krævede antal skal underskrive før udsendelse."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jedes Mitglied kontrolliert seine eigene Wallet. Alle haben dasselbe Gewicht; vor dem Senden müssen genügend Mitglieder unterschreiben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each member controls their own wallet. Each member has equal weight; the required number must sign before broadcast."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada miembro controla su propia billetera. Todos tienen el mismo peso; debe firmar el número requerido antes de transmitir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر عضو کیف پول خودش را کنترل می‌کند. وزن همه برابر است؛ پیش از انتشار، تعداد لازم از اعضا باید امضا کنند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Bawat miyembro ang may kontrol sa sariling wallet. Pantay ang bigat ng bawat isa; kailangang pumirma ang itinakdang bilang bago ipadala sa network."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque membre contrôle son propre portefeuille. Tous ont le même poids ; le nombre requis doit signer avant la diffusion."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kowane mamba yana sarrafa walat ɗinsa. Nauyinsu daidai ne; dole adadin da ake bukata su sa hannu kafin a watsa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל חבר שולט בארנק שלו. לכל החברים משקל שווה; מספר החברים הנדרש חייב לחתום לפני השידור."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर सदस्य अपना वॉलेट खुद नियंत्रित करता है। सभी का भार समान है; नेटवर्क पर भेजने से पहले तय संख्या में सदस्यों के हस्ताक्षर चाहिए।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap anggota mengendalikan dompetnya sendiri. Bobot semua anggota sama; jumlah anggota yang diwajibkan harus menandatangani sebelum transaksi disiarkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni membro controlla il proprio portafoglio. Tutti hanno lo stesso peso; prima della trasmissione deve firmare il numero richiesto."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "各メンバーが自分のウォレットを管理し、同じ重みを持ちます。必要な人数の署名が揃ってから送信できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "각 구성원은 자신의 지갑을 관리하며 가중치는 같습니다. 전송 전에 필요한 수의 구성원이 서명해야 합니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap ahli mengawal dompet sendiri dengan pemberat yang sama. Bilangan tandatangan yang diperlukan mesti cukup sebelum siaran."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elk lid beheert zijn eigen wallet en heeft hetzelfde gewicht. Voor verzending moeten voldoende leden ondertekenen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy członek kontroluje własny portfel i ma taką samą wagę. Przed rozgłoszeniem musi podpisać wymagana liczba osób."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada membro controla sua própria carteira e tem o mesmo peso. O número exigido deve assinar antes da transmissão."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare membru își controlează portofelul și are aceeași pondere. Numărul necesar de membri trebuie să semneze înainte de difuzare."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый участник управляет своим кошельком и имеет равный вес. Перед отправкой транзакции нужны подписи установленного числа участников."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila mwanachama anadhibiti mkoba wake na ana uzito sawa. Idadi inayohitajika lazima isaini kabla ya kutangaza muamala."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สมาชิกแต่ละคนดูแลกระเป๋าของตนเองและมีน้ำหนักเท่ากัน ต้องมีผู้ลงนามครบตามจำนวนก่อนส่งธุรกรรม"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Her üye kendi cüzdanını kontrol eder ve eşit ağırlığa sahiptir. Yayınlamadan önce gerekli sayıda üye imzalamalıdır."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Кожен учасник контролює свій гаманець і має однакову вагу. До надсилання в мережу потрібні підписи визначеної кількості учасників."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "ہر رکن اپنے والیٹ کا اختیار رکھتا ہے اور سب کا وزن برابر ہے۔ نشر کرنے سے پہلے مطلوبہ تعداد کے دستخط ضروری ہیں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Mỗi thành viên kiểm soát ví riêng và có trọng số bằng nhau. Cần đủ số người ký trước khi phát giao dịch."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "各成员独立保管自己的钱包。每位成员权重相同，达到指定签名人数后才能广播。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "各成員獨立保管自己的錢包。每位成員權重相同，達到指定簽名人數後才能廣播。"
          }
        }
      }
    },
