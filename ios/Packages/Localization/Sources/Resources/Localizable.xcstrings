        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يمكن لمنشئ المحفظة فقط تغيير إعدادات Paymail."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "শুধু ওয়ালেটের স্রষ্টাই Paymail সেটিংস বদলাতে পারেন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Nastavení Paymail může měnit pouze zakladatel peněženky."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kun den, der oprettede tegnebogen, kan ændre Paymail-indstillingerne."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nur der Ersteller der Wallet kann die Paymail-Einstellungen ändern."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The wallet creator can change Paymail settings."
          }
