    "multisig_transfer_rule_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يتطلب كل تحويل توقيعات %d أعضاء. موافقة عضو واحد وحدها لا تكفي لإرسال الأموال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতিটি ট্রান্সফারে %dজন সদস্যের স্বাক্ষর লাগে। একজনের অনুমোদনেই অর্থ পাঠানো যায় না।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Požadovaný počet podepisujících členů při každém převodu: %d. Souhlas jediného člena k odeslání nestačí."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Hver overførsel kræver %d medlemmers underskrifter. Ét medlems godkendelse alene kan ikke sende midler."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jede Überweisung braucht die Signaturen von %d Mitgliedern. Die Zustimmung eines einzelnen Mitglieds reicht nicht aus."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Every transfer requires %d member signatures. One member’s approval alone cannot send funds."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada transferencia requiere las firmas de %d miembros. La aprobación de un solo miembro no permite enviar fondos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هر انتقال به امضای %d عضو نیاز دارد. تأیید تنها یک عضو برای ارسال دارایی کافی نیست."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Kailangan ng lagda ng %d miyembro sa bawat paglipat. Hindi sapat ang pag-apruba ng isang miyembro lang para magpadala ng pondo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaque transfert nécessite la signature de %d membres. L’accord d’un seul membre ne suffit pas à envoyer les fonds."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kowane canja kuɗi yana bukatar sa hannun mambobi %d. Amincewar mamba ɗaya kaɗai ba ta iya aika kuɗi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "כל העברה דורשת חתימות של %d חברים. אישור של חבר אחד בלבד אינו מאפשר לשלוח כספים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "हर ट्रांसफ़र के लिए %d सदस्यों के हस्ताक्षर चाहिए। केवल एक सदस्य की मंज़ूरी से राशि नहीं भेजी जा सकती।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap transfer memerlukan tanda tangan %d anggota. Persetujuan satu anggota saja tidak dapat mengirim dana."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Ogni trasferimento richiede le firme di %d membri. L’approvazione di un solo membro non basta a inviare fondi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金ごとに %d 人の署名が必要です。1 人の承認だけでは送金できません。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모든 이체에는 %d명의 서명이 필요합니다. 한 사람의 승인만으로 자금을 보낼 수 없습니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Setiap pemindahan memerlukan tandatangan %d ahli. Kelulusan seorang sahaja tidak dapat menghantar dana."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Elke overdracht vereist handtekeningen van %d leden. Goedkeuring van één lid kan geen geld verzenden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Każdy transfer wymaga podpisów %d członków. Zgoda jednej osoby nie wystarczy do wysłania środków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Cada transferência exige %d assinaturas de membros. A aprovação de um único membro não permite enviar fundos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Fiecare transfer necesită semnăturile a %d membri. Aprobarea unui singur membru nu poate trimite fonduri."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Каждый перевод требует %d подписей участников. Согласия одного участника недостаточно для отправки средств."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Kila uhamisho unahitaji saini za wanachama %d. Idhini ya mmoja haitoshi kutuma fedha."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
