    "multisig_weight_notice": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "وزن كل عضو 1. يلزم %d توقيعات على الأقل لتحويل الأموال."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "প্রতি সদস্যের ওজন 1। অর্থ পাঠাতে অন্তত %dটি স্বাক্ষর প্রয়োজন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Každý člen má váhu 1. Minimální počet podpisů pro převod: %d."
