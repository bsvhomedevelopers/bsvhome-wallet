        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Solo quien creó la billetera puede cambiar los ajustes de Paymail."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "فقط سازندهٔ کیف پول می‌تواند تنظیمات Paymail را تغییر دهد."
          }
        },
        "fil": {
          "stringUnit": {
