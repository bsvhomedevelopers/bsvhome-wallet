    "rewards.share_text": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "ينضم BsvHome Wallet استخدم رابط الإحالة الخاص بي واحصل على مكافآت: %@"
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "যোগদান করুন BsvHome Wallet আমার রেফারেল লিঙ্ক দিয়ে পুরষ্কার জিতুন: %@"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Připojte se ke BsvHome Wallet pomocí mého doporučovacího odkazu a získejte odměny: %@"
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Deltag BsvHome Wallet med mit henvisningslink og optjen belønninger: %@"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Treten Sie BsvHome Wallet mit meinem Empfehlungslink bei und verdienen Sie Prämien: %@"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Join BsvHome Wallet with my referral link and earn rewards: %@"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Únete a BsvHome Wallet con mi enlace de referencia y gana recompensas: %@"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "عضویت BsvHome Wallet با لینک معرفی من و کسب جوایز: %@"
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Sumali BsvHome Wallet gamit ang aking referral link at kumita ng mga gantimpala: %@"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Rejoignez BsvHome Wallet avec mon lien de parrainage et gagnez des récompenses : %@"
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Shiga BsvHome Wallet tare da hanyar haɗin yanar gizo na kuma sami lada: %@"
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "לְהִצְטַרֵף BsvHome Wallet בעזרת קישור ההפניה שלי וצברו פרסים: %@"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "जोड़ना BsvHome Wallet मेरे रेफरल लिंक का उपयोग करें और पुरस्कार अर्जित करें: %@"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Bergabung BsvHome Wallet Gunakan tautan referensi saya dan dapatkan hadiah: %@"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Unisciti a BsvHome Wallet con il mio link di riferimento e guadagna premi: %@"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "私の紹介リンクから BsvHome Wallet に参加して、ポイントを獲得しましょう：%@"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "제 추천 링크로 BsvHome Wallet에 가입하고 보상을 받으세요: %@"
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Sertai BsvHome Wallet dengan pautan rujukan saya dan dapatkan ganjaran: %@"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Doe mee met BsvHome Wallet via mijn verwijzingslink en verdien beloningen: %@"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dołącz do BsvHome Wallet z moim linkiem polecającym i zyskaj nagrody: %@"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Juntar BsvHome Wallet Use meu link de indicação e ganhe recompensas: %@"
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Alătură-te BsvHome Wallet cu linkul meu de recomandare și câștigă recompense: %@"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Создайте BsvHome Wallet по моей реферальной ссылке и получите вознаграждение: %@"
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Jiunge BsvHome Wallet kwa kutumia kiungo changu cha rufaa na upate zawadi: %@"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "เข้าร่วม BsvHome Wallet ใช้ลิงก์แนะนำของฉันเพื่อรับรางวัล: %@"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Katılmak BsvHome Wallet Benim referans linkimi kullanarak kayıt olun ve ödüller kazanın: %@"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Приєднатися BsvHome Wallet за моїм реферальним посиланням та отримуйте винагороди: %@"
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "شمولیت BsvHome Wallet میرے ریفرل لنک کے ساتھ اور انعامات حاصل کریں: %@"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Tham gia BsvHome Wallet Sử dụng liên kết giới thiệu của tôi và nhận phần thưởng: %@"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通过我的邀请链接加入 BsvHome Wallet，即可获得积分：%@"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "透過我的邀請連結加入 BsvHome Wallet，即可獲得積分：%@"
          }
        }
      }
