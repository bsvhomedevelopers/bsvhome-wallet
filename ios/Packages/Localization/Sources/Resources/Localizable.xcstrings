    "wowpay_usdt_description": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عملة مستقرة مرتبطة بالدولار الأمريكي، تُستخدم للمدفوعات والتحويلات ومبادلة الأصول."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "মার্কিন ডলারের সঙ্গে মূল্য সংযুক্ত একটি স্টেবলকয়েন, যা পেমেন্ট, স্থানান্তর ও সম্পদ অদলবদলে ব্যবহৃত হয়।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Stablecoin navázaný na americký dolar, používaný pro platby, převody a směnu aktiv."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "En stablecoin knyttet til den amerikanske dollar, som bruges til betalinger, overførsler og ombytning af aktiver."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein an den US-Dollar gebundener Stablecoin für Zahlungen, Überweisungen und den Tausch von Assets."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A stablecoin pegged to the US dollar, used for payments, transfers and asset swaps."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stablecoin vinculada al dólar estadounidense, utilizada para pagos, transferencias e intercambios de activos."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "استیبل‌کوینی با ارزش وابسته به دلار آمریکا که برای پرداخت، انتقال و مبادله دارایی‌ها استفاده می‌شود."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Isang stablecoin na nakatali ang halaga sa dolyar ng US, na ginagamit para sa mga pagbabayad, paglilipat at pagpapalit ng mga asset."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un stablecoin indexé sur le dollar américain, utilisé pour les paiements, les transferts et les échanges d’actifs."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Kuɗin dijital mai tsayayyen ƙima da aka ɗaura wa dalar Amurka, ana amfani da shi wajen biyan kuɗi, tura kuɗi da musayar kadarori."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "מטבע יציב הצמוד לדולר האמריקאי, המשמש לתשלומים, להעברות ולהחלפת נכסים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "अमेरिकी डॉलर से जुड़ा स्टेबलकॉइन, जिसका उपयोग भुगतान, हस्तांतरण और संपत्तियों के स्वैप के लिए किया जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Stablecoin yang dipatok ke dolar AS, digunakan untuk pembayaran, transfer, dan penukaran aset."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Una stablecoin ancorata al dollaro statunitense, utilizzata per pagamenti, trasferimenti e scambi di asset."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "米ドルに価値が連動するステーブルコインで、支払い、送金、資産の交換に使用されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "미국 달러에 가치가 연동되는 스테이블코인으로, 결제, 전송 및 자산 교환에 사용됩니다."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Stablecoin yang ditambat kepada dolar AS, digunakan untuk pembayaran, pemindahan dan pertukaran aset."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een stablecoin gekoppeld aan de Amerikaanse dollar, gebruikt voor betalingen, overboekingen en het omwisselen van assets."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Stablecoin powiązany z dolarem amerykańskim, używany do płatności, przelewów i wymiany aktywów."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma stablecoin vinculada ao dólar americano, usada para pagamentos, transferências e trocas de ativos."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Un stablecoin ancorat la dolarul american, folosit pentru plăți, transferuri și schimburi de active."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Стейблкоин, привязанный к доллару США и используемый для платежей, переводов и обмена активов."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Sarafu yenye thamani thabiti iliyounganishwa na dola ya Marekani, inayotumiwa kwa malipo, uhamishaji na kubadilishana mali."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "สเตเบิลคอยน์ที่มีมูลค่าผูกกับดอลลาร์สหรัฐ ใช้สำหรับการชำระเงิน การโอน และการแลกเปลี่ยนสินทรัพย์"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ödemeler, transferler ve varlık takasları için kullanılan, ABD dolarına sabitlenmiş bir sabit coin."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Стейблкоїн, прив’язаний до долара США, який використовується для платежів, переказів та обміну активів."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "امریکی ڈالر سے منسلک ایک اسٹیبل کوائن، جو ادائیگیوں، منتقلیوں اور اثاثوں کے تبادلے کے لیے استعمال ہوتا ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Một stablecoin neo giá vào đô la Mỹ, dùng để thanh toán, chuyển tiền và hoán đổi tài sản."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "与美元价值挂钩的稳定币，用于支付、转账与资产兑换。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "與美元價值掛鉤的穩定幣，用於支付、轉帳與資產兌換。"
          }
        }
      }
    },
