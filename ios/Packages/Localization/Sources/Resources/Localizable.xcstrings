    "wowpay_import_method_private_key_subtitle": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استورد محفظة لسلسلة واحدة بمفتاح خاص"
