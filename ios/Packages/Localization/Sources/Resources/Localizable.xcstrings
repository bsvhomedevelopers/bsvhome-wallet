    "wowpay_network_consistency_note": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تأكد من تطابق الشبكة عند الإرسال أو الاستلام."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "পাঠানো বা গ্রহণ করার সময় নেটওয়ার্ক মিলে যাচ্ছে কিনা নিশ্চিত করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Při odesílání nebo přijímání ověřte, že se sítě shodují."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Kontrollér, at netværket er det samme, når du sender eller modtager."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Stelle beim Senden oder Empfangen sicher, dass das Netzwerk übereinstimmt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirm that the network matches when sending or receiving."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirma que la red coincida al enviar o recibir."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "هنگام ارسال یا دریافت، مطمئن شوید شبکه‌ها یکسان هستند."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Tiyaking pareho ang network kapag nagpapadala o tumatanggap."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vérifiez que le réseau correspond lors de l’envoi ou de la réception."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Tabbatar cibiyar sadarwa ɗaya ce yayin aikawa ko karɓa."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש לוודא שהרשת תואמת בעת שליחה או קבלה."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "भेजते या प्राप्त करते समय सुनिश्चित करें कि नेटवर्क समान है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan jaringannya sama saat mengirim atau menerima."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Verifica che la rete corrisponda quando invii o ricevi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "送金や受取の際は、ネットワークが一致していることを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "보내거나 받을 때 네트워크가 일치하는지 확인하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Pastikan rangkaian sepadan semasa menghantar atau menerima."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Controleer bij het verzenden of ontvangen of het netwerk overeenkomt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przy wysyłaniu lub odbieraniu upewnij się, że sieci są zgodne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirme se a rede é a mesma ao enviar ou receber."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Confirmă că rețeaua este aceeași când trimiți sau primești."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "При отправке или получении убедитесь, что сети совпадают."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Hakikisha mitandao inalingana unapotuma au kupokea."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ยืนยันว่าเครือข่ายตรงกันเมื่อส่งหรือรับ"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Gönderirken veya alırken ağın eşleştiğini doğrulayın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час надсилання або отримання перевірте, що мережі збігаються."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "بھیجتے یا وصول کرتے وقت تصدیق کریں کہ نیٹ ورک ایک ہی ہے۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Xác nhận mạng trùng khớp khi gửi hoặc nhận."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "转账和收款时请确认网络一致。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "轉帳和收款時請確認網路一致。"
          }
        }
      }
    },
