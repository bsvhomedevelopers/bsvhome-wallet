    "multisig_rule_limits": {
      "extractionState": "manual",
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم من 2 إلى 5 أعضاء وحدًا للتوقيعات من 2 إلى عدد الأعضاء."
          }
        },
        "bn": {
          "stringUnit": {
            "state": "translated",
            "value": "2–5 জন সদস্য এবং 2 থেকে সদস্যসংখ্যা পর্যন্ত প্রয়োজনীয় স্বাক্ষর নির্ধারণ করুন।"
          }
        },
        "cs": {
          "stringUnit": {
            "state": "translated",
            "value": "Použijte 2–5 členů a vyžadujte 2 až celkový počet podpisů členů."
          }
        },
        "da": {
          "stringUnit": {
            "state": "translated",
            "value": "Brug 2–5 medlemmer og en underskriftstærskel fra 2 til antallet af medlemmer."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende 2–5 Mitglieder und eine Signaturschwelle zwischen 2 und der Mitgliederzahl."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use 2–5 members and a threshold from 2 to the member count."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa entre 2 y 5 miembros y un umbral de firmas de 2 hasta el número de miembros."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "از 2 تا 5 عضو و حد نصاب امضا از 2 تا تعداد اعضا استفاده کنید."
          }
        },
        "fil": {
          "stringUnit": {
            "state": "translated",
            "value": "Gumamit ng 2–5 miyembro at magtakda ng kailangang lagda mula 2 hanggang sa bilang ng miyembro."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez 2 à 5 membres et un seuil de signatures compris entre 2 et le nombre de membres."
          }
        },
        "ha": {
          "stringUnit": {
            "state": "translated",
            "value": "Yi amfani da mambobi 2–5 da adadin sa hannu daga 2 zuwa adadin mambobi."
          }
        },
        "he": {
          "stringUnit": {
            "state": "translated",
            "value": "יש להשתמש ב־2–5 חברים ובסף חתימות מ־2 עד מספר החברים."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "2–5 सदस्य रखें और ज़रूरी हस्ताक्षरों की संख्या 2 से सदस्यों की कुल संख्या तक चुनें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan 2–5 anggota dan ambang tanda tangan dari 2 hingga jumlah anggota."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa da 2 a 5 membri e una soglia di firme da 2 al numero di membri."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メンバーは2〜5人、必要署名数は2からメンバー数までに設定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "구성원은 2~5명, 필요 서명 수는 2부터 구성원 수까지 설정하세요."
          }
        },
        "ms": {
          "stringUnit": {
            "state": "translated",
            "value": "Gunakan 2–5 ahli dan ambang tandatangan dari 2 hingga bilangan ahli."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik 2–5 leden en vereis 2 tot het totale aantal handtekeningen van de leden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz 2–5 członków i próg podpisów od 2 do liczby członków."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use de 2 a 5 membros e exija de 2 assinaturas até o total de membros."
          }
        },
        "ro": {
          "stringUnit": {
            "state": "translated",
            "value": "Folosește 2–5 membri și un prag de semnături între 2 și numărul membrilor."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте 2–5 участников и порог подписей от 2 до числа участников."
          }
        },
        "sw": {
          "stringUnit": {
            "state": "translated",
            "value": "Tumia wanachama 2–5 na kiwango cha saini kuanzia 2 hadi idadi ya wanachama."
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้สมาชิก 2–5 คนและกำหนดจำนวนลายเซ็นตั้งแต่ 2 ถึงจำนวนสมาชิกทั้งหมด"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "2–5 üye ve 2 ile üye sayısı arasında bir imza eşiği kullanın."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте 2–5 учасників і поріг підписів від 2 до кількості учасників."
          }
        },
        "ur": {
          "stringUnit": {
            "state": "translated",
            "value": "2–5 اراکین رکھیں اور دستخط کی مطلوبہ حد 2 سے اراکین کی تعداد تک مقرر کریں۔"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng 2–5 thành viên và ngưỡng chữ ký từ 2 đến số lượng thành viên."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "成员人数为 2–5 人，签名门槛为 2 至成员总数。"
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "成員人數為 2–5 人，簽名門檻為 2 至成員總數。"
          }
        }
      }
    },
